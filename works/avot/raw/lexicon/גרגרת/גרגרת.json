[{"headword": "גַּרְגֶּרֶת", "parent_lexicon": "Jastrow Dictionary", "rid": "C01265", "language_code": "(b. h. ", "refs": ["Jastrow, גָּרַר I 1", "Kohelet Rabbah 12:6:1", "Vayikra Rabbah 18:1", "Shemot Rabbah 24", "Mishnah Chullin 3:3"], "content": {"senses": [{"definition": " pl. <span dir=\"rtl\">גַּרְגְּרוֹת</span> <i>neck;</i> <span dir=\"rtl\">גרגר</span>; v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_גָּרַר I.1\" data-ref=\"Jastrow, גָּרַר I 1\">גָּרַר</a>, <i>throat, gullet;</i> (in ritual law) <i>wind-pipe, trachea</i>. <a class=\"refLink\" href=\"/Kohelet_Rabbah.12.6.1\" data-ref=\"Kohelet Rabbah 12:6:1\">Koh. R. to XII, 6</a>; <a class=\"refLink\" href=\"/Vayikra_Rabbah.18.1\" data-ref=\"Vayikra Rabbah 18:1\">Lev. R. s. 18</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_גָּלָה.1\" data-ref=\"Jastrow, גָּלָה 1\">גָּלָה</a> Hif.—<a class=\"refLink\" href=\"/Shemot_Rabbah.24\" data-ref=\"Shemot Rabbah 24\">Ex. R. s. 24</a> the Lord created for man <span dir=\"rtl\">מעין בתוך גַּרְגַּרְתֹּו</span> a well (mucous membranes) in the trachea. <a class=\"refLink\" href=\"/Mishnah_Chullin.2.4\" data-ref=\"Mishnah Chullin 2:4\">Ḥull. II, 4</a> <span dir=\"rtl\">פסק את הג׳</span> he tore open (instead of cutting) the trachea. <a class=\"refLink\" href=\"/Mishnah_Chullin.3.3\" data-ref=\"Mishnah Chullin 3:3\">Ib. III, 3</a> <span dir=\"rtl\">פסוקת הג׳</span> an animal with a split between the rings of the wind-pipe."}]}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "גַּרְגְּרָנִית", "next_hw": "גַּרְגִּשְׁתָּא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "גַּרְגֶּרֶת", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p><sup class=\"footnote-marker\">1</sup><i class=\"footnote\">אולי שם חקוי הקול.</i>, ש\"נ, מ\"ר גַּרְגָּרוֹת, — א) כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_גָּרוֹן.1\" data-ref=\"Ben Yehuda Dictionary, גָּרוֹן 1\">גָּרוֹן</a>:  חסד  ואמת אל יעזבך קשרם על גַּרְגְּרוֹתֶיך כתבם על לוח לבך (<span class=\"by-source\">משלי ג ג</span>).  — ב)  ביחוד * הקנה שבתוך הגרון שהקול יוצא ממנו, Gurgel;  gosier;  trachea:  שחט את הוושט ופסק את ה<strong>גרגרת</strong> או שחט את ה<strong>גרגרת</strong> ופסק את הוושט (<span class=\"by-source\">חול' ב ד</span>).  אלו טריפות בבהמה נקובת הוושט ופסוקת ה<strong>גרגרת</strong> (<span class=\"by-source\">שם ג א</span>).  נשמטה ה<strong>גרגרת </strong>ואח\"כ שחט את הוושט שחיטתו פסולה שחט את הוושט ונמצאת ה<strong>גרגרת</strong> שמוטה (<span class=\"by-source\">תוספתא שם ב ד</span>).  ובכנ':  ברא הקב\"ה מעין בתוך <strong>גרגרתו  </strong>(של האדם) שהוא מוריד את הפת בשלום (<span class=\"by-source\">מד\"ר שמות כד</span>).</p>"]}, "rid": "BY-03048", "prev_hw": "גַּרְגְּרָנִית", "next_hw": "גְּרֹגֶרֶת I", "page_num": 833, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]