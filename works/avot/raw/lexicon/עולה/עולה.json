[{"headword": "עֶוֶל", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n", "senses": [{"definition": "injustice,  unrighteousness,  wrong", "senses": [{"definition": "violent deeds of injustice"}, {"definition": "injustice (of speech)"}, {"definition": "injustice (generally)"}]}]}, "strong_number": "5766", "transliteration": "ʻevel", "pronunciation": "eh'-vel", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "עַוְלָה", "parent_lexicon": "Jastrow Dictionary", "rid": "P00250", "refs": ["Jastrow, עָוֶל 1", "Ketubot 19b:1"], "content": {"senses": [{"definition": " (b. h; v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עָוֶל.1\" data-ref=\"Jastrow, עָוֶל 1\">עָוֶל</a>) <i>wrong</i>. <a class=\"refLink\" href=\"/Ketubot.19b.1\" data-ref=\"Ketubot 19b:1\">Keth. 19ᵇ</a> <span dir=\"rtl\">כיון דע׳ הוא אע׳ חתמי</span> since it (the holding of a bill of indebtedness on trust, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אֲמָנָה.1\" data-ref=\"Jastrow, אֲמָנָה 1\">אֲמָנָה</a>) is a wrong, (a violation of the rule, ‘harbor no wrong in thy tent’, <a class=\"refLink\" href=\"/Job.11.14\" data-ref=\"Job 11:14\">Job XI, 14</a>), they would not have lent their signature to a wrong act; a. e."}], "morphology": "f."}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "עוּלְבַּן", "next_hw": "עַוְלָה ²", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "עַוְלָה ²", "parent_lexicon": "Jastrow Dictionary", "rid": "P00251", "refs": ["Jastrow, עַוְלָא 1"], "content": {"senses": [{"definition": " ch., v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עַוְלָא.1\" data-ref=\"Jastrow, עַוְלָא 1\">עַוְלָא</a>"}]}, "quotes": [], "prev_hw": "עַוְלָה", "next_hw": "עוּלָה I", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "עַוְלָה", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"plural_form": "(pl. <span dir=\"rtl\">עוֹלוֹת</span>, also <span dir=\"rtl\">עַוֽלוֹת</span>)", "definition": "injustice, unrighteousness."}]}, "rid": "P00245", "refs": ["Klein Dictionary, עול ᴵ 1", "Klein Dictionary, עַלְוָה ᴵᴵ 1", "Klein Dictionary, עול ᴵ 1", "Klein Dictionary, עַלְוָה ᴵᴵ 1"], "prev_hw": "עוֹלָה", "next_hw": "עוּלָה", "notes": "[From <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_עול ᴵ.1\" data-ref=\"Klein Dictionary, עול ᴵ 1\">עול ᴵ</a>. cp. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_עַלְוָה ᴵᴵ.1\" data-ref=\"Klein Dictionary, עַלְוָה ᴵᴵ 1\">עַלְוָה ᴵᴵ</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "עָ֫וֶל", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.m. injustice, unrighteousness</strong> (opp. <span dir=\"rtl\">צְדָקָה</span>);—<span di