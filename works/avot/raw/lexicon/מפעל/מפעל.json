[{"headword": "מִפְעָל", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"plural_form": "(pl. <span dir=\"rtl\">מִפְעָלִים</span>, also <span dir=\"rtl\">מִפְעָלוֹת</span>)", "definition": "deed, work, action; in the Bible occurring only <a class=\"refLink\" href=\"/Proverbs.8.22\" data-ref=\"Proverbs 8:22\">Pr. 8:22</a> <span dir=\"rtl\">(<span dir=\"rtl\">מִפְעָלָיו</span>)</span>, <a class=\"refLink\" href=\"/Psalms.46.9\" data-ref=\"Psalms 46:9\">Ps. 46:9</a> and <a class=\"refLink\" href=\"/Psalms.66.5\" data-ref=\"Psalms 66:5\">66:5</a> <span dir=\"rtl\">(<span dir=\"rtl\">מִפְעֲלוֹת</span>)</span>.", "number": "1"}, {"definition": "undertaking, enterprise.", "number": "2", "language_code": "NH"}]}, "rid": "M03336", "refs": ["Psalms 66:5", "Klein Dictionary, פעל 1", "Klein Dictionary, מִ◌ 1", "Klein Dictionary, פעל 1", "Klein Dictionary, מִ◌ 1", "Klein Dictionary, מִפֽעָלִי 1", "Klein Dictionary, מִפֽעָלִי 1"], "derivatives": "Derivative: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מִפֽעָלִי.1\" data-ref=\"Klein Dictionary, מִפֽעָלִי 1\">מִפְעָלִי</a>.", "prev_hw": "מְפֻסָּק", "next_hw": "מֻפְעָל", "notes": "[Formed from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_פעל.1\" data-ref=\"Klein Dictionary, פעל 1\">פעל</a> (= to make, do), with pref. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מִ◌.1\" data-ref=\"Klein Dictionary, מִ◌ 1\">מִ◌</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מִפְעָל", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>ש\"ז, מ\"ר בכנ' מִפְעָלָיו, — מה שפעל אדם, מַעֲשֶׂה: יי' קנני ראשית דרכו קדם מִפְעָלָיו מאז (<span class=\"by-source\">משלי ח כב</span>). — ואמר המשורר: אנשים יש לכל <strong>מפעל</strong> וכל איש מקודש לאשר חפץ ובוחר <span class=\"by-source\">(ר\"ש הנגיד, בן משלי א ב)</span>. לפי שכלו יהולל איש ו<strong>מפעליו </strong>בפרהסיא <span class=\"by-source\">(הוא, הבמות פליליה)</span>. אשר נסתר יקר עדיו ונגלה ב<strong>מפעליו </strong>לעיני רעיוני <span class=\"by-source\">(רמב\"ע, הקיצותי)</span>. — ובדברים לא בע\"ח: שער שמיני בחבור הככבים <strong>ומפעליהם</strong> <span class=\"by-source\">(ראב\"ע, ספ' למשאלה בקדרות ח)</span>. — ובמשמ' פֹעל בדקדוק: והכלל כל<strong> מפעל</strong> שהוא עם סימן לשון יחיד וכו' לעולם הוא פתוח <span class=\"by-source\">(ראב\"ע, צחות ג:)</span>.</p>"]}, "rid": "BY-11096", "prev_hw": "מִפְסָע", "next_hw": "מִפְעָלָה", "page_num": 3218, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]