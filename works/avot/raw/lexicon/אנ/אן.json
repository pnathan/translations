[{"headword": "אָן", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "adv", "senses": [{"definition": "where?,  whither? (of place)"}, {"definition": "when?,  until when?, how long? (of time)"}]}, "strong_number": "575", "transliteration": "ʼân", "pronunciation": "awn", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "אָן", "parent_lexicon": "Jastrow Dictionary", "rid": "A02081", "refs": [], "content": {"senses": [{"definition": " (b. h.) <i>where?</i> לְאָן <i>whither.</i> <a class=\"refLink\" href=\"/Pirkei_Avot.3.1\" data-ref=\"Pirkei Avot 3:1\">Ab. III, 1</a>."}]}, "quotes": [], "prev_hw": "אֶן", "next_hw": "אָן ²", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אָן ²", "parent_lexicon": "Jastrow Dictionary", "rid": "A02082", "language_code": " ch. ", "refs": ["Jastrow, אָן 1", "Vayikra Rabbah 27:1", "Vayikra Rabbah 27:6", "Yalkut Shimoni on Nach 727:1", "Jerusalem Talmud Yoma 8:1:9", "Jerusalem Talmud Yevamot 12:6:2"], "language_reference": "<a class=\"refLink\" href=\"/Jastrow,_אָן.1\" data-ref=\"Jastrow, אָן 1\">same</a>", "content": {"senses": [{"definition": "; (interrog.) <i>where?</i> <a class=\"refLink\" href=\"/Onkelos_Genesis.4.9\" data-ref=\"Onkelos Genesis 4:9\">Targ. Gen. IV, 9</a>; a. e.—<a class=\"refLink\" href=\"Jerusalem_Talmud_Yoma.8.1.9\" data-ref=\"Jerusalem Talmud Yoma 8:1:9\">Y. Yoma VIII, 44ᵈ</a> bot. <span dir=\"rtl\">אן מן הדה</span> (read … <span dir=\"rtl\">מן אן</span>) wherefrom this? i.e. where is your authority? <a class=\"refLink\" href=\"Jerusalem_Talmud_Yevamot.12.6.2\" data-ref=\"Jerusalem Talmud Yevamot 12:6:2\">Y. Yeb. XII, 12ᵈ</a> bot. <span dir=\"rtl\">ההן סבא לְאָן ליך</span> of what use is this old man to thee?; a. e.—(relat.) <i>where, wherever</i>. <a class=\"refLink\" href=\"/Vayikra_Rabbah.27.6\" data-ref=\"Vayikra Rabbah 27:6\">Lev. R. s. 27</a> beg. <span dir=\"rtl\">א׳ את יהיב וכ׳</span> (<a class=\"refLink\" href=\"/Yalkut_Shimoni_on_Nach.727.1\" data-ref=\"Yalkut Shimoni on Nach 727:1\">Yalk. Ps. 727</a> <span dir=\"rtl\">הן</span>) wherever thou givest, thou givest abundantly."}]}, "plural_form": [], "alt_headwords": ["אַן"], "quotes": [], "prev_hw": "אָן", "next_hw": "אָנָּא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אָן", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "pron.", "senses": [{"definition": "where? whither?"}]}, "rid": "A01505", "refs": ["Klein Dictionary, אַֽיִן ᴵ 1", "Klein Dictionary, אָן 1", "Klein Dictionary, אנה ᴵ 1", "Klein Dictionary, אנה ᴵ 1", "Klein Dictionary, אַֽיִן ᴵ 1", "Klein Dictionary, אָן 1", "Klein Dictionary, אנה ᴵ 1", "Klein Dictionary, אנה ᴵ 1"], "alt_headwords": ["אָֽנָה"], "prev_hw": "אֲמַתְלָן", "next_hw": "אָנָ◌", "notes": "[Prob. not related to <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_אַֽיִן ᴵ.1\" data-ref=\"Klein Dictionary, אַֽיִן ᴵ 1\">אַיִן</a> (= where), as generally assumed, but standing for <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_אָן.1\" data-ref=\"Klein Dictionary, אָן 1\">אָ־ן</a>, resp. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_אנה ᴵ.1\" data-ref=\"Klein Dictionary, אנה ᴵ 1\">אָ־נָה</a>, i.e. formed from interrogative pref. <i>’a</i> and pron. base - <i>n, -an</i>. Accordingly Heb. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_אנה ᴵ.1\" data-ref=\"Klein Dictionary, אנה ᴵ 1\">אָנָה</a> and Arab. <i>annay</i> (= where? where… from? why?) correspond to each other derivatively.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אָן", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>adv. (</strong>contracted from I. <span dir=\"rtl\">אַיִן</span><strong>) where</strong>? or <strong>whither</strong>? <a data-ref=\"I Samuel 10:14\" href=\"/I_Samuel.10.14\">1 S 10:14</a> (cf. <a data-ref=\"I Samuel 27:10\" href=\"/I_Samuel.27.10\">27:10</a> 𝔖 𝔗, v. sub <a data-ref=\"BDB, אַל\" href=\"/BDB,_אַל\", dir=\"rtl\">אַל</a> ad fin.); only besides in †<span dir=\"rtl\">מֵאָן</span> <em>whence?</em> <a data-ref=\"II Kings 5:25\" href=\"/II_Kings.5.25\">2 K 5:25</a> Kt (Qr <span dir=\"rtl\">מֵאַיִן</span>); †<span dir=\"rtl\">עַד־אָן</span> of time <em>to what point? how long?</em> <a data-ref=\"Job 8:2\" href=\"/Job.8.2\">Jb 8:2</a>. With ה <em>locale:</em> <span dir=\"rtl\">אָ֫נָה</span> (<em>a</em>) <em>whither?</em> <a data-ref=\"Genesis 16:8\" href=\"/Genesis.16.8\">Gn 16:8</a>; <a data-ref=\"Genesis 32:18\" href=\"/Genesis.32.18\">32:18</a> <a data-ref=\"II Samuel 2:1\" href=\"/II_Samuel.2.1\">2 S 2:1</a>; <a data-ref=\"II Samuel 13:13\" href=\"/II_Samuel.13.13\">13:13</a> <a data-ref=\"II Kings 6:6\" href=\"/II_Kings.6.6\">2 K 6:6</a> <a data-ref=\"Psalms 139:7\" href=\"/Psalms.139.7\">ψ 139:7</a><sup>(×2)</sup> + 9 textual; in indirect sentence <a data-ref=\"Joshua 2:5\" href=\"/Joshua.2.5\">Jos 2:5</a> <a data-ref=\"Nehemiah 2:16\" href=\"/Nehemiah.2.16\">Ne 2:16</a>; (<em>b</em>) <em>pregnantly</em> †<a data-ref=\"Ruth 2:19\" href=\"/Ruth.2.19\">Ru 2:19</a> <a data-ref=\"Isaiah 10:3\" href=\"/Isaiah.10.3\">Is 10:3</a>; (<em>c</em>) in the phrase <span dir=\"rtl\">אָ֫נֶה וָאָ֫נָה</span> <em>any whither</em> †<a data-ref=\"I Kings 2:36\" href=\"/I_Kings.2.36\">1 K 2:36</a>, <a data-ref=\"I Kings 2:42\" href=\"/I_Kings.2.42\">42</a> <a data-ref=\"II Kings 5:25\" href=\"/II_Kings.5.25\">2 K 5:25</a>; (<em>d</em>) of time, <span dir=\"rtl\">עַד־אָ֫נָה</span> <em>how long?</em> †<a data-ref=\"Exodus 16:28\" href=\"/Exodus.16.28\">Ex 16:28</a> <a data-ref=\"Numbers 14:11\" href=\"/Numbers.14.11\">Nu 14:11</a><sup>(×2)</sup> (c. <span dir=\"rtl\">לֹא</span>) <a data-ref=\"Joshua 18:3\" href=\"/Joshua.18.3\">Jos 18:3</a> <a data-ref=\"Jeremiah 47:6\" href=\"/Jeremiah.47.6\">Je 47:6</a> (sq. <span dir=\"rtl\">לֹא</span>) <a data-ref=\"Habakkuk 1:2\" href=\"/Habakkuk.1.2\">Hb 1:2</a> <a data-ref=\"Psalms 13:2\" href=\"/Psalms.13.2\">ψ 13:2</a><sup>(×2)</sup>, <a data-ref=\"Psalms 13:3\" href=\"/Psalms.13.3\">3</a><sup>(×2)</sup>; <a data-ref=\"Psalms 62:4\" href=\"/Psalms.62.4\">62:4</a> <a data-ref=\"Job 18:2\" href=\"/Job.18.2\">Jb 18:2</a>; <a data-ref=\"Job 19:2\" href=\"/Job.19.2\">19:2</a> (less common than the syn. <span dir=\"rtl\">עַד מָתַי</span>)."}]}, "rid": "BDB00404", "strong_numbers": ["575"], "next_hw": "אֵיפֹה", "prev_hw": "אַ֫יִן", "quotes": [], "GK": ["625"], "TWOT": ["75g"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אָן²", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>adv.</strong> v. p. 33 sub <a data-ref=\"BDB, אַי\" href=\"/BDB,_אַי\", dir=\"rtl\">אַי</a>."}]}, "rid": "BDB00638", "strong_numbers": ["575"], "next_hw": "אֹן", "prev_hw": "אַמְתַּ֫חַת", "quotes": [], "GK": ["625"], "TWOT": ["75g"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אָן", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p><sup class=\"footnote-marker\">2</sup><i class=\"footnote\">לפי דעת חכמי הדקדוק האחרונים מקֻצר מן אַין. ויש דומה לקצור כזה גם בערבית. ודעת הראשנים (ריב\"ג ואחרים) כי היסוד היא אָן והוסיפו ה במלת אנה.</i>, מלת השאלה, — א) שאלת המקום, wo, wohin; où; where : ויאמר דוד שאול אליו ואל נערו אָן הלכתם ויאמר לבקש את האתנות (<span class=\"by-source\">ש\"א י יד</span>). ויאמר לו (אלהים להאדם) איכה <strong>אן</strong> נטה לבך (<span class=\"by-source\">סנה' לח:</span>). — ועם מֵ, מֵאָן, לשאלת המקום שמשם בא, woher; d'où; whence : ויאמר אליו אלישע מאן<sup class=\"footnote-marker\">3</sup><i class=\"footnote\">כך הכתיב ונקוד מֵאַׅן, ונמסר מאין קרי.</i> גחזי (<span class=\"by-source\">מ\"ב ה כה</span>). — ועם ל לפניה *לְאָן, כמו אָן לבדה, המקום ששמה: דע מאין באת <strong>ולאן</strong> אתה הולך (<span class=\"by-source\">אב' ג א</span>). —  °והשתמשו במלת אָן במשמעת אַיֵּה: חברי אָן יהי נמצא דבר חכמה ותושיה (<span class=\"by-source\">ר\"ש הנגיד, הבמות פליליה</span>). — °אָן ואָן, כמו פה ושם: הודות הוגים לך אָן ואָן (<span class=\"by-source\">קונט' הפיוטים, הוצ' מק\"נ דף ח</span>). — ב) לשאלת הזמן, עם עד, עד אָן, עד כמה זמן עוד: ויען בלדד השוחי ויאמר עַד אָן תמלל אלה (<span class=\"by-source\">איוב ח א-ב</span>).</p>"]}, "rid": "BY-00923", "prev_hw": "אֶמְתָּן", "next_hw": "אָנָּא", "page_num": 306, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]