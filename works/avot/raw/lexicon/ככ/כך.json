[{"headword": "כָּךְ", "parent_lexicon": "Jastrow Dictionary", "rid": "K00655", "language_code": "(b. h. ", "refs": ["Jastrow, כָּכָה 1", "Bava Kamma 61a:3", "Sanhedrin 66b", "Sanhedrin 65a", "Rosh Hashanah 18b:15", "Bamidbar Rabbah 4:1", "Bamidbar Rabbah 4:2", "Bamidbar Rabbah 4:6", "Bamidbar Rabbah 4:8", "Bamidbar Rabbah 4:10", "Bamidbar Rabbah 4:13", "Bamidbar Rabbah 4:14", "Bamidbar Rabbah 4:15", "Bamidbar Rabbah 4:16", "Bamidbar Rabbah 4:18", "Bamidbar Rabbah 4:20"], "language_reference": "<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_כָּכָה.1\" data-ref=\"Jastrow, כָּכָה 1\"><a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_כָּכָה.1\" data-ref=\"Jastrow, כָּכָה 1\">כָּכָה</a>)</a>", "content": {"senses": [{"definition": "<i>thus, so.</i> <a class=\"refLink\" href=\"/Pirkei_Avot.4.5\" data-ref=\"Pirkei Avot 4:5\">Ab. IV, 5</a> <span dir=\"rtl\">וכך הי׳ הלל וכ׳</span> and even so (in the same sense) did Hillel say. <a class=\"refLink\" href=\"/Bava_Kamma.61a.3\" data-ref=\"Bava Kamma 61a:3\">B. Kam. 61ᵃ</a> <span dir=\"rtl\">כך מקובלני וכ׳</span> such is my tradition from &c. <a class=\"refLink\" href=\"/Tosefta_Ketubot.5.9\" data-ref=\"Tosefta Ketubot 5:9\">Tosef. Keth. V, 9</a> <span dir=\"rtl\">כך תתנו וכ׳</span> even so much (and no more) may you have wherewith to endow your daughters; Bab. <a class=\"refLink\" href=\"/Sanhedrin.66b\" data-ref=\"Sanhedrin 66b\">Snh. 66ᵇ</a>; <a class=\"refLink\" href=\"/Sanhedrin.65a\" data-ref=\"Sanhedrin 65a\">ib. 65ᵃ</a> <span dir=\"rtl\">כך תפסקו</span>; Y. ib. V, end, 30ᶜ <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_כָּכָה.1\" data-ref=\"Jastrow, כָּכָה 1\">כָּכָה</a>; a. fr.—כך וכך <i>so and so many, a certain number, date</i> &c. <a class=\"refLink\" href=\"/Rosh_Hashanah.18b.15\" data-ref=\"Rosh Hashanah 18b:15\">R. Hash. 18ᵇ</a> <span dir=\"rtl\">בשנת כך וכך ליוחנן וכ׳</span> in the year—of John &c.; a. fr.—<span dir=\"rtl\">אחר כך</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אַחַר.1\" data-ref=\"Jastrow, אַחַר 1\">אַחַר</a>.—<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_לְכָךְ.1\" data-ref=\"Jastrow, לְכָךְ 1\">לְכָךְ</a> (cmp. b. h. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_לָכֵן.1\" data-ref=\"Jastrow, לָכֵן 1\">לָכֵן</a>) <i>for such a purpose, therefore.</i> <a class=\"refLink\" href=\"/Pirkei_Avot.2.8\" data-ref=\"Pirkei Avot 2:8\">Ab. II, 8</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_יָצַר.1\" data-ref=\"Jastrow, יָצַר 1\">יָצַר</a>. <a class=\"refLink\" href=\"/Bamidbar_Rabbah.4.20\" data-ref=\"Bamidbar Rabbah 4:20\">Num. R. s. 4</a>, beg. <span dir=\"rtl\">ל׳ דַּקְדֵּק וכ׳</span> therefore be exact in recording the numbers &c.; a. fr.—V. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_הִילְכָךְ.1\" data-ref=\"Jastrow, הִילְכָךְ 1\">הִילְכָךְ</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_לְפִיכָךְ.1\" data-ref=\"Jastrow, לְפִיכָךְ 1\">לְפִיכָךְ</a>."}]}, "plural_form": [], "alt_headwords": [], "quotes": [[null, "כך וכך", null]], "prev_hw": "כִּיתְרָא", "next_hw": "כַּכָּא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "כָּךְ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "adv.", "senses": [{"definition": "so."}]}, "rid": "K00376", "language_code": "PBH", "refs": ["Klein Dictionary, כָּֽכָה 1", "Klein Dictionary, הִלְכָּךְ 1", "Klein Dictionary, לְפִיכָךְ 1", "Klein Dictionary, כָּֽכָה 1", "Klein Dictionary, הִלְכָּךְ 1", "Klein Dictionary, לְפִיכָךְ 1"], "prev_hw": "כִּישׁוֹר", "next_hw": "ככב", "notes": "[Prob. shortened from Biblical Heb. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_כָּֽכָה.1\" data-ref=\"Klein Dictionary, כָּֽכָה 1\">כָּכָה</a>. cp. the second element in <a dir=\"rtl\" clas