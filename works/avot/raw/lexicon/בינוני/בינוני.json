[{"headword": "בֵּינוֹנִי", "parent_lexicon": "Jastrow Dictionary", "rid": "B00643", "refs": ["Sotah 42b:5", "Vayikra Rabbah 30:7", "Kohelet Rabbah 9:7:1", "Rosh Hashanah 16b:12", "Mishnah Kelim 17:10", "Jerusalem Talmud Shabbat 1:1:24", "Jerusalem Talmud Berakhot 1:1:22", "Jerusalem Talmud Taanit 1:1:14", "Jerusalem Talmud Berakhot 5:2:14", "Jerusalem Talmud Shekalim 6:1:9", "Jerusalem Talmud Sotah 8:3:8"], "content": {"senses": [{"definition": " (<span dir=\"rtl\">בין</span>) <i>central, mean</i> (between extremes), <i>average</i>. <a class=\"refLink\" href=\"Jerusalem_Talmud_Shabbat.1.1.24\" data-ref=\"Jerusalem Talmud Shabbat 1:1:24\">Y. Sabb. I, 2ᵈ</a> bot. <span dir=\"rtl\">לא לח וכ׳</span> neither wet, nor dry, but between the two (moist). <span dir=\"rtl\">אדם ב׳</span> a man of average strength. <a class=\"refLink\" href=\"Jerusalem_Talmud_Berakhot.1.1.22\" data-ref=\"Jerusalem Talmud Berakhot 1:1:22\">Y. Ber. I, 2ᶜ</a> bot.; a. fr.—<a class=\"refLink\" href=\"/Sotah.42b.5\" data-ref=\"Sotah 42b:5\">Sot. 42ᵇ</a> <span dir=\"rtl\">ב׳ שבאחיו</span> the middle betw. his brothers (the third of five).—Pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_בֵּינוֹנִי.1\" data-ref=\"Jastrow, בֵּינוֹנִי 1\">בֵּינוֹנִים</a>, <span dir=\"rtl\">בֵּינוֹנִיִּים</span>. <a class=\"refLink\" href=\"/Vayikra_Rabbah.30.7\" data-ref=\"Vayikra Rabbah 30:7\">Lev. R. s. 30</a> <span dir=\"rtl\">בֵּינוֹנֵי המדינה</span> people of the middle class, opp. <span dir=\"rtl\">גדולי</span>; <a class=\"refLink\" href=\"/Kohelet_Rabbah.9.7.1\" data-ref=\"Kohelet Rabbah 9:7:1\">Koh. R. to IX, 7</a> <span dir=\"rtl\">הבינונים</span>; Tanḥ. Emor 22 <span dir=\"rtl\">בריוני</span> (corr. acc.). <a class=\"refLink\" href=\"/Rosh_Hashanah.16b.12\" data-ref=\"Rosh Hashanah 16b:12\">R. Hash. 16ᵇ</a> <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_ב׳.1\" data-ref=\"Jastrow, ב׳ 1\">ב׳</a> those between the very good and the very bad; a. fr.—Fem. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_בֵּינוֹנִי.1\" data-ref=\"Jastrow, בֵּינוֹנִי 1\">בֵּינוֹנִית</a>. <a class=\"refLink\" href=\"/Mishnah_Gittin.5.1\" data-ref=\"Mishnah Gittin 5:1\">Gitt. V, 1</a>, a. fr. (sub. <span dir=\"rtl\">שדה</span>) <i>a field of average fertility;</i> betw. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עִידִּית.1\" data-ref=\"Jastrow, עִידִּית 1\">עידית</a> a. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_זִיבּוּרִית.1\" data-ref=\"Jastrow, זִיבּוּרִית 1\">זיבורית</a>.—<a class=\"refLink\" href=\"Jerusalem_Talmud_Taanit.1.1.14\" data-ref=\"Jerusalem Talmud Taanit 1:1:14\">Y. Taan. I, 64ᵃ</a> bot. <span dir=\"rtl\">הב׳</span> the intermediate rainy season.—<a class=\"refLink\" href=\"Jerusalem_Talmud_Berakhot.5.2.14\" data-ref=\"Jerusalem Talmud Berakhot 5:2:14\">Y. Ber. V, 9ᶜ</a> bot. there are three things of which too much or too little is obnoxious <span dir=\"rtl\">ובֵינוֹנִיתָן יפה</span> but a reasonable quantity good. <a class=\"refLink\" href=\"/Mishnah_Kelim.17.7\" data-ref=\"Mishnah Kelim 17:7\">Kel. XVII, 7</a>; a. fr.—Pl. <span dir=\"rtl\">בֵּינוֹנִיּוֹת</span>. <a class=\"refLink\" href=\"/Mishnah_Kelim.17.10\" data-ref=\"Mishnah Kelim 17:10\">Ib. 10</a> <span dir=\"rtl\">היו ב׳</span> were mean cubits; <a class=\"refLink\" href=\"Jerusalem_Talmud_Shekalim.6.1.9\" data-ref=\"Jerusalem Talmud Shekalim 6:1:9\">Y. Shek. VI, 49ᵈ</a> top <span dir=\"rtl\">הוא כבניינות</span>; <a class=\"refLink\" href=\"Jerusalem_Talmud_Sotah.8.3.8\" data-ref=\"Jerusalem Talmud Sotah 8:3:8\">Y. Sot. VIII, 22ᶜ</a> bot. <span dir=\"rtl\">בבינויות</span> (corr. acc.)."}], "morphology": "m."}, "plural_form": ["בֵּינוֹנִים", "בֵּינוֹנִיִּים", "בֵּינוֹנִיּוֹת"], "alt_headwords": [], "quotes": [], "prev_hw": "בִּינָה", "next_hw": "בִּינוּתָא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "בֵּינוֹנִי", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "adj.", "senses": [{"definition": "middle.", "number": "1", "language_code": "PBH"}, {"definition": "intermediate.", "number": "2"}, {"definition": "participle.", "number": "3", "language_code": "MH"}]}, "rid": "B00492", "refs": ["Klein Dictionary, בֵּין 1", "Klein Dictionary, בֵּין 1", "Klein Dictionary, בֵּינוֹנִיּוּת 1", "Klein Dictionary, בֵּינוֹנִיּוּת 1"], "derivatives": "Derivative: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_בֵּינוֹנִיּוּת.1\" data-ref=\"Klein Dictionary, בֵּינוֹנִיּוּת 1\">בֵּינוֹנִיּוּת</a>.", "prev_hw": "בִּינוֹם", "next_hw": "בֵּינוֹנִיּוּת", "notes": "[From <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_בֵּין.1\" data-ref=\"Klein Dictionary, בֵּין 1\">בֵּין</a> (= between). For the ending see suff. <span dir=\"rtl\">◌ִי</span>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}]