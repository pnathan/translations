[{"headword": "גִּבּוֹר", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "a", "senses": [{"definition": "adj"}, {"definition": "strong,  mighty"}, {"definition": "n m"}, {"definition": "strong man,  brave man,  mighty man"}]}, "strong_number": "1368", "transliteration": "gibbôwr", "pronunciation": "ghib-bore'", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "גִּבּוֹר", "parent_lexicon": "Jastrow Dictionary", "rid": "C00059", "language_code": "(b. h.;", "refs": ["Jastrow, גְּבַר I 1", "Nedarim 38a:7", "Shabbat 92a:8", "Tamid 32a:33", "Bereishit Rabbah 37:5", "Sotah 42b:9", "Sotah 42b:12"], "language_reference": " <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_גְּבַר I.1\" data-ref=\"Jastrow, גְּבַר I 1\"><a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_גְּבַר I.1\" data-ref=\"Jastrow, גְּבַר I 1\">גבר</a>)</a>", "content": {"senses": [{"definition": "<i>strong, brave, mighty; hero</i>. <a class=\"refLink\" href=\"/Nedarim.38a.7\" data-ref=\"Nedarim 38a:7\">Ned. 38ᵃ</a> <span dir=\"rtl\">על ג׳</span> on a strong man; <a class=\"refLink\" href=\"/Shabbat.92a.8\" data-ref=\"Shabbat 92a:8\">Sabb. 92ᵃ</a>. <a class=\"refLink\" href=\"/Pirkei_Avot.4.1\" data-ref=\"Pirkei Avot 4:1\">Ab. IV, 1</a> <span dir=\"rtl\">איזהו ג׳</span> who is a hero?; <a class=\"refLink\" href=\"/Tamid.32a.33\" data-ref=\"Tamid 32a:33\">Tam. 32ᵃ</a>; a. fr.—Pl. <span dir=\"rtl\">גִּבּוֹרִים</span>. <a class=\"refLink\" href=\"/Bereishit_Rabbah.37.5\" data-ref=\"Bereishit Rabbah 37:5\">Gen. R. s. 37</a> פלשתים ג׳ <i>Philisteans</i> which means giants, opp. <span dir=\"rtl\">ננסים</span>. <a class=\"refLink\" href=\"/Sotah.42b.12\" data-ref=\"Sotah 42b:12\">Sot. 42ᵇ</a> <span dir=\"rtl\">ד׳ ג׳</span> four (Philistean) heroes; a. e."}], "morphology": "m."}, "plural_form": ["גִּבּוֹרִים"], "alt_headwords": [], "quotes": [], "prev_hw": "גבונתא", "next_hw": "גבור", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "גִּבּוֹר", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "adj.", "senses": [{"definition": "mighty, courageous, valiant, heroic.", "number": "1"}, {"definition": "warrior, hero.", "number": "2"}, {"definition": "central character (in a novel or a drama).", "number": "3", "language_code": "NH"}]}, "rid": "C00067", "refs": ["Klein Dictionary, גבר 1", "Klein Dictionary, גֶּֽבֶר ᴵ 1", "Klein Dictionary, גֶּֽבֶר ᴵ 1", "Klein Dictionary, גַּבְרָא 1", "Klein Dictionary, גֶּֽבֶר ᴵ 1", "Klein Dictionary, גַּבְרָא 1", "Klein Dictionary, גבר 1", "Klein Dictionary, גֶּֽבֶר ᴵ 1", "Klein Dictionary, גֶּֽבֶר ᴵ 1", "Klein Dictionary, גַּבְרָא 1", "Klein Dictionary, גֶּֽבֶר ᴵ 1", "Klein Dictionary, גַּבְרָא 1", "Klein Dictionary, גִּבּוֹרִי 1", "Klein Dictionary, גִּבּוֹרִי 1"], "derivatives": "Derivative: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_גִּבּוֹרִי.1\" data-ref=\"Klein Dictionary, גִּבּוֹרִי 1\">גִּבּוֹרִי</a>.", "prev_hw": "גִּבּוֹן", "next_hw": "גְּבוּרָה", "notes": "[From <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_גבר.1\" data-ref=\"Klein Dictionary, גבר 1\">גבר</a>. cp. BAram. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_גֶּֽבֶר ᴵ.1\" data-ref=\"Klein Dictionary, גֶּֽבֶר ᴵ 1\">גִּבָּר</a>, JAram. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_גֶּֽבֶר ᴵ.1\" dat