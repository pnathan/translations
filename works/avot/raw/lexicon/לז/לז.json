[{"headword": "לָז", "parent_lexicon": "Jastrow Dictionary", "rid": "L00328", "refs": ["Jastrow, הַלָּז 1"], "content": {"senses": [{"definition": ", v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_הַלָּז.1\" data-ref=\"Jastrow, הַלָּז 1\">הַלָּז</a>"}]}, "quotes": [], "prev_hw": "לְוָת", "next_hw": "*לְזָא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "לוז ᴵ", "parent_lexicon": "Klein Dictionary", "content": {"senses": [{"definition": "to turn aside."}, {"senses": [{"definition": "he turned aside, departed."}], "grammar": {"morphology": "intr. v.", "binyan_form": ["לָז"], "verbal_stem": "— Qal"}}, {"senses": [{"definition": "was devious, was crooked."}], "grammar": {"binyan_form": ["נָלוֹז"], "verbal_stem": "— Niph."}}, {"senses": [{"definition": "he turned aside, departed."}], "grammar": {"morphology": "intr. v.", "binyan_form": ["הִלִּיז"], "verbal_stem": "— Hiph."}}]}, "rid": "L00210", "refs": ["Klein Dictionary, לָזוּת 1", "Klein Dictionary, נָלוֹז 1", "Klein Dictionary, לָזוּת 1", "Klein Dictionary, נָלוֹז 1"], "derivatives": "Derivatives: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_לָזוּת.1\" data-ref=\"Klein Dictionary, לָזוּת 1\">לָזוּת</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_נָלוֹז.1\" data-ref=\"Klein Dictionary, נָלוֹז 1\">נָלוֹז</a>.", "prev_hw": "לוּז", "next_hw": "לוז ᴵᴵ", "notes": "[Arab. <i>lādha</i> (= he turned aside).]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "לָז", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>הַלָּז<sup class=\"footnote-marker\">1</sup><i class=\"footnote\">הוספת אות הרמז לַ בין שתי אותיות הרמז ה, ז, לחזק את הרמז, ודומה לזה בערב' אלד'י ל פתוחה בין א ובין ד' (<span class=\"by-source\"><span dir=\"ltr\">Barth, Pron. 261</span> § 43, f</span>).</i>, עי' <a class=\"refLink\" data-ref=\"Ben Yehuda Dictionary, הַלָּז 1\" href=\"/Ben_Yehuda_Dictionary,_הַלָּז.1\">הַלָּז</a>, והוסיפה מהתו\"מ: הזורק אבן לרשות הרבים והרג הרי זה גולה ר' אליעזר בן יעקב אומר אם מכשיצאתה האבן מידו הוציא <strong>הלז</strong> את ראשו וקבלה הרי זה פטור <span class=\"by-source\">(מכות ב ב)</span>. נכנס לבקעה בימות הגשמים וטומאה בשדה פלונית ואמר הלכתי למקום <strong>הלז</strong> ואיני יודע אם נכנסתי לאותה השדה <span class=\"by-source\">(טהר' ו ה)</span>. מעשה בר\"ג והזקנים שהיו יושבין על מעלות האולם בהר הבית והיה יוחנן הסופר <strong>הלז</strong> יושב לפניהן <span class=\"by-source\">(ירוש' מע\"ש ה נו ג)</span>. — ואמר הפיטן: קריאתם יוכיח <strong>לז</strong> <strong>ללז </strong>לדון, כל מחלל יום קדש בזדון, כאילו מעיד עדות שקר באדון <span class=\"by-source\">(שמעון בר\"א, ב' שבוע', שבוית מרום)</span>. ארי עלז ביום <strong>הלז</strong> וחץ קלקל למול עירי <span class=\"by-source\">(סליח' י' טבת, שעה עליון)</span>. גליפת אבנים על כתיפיו בנועם ריח המגדים יפסקו טעם דיקדוק גבלות זהב קדושים <strong>לז לז</strong> דיבק באהב <span class=\"by-source\">(אמת מה נהדר, <span dir=\"ltr\">J. Elbogen, 187</span>)</span>. — ואמר המליץ: אם יקרצו עינים יחרקו שינים, <strong>ולז ללז</strong> ילחשו על אזנים, אז יחלק העם לשנים <span class=\"by-source\">(ר' קלוני', אבן בחן סד)</span>.</p>"]}, "rid": "BY-09288", "prev_hw": "לוּשׁ", "next_hw": "לֵזוּ", "page_num": 2648, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]