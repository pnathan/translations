[{"headword": "חָרֵר", "parent_lexicon": "Klein Dictionary", "content": {"senses": [{"morphology": "adj.", "definition": "parched.", "number": "1", "language_code": "NH"}, {"morphology": "n.", "definition": "a parched place (a hapax legomenon in the Bible, occurring <a class=\"refLink\" href=\"/Jeremiah.17.6\" data-ref=\"Jeremiah 17:6\">Jer. 17:6</a> in the pl. <span dir=\"rtl\">חֲרֵרִים</span>).", "number": "2"}]}, "rid": "H01427", "refs": ["Klein Dictionary, חרר ᴵ 1", "Klein Dictionary, חרר ᴵ 1"], "prev_hw": "חרר ᴵᴵᴵ", "next_hw": "חָרָר", "notes": "[From <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_חרר ᴵ.1\" data-ref=\"Klein Dictionary, חרר ᴵ 1\">חרר ᴵ</a>. cp. Arab. <i>ḥarrāt</i> (= lava fields).]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "חָרֵר", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p><sup class=\"footnote-marker\">1</sup><i class=\"footnote\">כך רד\"ק, וכנראה מן <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_חרר_I.1\" data-ref=\"Ben Yehuda Dictionary, חרר I 1\">א. חרר</a>.</i>, ש\"ז, מ\"ר חֲרֵרִים, — ארץ יבשה, שרופה מחֹם השמש, מדבר ישימון וכדומה, verbrannter Gegend; pays brûlé; sunburnt place: והיה (הגבר אשר יבטח באדם) כערער בערבה ולא יראה כי יבוא טוב ושכן חֲרֵרִים במדבר ארץ מלחה ולא תשב (<span class=\"by-source\">ירמ' יג ו</span>).  — ואמר המשורר: וידיו יזלו גשמי נדבות עדי במקום חֲרֵרִים שם נהרים (<span class=\"by-source\">יראב\"ע, חדשים</span>). אמנם מדינות בתבל כתרצה מאין דרוך רגלך בם כגלים, כאשר <strong>חרירי</strong> ישימון בעת כפך בם תנופף ישובון כגלים (<span class=\"by-source\">רמב\"ע, תרשיש א</span>).</p>"]}, "rid": "BY-06938", "prev_hw": "חַר", "next_hw": "חרר II", "page_num": 1784, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]