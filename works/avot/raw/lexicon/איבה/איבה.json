[{"headword": "אֵיבָה", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-f", "senses": [{"definition": "enmity,  hatred"}]}, "strong_number": "342", "transliteration": "ʼêybâh", "pronunciation": "ay-baw'", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "אֵיבָה", "parent_lexicon": "Jastrow Dictionary", "rid": "A01120", "language_code": "(b. h.;", "refs": ["Jastrow, אָוֶן 1", "Jastrow, עָוֹן 1", "Jerusalem Talmud Demai 4:1:6", "Jerusalem Talmud Yoma 8:1:12"], "language_reference": " <span dir=\"rtl\">אָיַב</span>, √<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אוֹ I.1\" data-ref=\"Jastrow, אוֹ I 1\">או</a> or <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אָב I.1\" data-ref=\"Jastrow, אָב I 1\">אב</a>, cmp. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אַכְאָבִית.1\" data-ref=\"Jastrow, אַכְאָבִית 1\">אַבְאָבִית</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אָוֶן.1\" data-ref=\"Jastrow, אָוֶן 1\">אָוֶן</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עָוֹן.1\" data-ref=\"Jastrow, עָוֹן 1\"><a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עָוֹן.1\" data-ref=\"Jastrow, עָוֹן 1\">עָוֹן</a>)</a>", "content": {"senses": [{"definition": "<i>enmity, hostility, grudge</i>. <a class=\"refLink\" href=\"/Mishnah_Sanhedrin.3.5\" data-ref=\"Mishnah Sanhedrin 3:5\">Snh. III, 5</a> an enemy is he who has not spoken to his neighbor for three days <span dir=\"rtl\">בא׳</span> in his grudge; a. fr.—<span dir=\"rtl\"><span dir=\"rtl\">משום</span> (<span dir=\"rtl\">מפני</span>) <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_א׳.1\" data-ref=\"Jastrow, א׳ 1\">א׳</a></span> for the sake of preventing ill-feeling. <a class=\"refLink\" href=\"Jerusalem_Talmud_Demai.4.1.6\" data-ref=\"Jerusalem Talmud Demai 4:1:6\">Y. Dem. IV, 24ᵃ</a>; a. fr.", "number": "1)"}, {"definition": "<i>aversion, disgust, loss of attraction</i>. <a class=\"refLink\" href=\"Jerusalem_Talmud_Yoma.8.1.12\" data-ref=\"Jerusalem Talmud Yoma 8:1:12\">Y. Yoma VIII, 44ᵈ</a> bot. <span dir=\"rtl\">הכלה מפני א׳</span> the bride (is permitted to wash her face on the Day of Atone.) that she may not lose her attraction.", "number": "—2)"}], "morphology": "f."}, "quotes": [], "prev_hw": "*אִיבְבָא", "next_hw": "אִיבּוּ", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אֵיבָה", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"definition": "enmity, hatred, grudge, malice."}]}, "rid": "A00829", "refs": ["Klein Dictionary, איב 1", "Klein Dictionary, ◌ָה ᴵ 1", "Klein Dictionary, איב 1", "Klein Dictionary, ◌ָה ᴵ 1"], "prev_hw": "איב", "next_hw": "אֵיבוֹלוּצְיָה", "notes": "[Formed from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_איב.1\" data-ref=\"Klein Dictionary, איב 1\">איב</a> with first suff. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_◌ָה ᴵ.1\" data-ref=\"Klein Dictionary, ◌ָה ᴵ 1\">◌ָה</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אֵיבָה", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.f. enmity</strong>—<span dir=\"rtl\">א׳</span> <a data-ref=\"Genesis 3:15\" href=\"/Genesis.3.15\">Gn 3:15</a> + 2 textual; cstr. <span dir=\"rtl\">אֵיבַת</span> <a data-ref=\"Ezekiel 25:15\" href=\"/Ezekiel.25.15\">Ez 25:15</a>; <a data-ref=\"Ezekiel 35:5\" href=\"/Ezekiel.35.5\">35:5</a>—<em>enmity</em>, personal hostility, betw. men <a data-ref=\"Numbers 35:21\" href=\"/Numbers.35.21\">Nu 35:21</a>, <a data-ref=\"Numbers 35:22\" href=\"/Numbers.35.22\">22</a> (P), betw. serpent & woman <a data-ref=\"Genesis 3:15\" href=\"/Genesis.3.15\">Gn 3:15</a> (J), betw. peoples <span dir=\"rtl\">אֵיבַת עוֹלָם</span> <a data-ref=\"Ezekiel 25:15\" href=\"/Ezekiel.25.15\">Ez 25:15</a>; <a data-ref=\"Ezekiel 35:5\" href=\"/Ezekiel.35.5\">35:5</a>."}]}, "rid": "BDB00415", "strong_numbers": ["342"], "next_hw": "אִיּוֹב", "prev_hw": "אָיַב", "all_cited": true, "quotes": [], "GK": ["368"], "TWOT": ["78a"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אֵיבָה", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p><sup class=\"footnote-marker\">1</sup><i class=\"footnote\">מן פעל <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_איב.1\" data-ref=\"Ben Yehuda Dictionary, איב 1\">אָיב</a>.</i>, ש\"נ, רגש האויב לאויבו, Feindschaft; inimitié; enmity  : ואֵיבָה אשית בינך (בין הנחש) ובין האשה ובין זרעך ובין זרעה הוא ישופך ראש ואתה תשופנו עקב (<span class=\"by-source\">בראש' ג יה</span>).  או בְאֵיבָה הכהו (הרוצח) בידו וימת (<span class=\"by-source\">במד' לה כא</span>).  ואם בפתע בלא אֵיבָה הדפו (<span class=\"by-source\">שם שם כב</span>).  שונא כל שלא דבר עמו ג' ימים <strong>באיבה</strong> (<span class=\"by-source\">סנה' ג ה</span>).  א\"ר ישמעאל ומה אם לעשות שלום בין איש לאשתו אמר המקום שמי שנכתב בקדושה ימחה על המים ספרי מינין שמטילין <strong>איבה</strong> ותחרות וקנאה בין ישראל לאביהם שבשמים עאכ\"ו (<span class=\"by-source\">תוספתא שבת יג ה</span>).  —  וסמי' יען היות לך אֵיבַת עולם ותגר את בני ישראל על ידי חרב (<span class=\"by-source\">יחזק' לה ה</span>).  — ומ\"ר ולא תטור אֵיבוֹת ולא תשאל אובות (<span class=\"by-source\">ר\"ש בן גבירול, אזהרות</span>).  —  ועי' <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_שִׂנְאָה.1\" data-ref=\"Ben Yehuda Dictionary, שִׂנְאָה 1\">שנאה</a> <strong>השיכים</strong>. -  ב) °כנוי למלאך הממונה על אחד מפתחי היכלי הגיהנם ולהיכל זה בעצמו:  בהיכל זה (היכל הנקרא שאול) יש פתח אחד ועליו ממונה אחד ושמו <strong>איבה</strong> והוא מעורר מדנים <strong>ואיבות</strong> בעולם על שמו נקרא ההיכל הזה <strong>איבה</strong> (<span class=\"by-source\">ראשי' חכמה יג כח</span>).</p>"]}, "rid": "BY-00565", "prev_hw": "אִיב", "next_hw": "אִיד", "page_num": 174, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]