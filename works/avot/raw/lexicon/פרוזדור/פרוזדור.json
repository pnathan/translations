[{"headword": "פְּרוֹזְדוֹר", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "corridor, vestibule."}]}, "rid": "Q01281", "language_code": "PBH", "refs": ["Klein Dictionary, פְּרוֹ◌ ᴵᴵ 1", "Klein Dictionary, סְטָטִי 1", "Klein Dictionary, פְּרוֹ◌ ᴵᴵ 1", "Klein Dictionary, סְטָטִי 1", "Klein Dictionary, פְּרוֹזְדוֹרִי 1", "Klein Dictionary, פְּרוֹזְדוֹרִי 1"], "derivatives": "Derivative: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_פְּרוֹזְדוֹרִי.1\" data-ref=\"Klein Dictionary, פְּרוֹזְדוֹרִי 1\">פְּרוֹזְדוֹרִי</a>.", "prev_hw": "פְּרוֹזְבּוּל", "next_hw": "פְּרוֹזְדוֹרִי", "notes": "[The correct reading is <span dir=\"rtl\">פּֽרוֹזְדוֹד</span>, a word borrowed from Gk. <i>prostada</i>, accusative of <i>prostas</i> (= vestibule, porch, portico). Gk. <i>prostas</i> derives from the stem <i>proistanai</i> (= to stand before). See ‘post’ (pillar) in my CEDEL and cp. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_פְּרוֹ◌ ᴵᴵ.1\" data-ref=\"Klein Dictionary, פְּרוֹ◌ ᴵᴵ 1\">פְּרוֹ◌ ᴵᴵ</a> and <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_סְטָטִי.1\" data-ref=\"Klein Dictionary, סְטָטִי 1\">סְטָטִי</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}]