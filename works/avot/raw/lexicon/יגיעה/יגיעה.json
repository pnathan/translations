[{"headword": "יְגִיעָה", "parent_lexicon": "Jastrow Dictionary", "rid": "J00086", "refs": ["Jastrow, יְגִיעַ 1", "Bereishit Rabbah 10", "Bereishit Rabbah 3", "Kohelet Rabbah 12:12:1", "Taanit 16a:16", "Vayikra Rabbah 19:2", "Berakhot 58a:4", "Vayikra Rabbah 28:1", "Vayikra Rabbah 28:2", "Jerusalem Talmud Sanhedrin 10:1:20"], "content": {"senses": [{"definition": " (b. h.) <a class=\"refLink\" href=\"/Jastrow,_יְגִיעַ.1\" data-ref=\"Jastrow, יְגִיעַ 1\">same</a>. <a class=\"refLink\" href=\"/Bereishit_Rabbah.10\" data-ref=\"Bereishit Rabbah 10\">Gen. R. s. 10</a>, end; <a class=\"refLink\" href=\"/Bereishit_Rabbah.3\" data-ref=\"Bereishit Rabbah 3\">ib. s. 3</a>, a. e. <span dir=\"rtl\">לא בעמל ולא בי׳ וכ׳</span> (some ed. <span dir=\"rtl\">ביָגָע</span>) not with trouble and wearisome labor did the Lord create &c.—<a class=\"refLink\" href=\"Jerusalem_Talmud_Sanhedrin.10.1.20\" data-ref=\"Jerusalem Talmud Sanhedrin 10:1:20\">Y. Snh. X, 28ᵃ</a> top <span dir=\"rtl\">לי׳</span>; <a class=\"refLink\" href=\"/Kohelet_Rabbah.12.12.1\" data-ref=\"Kohelet Rabbah 12:12:1\">Koh. R. to XII, 12</a> <span dir=\"rtl\">לִיגִיעַת בשר</span> for painful study, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_הִגָּיוֹן.1\" data-ref=\"Jastrow, הִגָּיוֹן 1\">הִגָּיוֹן</a>. <a class=\"refLink\" href=\"/Taanit.16a.16\" data-ref=\"Taanit 16a:16\">Taan. 16ᵃ</a> <span dir=\"rtl\">ויש לו י׳ בשדה</span> has his labor invested in the field.—<a class=\"refLink\" href=\"/Vayikra_Rabbah.19.2\" data-ref=\"Vayikra Rabbah 19:2\">Lev. R. s. 19</a>; Midr. Sam. ch. V <span dir=\"rtl\">לא שכר י׳ וכ׳</span> does not the Lord reward the work of studying?; a. fr.—Pl. <span dir=\"rtl\">יְגִיעוֹת</span>. <a class=\"refLink\" href=\"/Berakhot.58a.4\" data-ref=\"Berakhot 58a:4\">Ber. 58ᵃ</a>; Y. ib. IX, 13ᶜ top <span dir=\"rtl\">כמה י׳ יגע וכ׳</span> how many labors did Adam have to go through &c.; (Tosef. ib. VII (VI), 2 <span dir=\"rtl\">כמה יגע</span>). <a class=\"refLink\" href=\"/Vayikra_Rabbah.28.2\" data-ref=\"Vayikra Rabbah 28:2\">Lev. R. s. 28</a>, beg. <span dir=\"rtl\">כמה י׳ הוא יגע</span>; a. fr."}], "morphology": "f."}, "plural_form": ["יְגִיעוֹת"], "alt_headwords": [], "quotes": [], "prev_hw": "יְגִיעַ", "next_hw": "יג\"ל", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "יְגִיעָה", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"definition": "labor, toil, wearying (a hapax legomenon in the Bible, occurring <a class=\"refLink\" href=\"/Ecclesiastes.12.12\" data-ref=\"Ecclesiastes 12:12\">Eccles. 12:12</a> in the form <span dir=\"rtl\">יְגִעַת</span>)."}]}, "rid": "J00065", "refs": ["Klein Dictionary, יגע 1", "Klein Dictionary, יגע 1", "Klein Dictionary, יגע 1", "Klein Dictionary, ◌ָה ᴵ 1", "Klein Dictionary, יגע 1", "Klein Dictionary, יגע 1", "Klein Dictionary, יגע 1", "Klein Dictionary, ◌ָה ᴵ 1"], "prev_hw": "יְגִֽיעַ", "next_hw": "יגן", "notes": "[Verbal n. of <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_יגע.1\" data-ref=\"Klein Dictionary, יגע 1\">יָגַע</a>. See <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_יגע.1\" data-ref=\"Klein Dictionary, יגע 1\">יגע</a> and first suff. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_◌ָה ᴵ.1\" data-ref=\"Klein Dictionary, ◌ָה ᴵ 1\">◌ָה</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "יְגִיעָה", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>*, ש\"נ, סמי' יְגִיעַת, מ\"ר יְגִיעֹות, — שה\"פ מן <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_יגע.1\" data-ref=\"Ben Yehuda Dictionary, יגע 1\">יגע</a>: וינח ביום השביעי וכי יש לפניו <strong>יגיעה</strong> והלא כבר נאמר לא ייעף ולא ייגע (<span class=\"by-source\">מכי' יתרו, בחדש ז</span>).  יפה תלמוד תורה עם דרך ארץ <strong>שיגיעת</strong> שניהם משכחת עון (<span class=\"by-source\">אבות ב ב</span>).  ראה כמה <strong>יגיעות</strong> יגע אדם הראשון עד שמצא חלוק ללבוש גזז וליבן וכו' כבס ותפר (<span class=\"by-source\">ירוש' ברכ' ט יג ג</span>).  להגיון ניתנו <strong>ליגיעה</strong> לא ניתנו (<span class=\"by-source\">שם סנה' י כח.</span>).  כמה <strong>יגיעות</strong> יגע אדם הראשון עד שמצא פת לאכול חרש וזרע וקצר ועמר ודש וזרה וברר וטחן והרקיד ולש ואפה ואח\"כ אכל (<span class=\"by-source\">ברכ' נח.</span>).  אמר הקב\"ה יקרה היא בעיני בני אדם ורואים כאלו <strong>יגיעה</strong> היא לפני ואינה <strong>יגיעה</strong> (<span class=\"by-source\">מד\"ר שמות יג</span>).  בנוהג שבעולם אדם לוקח ליטרא אחת של בשר מן השוק כמה <strong>יגיעות</strong> הוא יגע כמה צער הוא מצער עד שבישלה (<span class=\"by-source\">שם ויקר' כח</span>).  אמר (משה) לפניו רבש\"ע אחר כל <strong>היגיעה</strong> הזו אתה אומר לי הן קרבו ימיך (<span class=\"by-source\">שם דבר' יא</span>).  — וברפואה, יְגִיעָה נגעיית, מתוחיית וכו': מיני <strong>היגיעה</strong> ג' וכו' הם הנגעיית והמתוחיית והמורסיית והכחושיית והנגעיית היא <strong>יגיעה</strong> יוחש ממנה בחיצוני העור דומה לכאב הנגעים וכו' ואמנם <strong>היגיעה</strong> המורסיית יהא שיהיה הגוף יותר חם מן המנהג ודומה לנפוח וכו' <strong>היגיעה</strong> הכחושיית הנה היא ענין ירגיש בו האדם מגופו כאלו כבר הפליג בו הנגוב והיובש (<span class=\"by-source\">קאנון א ג ב יב</span>).  ליחה ממתחת תקרא מה שיתחדש ממנה <strong>היגיעה</strong> המתחיית (<span class=\"by-source\">שם א ב ב כ</span>).</p>"]}, "rid": "BY-07579", "prev_hw": "יָגִיעַ II", "next_hw": "יְגִיעִי", "page_num": 1952, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}, {"headword": "יְגִעָה", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>ש\"נ, סמי' יְגִעַת, — כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_יָגִיעַ_I.1\" data-ref=\"Ben Yehuda Dictionary, יָגִיעַ I 1\">יָגִיעַ</a>, <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_יְגִיעָה.1\" data-ref=\"Ben Yehuda Dictionary, יְגִיעָה 1\">יְגִיעָה</a>: ויתר מהמה בני הזהר עשות ספרים הרבה אין קץ ולהג הרבה יְגִעַת בשר (<span class=\"by-source\">קהל' יב יב</span>).</p>"]}, "rid": "BY-07586", "prev_hw": "יָגֵע", "next_hw": "יגר I", "page_num": 1955, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]