_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "כֹּד", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"plural_form": "(pl. <span dir=\"rtl\">כֻּדִּים</span>)", "definition": "round end."}]}, "rid": "K00092", "refs": ["Klein Dictionary, כַּד ᴵᴵ 1", "Klein Dictionary, כַּד ᴵᴵ 1"], "prev_hw": "כַּד ᴵᴵᴵ", "next_hw": "כְּדַאי", "notes": "[From <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_כַּד ᴵᴵ.1\" data-ref=\"Klein Dictionary, כַּד ᴵᴵ 1\">כַּד ᴵᴵ</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "כַּד", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.f. jar (</strong>NH <em>id.;</em> Aramaic <span dir=\"rtl\">כַּדָּא</span><strong>)</strong>—<span dir=\"rtl\">כַּד</span> abs. <a data-ref=\"I Kings 17:12\" href=\"/I_Kings.17.12\">1 K 17:12</a> <a data-ref=\"Ecclesiastes 12:6\" href=\"/Ecclesiastes.12.6\">Ec 12:6</a>; cstr. <a data-ref=\"I Kings 17:14\" href=\"/I_Kings.17.14\">1 K 17:14</a>, <a data-ref=\"I Kings 17:16\" href=\"/I_Kings.17.16\">16</a>; <span dir=\"rtl\">כַּדֵּךְ</span> <a data-ref=\"Genesis 24:14\" href=\"/Genesis.24.14\">Gn 24:14</a>, <a data-ref=\"Genesis 24:17\" href=\"/Genesis.24.17\">17</a>, <a data-ref=\"Genesis 24:43\" href=\"/Genesis.24.43\">43</a> etc.; pl. <span dir=\"rtl\">כַּדִּים</span> <a data-ref=\"Judges 7:16\" href=\"/Judges.7.16\">Ju 7:16</a><sup>(×2)</sup> + 3 times;—water-<em>jar</em>, carried on woman’s shoulder <a data-ref=\"Genesis 24:14\" href=\"/Genesis.24.14\">Gn 24:14</a>, <a data-ref=\"Genesis 24:15\" href=\"/Genesis.24.15\">15</a>, <a data-ref=\"Genesis 24:16\" href=\"/Genesis.24.16\">16</a>, <a data-ref=\"Genesis 24:17\" href=\"/Genesis.24.17\">17</a>, <a data-ref=\"Genesis 24:18\" href=\"/Genesis.24.18\">18</a>, <a data-ref=\"Genesis 24:20\" href=\"/Genesis.24.20\">20</a>, <a data-ref=\"Genesis 24:43\" href=\"/Genesis.24.43\">43</a>, <a data-ref=\"Genesis 24:45\" href=\"/Genesis.24.45\">45</a>, <a data-ref=\"Genesis 24:46\" href=\"/Genesis.24.46\">46</a> (all J), <a data-ref=\"I Kings 18:34\" href=\"/I_Kings.18.34\">1 K 18:34</a> <a data-ref=\"Ecclesiastes 12:6\" href=\"/Ecclesiastes.12.6\">Ec 12:6</a>; empty (of water), containing lamps <a data-ref=\"Judges 7:16\" href=\"/Judges.7.16\">Ju 7:16</a>, <a data-ref=\"Judges 7:19\" href=\"/Judges.7.19\">19</a>, <a data-ref=\"Judges 7:20\" href=\"/Judges.7.20\">20</a>; containing meal <a data-ref=\"I Kings 17:12\" href=\"/I_Kings.17.12\">1 K 17:12</a>, <a data-ref=\"I Kings 17:14\" href=\"/I_Kings.17.14\">14</a>, <a data-ref=\"I Kings 17:16\" href=\"/I_Kings.17.16\">16</a>. (On extra-Palest. hist. of this word cf. Lag<sup>BN 104</sup>.)"}]}, "rid": "BDB04378", "strong_numbers": ["3537"], "next_hw": "כִּידוֹד", "prev_hw": "כדד", "all_cited": true, "quotes": [], "GK": ["3902"], "TWOT": ["953a"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "כַּד I", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p><sup class=\"footnote-marker\">1</sup><i class=\"footnote\">רק בעברית וארמית.  ונכנסה מלה זו גם ללשון היונית κάδος, ולא נתברר מקורה.</i>, שזו\"נ, בכנ' כַּדֵּךְ, כַּדָּהּ, מ\"ר כַּדִּים, — כלי חרס עגֹל לתשמישי הבית, להביא בו מים, יין, שמן ולשמור בו קמח וכדומה, Krug; cruche; jug, pitcher: והנה רבקה יצאת וכו' וְכַדָּהּ על שכמה וכו' ותרד העינה ותמלא כַדָּהּ ותעל וירץ העבד לקראתה ויאמר הגמיאיני נא מעט מים מִכַּדֵּךְ וכו' ותמהר ותרד כַּדָּהּ על ידה ותשקהו (<span class=\"by-source\">בראש' כד יה=יח</span>).  ותשבר כַּד על המבוע (<span class=\"by-source\">קהל' יב ו</span>).  מלאו ארבעה כַדִּים מים ויצקו על העלה (<span class=\"by-source\">מ\"א יח לד</span>).  — ולשמירת קמח וכדומה: חי יי' אלהיך אם יש לי מעוג כי אם מלא כף קמח בַּכַּד ומעט שמן בצפחת (<span class=\"by-source\">מ\"א יז יב</span>).  כַּד הקמח לא תכלה וצפחת השמן לא תחסר (<span class=\"by-source\">שם יד</span>).  — ולתשמישים אחרים: ויתן שופרות ביד כלם וְכַדִּים ריקים ולפדים בתוך הַכַּדִּים (<span class=\"by-source\">שופט' ז יו</span>).  — ובתו\"מ: טהורים וטמאין שותין <strong>מכד</strong> אחד <span class=\"by-source\">מע\"ש ב י</span>.  <strong>כדי</strong> יין סתומות מקום שדרכן לימכר סתומות יצא קנקן לחולין (<span class=\"by-source\">שם א ג</span>).  היוצר מוכר ה' <strong>כדי </strong>שמן וחמשה עשר <strong>כדי </strong>יין (<span class=\"by-source\">שבי' ה ז</span>).  המניח את <strong>הכד</strong> ברשות הרבים ובא אחר ונתקל בה ושברה (<span class=\"by-source\">ב\"ק ג א</span>).  נשברה <strong>כדו</strong>  ברשות הרבים והוחלק אחד במים (<span class=\"by-source\">שם</span>).  זה בא בחביתו של יין וזה <strong>בכדו</strong> של דבש (<span class=\"by-source\">שם י ד</span>).  וארבעה ילדים מפרחי כהונה ובידיהם <strong>כדים</strong> של שמן של מאה ועשרים לוג (<span class=\"by-source\">סוכ'ה ב</span>).  הטוען את חבירו <strong>כדי</strong> שמן והודה בקנקנים (<span class=\"by-source\">כתוב' יג ד</span>).  עכו\"ם שהיה מעביר עם ישראל <strong>כדי </strong>יין ממקום למקום (<span class=\"by-source\">ע\"ז ה ג</span>).  למה זה דומה <strong>לכדו</strong> ריקנית שהיא מלאה רוח (<span class=\"by-source\">תוספתא כל' ב\"מ י א</span>).  שטוחנות (הכפריות) ברחיים ונושאות <strong>כדין</strong> על גיסיהן (<span class=\"by-source\">שם נדה ו ט</span>).  שנים שזרקו שתי צרורות ושברו שתי <strong>כדין</strong> אחת של יין ואחת של שמן (<span class=\"by-source\">בירוש' ב\"ק ג ג ד</span>).  זיתיו (של האבֵל) הפוכין טוענין לו <strong>וכדו</strong> לגוף ופשתנו להעלות מן המשרה (<span class=\"by-source\">מו\"ק יא:</span>).  נשברה <strong>כדו</strong> ולא סילקו (<span class=\"by-source\">ב\"מ פב:</span>).  ראשו (של  קטב) דומה לעגל וקרן אחת יוצאה בתוך מצחו והוא מתגלגל <strong>בכד</strong> (<span class=\"by-source\">מד\"ר במד' יב</span>).  כלי אין חפץ בו וכו' <strong>בכדין</strong> של מי רגלים ר\"ש בר נחמן אמר <strong>ככדין</strong> של מקיזי דם (<span class=\"by-source\">שם ויקר' י</span>).  שהיו ידיו של משה כבידות כשתי <strong>כדים</strong> של מים (<span class=\"by-source\">פסיק' רבתי יב</span>).  — ומשל: וחכמי המוסר אמרו מלא <strong>כדך</strong> בעוד שתחזק בחבל ובדלי (<span class=\"by-source\">מנח' המאירי, משיב נפש, או\"נ ב קיא</span>).</p>"]}, "rid": "BY-08277", "prev_hw": "כג\"ק", "next_hw": "כַּד II", "page_num": 2258, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}, {"headword": "כַּד II", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>* <sup class=\"footnote-marker\">1</sup><i class=\"footnote\">לא נתברר מקור מלה זו.</i>, ת\"ז, לנק' כַּדָה, מ\"ר כַּדִים, כַּדוֹת, — לא חד כמו עֹקץ אלא עגלגל קצת, arrondi; rundlich; rounded: ואלו הן סימני ביצים כל שכודרת ועגולגלת ראשה אחד <strong>כד</strong> וראשה אחר חד טהורה ב' ראשיה חדין וב' ראשיה <strong>כדין</strong> טמאה <span class=\"by-source\">ע\"ז מ.</span>, <span class=\"by-source\">חול' סד.</span>.</p>"]}, "rid": "BY-08278", "prev_hw": "כַּד I", "next_hw": "כדאי", "page_num": 2258, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]