lete": true}}, {"headword": "רָץ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "runner, courier.", "number": "1"}, {"definition": "sprinter (sport).", "number": "2", "language_code": "NH"}, {"definition": "bishop (in chess).", "number": "3", "language_code": "NH"}]}, "rid": "T01048", "refs": ["Klein Dictionary, רוץ 1", "Klein Dictionary, רוץ 1", "Klein Dictionary, רוץ 1", "Klein Dictionary, רוץ 1"], "prev_hw": "רַפְתָּנוּת", "next_hw": "רַץ", "notes": "[Act. part. of <span dir=\"rtl\">רוּץ</span>. See <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_רוץ.1\" data-ref=\"Klein Dictionary, רוץ 1\">רוץ</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "רוּץ", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>vb.</strong> run <strong>(</strong>NH id. (rare); Ethiopic ሮጸ Zinj. Pf. 1 s. <span dir=\"rtl\">רצת</span>; = Aramaic <span dir=\"rtl\">רְהַט</span>; <span dir=\"rtl\">ܪܗܰܛ</span> (W<sup>SG 47</sup>); cf. Assyrian <em>râṣu</em>, <em>be helpful</em> (i.e. <em>run</em> to help?)<strong>)</strong>;—"}, {"senses": [{"definition": "Pf. 3 ms. <span dir=\"rtl\">רָץ</span> <a data-ref=\"Genesis 18:7\" href=\"/Genesis.18.7\">Gn 18:7</a>; 2 ms. <span dir=\"rtl\">רַצְתָּה</span> <a data-ref=\"Jeremiah 12:5\" href=\"/Jeremiah.12.5\">Je 12:5</a>, etc.; Impf. <span dir=\"rtl\">יָרוּץ</span> <a data-ref=\"Habakkuk 2:2\" href=\"/Habakkuk.2.2\">Hb 2:2</a> +, <span dir=\"rtl\">יָרֻץ</span> <a data-ref=\"Job 16:14\" href=\"/Job.16.14\">Jb 16:14</a>, <span dir=\"rtl\">וַיָּ֫רָץ</span> <a data-ref=\"Genesis 18:2\" href=\"/Genesis.18.2\">Gn 18:2</a> +, <span dir=\"rtl\">וַיָּרֹ֑ץ</span> <a data-ref=\"