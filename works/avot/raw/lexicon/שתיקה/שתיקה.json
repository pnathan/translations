[{"headword": "שְׁתִיקָה", "parent_lexicon": "Jastrow Dictionary", "rid": "U02110", "refs": ["Yevamot 87b:20", "Zevachim 115b:14", "Pesachim 99a:1", "Sotah 39a:2", "Tosefta Chagigah 2:12", "Beitzah 20b:2", "Beitzah 20b:3", "Jerusalem Talmud Chagigah 2:3:5"], "content": {"senses": [{"definition": " (<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_שָׁתַק.1\" data-ref=\"Jastrow, שָׁתַק 1\">שָׁתַק</a>) <i>silence</i>. <a class=\"refLink\" href=\"/Yevamot.87b.20\" data-ref=\"Yevamot 87b:20\">Yeb. 87ᵇ</a>, a. fr. <span dir=\"rtl\">ש׳ כהודאה דמיא</span> silence is tantamount to admission. <a class=\"refLink\" href=\"/Zevachim.115b.14\" data-ref=\"Zevachim 115b:14\">Zeb. 115ᵇ</a> <span dir=\"rtl\">פעמים … על הש׳ וכ׳</span> at times one keeps silence and is rewarded for his silence, at times one speaks &c. <a class=\"refLink\" href=\"/Pirkei_Avot.3.13\" data-ref=\"Pirkei Avot 3:13\">Ab. III, 13</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_סְיָיג.1\" data-ref=\"Jastrow, סְיָיג 1\">סְיָיג</a>. <a class=\"refLink\" href=\"/Pesachim.99a.1\" data-ref=\"Pesachim 99a:1\">Pes. 99ᵃ</a> <span dir=\"rtl\">יפה ש׳ לחכמים וכ׳</span> silence becometh the wise, how much more the stupid; Treat. Der. Er. Zuṭṭa ch. VII. <a class=\"refLink\" href=\"/Sotah.39a.2\" data-ref=\"Sotah 39a:2\">Sot. 39ᵃ</a> (ref. to <a class=\"refLink\" href=\"/Nehemiah.8.5\" data-ref=\"Nehemiah 8:5\">Neh. VIII, 5</a>) <span dir=\"rtl\">אין עמידה אלא ש׳</span> standing means being silent; a. fr.—<a class=\"refLink\" href=\"Jerusalem_Talmud_Chagigah.2.3.5\" data-ref=\"Jerusalem Talmud Chagigah 2:3:5\">Y. Ḥag. II, 78ᵃ</a>; <a class=\"refLink\" href=\"/Tosefta_Chagigah.2.12\" data-ref=\"Tosefta Chagigah 2:12\">Tosef. ib. II, 12</a>; <a class=\"refLink\" href=\"/Beitzah.20b.3\" data-ref=\"Beitzah 20b:3\">Bets. 20ᵇ</a> <span dir=\"rtl\">מה זו ש׳</span> what does silence mean? (i.e. better be silent)."}], "morphology": "f."}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "שְׁתֵיק", "next_hw": "שְׁתִיקוּת", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "שְׁתִיקָה", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"definition": "silence."}]}, "rid": "U02040", "language_code": "PBH", "refs": ["Klein Dictionary, שׁתק 1", "Klein Dictionary, שׁתק 1", "Klein Dictionary, שׁתק 1", "Klein Dictionary, ◌ָה ᴵ 1", "Klein Dictionary, שְׁתִיקוּת 1", "Klein Dictionary, שׁתק 1", "Klein Dictionary, שׁתק 1", "Klein Dictionary, שׁתק 1", "Klein Dictionary, ◌ָה ᴵ 1", "Klein Dictionary, שְׁתִיקוּת 1"], "prev_hw": "שְׁתִינָה", "next_hw": "שְׁתִיקוּת", "notes": "[Verbal n. of <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_שׁתק.1\" data-ref=\"Klein Dictionary, שׁתק 1\">שָׁתַק</a>. See <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_שׁתק.1\" data-ref=\"Klein Dictionary, שׁתק 1\">שׁתק</a> and first suff. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_◌ָה ᴵ.1\" data-ref=\"Klein Dictionary, ◌ָה ᴵ 1\">◌ָה</a>. cp. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_שְׁתִיקוּת.1\" data-ref=\"Klein Dictionary, שְׁתִיקוּת 1\">שְׁתִיקוּת</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "שְׁתִיקָה", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>*, ש\"נ, — שה\"פ מן <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_שָׁתַק.1\" data-ref=\"Ben Yehuda Dictionary, שָׁתַק 1\">שָׁתַק</a>, Schweigen; silence: כל ימי גדלתי בין החכמים ולא מצאתי לגוף טוב <strong>משתיקה</strong> <span class=\"by-source\">רשב\"ג, אבות א יז</span>. סייג לחכמה <strong>שתיקה</strong> <span class=\"by-source\">ר\"ע, שם ג יג</span>. שחט <strong>בשתיקה</strong> וכו' קבל והלך וזרק <strong>בשתיקה</strong> וכו' זה הוא שקרב המתיר כמצותו <span class=\"by-source\">זבח' ב ד</span>. שכל דבר <strong>ששתיקתו</strong> פטורה (ממעשר וכדו') נאמן להחמיר <span class=\"by-source\">תוספת' דמאי א ח</span>. <strong>שתיקה</strong> מקיימת ואין <strong>שתיקה</strong> מבטלת <span class=\"by-source\">שם נדר' ז ה</span>, <span class=\"by-source\">בבלי נדר' עט.</span>. יפה<strong> שתיקה</strong> לחכמים קל וחומר לטפשים <span class=\"by-source\">ירוש' פסחים ט ח</span>, <span class=\"by-source\">בבלי שם צט.</span>, ועוד. <strong>ושתיקה</strong> כהודאה דמיא <span class=\"by-source\">יבמ' פז:</span>. <strong>שתיקה </strong>כהודאה <span class=\"by-source\">ב\"מ לז:</span>. מה זכירה זכר לה <strong>שתיקתה </strong>לאחותה בשעה שהיו נותנין לו את לאה היתה יודעת ושותקת <span class=\"by-source\">מד\"ר בראש' עג</span>. — ובסהמ\"א: תחלת החכמה <strong>שתיקה </strong>שניה לה שמיעה שלישית זכרון <span class=\"by-source\">רמב\"ג, מבחר הפנינים, שער החכמה, 5</span>. ואמרו (לסוקראט) מתי השתיקה טובה מן הדבור? אמר בעת התאוה <span class=\"by-source\">ר\"י זבארה, ס' שעשועים ז, דוידזון, 71</span>. והיה פתיותו נסתר <strong>בשתיקתו</strong> עד זרק הקיתון, ויפתח ה' את פי האתון <span class=\"by-source\">ר\"י חריזי, תחכ' כד, 225</span>. כי קצת החכמה חלק מן <strong>השתיקה </strong><span class=\"by-source\">מוסר הפילוספ' א טז</span>, ועוד. באשר <strong>השתיקה </strong>תוליד המות הדבור חכמה <span class=\"by-source\">עמנו', מחב' ג, הברמן, 83</span>. — ובמשמ' מחלת השתוק: ומוליד (היין) חלאים רבים כמו הפלג ולקות הפה ועקומו <strong>ושתיקה</strong> <span class=\"by-source\">ר\"י זבארה, ס' שעשועים א, דוידזון, 10</span>. — ואמר המשורר: וסרה אחרי זאת כל תביעה והיתה בה למשטיני <strong>שתיקה</strong> <span class=\"by-source\">ר\"ש הנגיד, ידידותך בתוך לבי, בן תהלים ב, הברמן, 57</span>. אמת כי <strong>השתיקה</strong> היא יקרה, בכל מדות חמודות היא שקולה <span class=\"by-source\">ר\"י חריזי, אשר יאמר, תחכ' כד, 225</span>.</p>"]}, "rid": "BY-20988", "prev_hw": "שַׁתְיָן", "next_hw": "שְׁתִיקוּת", "page_num": 7498, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]