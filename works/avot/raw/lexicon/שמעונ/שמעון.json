[{"headword": "שִׁמְעוֹן", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-pr-m", "senses": [{"definition": "Simeon or Shimeon = \"heard\""}, {"definition": "the 2nd son of Jacob by his wife Leah and progenitor of the tribe of Simeon"}, {"definition": "an Israelite of the sons of Bani who had a foreign wife in the time of Ezra"}]}, "strong_number": "8095", "transliteration": "Shimʻôwn", "pronunciation": "shim-one'", "language_code": "x-pn", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "שִׁמְעוֹן", "parent_lexicon": "Jastrow Dictionary", "rid": "U01517", "refs": ["Bereishit Rabbah 71:2", "Bereishit Rabbah 71:3", "Bereishit Rabbah 71:4", "Bamidbar Rabbah 2:7", "Bamidbar Rabbah 2:10", "Bamidbar Rabbah 13:2", "Bamidbar Rabbah 13:3", "Bamidbar Rabbah 13:5", "Bamidbar Rabbah 13:7", "Bamidbar Rabbah 13:8", "Bamidbar Rabbah 13:12", "Bamidbar Rabbah 13:19", "Bamidbar Rabbah 13:20", "Yoma 69a:11", "Shabbat 15a", "Kiddushin 66a:12", "Sukkah 53a:7", "Tosefta Sukkah 4:4", "Avodah Zarah 20a:10", "Horayot 13b:11", "Horayot 13b:12", "Horayot 13b:14", "Horayot 13b:17", "Horayot 13b:18", "Ketubot 77a:2", "Ketubot 77a:4", "Ketubot 77a:5", "Ketubot 77a:6", "Ketubot 77a:7", "Berakhot 13b:19", "Shabbat 61a:15", "Berakhot 33a:31", "Ketubot 54b", "Gittin 47a:15", "Jerusalem Talmud Berakhot 9:1:31", "Jerusalem Talmud Shabbat 7:2:32", "Jerusalem Talmud Berakhot 5:2:9", "Jerusalem Talmud Yevamot 8:3:9"], "content": {"senses": [{"definition": " (b. h.) pr. n. m. <i>Simeon, Simon</i>, "}, {"definition": " the son of Jacob; the tribe of Simeon. <a class=\"refLink\" href=\"/Bereishit_Rabbah.71.4\" data-ref=\"Bereishit Rabbah 71:4\">Gen. R. s. 71</a> ש̇מ̇ע̇ון ש̇ומ̇ע בקול וכ׳ Simeon (listener), listening to the voice of his father in heaven. <a class=\"refLink\" href=\"/Bamidbar_Rabbah.2.10\" data-ref=\"Bamidbar Rabbah 2:10\">Num. R. s. 2</a><sup>7</sup> <span dir=\"rtl\">ש׳ פטדה</span> the jewel in the high priest’s breastplate for the tribe of S. was a topaz. <a class=\"refLink\" href=\"/Bamidbar_Rabbah.13.20\" data-ref=\"Bamidbar Rabbah 13:20\">Num. R. s. 13</a><sup>19</sup> <span dir=\"rtl\">נשיא ש׳</span> the prince of the tribe of S.; a. fr.", "number": "1)"}, {"definition": " ש׳ הצדיק <i>Simon the Just</i>, a high priest. <a class=\"refLink\" href=\"/Yoma.69a.11\" data-ref=\"Yoma 69a:11\">Yoma 69ᵃ</a> <span dir=\"rtl\">כיון שראה לש׳ הצ׳ וכ׳</span> when he (Alexander the Great) saw Simon the Just, he alighted from his chariot &c. <a class=\"refLink\" href=\"/Pirkei_Avot.1.2\" data-ref=\"Pirkei Avot 1:2\">Ab. I, 2</a> ש׳ הצ׳ היה וכ׳ Simon the Just was one of the last members of the Great Assembly; a. fr.", "number": "—2)"}, {"definition": " name of several Tannaim, esp. <i>a</i>) S. son of Hillel. <a class=\"refLink\" href=\"/Shabbat.15a\" data-ref=\"Shabbat 15a\">Sabb. 15ᵃ</a>.—<i>b</i>) R. S. son of the Sagan. <a class=\"refLink\" href=\"/Mishnah_Shekalim.8.5\" data-ref=\"Mishnah Shekalim 8:5\">Shek. VIII, 5</a>. <a class=\"refLink\" href=\"/Mishnah_Ketubot.2.8\" data-ref=\"Mishnah Ketubot 2:8\">Keth. II, 8</a>; a. e.—<i>c</i>) S. ben Sheṭaḥ, chief of the Pharisees under Alexander Jannai. <a class=\"refLink\" href=\"/Mishnah_Chagigah.2.2\" data-ref=\"Mishnah Chagigah 2:2\">Ḥag. II, 2</a>. <a class=\"refLink\" href=\"/Tosefta_Ketubot.12.1\" data-ref=\"Tosefta Ketubot 12:1\">Tosef. Keth. XII, 1</a>. <a class=\"refLink\" href=\"/Kiddushin.66a.12\" data-ref=\"Kiddushin 66a:12\">Kidd. 66ᵃ</a>; a. fr.—<i>d</i>) R. S. ben Gamliel I (abbrev. <span dir=\"rtl\">רשב\"ג</span>) <a class=\"refLink\" href=\"/Mishnah_Keritot.1.7\" data-ref=\"Mishnah Keritot 1:7\">Ker. I, 7</a>. <a class=\"refLink\" href=\"/Sukkah.53a.7\" data-ref=\"Sukkah 53a:7\">Succ. 53ᵃ</a>; <a class=\"refLink\" href=\"/Tosefta_Sukkah.4.4\" data-ref=\"Tosefta Sukkah 4:4\">Tosef. ib. IV, 4</a>. <a class=\"refLink\" href=\"/Avodah_Zarah.20a.10\" data-ref=\"Avodah Zarah 20a:10\">Ab. Zar. 20ᵃ</a>; (Y. ib. I, 40ᵃ bot.; <a class=\"refLink\" href=\"Jerusalem_Talmud_Berakhot.9.1.31\" data-ref=\"Jerusalem Talmud Berakhot 9:1:31\">Y. Ber. IX, 13ᵇ</a> bot. <span dir=\"rtl\">רבן גמליאל</span>); a. e.—<i>e</i>) Rabban S. ben Gamliel II. <a class=\"refLink\" href=\"/Horayot.13b.18\" data-ref=\"Horayot 13b:18\">Hor. 13ᵇ</a>. <a class=\"refLink\" href=\"/Ketubot.77a.7\" data-ref=\"Ketubot 77a:7\">Keth. 77ᵃ</a>, a. fr. <span dir=\"rtl\">כל מקום ששנה רשב\"ג וכ׳</span> wherever R. S. b. G. is cited in the Mishnah, his opinion is the adopted law. Ib. VII, 9; a. v. fr.—<i>f</i>) <span dir=\"rtl\">ר׳ ש׳ ברבי</span> R. S. son of R. Judah han-Nasi (B’ribbi). Ib. 103ᵇ. <a class=\"refLink\" href=\"/Berakhot.13b.19\" data-ref=\"Berakhot 13b:19\">Ber. 13ᵇ</a>; a. fr.—<span dir=\"rtl\">ש׳ בן זומא</span>, v. <a class=\"refLink\" href=\"/Jastrow,_זוֹמָא II.1\" data-ref=\"Jastrow, זוֹמָא II 1\"><span dir=\"rtl\">זוֹמָא</span> II</a>.—<span dir=\"rtl\">ש׳ בן עזאי</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עַזַּאי.1\" data-ref=\"Jastrow, עַזַּאי 1\">עַזַּאי</a>; a. many other Tannaim; v. Fr. Darkhé, Additamenta, p. 64–67.", "number": "—3)"}, {"definition": " name of several Amoraim, esp. <i>a</i>) R. S. bar Abba (Ba, Va), in Babli <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_שִׁמָּן.1\" data-ref=\"Jastrow, שִׁמָּן 1\">שִׁמָּן</a>. <a class=\"refLink\" href=\"Jerusalem_Talmud_Shabbat.7.2.32\" data-ref=\"Jerusalem Talmud Shabbat 7:2:32\">Y. Sabb. VII, 8ᵃ</a> bot.; Bab. <a class=\"refLink\" href=\"/Shabbat.61a.15\" data-ref=\"Shabbat 61a:15\">Sabb. 61ᵃ</a>. <a class=\"refLink\" href=\"Jerusalem_Talmud_Berakhot.5.2.9\" data-ref=\"Jerusalem Talmud Berakhot 5:2:9\">Y. Ber. V, 9ᵇ</a> bot.; Bab. <a class=\"refLink\" href=\"/Berakhot.33a.31\" data-ref=\"Berakhot 33a:31\">Ber. 33ᵃ</a>; a. fr.—<i>b</i>) R. S. b. Laḳish (abbrev. <span dir=\"rtl\">רשב\"ל</span>, a. <span dir=\"rtl\">ריש לקיש</span>, <span dir=\"rtl\">ר\"ל</span>). <a class=\"refLink\" href=\"/Ketubot.54b\" data-ref=\"Ketubot 54b\">Keth. 54ᵇ</a>. <a class=\"refLink\" href=\"/Gittin.47a.15\" data-ref=\"Gittin 47a:15\">Gitt. 47ᵃ</a>. <a class=\"refLink\" href=\"Jerusalem_Talmud_Yevamot.8.3.9\" data-ref=\"Jerusalem Talmud Yevamot 8:3:9\">Y. Yeb. VIII, 9ᵈ</a> bot.; a. v. fr., v. <a class=\"refLink\" href=\"/Jastrow,_לָקִישׁ II.1\" data-ref=\"Jastrow, לָקִישׁ II 1\"><span dir=\"rtl\">לָקִישׁ</span> I</a>; a. other Amoraim; v. Fr. M’bo p. 127ᵃ–130ᵃ", "number": "—4)"}]}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "שַׁמְּעָא", "next_hw": "שִׁמְעִי", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "שִׁמְעוֹן", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.pr.m. (</strong>cf. n.pr. <span dir=\"rtl\">שמעון</span> in Palm. Lzb <sup>378</sup>; meaning doubtful; RS al. cp. <span dir=\"rtl\">سِمْعٌ</span>, said to mean <em>offspring of hyena and wolf;</em> v. Hogg<sup>EB iv. 4531</sup><strong>)</strong>;—"}, {"senses": [{"definition": "second son of Jacob and Leah, Συμεων: <a data-ref=\"Genesis 29:33\" href=\"/Genesis.29.33\">Gn 29:33</a> (name expl. from <span dir=\"rtl\">שָׁמַע</span>), <a data-ref=\"Genesis 35:23\" href=\"/Genesis.35.23\">35:23</a> <a data-ref=\"Exodus 1:2\" href=\"/Exodus.1.2\">Ex 1:2</a> + 14 times (assoc. especially with Levi <a data-ref=\"Genesis 34:25\" href=\"/Genesis.34.25\">Gn 34:25</a>, <a data-ref=\"Genesis 34:30\" href=\"/Genesis.34.30\">30</a>; <a data-ref=\"Genesis 49:5\" href=\"/Genesis.49.5\">49:5</a>)."}], "num": "1."}, {"senses": [{"definition": "tribal name <a data-ref=\"Judges 1:3\" href=\"/Judges.1.3\">Ju 1:3</a><sup>(×2)</sup>, <a data-ref=\"Judges 1:17\" href=\"/Judges.1.17\">17</a> <a data-ref=\"Numbers 1:6\" href=\"/Numbers.1.6\">Nu 1:6</a> +; so <span dir=\"rtl\">בְּנֵי שׁ׳</span> <a data-ref=\"Numbers 1:22\" href=\"/Numbers.1.22\">Nu 1:22</a> + 7 times, <span dir=\"rtl\">מַטֵּה שׁ׳</span> <a data-ref=\"Numbers 1:23\" href=\"/Numbers.1.23\">Nu 1:23</a>; <a data-ref=\"Numbers 2:12\" href=\"/Numbers.2.12\">2:12</a>; <a data-ref=\"Numbers 13:5\" href=\"/Numbers.13.5\">13:5</a>; <span dir=\"rtl\">מַטֵּה בְנֵי שׁ׳</span> <a data-ref=\"Numbers 10:19\" href=\"/Numbers.10.19\">10:19</a>; <a data-ref=\"Numbers 34:20\" href=\"/Numbers.34.20\">34:20</a> <a data-ref=\"Joshua 19:1\" href=\"/Joshua.19.1\">Jos 19:1</a>, <a data-ref=\"Joshua 19:8\" href=\"/Joshua.19.8\">8</a>; <a data-ref=\"Joshua 21:9\" href=\"/Joshua.21.9\">21:9</a> <a data-ref=\"I Chronicles 6:50\" href=\"/I_Chronicles.6.50\">1 Ch 6:50</a>."}], "num": "2."}, {"senses": [{"definition": "post-ex.. Jew with foreign wife <a data-ref=\"Ezra 10:31\" href=\"/Ezra.10.31\">Ezr 10:31</a>."}], "all_cited": true, "num": "3."}]}, "rid": "BDB10382", "strong_numbers": ["8095"], "next_hw": "שִׁמְעוֹנִי", "prev_hw": "שַׁמּוּעַ", "occurrences": "44", "quotes": [], "GK": ["9058"], "TWOT": [], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}]