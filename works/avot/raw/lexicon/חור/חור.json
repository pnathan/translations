[{"headword": "חוֹר I", "parent_lexicon": "Jastrow Dictionary", "rid": "H00447", "language_code": "(b. h.;", "refs": ["Jastrow, חוּר I 1", "Pesachim 8a:7", "Shabbat 52b:15", "Shabbat 123a", "Jastrow, חוֹרָר 1", "Jerusalem Talmud Maasrot 5:3:7"], "content": {"senses": [{"definition": " <a class=\"refLink\" href=\"/Jastrow,_חוּר I.1\" data-ref=\"Jastrow, חוּר I 1\">preced.</a> wds.) "}, {"definition": "<i>hole, cavity</i>. <a class=\"refLink\" href=\"/Pesachim.8a.7\" data-ref=\"Pesachim 8a:7\">Pes. 8ᵃ</a> <span dir=\"rtl\">ח׳ שבין אדם לחבירו</span> a cave between two residences of neighbors.—<a class=\"refLink\" href=\"/Shabbat.52b.15\" data-ref=\"Shabbat 52b:15\">Sabb. 52ᵇ</a> <span dir=\"rtl\">מחט שניטל חוּרָהּ</span> (Ms. M. <span dir=\"rtl\">חוּדְדָהּ</span>, Ms. O. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חֲרָרָה.1\" data-ref=\"Jastrow, חֲרָרָה 1\">חֲרָרָהּ</a>, some ed. <span dir=\"rtl\">חוּדָּהּ</span>) a needle whose eye is broken off; <a class=\"refLink\" href=\"/Shabbat.123a\" data-ref=\"Shabbat 123a\">ib. 123ᵃ</a> <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חֲרָרָה.1\" data-ref=\"Jastrow, חֲרָרָה 1\">חֲרָרָהּ</a> (Ms. M. <span dir=\"rtl\">חוּדָּהּ</span>); <a class=\"refLink\" href=\"/Mishnah_Kelim.13.5\" data-ref=\"Mishnah Kelim 13:5\">Kel. XIII, 5</a> <span dir=\"rtl\">חֲרִירָהּ</span>; <a class=\"refLink\" href=\"/Tosefta_Keilim_Metsia.3.9\" data-ref=\"Tosefta Keilim Metsia 3:9\">Tosef. Kel. B. Mets. III, 9</a> <span dir=\"rtl\">חודה</span>.—Pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חֹר.1\" data-ref=\"Jastrow, חֹר 1\">חוֹרִין</a>. Pes. l. c. Ib. <span dir=\"rtl\">חוֹרֵי בית וכ׳</span> the upper and the lower holes in the wall; a. fr.", "number": "1)"}, {"definition": "<i>ant’s store</i>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חוֹרָר.1\" data-ref=\"Jastrow, חוֹרָר 1\">חוֹרָר</a>. [Pesik. Shor p. 74ᵇ <span dir=\"rtl\">חורין דדהב</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חַזּוּר.1\" data-ref=\"Jastrow, חַזּוּר 1\">חַזּוּר</a>.] [<a class=\"refLink\" href=\"Jerusalem_Talmud_Maasrot.5.3.7\" data-ref=\"Jerusalem Talmud Maasrot 5:3:7\">Y. Maasr. V, end, 52ᵃ</a> <span dir=\"rtl\">חור אחד</span>, v. <a class=\"refLink\" href=\"/Jastrow,_זוּר II.1\" data-ref=\"Jastrow, זוּר II 1\"><span dir=\"rtl\">זוּר</span> II</a>.]", "number": "—2)"}], "morphology": "m."}, "plural_form": ["חוֹרִין"], "alt_headwords": ["חוּר II"], "quotes": [], "prev_hw": "חוּר I", "next_hw": "חוֹר II", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "חוֹר II", "parent_lexicon": "Jastrow Dictionary", "rid": "H00448", "refs": ["Mishnah Gittin 4:5", "Bava Kamma 8b:4"], "content": {"senses": [{"definition": " (b. h.), pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חֹר.1\" data-ref=\"Jastrow, חֹר 1\">חוֹרִין</a> [<i>white garments</i>,] <i>freedom;</i> <span dir=\"rtl\">בֶּן ח׳</span>, <span dir=\"rtl\">בַּת ח׳</span> <i>free, freed</i>, opp. to slave. <a class=\"refLink\" href=\"/Mishnah_Gittin.4.4\" data-ref=\"Mishnah Gittin 4:4\">Gitt. IV, 4</a> <span dir=\"rtl\">ועושה … בן ח׳</span> and he must declare him free. <a class=\"refLink\" href=\"/Mishnah_Gittin.4.5\" data-ref=\"Mishnah Gittin 4:5\">Ib. 5</a> <span dir=\"rtl\">חציו עבד וחציו בן ח׳</span> half a slave and half a freedman; a. fr.—Pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_בְּרַק II.1\" data-ref=\"Jastrow, בְּרַק II 1\">בְּנֵי ח׳</a>. <a class=\"refLink\" href=\"/Mishnah_Bava_Kamma.1.3\" data-ref=\"Mishnah Bava Kamma 1:3\">B. Kam. I, 3</a> <span dir=\"rtl\">עדים ב׳ ח׳ וכ׳</span> witnesses who are freemen and of the Jewish faith. <a class=\"refLink\" href=\"/Esther_Rabbah.2.7\" data-ref=\"Esther Rabbah 2:7\">Esth. R. to I, 6</a> (expl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חוּר I.1\" data-ref=\"Jastrow, חוּר I 1\">חוּר</a> ib.) <span dir=\"rtl\">בגדים שב׳ ח׳ וכ׳</span> garments which freemen wear; a. fr.—(<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נְכָסִים.1\" data-ref=\"Jastrow, נְכָסִים 1\">נכסים</a>) <span dir=\"rtl\">בני ח׳</span> <i>free</i> (not mortgaged) <i>property</i>, opp. <span dir=\"rtl\">משועבדים</span>. <a class=\"refLink\" href=\"/Bava_Kamma.8b.4\" data-ref=\"Bava Kamma 8b:4\">B. Kam. 8ᵇ</a>; a. fr. [Bibl. Hebr. <span dir=\"rtl\">חוֹרִים</span>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חֲרַם.1\" data-ref=\"Jastrow, חֲרַם 1\">חֹרִים</a> <i>noblemen</i>"}], "morphology": "m."}, "plural_form": ["חוֹרִין", "בְּנֵי ח׳"], "alt_headwords": [], "quotes": [], "prev_hw": "חוֹר I", "next_hw": "חוּר III", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "חוֹר ᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "hole, aperture.", "number": "1"}, {"definition": "socket of the eye.", "number": "2"}]}, "rid": "H00313", "refs": ["Klein Dictionary, חרר ᴵ 1", "Klein Dictionary, חרר ᴵ 1", "Klein Dictionary, חָרִיר 1", "Klein Dictionary, חָרִיר 1"], "alt_headwords": ["חֹר ᴵ"], "derivatives": "Derivative: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_חָרִיר.1\" data-ref=\"Klein Dictionary, חָרִיר 1\">חָרִיר</a>.", "prev_hw": "חוּר ᴵᴵ", "next_hw": "חוֹר ᴵᴵ", "notes": "[From <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_חרר ᴵ.1\" data-ref=\"Klein Dictionary, חרר ᴵ 1\">חרר ᴵ</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionar