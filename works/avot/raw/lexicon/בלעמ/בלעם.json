[{"headword": "בִּלְעָם", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-pr-m n-pr-loc", "senses": [{"definition": "Balaam = \"not of the people\""}, {"definition": "n pr m"}, {"definition": "the son of Beor,  a man endowed with the gift of prophecy"}, {"definition": "n pr loc"}, {"definition": "a town in Manasseh"}]}, "strong_number": "1109", "transliteration": "Bilʻâm", "pronunciation": "bil-awm'", "language_code": "x-pn", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "בִּלְעָם", "parent_lexicon": "Jastrow Dictionary", "rid": "B00904", "refs": ["Sanhedrin 105a:7", "Bereishit Rabbah 65"], "content": {"senses": [{"definition": " (b. h.) pr. n. m. <i>Balaam</i>, the gentile prophet of the Pentateuch. <a class=\"refLink\" href=\"/Sanhedrin.105a.7\" data-ref=\"Sanhedrin 105a:7\">Snh. 105ᵃ</a> ב׳ בַּלַּע עם Ar. (Var. in Ar., a. ed. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_בַּלָּא.1\" data-ref=\"Jastrow, בַּלָּא 1\">בַּלָּא</a>) devourer (destroyer) of the people; other homilet. etymology ibid. <span dir=\"rtl\">שבִּלָּה עם</span> he ruined the people (through debauchery; Rashi: = <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_בִּלְבֵּל.1\" data-ref=\"Jastrow, בִּלְבֵּל 1\">בִּלְבֵּל</a>). <a class=\"refLink\" href=\"/Bereishit_Rabbah.65\" data-ref=\"Bereishit Rabbah 65\">Gen. R. s. 65</a>. <a class=\"refLink\" href=\"/Pirkei_Avot.5.19\" data-ref=\"Pirkei Avot 5:19\">Ab. V, 19</a> (as type of false teachers); a. fr."}]}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "בלעין", "next_hw": "בַּלְעֵס", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "בִּלְעָם", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.pr.m. Balaam (</strong>according to Sta<sup>§ 293</sup> = <span dir=\"rtl\">בלע</span> + ם; Nbr<sup>Stud. Bib. i, 226</sup> proposes <span dir=\"rtl\">בל</span> = <span dir=\"rtl\">בעל</span> + (god) <span dir=\"rtl\">עם</span><strong>)</strong>, son of <span dir=\"rtl\">בְּעוֹר</span>, prophet from <span dir=\"rtl\">פְּתוֹר</span> (q.v.):—<a data-ref=\"Numbers 22:5\" href=\"/Numbers.22.5\">Nu 22:5</a>, <a data-ref=\"Numbers 22:7\" href=\"/Numbers.22.7\">7</a>, <a data-ref=\"Numbers 22:8\" href=\"/Numbers.22.8\">8</a>, <a data-ref=\"Numbers 22:9\" href=\"/Numbers.22.9\">9</a> + 47 times <a data-ref=\"Numbers 22-24\" href=\"/Numbers.22-24\">Nu 22–24</a> (all JE) <a data-ref=\"Numbers 31:8\" href=\"/Numbers.31.8\">31:8</a>, <a data-ref=\"Numbers 31:16\" href=\"/Numbers.31.16\">16</a> (P) <a data-ref=\"Deuteronomy 23:5\" href=\"/Deuteronomy.23.5\">Dt 23:5</a>, <a data-ref=\"Deuteronomy 23:6\" href=\"/Deuteronomy.23.6\">6</a> (D) (cf. R<sup>D</sup> <a data-ref=\"Joshua 13:22\" href=\"/Joshua.13.22\">Jos 13:22</a>) <a data-ref=\"Joshua 24:9\" href=\"/Joshua.24.9\">Jos 24:9</a>, <a data-ref=\"Joshua 24:10\" href=\"/Joshua.24.10\">10</a> (E) <a data-ref=\"Micah 6:5\" href=\"/Micah.6.5\">Mi 6:5</a> <a data-ref=\"Nehemiah 13:2\" href=\"/Nehemiah.13.2\">Ne 13:2</a>."}]}, "rid": "BDB01280", "strong_numbers": ["1109"], "next_hw": "בִּלְעָם²", "prev_hw": "בִּלְעֲדֵי²", "ordinal": "I.", "quotes": [], "GK": ["1189", "1190"], "TWOT": ["251b"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "בִּלְעָם²", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.pr.loc.</strong> town in Manasseh <a data-ref=\"I Chronicles 6:55\" href=\"/I_Chronicles.6.55\">1 Ch 6:55</a>; A Ιβλααμ, 𝔊L Ιεβλααμ = <span dir=\"rtl\">יִבְלְעָם</span> (q.v.) <a data-ref=\"Joshua 17:11\" href=\"/Joshua.17.11\">Jos 17:11</a> + 2 times mod. <em>Belʿame</em>, 6 hours N. of Nâblus, Bd<sup>Pal. 228</sup>, so Survey<sup>ii. 47</sup>."}]}, "rid": "BDB01281", "strong_numbers": ["1109"], "next_hw": "בָּלַק", "prev_hw": "בִּלְעָם", "all_cited": true, "ordinal": "II.", "quotes": [], "GK": ["1189", "1190"], "TWOT": ["251b"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}]