[{"headword": "נָפָה I", "parent_lexicon": "Jastrow Dictionary", "rid": "N01018", "refs": ["Jastrow, נפי 1"], "content": {"senses": [{"definition": "<i>Pi.</i> <span dir=\"rtl\">נִיפָּה</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נפי.1\" data-ref=\"Jastrow, נפי 1\">נפי</a>."}]}, "quotes": [], "prev_hw": "נָפָא", "next_hw": "נָפָה II", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "נָפָה II", "parent_lexicon": "Jastrow Dictionary", "rid": "N01019", "language_code": "(b. h.;", "refs": ["Jastrow, נוּף 1", "Mishnah Menachot 10:4", "Chullin 45a:2", "Sotah 48b:16", "Yalkut Shimoni on Nach 676:2", "Menachot 76b:9", "Jerusalem Talmud Ketubot 7:5:2"], "language_reference": " <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נוּף.1\" data-ref=\"Jastrow, נוּף 1\"><a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נוּף.1\" data-ref=\"Jastrow, נוּף 1\">נוּף</a>)</a>", "content": {"senses": [{"definition": "<i>fan; winnow; sieve</i>. <a class=\"refLink\" href=\"/Mishnah_Menachot.6.7\" data-ref=\"Mishnah Menachot 6:7\">Men. VI, 7</a>; <a class=\"refLink\" href=\"/Mishnah_Menachot.10.4\" data-ref=\"Mishnah Menachot 10:4\">X, 4</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נפי.1\" data-ref=\"Jastrow, נפי 1\">נפי</a>. <a class=\"refLink\" href=\"Jerusalem_Talmud_Ketubot.7.5.2\" data-ref=\"Jerusalem Talmud Ketubot 7:5:2\">Y. Keth. VII, 31ᵇ</a> bot., v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נָדַר.1\" data-ref=\"Jastrow, נָדַר 1\">נָדַר</a>. <a class=\"refLink\" href=\"/Chullin.45a.2\" data-ref=\"Chullin 45a:2\">Ḥull. 45ᵃ</a> <span dir=\"rtl\">ניקבה כנ׳</span> if the windpipe has perforations like a sieve. <a class=\"refLink\" href=\"/Sotah.48b.16\" data-ref=\"Sotah 48b:16\">Sot. 48ᵇ</a>; Y. ib. IX, 24ᵇ bot., v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נוֹפֶת.1\" data-ref=\"Jastrow, נוֹפֶת 1\">נוֹפֶת</a>. Tanḥ. Ekeb 1; <a class=\"refLink\" href=\"/Yalkut_Shimoni_on_Nach.676.2\" data-ref=\"Yalkut Shimoni on Nach 676:2\">Yalk. Ps. 676</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נוֹפֶת.1\" data-ref=\"Jastrow, נוֹפֶת 1\">נוֹפֶת</a>; a. fr.—<a class=\"refLink\" href=\"/Pirkei_Avot.5.15\" data-ref=\"Pirkei Avot 5:15\">Ab. V, 15</a> <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נ׳.1\" data-ref=\"Jastrow, נ׳ 1\">נ׳</a> a scholar who retains the best teachings.—Pl. <span dir=\"rtl\">נָפוֹת</span>. <a class=\"refLink\" href=\"/Menachot.76b.9\" data-ref=\"Menachot 76b:9\">Men. 76ᵇ</a>"}]}, "plural_form": ["נָפוֹת"], "alt_headwords": [], "quotes": [], "prev_hw": "נָפָה I", "next_hw": "נִפְוָותָא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "נפי", "parent_lexicon": "Jastrow Dictionary", "rid": "N01036", "refs": ["Bava Batra 94a:7", "Mishnah Menachot 6:7", "Pesikta Rabbati 3", "Jerusalem Talmud Maasrot 4:3:2"], "content": {"senses": [{"definition": ", <i>Pi.</i> <span dir=\"rtl\">נִיפָּה</span> (denom. of <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נפי.1\" data-ref=\"Jastrow, נפי 1\">נָפָה</a>) <i>to fan, winnow, sift.</i> <a class=\"refLink\" href=\"/Mishnah_Maasrot.4.5\" data-ref=\"Mishnah Maasrot 4:5\">Maasr. IV, 5</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נָפַח.1\" data-ref=\"Jastrow, נָפַח 1\">נָפַח</a>. <a class=\"refLink\" href=\"/Bava_Batra.94a.7\" data-ref=\"Bava Batra 94a:7\">B. Bath. 94ᵃ</a> <span dir=\"rtl\">אם בא לנַפּוֹת מְנַפֶּה וכ׳</span> if the buyer winnows (a sample of the wheat, and it is found to contain more than the legally allowed refuse), he winnows the entire quantity, and the seller has to indemnify him for the entire quantity lost by winnowing. <a class=\"refLink\" href=\"Jerusalem_Talmud_Maasrot.4.3.2\" data-ref=\"Jerusalem Talmud Maasrot 4:3:2\">Y. Maasr. IV, 51ᵇ</a> bot. <span dir=\"rtl\">ובלבד שלא יְנַפֶּה וכ׳</span> (better <span dir=\"rtl\">יְנַפֵּחַ</span>) but he must not blow the chaff out over a basket; a. e.—Part. pass. <span dir=\"rtl\">מְנוּפֶּה</span>; f. <span dir=\"rtl\">מְנוּפָּה</span>. <a class=\"refLink\" href=\"/Mishnah_Menachot.10.4\" data-ref=\"Mishnah Menachot 10:4\">Men. X, 4</a>; <a class=\"refLink\" href=\"/Mishnah_Menachot.6.7\" data-ref=\"Mishnah Menachot 6:7\">VI, 7</a> <span dir=\"rtl\">מנ׳ בשלש עשרה נפה</span> sifted thirteen times. Ib. <span dir=\"rtl\">סלת מנ׳ כל צרכה</span> fine flour sufficiently sifted. Tanḥ. T’tsavveh 5, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_סָלַת.1\" data-ref=\"Jastrow, סָלַת 1\">סָלַת</a>; a. e.—<a class=\"refLink\" href=\"/Pesikta_Rabbati.3\" data-ref=\"Pesikta Rabbati 3\">Pesik. R. s. 3</a> (ref. to <span dir=\"rtl\">כברת</span>, <a class=\"refLink\" href=\"/Genesis.48.7\" data-ref=\"Genesis 48:7\">Gen. XLVIII, 7</a>) <span dir=\"rtl\">מנ׳ … בכברה בזמן שהארץ</span> (not <span dir=\"rtl\">ככברה</span>) at a season when the ground can be sifted and be shaken in the sieve."}]}, "plural_form": [], "alt_headwords": ["נָפָה"], "quotes": [], "prev_hw": "נַפְטוֹיָא", "next_hw": "נְפֵי", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "נָפָה ᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"definition": "sieve (a hapax legomenon in the Bible, occurring <a class=\"refLink\" href=\"/Isaiah.30.28\" data-ref=\"Isaiah 30:28\">Is. 30:28</a>)."}]}, "rid": "N00954", "refs": ["Klein Dictionary, נוף ᴵ 1", "Klein Dictionary, ◌ָה ᴵ 1", "Klein Dictionary, נוף ᴵ 1", "Klein Dictionary, ◌ָה ᴵ 1", "Klein Dictionary, נפה 1", "Klein Dictionary, נפה 1"], "derivatives": "Derivative: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_נפה.1\" data-ref=\"Klein Dictionary, נפה 1\">נפה</a>.", "prev_hw": "נִפְגָּע", "next_hw": "נָפָה ᴵᴵ", "notes": "[From <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_נוף ᴵ.1\" data-ref=\"Klein Dictionary, נוף ᴵ 1\">נוף ᴵ</a> (= to move to and fro, swing). For the ending see first suff. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_◌ָה ᴵ.1\" data-ref=\"Klein Dictionary, ◌ָה ᴵ 1\">◌ָה</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "נָפָה ᴵᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"definition": "region, district (in the Bible occurring only together with the proper name <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דֹּֽאַר.1\" data-ref=\"Klein Dictionary, דֹּֽאַר 1\">דֹאַר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דּוֹר.1\" data-ref=\"Klein Dictionary, דּוֹר 1\">דּוֹר</a>)."}]}, "rid": "N00955", "refs": ["Klein Dictionary, דֹּֽאַר 1", "Klein Dictionary, דּוֹר 1", "Klein Dictionary, דֹּֽאַר 1", "Klein Dictionary, דּוֹר 1", "Klein Dictionary, נוֹף ᴵ 1", "Klein Dictionary, נֶֽפֶת 1", "Klein Dictionary, נוֹף ᴵ 1", "Klein Dictionary, נֶֽפֶת 1"], "prev_hw": "נָפָה ᴵ", "next_hw": "נפה", "notes": "[Prob. related to <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_נוֹף ᴵ.1\" data-ref=\"Klein Dictionary, נוֹף ᴵ 1\">נוֹף ᴵ</a> (= height, elevation, landscape), and to <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_נֶֽפֶת.1\" data-ref=\"Klein Dictionary, נֶֽפֶת 1\">נֶפֶת</a> (= height, elevation).]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "נָפָה I", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>ש\"נ, סמי' נָפַת, מ\"ר נָפוֹת, — כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_כְּבָרָה.1\" data-ref=\"Ben Yehuda Dictionary, כְּבָרָה 1\">כְּבָרָה</a>, אבל יותר דקה ממנה, Sieb; tamis; sieve: להנפה גויים בְּנָפַת שוא <span class=\"by-source\">(ישע' ל כח)</span>. — ובתו\"מ: משאלת אשה לחברתה החשודה על השביעית <strong>נפה</strong> וכברה וריחים ותנור <span class=\"by-source\">(שבי' ה ט)</span>. מה <strong>נפה </strong> זו מוציאה קמח בפני עצמו סובין בפני עצמם כך ת\"ח יושב ומדקדק בד\"ת ומברר ד\"ת ומשקלם <span class=\"by-source\">(ספרי דבר' מח)</span>. המוציא חבל כדי לעשות אזן לקופה גמי כדי לעשות תלאי <strong>לנפה</strong> ולכברה <span class=\"by-source\">(שבת ח ב)</span>. העושה שני בתי נירין בנירין בקירוס <strong>בנפה</strong> בכברה ובסל <span class=\"by-source\">(שם יג ב)</span>. ים <strong>נפה</strong> של סלתין <span class=\"by-source\">(כלים יה ג)</span>. כל התלוים טמאין חוץ מתלי <strong>נפה</strong> וכברה של בעל הבית <span class=\"by-source\">(ר\"מ, שם ד)</span>. אני אומר <strong>נפה</strong> לספור בה מעות <span class=\"by-source\">(ר' מנא, ירוש' שבי' ה ט)</span>. הדירה שלא להשאיל <strong>נפה</strong> וכברה <span class=\"by-source\">(שם כתוב' ז ה)</span>. אפי' לא כתב אלא אות אחת ולא ארג אלא חוט אחד ולא עשה אלא בית אחד <strong>בנפה</strong> <span class=\"by-source\">(שבת קג.)</span>. — ומ\"ר: שלש עשרה <strong>נפות</strong> היו במקדש זו למעלה מזו וזו למעלה מזו עליונה קולטת סובין תחתונה קולטת סולת <span class=\"by-source\">(רשב\"א, מנח' עו:)</span>. — וכנוי למדה ממדות תלמידי חכמים: ארבע מדות ביושבים לפני חכמים ספוג ומשפך משמרת <strong>ונפה</strong> ספוג שהוא סופג את הכל וכו' <strong>ונפה</strong> שמוציאה את הקמח וקולטת את הסולת <span class=\"by-source\">(אבות ה טו)</span>. — ואמר המליץ: בני אל תהיו <strong>כנפה</strong> שמוציאה הסלת וקולטת הפסולת <span class=\"by-source\">(ר\"א הלוי בר חסדאי, בן המלך והנזיר כו)</span>.</p>"]}, "rid": "BY-12607", "prev_hw": "נְעֹרֶת", "next_hw": "נָפָה II", "page_num": 3715, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}, {"headword": "נָפָה II", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>ש\"נ, מ\"ר נָפוֹת, —  גֹבַה, רָמָה, כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_נוֹף_I.1\" data-ref=\"Ben Yehuda Dictionary, נוֹף I 1\">נוֹף</a> עי' ערכו. רק בקשר עם שם המקום דור, או דאר:  ואל המלכים אשר מצפון בהר ובערבה נגד כנרות ובשפלה וּבְנָפוֹת דור מים <span class=\"by-source\">(יהוש' יא ב)</span>. מלך דור לנפת דור <span class=\"by-source\">(שם יב כג)</span>.  בן אבינדב כל <strong>נפת</strong> דאר <span class=\"by-source\">(מ\"א ד יא)</span>.</p>"]}, "rid": "BY-12608", "prev_hw": "נָפָה I", "next_hw": "נִפָּה", "page_num": 3716, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]