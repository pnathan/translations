[{"headword": "אוֹר", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "v", "senses": [{"definition": "to be or become light,  shine", "senses": [{"senses": [{"definition": "to become light (day)"}, {"definition": "to shine (of the sun)"}, {"definition": "to become bright"}], "grammar": {"verbal_stem": "Qal"}}, {"senses": [{"definition": "to be illuminated"}, {"definition": "to become lighted up"}], "grammar": {"verbal_stem": "Niphal"}}, {"senses": [{"definition": "to give light,  shine (of sun,  moon,  and stars)"}, {"definition": "to illumine,  light up,  cause to shine,  shine"}, {"definition": "to kindle,  light (candle,  wood)"}, {"definition": "lighten (of the eyes,  his law,  etc)"}, {"definition": "to make shine (of the face)"}], "grammar": {"verbal_stem": "Hiphil"}}]}]}, "strong_number": "215", "transliteration": "ʼôwr", "pronunciation": "ore", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "אוֹר", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-f", "senses": [{"definition": "light", "senses": [{"definition": "light of day"}, {"definition": "light of heavenly luminaries (moon,  sun, stars)"}, {"definition": "day-break,  dawn,  morning light"}, {"definition": "daylight"}, {"definition": "lightning"}, {"definition": "light of lamp"}, {"definition": "light of life"}, {"definition": "light of prosperity"}, {"definition": "light of instruction"}, {"definition": "light of face (fig.)"}, {"definition": "Jehovah as Israel's light"}]}]}, "strong_number": "216", "transliteration": "ʼôwr", "pronunciation": "ore", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "מֵאִיר", "parent_lexicon": "Jastrow Dictionary", "rid": "M00031", "refs": ["Eruvin 13b:3", "Eruvin 13b:4", "Eruvin 13b:5", "Eruvin 13b:6", "Horayot 13b:11", "Horayot 13b:12", "Horayot 13b:13", "Horayot 13b:17", "Bereishit Rabbah 9:5"], "content": {"senses": [{"definition": "<i>Meïr</i>, esp. R. M., a renowned Tannai, disciple of R. Akiba and of Elisha ben Abuya (v. Fr. Darkhe Mish., p. 154, a. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אֶלִישָׁע.1\" data-ref=\"Jastrow, אֶלִישָׁע 1\">אֱלִישָׁע</a>). <a class=\"refLink\" href=\"/Eruvin.13b.6\" data-ref=\"Eruvin 13b:6\">Erub. 13ᵇ</a> <span dir=\"rtl\">לא ר׳ מ׳ שמו אלא ר׳ מיישא שמו</span> (v. Rabb. D. S. a. l. note) his name was not R. M. but R. Maysha. <a class=\"refLink\" href=\"/Horayot.13b.17\" data-ref=\"Horayot 13b:17\">Hor. 13ᵇ</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אַחֵר.1\" data-ref=\"Jastrow, אַחֵר 1\">אַחֵר</a>. <a class=\"refLink\" href=\"/Bereishit_Rabbah.9.5\" data-ref=\"Bereishit Rabbah 9:5\">Gen. R. s. 9</a>, a. fr. <span dir=\"rtl\">בתורתו של ר׳ מ׳</span> in R. M.’s copy of the Pentateuch. <a class=\"refLink\" href=\"/Mishnah_Chullin.4.4\" data-ref=\"Mishnah Chullin 4:4\">Ḥull. IV, 4</a>; a. v. fr."}], "morphology": "pr. n. m."}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "מְאִיסוּתָא", "next_hw": "מְאֵירָה", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אוֹר", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>vb. be</strong> or become light <strong>(</strong>cf. Arabic <span dir=\"rtl\">أَوَّرَ</span> <em>enkindle</em>, Aramaic (Nasar.) <span dir=\"rtl\">ܐܘܪ</span> Aph. <em>illumine</em>, & deriv. in Assyrian<strong>)</strong>—"}, {"senses": [{"definition": "Pf. <span dir=\"rtl\">אוֹר</span> <a data-ref=\"Genesis 44:3\" href=\"/Genesis.44.3\">Gn 44:3</a> +; <span dir=\"rtl\">אֹ֫רוּ</span> <a data-ref=\"I Samuel 14:29\" href=\"/I_Samuel.14.29\">1 S 14:29</a>; Impf. 3 fpl. <span dir=\"rtl\">וַתָּאֹרְנָה</span> <a data-ref=\"I Samuel 14:27\" href=\"/I_Samuel.14.27\">1 S 14:27</a> Qr; Pt. <span dir=\"rtl\">אוֹר</span> <a data-ref=\"Proverbs 4:18\" href=\"/Proverbs.4.18\">Pr 4:18</a> (Ges<sup>§ 72 R. 1</sup>); Imv. fs. <span dir=\"rtl\">א֫וֹרִי</span> <a data-ref=\"Isaiah 60:1\" href=\"/Isaiah.60.1\">Is 60:1</a>;—<em>become light, shine</em> of sun (especially in early morn.) <a data-ref=\"Genesis 44:3\" href=\"/Genesis.44.3\">Gn 44:3</a> (J) <a data-ref=\"I Samuel 29:10\" href=\"/I_Samuel.29.10\">1 S 29:10</a> <a data-ref=\"Proverbs 4:18\" href=\"/Proverbs.4.18\">Pr 4:18</a> <a data-ref=\"Isaiah 60:1\" href=\"/Isaiah.60.1\">Is 60:1</a>; of eyes (owing to refreshment) <a data-ref=\"I Samuel 14:27\" href=\"/I_Samuel.14.27\">1 S 14:27</a><sup>(Qr) 29</sup>."}], "form": "Qal"}, {"senses": [{"definition": "Impf. <span dir=\"rtl\">וַיֵּאֹר</span> <a data-ref=\"II Samuel 2:32\" href=\"/II_Samuel.2.32\">2 S 2:32</a>; Inf. c. <span dir=\"rtl\">לֵאוֹר</span> <a data-ref=\"Job 33:30\" href=\"/Job.33.30\">Jb 33:30</a>; Pt. <span dir=\"rtl\">נָאוֹר</span> <a data-ref=\"Psalms 76:5\" href=\"/Psalms.76.5\">ψ 76:5</a>—become <em>lighted up</em> of day-break <a data-ref=\"II Samuel 2:32\" href=\"/II_Samuel.2.32\">2 S 2:32</a>; by light of life, revival <a data-ref=\"Job 33:30\" href=\"/Job.33.30\">Jb 33:30</a>; by light of glory, enveloped in light <a data-ref=\"Psalms 76:5\" href=\"/Psalms.76.5\">ψ 76:5</a>."}], "form": "Niph."}, {"senses": [{"definition": "Pf. <span dir=\"rtl\">וְהֵאִיר</span> <a data-ref=\"Exodus 25:37\" href=\"/Exodus.25.37\">Ex 25:37</a>, etc.; Impf. <span dir=\"rtl\">יָאִיר</span> <a data-ref=\"Job 41:24\" href=\"/Job.41.24\">Jb 41:24</a> +; <span dir=\"rtl\">יָאֵר</span> <a data-ref=\"Numbers 6:25\" href=\"/Numbers.6.25\">Nu 6:25</a> +; <span dir=\"rtl\">וַיָּ֫אֶר</span> <a data-ref=\"Psalms 118:27\" href=\"/Psalms.118.27\">ψ 118:27</a> +, etc.; Imv. <span dir=\"rtl\">הָאֵר</span> <a data-ref=\"Psalms 80:20\" href=\"/Psalms.80.20\">ψ 80:20</a> +, <span dir=\"rtl\">הָאִ֫ירָה</span> <a data-ref=\"Psalms 31:17\" href=\"/Psalms.31.17\">ψ 31:17</a> +; Inf. <span dir=\"rtl\">הָאִיר</span> <a data-ref=\"Genesis 1:15\" href=\"/Genesis.1.15\">Gn 1:15</a> +; Pt. <span dir=\"rtl\">מֵאִיר</span> <a data-ref=\"Proverbs 29:13\" href=\"/Proverbs.29.13\">Pr 29:13</a>; <span dir=\"rtl\">מְאִירַת</span> <a data-ref=\"Psalms 19:9\" href=\"/Psalms.19.9\">ψ 19:9</a>; <span dir=\"rtl\">מְאִירוֹת</span> <a data-ref=\"Isaiah 27:11\" href=\"/Isaiah.27.11\">Is 27:11</a>—"}, {"senses": [{"definition": "<em>give light</em>, of sun, moon & stars <a data-ref=\"Genesis 1:15\" href=\"/Genesis.1.15\">Gn 1:15</a>, <a data-ref=\"Genesis 1:17\" href=\"/Genesis.1.17\">17</a> (P), of moon <a data-ref=\"Isaiah 60:19\" href=\"/Isaiah.60.19\">Is 60:19</a>; of pillar of fire (sq. <span dir=\"rtl\">ל</span>) <a data-ref=\"Exodus 13:21\" href=\"/Exodus.13.21\">Ex 13:21</a>; <a data-ref=\"Exodus 14:20\" href=\"/Exodus.14.20\">14:20</a> (both JE) <a data-ref=\"Psalms 105:39\" href=\"/Psalms.105.39\">ψ 105:39</a> <a data-ref=\"Nehemiah 9:12\" href=\"/Nehemiah.9.12\">Ne 9:12</a>, <a data-ref=\"Nehemiah 9:19\" href=\"/Nehemiah.9.19\">19</a>; of sacred lamp <a data-ref=\"Exodus 25:37\" href=\"/Exodus.25.37\">Ex 25:37</a> <a data-ref=\"Numbers 8:2\" href=\"/Numbers.8.2\">Nu 8:2</a> (both P); fig. of the words of God <a data-ref=\"Psalms 119:130\" href=\"/Psalms.119.130\">ψ 119:130</a>."}], "num": "1."}, {"senses": [{"definition": "<em>lightup, cause to shine, shine</em>, sq. acc. <span dir=\"rtl\">הֵאִירוּ בְרָקִים תֵּבֵל</span> <em>lightnings lighted up the world</em> <a data-ref=\"Psalms 77:19\" href=\"/Psalms.77.19\">ψ 77:19</a>; <a data-ref=\"Psalms 97:4\" href=\"/Psalms.97.4\">97:4</a>; abs. <span dir=\"rtl\">הָאָרֶץ הֵאִירָה מִכְּבֹדוֹ</span> <a data-ref=\"Ezekiel 43:2\" href=\"/Ezekiel.43.2\">Ez 43:2</a>; <em>the earth shined with his glory</em> (of theophany); of leviathan, which makes path shine behind him <a data-ref=\"Job 41:24\" href=\"/Job.41.24\">Jb 41:24</a>; <span dir=\"rtl\">לַיְלָה כַּיּוֹם יָאִיר</span> <em>night shineth as day</em> <a data-ref=\"Psalms 139:12\" href=\"/Psalms.139.12\">ψ 139:12</a>."}], "num": "2."}, {"senses": [{"definition": "<em>light</em> a lamp <a data-ref=\"Psalms 18:29\" href=\"/Psalms.18.29\">ψ 18:29</a>; wood <a data-ref=\"Isaiah 27:11\" href=\"/Isaiah.27.11\">Is 27:11</a>; altar(-fire) <a data-ref=\"Malachi 1:10\" href=\"/Malachi.1.10\">Mal 1:10</a>."}], "num": "3."}, {"senses": [{"definition": "<em>lighten</em>, of the eyes, <span dir=\"rtl\">הָאִיר עֵינַיִם</span>, subj. <span dir=\"rtl\">י׳</span>, his law, etc. <a data-ref=\"Proverbs 29:13\" href=\"/Proverbs.29.13\">Pr 29:13</a> <a data-ref=\"Psalms 13:4\" href=\"/Psalms.13.4\">ψ 13:4</a>; <a data-ref=\"Psalms 19:9\" href=\"/Psalms.19.9\">19:9</a> <a data-ref=\"Ezra 9:8\" href=\"/Ezra.9.8\">Ezr 9:8</a>."}], "num": "4."}, {"senses": [{"definition": "<em>make shine</em>, of face of God <span dir=\"rtl\">יָאֵר י׳ פָּנָיו אֵלֶיךָ</span> <em>Yahweh make his face shine upon thee</em> <a data-ref=\"Numbers 6:25\" href=\"/Numbers.6.25\">Nu 6:25</a> (priest’s blessing), reappearing <a data-ref=\"Psalms 31:17\" href=\"/Psalms.31.17\">ψ 31:17</a> (sq. <span dir=\"rtl\">עַל־</span>), <a data-ref=\"Psalms 67:2\" href=\"/Psalms.67.2\">67:2</a> (sq. <span dir=\"rtl\">אֶת־</span>), <a data-ref=\"Psalms 80:4\" href=\"/Psalms.80.4\">80:4</a>, <a data-ref=\"Psalms 80:8\" href=\"/Psalms.80.8\">8</a>, <a data-ref=\"Psalms 80:20\" href=\"/Psalms.80.20\">20</a>; <a data-ref=\"Psalms 119:135\" href=\"/Psalms.119.135\">119:135</a> (sq. <span dir=\"rtl\">ב</span>), <a data-ref=\"Daniel 9:17\" href=\"/Daniel.9.17\">Dn 9:17</a> cf. <a data-ref=\"Psalms 4:7\" href=\"/Psalms.4.7\">ψ 4:7</a>; without <span dir=\"rtl\">פָּנִים</span> (sq. <span dir=\"rtl\">ל</span>) <a data-ref=\"Psalms 118:27\" href=\"/Psalms.118.27\">ψ 118:27</a>; once, of face of man, <a data-ref=\"Ecclesiastes 8:1\" href=\"/Ecclesiastes.8.1\">Ec 8:1</a> <span dir=\"rtl\">חָכַמַת אָדָם תָּאִיר פָּנָיו</span> <em>the wisdom of a man lighteth up his face</em>."}], "num": "5."}], "form": "Hiph."}]}, "rid": "BDB00261", "strong_numbers": ["215", "216"], "next_hw": "אוֹר²", "prev_hw": "אוּץ", "brackets": "first_word", "root": true, "occurrences": "43", "quotes": [], "GK": ["239", "240"], "TWOT": ["52", "52a"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אוֹר²", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<big><span dir=\"rtl\">אוֹר</span></big><sub>121</sub> <strong>f.</strong> <sup><a data-ref=\"Job 36:32\" href=\"/Job.36.32\">Jb 36:32</a></sup>; <a data-ref=\"Jeremiah 13:16\" href=\"/Jeremiah.13.16\">Je 13:16</a>; cf. <a data-ref=\"Genesis 1:3\" href=\"/Genesis.1.3\">Gn 1:3</a> <strong>light (</strong>Assyrian <em>urru</em> = <em>ûru</em> Dl<sup>W</sup><strong>)</strong>—abs. <a data-ref=\"Genesis 1:3\" href=\"/Genesis.1.3\">Gn 1:3</a> +; cstr. <a data-ref=\"Judges 16:2\" href=\"/Judges.16.2\">Ju 16:2</a> +; sf. <span dir=\"rtl\">אוֹרִי</span> <a data-ref=\"Psalms 27:1\" href=\"/Psalms.27.1\">ψ 27:1</a>, etc.; pl. <span dir=\"rtl\">אוֹרִים</span> <a data-ref=\"Psalms 136:7\" href=\"/Psalms.136.7\">ψ 136:7</a>;—<br/>"}, {"senses": [{"definition": "<em>light</em> as diffused in nature, light of day <a data-ref=\"Genesis 1:3\" href=\"/Genesis.1.3\">Gn 1:3</a>, <a data-ref=\"Genesis 1:4\" href=\"/Genesis.1.4\">4</a>, <a data-ref=\"Genesis 1:5\" href=\"/Genesis.1.5\">5</a> (P) <a data-ref=\"Job 3:9\" href=\"/Job.3.9\">Jb 3:9</a>; <a data-ref=\"Job 38:19\" href=\"/Job.38.19\">38:19</a> +.<br/>"}], "num": "1."}, {"senses": [{"definition": "<em>morning light, dawn</em>, <span dir=\"rtl\">אוֹר הַבֹּקֶר</span> light of the morn. <a data-ref=\"Judges 16:2\" href=\"/Judges.16.2\">Ju 16:2</a> <a data-ref=\"I Samuel 14:36\" href=\"/I_Samuel.14.36\">1 S 14:36</a>; <a data-ref=\"I Samuel 25:34\" href=\"/I_Samuel.25.34\">25:34</a>, <a data-ref=\"I Samuel 25:36\" href=\"/I_Samuel.25.36\">36</a> <a data-ref=\"II Samuel 17:22\" href=\"/II_Samuel.17.22\">2 S 17:22</a> <a data-ref=\"II Kings 7:9\" href=\"/II_Kings.7.9\">2 K 7:9</a> <a data-ref=\"Micah 2:1\" href=\"/Micah.2.1\">Mi 2:1</a>; <span dir=\"rtl\">א׳ בֹּקֶר</span> <a data-ref=\"II Samuel 23:4\" href=\"/II_Samuel.23.4\">2 S 23:4</a> (poem of David); <span dir=\"rtl\">עַד־הָא׳</span> <a data-ref=\"Judges 19:26\" href=\"/Judges.19.26\">Ju 19:26</a> (cf. <span dir=\"rtl\">עַד־הַבֹּקֶר</span> v <a data-ref=\"Judges 19:25\" href=\"/Judges.19.25\">25</a>); <span dir=\"rtl\">לָאוֹר</span> <a data-ref=\"Job 24:14\" href=\"/Job.24.14\">Jb 24:14</a>; <span dir=\"rtl\">מִן־הָאוֹר עַד מַחֲצִית הַיּוֹם</span> from <em>dawn till mid-day</em>, <a data-ref=\"Nehemiah 8:3\" href=\"/Nehemiah.8.3\">Ne 8:3</a> cf. <a data-ref=\"Proverbs 4:18\" href=\"/Proverbs.4.18\">Pr 4:18</a>.<br/>"}], "num": "2."}, {"senses": [{"definition": "<em>light</em> of the heavenly luminaries; <span dir=\"rtl\">א׳ הַלְּבָנָה</span>, ‖ <span dir=\"rtl\">א׳ הַחַמָּה</span> <em>moonlight</em> & <em>sunlight</em> <a data-ref=\"Isaiah 30:26\" href=\"/Isaiah.30.26\">Is 30:26</a>; <span dir=\"rtl\">כּוֹכְבֵי אוֹר</span> <em>stars of light</em> <a data-ref=\"Psalms 148:3\" href=\"/Psalms.148.3\">ψ 148:3</a>; <span dir=\"rtl\">מְאוֹרֵי אוֹר</span> <em>luminaries of light</em> <a data-ref=\"Ezekiel 32:8\" href=\"/Ezekiel.32.8\">Ez 32:8</a>; <span dir=\"rtl\">אוֹרִים</span> = <span dir=\"rtl\">מְאוֹרִים</span> <a data-ref=\"Psalms 136:7\" href=\"/Psalms.136.7\">ψ 136:7</a>; so <span dir=\"rtl\">עֲלֵי־אוֹר</span> <em>in sunshine</em> <a data-ref=\"Isaiah 18:4\" href=\"/Isaiah.18.4\">Is 18:4</a>; the sun itself <a data-ref=\"Job 31:26\" href=\"/Job.31.26\">Jb 31:26</a>.<br/>"}], "num": "3."}, {"senses": [{"definition": "<em>daylight</em> <span dir=\"rtl\">אוֹר רְשָׁעִים</span> <em>light of the wicked</em> <a data-ref=\"Job 38:15\" href=\"/Job.38.15\">Jb 38:15</a> (their work-day being the night); <span dir=\"rtl\">יוֹם אוֹר</span> <em>a day of light</em> <a data-ref=\"Amos 8:9\" href=\"/Amos.8.9\">Am 8:9</a> (= a clear, sunshiny day).<br/>"}], "num": "4."}, {"senses": [{"definition": "<em>lightning</em> <a data-ref=\"Job 36:32\" href=\"/Job.36.32\">Jb 36:32</a>; <a data-ref=\"Job 37:3\" href=\"/Job.37.3\">37:3</a>, <a data-ref=\"Job 37:11\" href=\"/Job.37.11\">11</a>, <a data-ref=\"Job 37:15\" href=\"/Job.37.15\">15</a> cf. <a data-ref=\"Habakkuk 3:11\" href=\"/Habakkuk.3.11\">Hb 3:11</a>.<br/>"}], "num": "5."}, {"senses": [{"definition": "<em>light</em> of lamp <a data-ref=\"Proverbs 13:9\" href=\"/Proverbs.13.9\">Pr 13:9</a> <a data-ref=\"Jeremiah 25:10\" href=\"/Jeremiah.25.10\">Je 25:10</a>; of crocodile’s hot breath <a data-ref=\"Job 41:10\" href=\"/Job.41.10\">Jb 41:10</a>.<br/>"}], "num": "6."}, {"senses": [{"definition": "<em>light of life</em> <span dir=\"rtl\">א׳ חַיִּים</span> <a data-ref=\"Job 33:30\" href=\"/Job.33.30\">Jb 33:30</a> <a data-ref=\"Psalms 56:14\" href=\"/Psalms.56.14\">ψ 56:14</a>; cf. <a ,=\"\" data-ref=\"BDB, אוֹר²\" dir=\"rtl\" href=\"/BDB,_אוֹר²\">אוֹר</a> <a data-ref=\"Job 3:16\" href=\"/Job.3.16\">Jb 3:16</a>, <a data-ref=\"Job 3:20\" href=\"/Job.3.20\">20</a>.<br/>"}], "num": "7."}, {"senses": [{"definition": "<em>light of prosperity</em> <a data-ref=\"Job 22:28\" href=\"/Job.22.28\">Jb 22:28</a>; <a data-ref=\"Job 30:26\" href=\"/Job.30.26\">30:26</a> <a data-ref=\"Psalms 97:11\" href=\"/Psalms.97.11\">ψ 97:11</a> <a data-ref=\"Lamentations 3:2\" href=\"/Lamentations.3.2\">La 3:2</a>.<br/>"}], "num": "8."}, {"senses": [{"definition": "<em>light of instruction</em> <span dir=\"rtl\">נֵר מִצְוָה וְתוֹרָה אוֹר</span> <a data-ref=\"Proverbs 6:23\" href=\"/Proverbs.6.23\">Pr 6:23</a> <em>the commandment</em> is <em>a lamp and instruction a light;</em> so the Messian. servant is <span dir=\"rtl\">אוֹר גּוֹיִם</span> <a data-ref=\"Isaiah 42:6\" href=\"/Isaiah.42.6\">Is 42:6</a>; <a data-ref=\"Isaiah 49:6\" href=\"/Isaiah.49.6\">49:6</a>; cf. <span dir=\"rtl\">א׳ עַמִּים</span> <a data-ref=\"Isaiah 51:4\" href=\"/Isaiah.51.4\">Is 51:4</a>; the advent of Mess. is shining of great light <a data-ref=\"Isaiah 9:1\" href=\"/Isaiah.9.1\">Is 9:1</a><sup>(×2)</sup>."}], "num": "9."}, {"senses": [{"definition": "<em>light</em> of face <span dir=\"rtl\">אוֹר פָּנִים</span> = bright, cheerful face (of men) <a data-ref=\"Job 29:24\" href=\"/Job.29.24\">Jb 29:24</a>; betokening king’s favour <a data-ref=\"Proverbs 16:15\" href=\"/Proverbs.16.15\">Pr 16:15</a> (cf. <a data-ref=\"BDB, עֵינַ֫יִם\" href=\"/BDB,_עֵינַ֫יִם\", dir=\"rtl\">א׳ עֵינַיִם</a> <a data-ref=\"Psalms 38:11\" href=\"/Psalms.38.11\">ψ 38:11</a>); of God = his shining, enlightening, favouring face <a data-ref=\"Psalms 4:7\" href=\"/Psalms.4.7\">ψ 4:7</a>; <a data-ref=\"Psalms 44:4\" href=\"/Psalms.44.4\">44:4</a>; <a data-ref=\"Psalms 89:16\" href=\"/Psalms.89.16\">89:16</a>."}], "num": "10."}, {"senses": [{"definition": "Yahweh is <span dir=\"rtl\">א׳ יִשְׂרָאֵל</span> <a data-ref=\"Isaiah 10:17\" href=\"/Isaiah.10.17\">Is 10:17</a>, as source of enlightenment & prosperity; light & salvation <a data-ref=\"Psalms 27:1\" href=\"/Psalms.27.1\">ψ 27:1</a>; light to guide <a data-ref=\"Micah 7:8\" href=\"/Micah.7.8\">Mi 7:8</a> cf. <a data-ref=\"Psalms 43:3\" href=\"/Psalms.43.3\">ψ 43:3</a>; everlasting light of Zion, instead of sun & moon <a data-ref=\"Isaiah 60:19\" href=\"/Isaiah.60.19\">Is 60:19</a>, <a data-ref=\"Isaiah 60:20\" href=\"/Isaiah.60.20\">20</a>; house of Jacob is to walk in his light <a data-ref=\"Isaiah 2:5\" href=\"/Isaiah.2.5\">Is 2:5</a>."}], "num": "11."}]}, "rid": "BDB00262", "strong_numbers": ["215", "216"], "next_hw": "אוֹרָה", "prev_hw": "אוֹר", "occurrences": "121", "quotes": [], "GK": ["239", "240"], "TWOT": ["52", "52a"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}]