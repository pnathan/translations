[{"headword": "שֹׁר", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "navel string, navel (in the Bible occurring <a class=\"refLink\" href=\"/Ezekiel.16.4\" data-ref=\"Ezekiel 16:4\">Ezek. 16:4</a> in the form <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_שׂרך ᴵ.1\" data-ref=\"Klein Dictionary, שׂרך ᴵ 1\">שָׁרֵּךְ</a> and <a class=\"refLink\" href=\"/Proverbs.3.8\" data-ref=\"Proverbs 3:8\">Pr. 3:8</a> in the form <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_שׂרך ᴵ.1\" data-ref=\"Klein Dictionary, שׂרך ᴵ 1\">שָׁרֶּֽךְ</a>)."}]}, "rid": "U01822", "refs": ["Klein Dictionary, שׂרך ᴵ 1", "Klein Dictionary, שׂרך ᴵ 1", "Klein Dictionary, שׂרך ᴵ 1", "Klein Dictionary, שׂרך ᴵ 1", "Klein Dictionary, שׁרר 1", "Klein Dictionary, שׁוּרָא 1", "Klein Dictionary, שׁוּרָא 1", "Klein Dictionary, שֹֽׁרֶר 1", "Klein Dictionary, שׁרר 1", "Klein Dictionary, שׁוּרָא 1", "Klein Dictionary, שׁוּרָא 1", "Klein Dictionary, שֹֽׁרֶר 1"], "prev_hw": "שָׁר", "next_hw": "שֵׁר", "notes": "[Prob. derived from base <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_שׁרר.1\" data-ref=\"Klein Dictionary, שׁרר 1\">שׁרר</a> (= to be strong). Related to Aram. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_שׁוּרָא.1\" data-ref=\"Klein Dictionary, שׁוּרָא 1\">שׁוּרָא</a>, Syr. <span dir=\"rtl\">שֶׁרָא</span>, Mand. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_שׁוּרָא.1\" data-ref=\"Klein Dictionary, שׁוּרָא 1\">שׁורא</a>, Arab. <i>surr</i> (of s.m.). cp. the collateral form <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_שֹֽׁרֶר.1\" data-ref=\"Klein Dictionary, שֹֽׁרֶר 1\">שֹׁרֶר</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "שֹׁר", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>ש\"ז, כנ' שָׁרֶּךָ, שָׁרֶּךְ, — טבור, חבל הטבור, Nabel(schnur); nombril, cordon ombilical; navel (-string): ומולדותיך ביום הולדת אותך לא כרת שָׁרֶּךְ ובמים לא רחצת למשעי וכו' (<span class=\"by-source\">יחזקאל יו ד</span>). — ובמשמ' בשר וגוף ובכלל<sup class=\"footnote-marker\">3</sup><i class=\"footnote\">[משמ' זו היא הנדרשת כאן, כדעת רבים, שלפיה כנראה מוטב לנקד לְשֵׁרֶךָ, ז\"א לשארך, לבשרך, ועי' בערך <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_שֵׁר_II.1\" data-ref=\"Ben Yehuda Dictionary, שֵׁר II 1\">ב. שֵׁר</a>. ותמה על הנקוד המסרתי, כי הוראת טבור של המלה יוצאת ברורה כל צרכה מן הכתוב ב(<span class=\"by-source\">יחזקאל יו ד</span>).  אמנם ביתר הלשונות השמיות אין עדות לשמוש השרש שר(ר) במשמ' טבור.]                               .</i>: רפאות תהי לשָׁרֶּךָ ושקוי לעצמותיך  (<span class=\"by-source\">משלי ג ח</span>). — ובתו\"מ: כיון שהיתה אחת מהן יולדת ביום היתה אומרת לבנה לך והבא לי צור ואני חותכת את <strong>שורך</strong> (<span class=\"by-source\">מד\"ר ויקר' ה</span>). ועי' <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_שֹׁרֶר.1\" data-ref=\"Ben Yehuda Dictionary, שֹׁרֶר 1\">שֹׁרֶר</a>.</p>"]}, "rid": "BY-20861", "prev_hw": "שֵׁר II", "next_hw": "שרב I", "page_num": 7455, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]