[{"headword": "אֲגַר III", "parent_lexicon": "Jastrow Dictionary", "rid": "A00339", "refs": ["Jastrow, אֲגַר II 1", "Bava Metzia 63b:10", "Bava Metzia 68b:15", "Bava Metzia 69b:12", "Berakhot 6b:11", "Jerusalem Talmud Moed Katan 2:3:2", "Jerusalem Talmud Bava Metzia 2:5:3"], "content": {"senses": [{"definition": " (<a class=\"refLink\" href=\"/Jastrow,_אֲגַר II.1\" data-ref=\"Jastrow, אֲגַר II 1\">foreg.</a>) <i>rent, wages; reward, profit</i>. <a class=\"refLink\" href=\"/Onkelos_Genesis.15.1\" data-ref=\"Onkelos Genesis 15:1\">Targ. Gen. XV, 1</a>; a. fr.—<a class=\"refLink\" href=\"/Bava_Metzia.63b.10\" data-ref=\"Bava Metzia 63b:10\">B. Mets. 63ᵇ</a> <span dir=\"rtl\">א׳ נטר ליה</span> compensation for waiting (giving time for delivery), i.e. advancing the money to the seller. <a class=\"refLink\" href=\"/Bava_Metzia.68b.15\" data-ref=\"Bava Metzia 68b:15\">Ib. 68ᵇ</a> <span dir=\"rtl\">פלגא בא׳ כ׳</span> half profit or loss. <a class=\"refLink\" href=\"/Bava_Metzia.69b.12\" data-ref=\"Bava Metzia 69b:12\">Ib. 69ᵇ</a> <span dir=\"rtl\">א׳ ופגרא</span> payment for carrying freight, and indemnity to the boatsmen in case of wreck. <a class=\"refLink\" href=\"Jerusalem_Talmud_Moed_Katan.2.3.2\" data-ref=\"Jerusalem Talmud Moed Katan 2:3:2\">Y. M. Kat. II, 81ᵇ</a> top <span dir=\"rtl\">א׳ וקרנא</span> profit and principal (cost-price).—<a class=\"refLink\" href=\"Jerusalem_Talmud_Bava_Metzia.2.5.3\" data-ref=\"Jerusalem Talmud Bava Metzia 2:5:3\">Y. B. Mets. II, 8ᶜ</a> top <span dir=\"rtl\">מא׳ כל הדין עלמא</span> than all profit this world can offer.—2) <i>that which deserves reward, meritorious deed.</i> <a class=\"refLink\" href=\"/Berakhot.6b.11\" data-ref=\"Berakhot 6b:11\">Ber. 6ᵇ</a> <span dir=\"rtl\">א׳ דפירקא ריהטא</span> the merit in attending a lecture lies in running [to it] (anxiety to hear it). [<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אֲגַר I.1\" data-ref=\"Jastrow, אֲגַר I 1\">אֲגַר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אֲגַר III.1\" data-ref=\"Jastrow, אֲגַר III 1\">אַגְרָא</a> <i>staff, pole</i>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אֵגֶד.1\" data-ref=\"Jastrow, אֵגֶד 1\">אגד</a>.]"}], "morphology": "m."}, "plural_form": [], "alt_headwords": ["אַגְרָא I"], "quotes": [], "prev_hw": "אֲגַר II", "next_hw": "אִגָר", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אַגְרָא II", "parent_lexicon": "Jastrow Dictionary", "rid": "A00341", "refs": ["Chullin 104b:11", "Chullin 104b:12", "Chullin 134a:12", "Niddah 53a:2", "Niddah 53a:13", "Niddah 53a:28", "Niddah 53a:31", "Niddah 53a:37", "Niddah 53a:39", "Niddah 53a:41", "Niddah 53a:42", "Niddah 53a:44"], "content": {"senses": [{"definition": "<i>Agra</i>, father-in-law of R. Abba; father of R. Y’hudah. <a class=\"refLink\" href=\"/Chullin.104b.12\" data-ref=\"Chullin 104b:12\">Ḥull. 104ᵇ</a>; <a class=\"refLink\" href=\"/Chullin.134a.12\" data-ref=\"Chullin 134a:12\">134ᵃ</a>. <a class=\"refLink\" href=\"/Niddah.53a.44\" data-ref=\"Niddah 53a:44\">Nidd. 53ᵃ</a>"}], "morphology": "pr. n. m."}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "אִגָר", "next_hw": "אגרדים", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אַגְרָא", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "pay, reward (occurring in phrases quoted from the Talmud and the Midrash, as in <span dir=\"rtl\">לְפוּם צַעֲרָא אַגְרָא</span>, ‘according to the pains is the reward’)."}]}, "rid": "A00231", "language_code": "PBH", "refs": ["Klein Dictionary, אֲגוֹרָה 1", "Klein Dictionary, אגר 1", "Klein Dictionary, אֲגוֹרָה 1", "Klein Dictionary, אַגְרָה 1", "Klein Dictionary, אגר 1", "Klein Dictionary, אֲגוֹרָה 1", "Klein Dictionary, אֲגוֹרָה 1", "Klein Dictionary, אַגְרָה 1"], "prev_hw": "אִגָּרָא", "next_hw": "אַגְרֶגָט", "notes": "[Aram., from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_אגר.1\" data-ref=\"Klein Dictionary, אגר 1\">אֲגַר</a> (= he hired), which is a loan word from Akka. <i>agāru</i> (= to hire). See <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_אֲגוֹרָה.1\" data-ref=\"Klein Dictionary, אֲגוֹרָה 1\">אֲגוֹרָה</a> and cp. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_אַגְרָה.1\" data-ref=\"Klein Dictionary, אַגְרָה 1\">אַגְרָה</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}]