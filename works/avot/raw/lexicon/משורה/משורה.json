[{"headword": "מְשׂוּרָה", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-f", "senses": [{"definition": "measure"}]}, "strong_number": "4884", "transliteration": "mᵉsûwrâh", "pronunciation": "mes-oo-raw'", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "מְשׂוּרָה", "parent_lexicon": "Jastrow Dictionary", "rid": "M02841", "refs": ["Pirkei Avot 6:4", "Bava Metzia 61b:5", "Bava Batra 89b:9"], "content": {"senses": [{"definition": " (b. h.) <i>m’surah</i>, a measure of capacity, one thirty-sixth of a Log. <a class=\"refLink\" href=\"/Pirkei_Avot.6.4\" data-ref=\"Pirkei Avot 6:4\">Ab. ch. VI</a> (adopted fr. <a class=\"refLink\" href=\"/Ezekiel.5.11\" data-ref=\"Ezekiel 5:11\">Ez. V, 11</a>). <a class=\"refLink\" href=\"/Bava_Metzia.61b.5\" data-ref=\"Bava Metzia 61b:5\">B. Mets. 61ᵇ</a>; <a class=\"refLink\" href=\"/Bava_Batra.89b.9\" data-ref=\"Bava Batra 89b:9\">B. Bath. 89ᵇ</a>.—Sifra K’dosh. Par. 3, ch. VIII במ׳ זו זיר הגדול ‘in measure’ (<a class=\"refLink\" href=\"/Leviticus.19.35\" data-ref=\"Leviticus 19:35\">Lev. XIX, 35</a>) that means you must leave a large crest (in dry measure), v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_זֵיר.1\" data-ref=\"Jastrow, זֵיר 1\">זֵיר</a>."}], "morphology": "f."}, "plural_form": [], "alt_headwords": [], "quotes": [[null, "במְשׂוּרָה זו זיר הגדול", "‘in measure’ (<a class=\"refLink\" href=\"/Leviticus"]], "prev_hw": "מְשׁוּקָּע", "next_hw": "מְשֹׁורְיָא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מְשׂוּרָה", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"definition": "a liquid measure.", "number": "1"}, {"definition": "measuring vessel, tube (under the influence of L. <i>mēnsūra</i>, ‘measure’).", "number": "2"}]}, "rid": "M04325", "refs": [], "prev_hw": "מַשּׂוֹר", "next_hw": "מְשׁוּרָה", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מְשׂוּרָה", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.f. measure</strong>, of water, <a data-ref=\"Ezekiel 4:11\" href=\"/Ezekiel.4.11\">Ez 4:11</a>, <a data-ref=\"Ezekiel 4:16\" href=\"/Ezekiel.4.16\">16</a> (‖ <span dir=\"rtl\">מִשְׁקָל</span>); capacity in gen., <a data-ref=\"Leviticus 19:35\" href=\"/Leviticus.19.35\">Lv 19:35</a> (+ <span dir=\"rtl\">מִדָּה</span>, <span dir=\"rtl\">מִשְׁקָל</span>), <a data-ref=\"I Chronicles 23:29\" href=\"/I_Chronicles.23.29\">1 Ch 23:29</a> <strong>(</strong>deriv. dub.<strong>)</strong>"}]}, "rid": "BDB05873", "strong_numbers": ["4884"], "next_hw": "מָשׂוֹשׂ", "prev_hw": "מַשּׂוֹר", "all_cited": true, "quotes": [], "GK": ["5374"], "TWOT": ["1250"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מְשׂוּרָה", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p><sup class=\"footnote-marker\">3</sup><i class=\"footnote\">עי' <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_שׂור_I.1\" data-ref=\"Ben Yehuda Dictionary, שׂור I 1\">שׂור</a>.</i>, ש\"נ, — מדת הלח, אחד מששה ושלשים בלוג, Flüssigkeitsmass; mesure de capacité; liquid measure:  לא תעשו עול במשפט במדה במשקל וּבַמְּשׂוּרָה <span class=\"by-source\">(ויקר' יט לה)</span>.  ומאכלך אשר תאכלנו במשקול עשרים שקל ליום וכו' ומים בִּמְשׂוּרָה תשתה ששית ההין מעת עד עת תשתה <span class=\"by-source\">(יחזק' ד יא)</span> ולכל מְשׂוּרָה ומדה <span class=\"by-source\">(דהי\"א כג כט)</span>. — ובתלמ':  כך היא דרכה של תורה פת במלח תאכל ומים <strong>במשורה </strong>תשתה ועל הארץ תישן וחיי צער תחיה ובתורה אתה עמל <span class=\"by-source\">(אבות ו ד)</span>.  ק\"ו ומה <strong>משורה </strong>שהיא אחד משלשים וששה בלוג הקפידה עליו תורה ק\"ו להין וכו' <span class=\"by-source\">(ב\"ב פט:)</span>. — ובסהמ\"א:  צמאי רוֵה ואל אשת <strong>במשורה </strong><span class=\"by-source\">(סדור תימנ' ליוה\"כ, כ\"י, אפסו בעוני)</span>.  איש טעם יאכל במדה וישתה <strong>במשורה </strong>ישכב ושנתו ערבה עליו <span class=\"by-source\">(בן זאב, תרג' ב\"ס לא כה)</span>.</p>"]}, "rid": "BY-11738", "prev_hw": "מָשׂוּר", "next_hw": "מַשּׂוֹרִי", "page_num": 3429, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]