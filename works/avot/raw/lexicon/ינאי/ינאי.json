[{"headword": "יַנַּאי", "parent_lexicon": "Jastrow Dictionary", "rid": "J00426", "refs": ["Kiddushin 66a:9", "Kiddushin 66a:10", "Kiddushin 66a:11", "Berakhot 29a:7", "Sanhedrin 19a:17", "Berakhot 44a", "Berakhot 48a:6", "Vayikra Rabbah 9:3", "Vayikra Rabbah 9:6", "Sotah 22b:6", "Megillah 32a:16", "Vayikra Rabbah 16:2", "Jerusalem Talmud Berakhot 3:1:15"], "content": {"senses": [{"definition": " (abbrev. of <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_יוֹחָנָן.1\" data-ref=\"Jastrow, יוֹחָנָן 1\">יוֹחָנָן</a>) <i>Yannai</i> (<i>Jannaeus</i>), "}, {"definition": " King of Judaea. <a class=\"refLink\" href=\"/Kiddushin.66a.11\" data-ref=\"Kiddushin 66a:11\">Kidd. 66ᵃ</a> <span dir=\"rtl\">י׳ המלך</span> (for <i>John Hyrcan</i>). <a class=\"refLink\" href=\"/Berakhot.29a.7\" data-ref=\"Berakhot 29a:7\">Ber. 29ᵃ</a> הוא י׳ הוא יוחנן Y. a. Joḥanan are the same; (another opin.) <span dir=\"rtl\">י׳ לחוד וכ׳</span> Y. a. Joḥ. are different persons.—<a class=\"refLink\" href=\"/Sanhedrin.19a.17\" data-ref=\"Sanhedrin 19a:17\">Snh. 19ᵃ</a> <span dir=\"rtl\">י׳ מלכא</span>, <span dir=\"rtl\">י׳ המלך</span> (ref. to Hyrcan II).—<a class=\"refLink\" href=\"/Berakhot.44a\" data-ref=\"Berakhot 44a\">Ber. 44ᵃ</a>. <a class=\"refLink\" href=\"/Berakhot.48a.6\" data-ref=\"Berakhot 48a:6\">Ib. 48ᵃ</a>; <a class=\"refLink\" href=\"/Vayikra_Rabbah.9.6\" data-ref=\"Vayikra Rabbah 9:6\">Lev. R. s. 9</a> (Alexander Jannaeus). <a class=\"refLink\" href=\"/Sotah.22b.6\" data-ref=\"Sotah 22b:6\">Sot. 22ᵇ</a> (Alex. J.); a. e.", "number": "1)"}, {"definition": " name of several Amoraim. <a class=\"refLink\" href=\"/Megillah.32a.16\" data-ref=\"Megillah 32a:16\">Meg. 32ᵃ</a>.—<a class=\"refLink\" href=\"Jerusalem_Talmud_Berakhot.3.1.15\" data-ref=\"Jerusalem Talmud Berakhot 3:1:15\">Y. Ber. III, 6ᵃ</a>.—<a class=\"refLink\" href=\"/Vayikra_Rabbah.16.2\" data-ref=\"Vayikra Rabbah 16:2\">Lev. R. s. 16</a>; a. fr.", "number": "—2)"}], "morphology": "pr. n. m."}, "plural_form": [], "alt_head