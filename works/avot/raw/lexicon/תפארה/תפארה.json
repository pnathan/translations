[{"headword": "תִּפְאָרָה", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-f", "senses": [{"definition": "beauty,  splendour, glory", "senses": [{"definition": "beauty,  finery (of garments,  jewels)"}, {"definition": "glory", "senses": [{"definition": "of rank,  renown"}, {"definition": "as attribute of God"}]}, {"definition": "honour (or nation Israel)"}, {"definition": "glorying,  boasting (of individual)"}]}]}, "strong_number": "8597", "transliteration": "tiphʼârâh", "pronunciation": "tif-aw-raw'", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "תִּפְאָרָה", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"definition": "beauty, finery, splendor.", "number": "1"}, {"definition": "glory.", "number": "2"}, {"definition": "(in the Kabbalah) one of the ten ‘sephiroth’.", "number": "3", "language_code": "NH"}]}, "rid": "V01014", "refs": ["Klein Dictionary, פאר ᴵ 1", "Klein Dictionary, תַּ◌ 1", "Klein Dictionary, פאר ᴵ 1", "Klein Dictionary, תַּ◌ 1"], "alt_headwords": ["תִּפְאֶֽרֶת"], "prev_hw": "תפאר", "next_hw": "תְּפוּגָה", "notes": "[From <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_פאר ᴵ.1\" data-ref=\"Klein Dictionary, פאר ᴵ 1\">פאר ᴵ</a> (= to adorn). Verbal n. of the form ‘taqtalat’, belonging to the Qal. See pref. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_תַּ◌.1\" data-ref=\"Klein Dictionary, תַּ◌ 1\">תַּ◌</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "תִּפְאָרָה", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.f. beauty, glory</strong>;—<span dir=\"rtl\">תּ׳</span> <a data-ref=\"Isaiah 28:5\" href=\"/Isaiah.28.5\">Is 28:5</a> <a data-ref=\"Jeremiah 48:17\" href=\"/Jeremiah.48.17\">Je 48:17</a>; elsewhere abs. and cstr. <span dir=\"rtl\">תִּפְאֶרֶת</span> <a data-ref=\"Isaiah 3:18\" href=\"/Isaiah.3.18\">Is 3:18</a> + 20 times; <span dir=\"rtl\">תִּפְאָ֑רֶת</span> <a data-ref=\"Proverbs 28:12\" href=\"/Proverbs.28.12\">Pr 28:12</a> + 6 times; sf. <span dir=\"rtl\">תִּפְאַרְתִּי</span> <a data-ref=\"Isaiah 46:13\" href=\"/Isaiah.46.13\">Is 46:13</a> + 20 times sf.;—"}, {"senses": [{"definition": "<em>beauty, finery</em> <a data-ref=\"Isaiah 3:18\" href=\"/Isaiah.3.18\">Is 3:18</a>; of garments <a data-ref=\"Isaiah 52:1\" href=\"/Isaiah.52.1\">52:1</a>; jewels <a data-ref=\"Ezekiel 16:17\" href=\"/Ezekiel.16.17\">Ez 16:17</a>, <a data-ref=\"Ezekiel 16:39\" href=\"/Ezekiel.16.39\">39</a>; <a data-ref=\"Ezekiel 23:26\" href=\"/Ezekiel.23.26\">23:26</a>, cf. <a data-ref=\"II Chronicles 3:6\" href=\"/II_Chronicles.3.6\">2 Ch 3:6</a>; flock <a data-ref=\"Jeremiah 13:20\" href=\"/Jeremiah.13.20\">Je 13:20</a>; a man <a data-ref=\"Isaiah 44:13\" href=\"/Isaiah.44.13\">Is 44:13</a>; city of Samaria <a data-ref=\"Isaiah 28:1\" href=\"/Isaiah.28.1\">28:1</a>, <a data-ref=\"Isaiah 28:4\" href=\"/Isaiah.28.4\">4</a>; diadem v <a data-ref=\"Isaiah 28:5\" href=\"/Isaiah.28.5\">5</a>."}], "num": "1."}, {"senses": [{"definition": "<em>glory:</em>"}, {"senses": [{"definition": "of rank: apparel of h. p. <a data-ref=\"Exodus 28:2\" href=\"/Exodus.28.2\">Ex 28:2</a>, <a data-ref=\"Exodus 28:40\" href=\"/Exodus.28.40\">40</a> (P); <span dir=\"rtl\">עֲטֶרֶת ת׳</span> <em>crown of glory</em> <a data-ref=\"Proverbs 4:9\" href=\"/Proverbs.4.9\">Pr 4:9</a>; <a data-ref=\"Proverbs 16:31\" href=\"/Proverbs.16.31\">16:31</a> <a data-ref=\"Isaiah 62:3\" href=\"/Isaiah.62.3\">Is 62:3</a> <a data-ref=\"Jeremiah 13:18\" href=\"/Jeremiah.13.18\">Je 13:18</a> <a data-ref=\"Ezekiel 16:12\" href=\"/Ezekiel.16.12\">Ez 16:12</a>; <a data-ref=\"Ezekiel 23:42\" href=\"/Ezekiel.23.42\">23:42</a>; greatness of monarch <a data-ref=\"Esther 1:4\" href=\"/Esther.1.4\">Est 1:4</a>; house of David and inhabitants of Jerus. <a data-ref=\"Zechariah 12:7\" href=\"/Zechariah.12.7\">Zc 12:7</a><sup>(×2)</sup>."}], "num": "a."}, {"senses": [{"definition": "of renown <span dir=\"rtl\">לְשֵׁם ולת׳</span> <a data-ref=\"Deuteronomy 26:19\" href=\"/Deuteronomy.26.19\">Dt 26:19</a> <a data-ref=\"I Chronicles 22:5\" href=\"/I_Chronicles.22.5\">1 Ch 22:5</a> <a data-ref=\"Jeremiah 13:11\" href=\"/Jeremiah.13.11\">Je 13:11</a>; <a data-ref=\"Jeremiah 33:9\" href=\"/Jeremiah.33.9\">33:9</a>."}], "num": "b."}, {"senses": [{"definition": "attribute of <span dir=\"rtl\">י׳</span> <a data-ref=\"Psalms 71:8\" href=\"/Psalms.71.8\">ψ 71:8</a> <a data-ref=\"I Chronicles 29:11\" href=\"/I_Chronicles.29.11\">1 Ch 29:11</a>; <span dir=\"rtl\">שֵׁם ת׳</span> <a data-ref=\"Isaiah 63:14\" href=\"/Isaiah.63.14\">Is 63:14</a> <a data-ref=\"I Chronicles 29:13\" href=\"/I_Chronicles.29.13\">1 Ch 29:13</a>; <span dir=\"rtl\">ת׳ עֹז</span> <a data-ref=\"Psalms 89:18\" href=\"/Psalms.89.18\">ψ 89:18</a>; <span dir=\"rtl\">זְרוֹעַ ת׳</span> <a data-ref=\"Isaiah 63:12\" href=\"/Isaiah.63.12\">Is 63:12</a>; hence <span dir=\"rtl\">ת׳</span> in <span dir=\"rtl\">י׳</span>’s sanctuary <a data-ref=\"Psalms 96:6\" href=\"/Psalms.96.6\">ψ 96:6</a>, <span dir=\"rtl\">בֵּית תִּפְאַרְתִּי</span> <a data-ref=\"Isaiah 60:7\" href=\"/Isaiah.60.7\">Is 60:7</a> cf. <a data-ref=\"Isaiah 63:15\" href=\"/Isaiah.63.15\">63:15</a> (of heavenly temple), <a data-ref=\"Isaiah 64:10\" href=\"/Isaiah.64.10\">64:10</a>; <span dir=\"rtl\">ת׳</span> as <span dir=\"rtl\">י׳</span>’s gift to Isr. <a data-ref=\"Isaiah 46:13\" href=\"/Isaiah.46.13\">46:13</a> cf. <a data-ref=\"Isaiah 60:19\" href=\"/Isaiah.60.19\">60:19</a> (also <a data-ref=\"Psalms 89:18\" href=\"/Psalms.89.18\">ψ 89:18</a> supr.); of future fruit of land <a data-ref=\"Isaiah 4:2\" href=\"/Isaiah.4.2\">4:2</a>; design. of ark of <span dir=\"rtl\">י׳</span> <a data-ref=\"Psalms 78:61\" href=\"/Psalms.78.61\">ψ 78:61</a>."}], "num": "c."}], "num": "2."}, {"senses": [{"senses": [{"definition": "<em>honour</em> of nation Isr. <a data-ref=\"Lamentations 2:1\" href=\"/Lamentations.2.1\">La 2:1</a>."}], "num": "a."}, {"senses": [{"definition": "<em>glorying, boasting</em>, of individ., <a data-ref=\"Isaiah 20:5\" href=\"/Isaiah.20.5\">Is 20:5</a> <a data-ref=\"Proverbs 17:6\" href=\"/Proverbs.17.6\">Pr 17:6</a>; <a data-ref=\"Proverbs 19:11\" href=\"/Proverbs.19.11\">19:11</a>; <a data-ref=\"Proverbs 20:29\" href=\"/Proverbs.20.29\">20:29</a>; <a data-ref=\"Proverbs 28:12\" href=\"/Proverbs.28.12\">28:12</a>; warrior <a data-ref=\"Judges 4:9\" href=\"/Judges.4.9\">Ju 4:9</a>; monarchs <a data-ref=\"Isaiah 10:12\" href=\"/Isaiah.10.12\">Is 10:12</a>; nations <a data-ref=\"Isaiah 13:19\" href=\"/Isaiah.13.19\">Is 13:19</a> <a data-ref=\"Ezekiel 24:25\" href=\"/Ezekiel.24.25\">Ez 24:25</a>, <span dir=\"rtl\">מַקֵּל ת׳</span> <em>rod</em> (<em>sceptre</em>) <em>of glorying</em> <a data-ref=\"Jeremiah 48:17\" href=\"/Jeremiah.48.17\">Je 48:17</a> (others <strong>1</strong>)."}], "num": "b."}], "num": "3."}]}, "rid": "BDB07769", "strong_numbers": ["8597"], "next_hw": "פאר", "prev_hw": "פְּאֵר", "all_cited": true, "quotes": [], "GK": ["9514"], "TWOT": ["1726b"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "תִּפְאָרָה²", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "v. <a data-ref=\"BDB, פָּאַר\" href=\"/BDB,_פָּאַר\", dir=\"rtl\">I.</a> [<a data-ref=\"BDB, פָּאַר\" href=\"/BDB,_פָּאַר\", dir=\"rtl\">פאר</a>]."}]}, "rid": "BDB10941", "strong_numbers": ["8597"], "next_hw": "תַּפּוּחַ²", "prev_hw": "תֹּף", "quotes": [], "GK": ["9514"], "TWOT": ["1726b"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "תִּפְאָרָה", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>ש\"נ, —  כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_תִּפְאֶרֶת.1\" data-ref=\"Ben Yehuda Dictionary, תִּפְאֶרֶת 1\">תפארת</a>, יפי הדר: ביום ההוא יהיה יי' צבאות לעטרת צבי ולצפירת תִּפְאָרָה לשאר עמו <span class=\"by-source\">(ישע' כח ה)</span>. איכה נשבר מטה עז מקל תִּפְאָרָה <span class=\"by-source\">(ירמ' מח יז)</span>. — ואמר הפיטן: והוא היה והוא הוה והוא יהיה <strong>בתפארה </strong><span class=\"by-source\">(אדון עולם)</span>, עי' <span class=\"by-source\">דודזון, אוצר א, 29</span>. — ועי' <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_תִּפְאֶרֶת.1\" data-ref=\"Ben Yehuda Dictionary, תִּפְאֶרֶת 1\">תִּפְאֶרֶת</a>.</p>"]}, "rid": "BY-21991", "prev_hw": "תֹּף", "next_hw": "תִּפְאֶרֶת", "page_num": 7843, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]