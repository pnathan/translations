[{"headword": "שֵׁינָה", "parent_lexicon": "Jastrow Dictionary", "rid": "U00972", "language_code": "(b. h.;", "refs": ["Jastrow, יָשֵׁן I 1", "Berakhot 3b:21", "Berakhot 62b:1", "Megillah 15b:20", "Sukkah 26a:11", "Sukkah 26a:12", "Sukkah 26a:14", "Sukkah 26a:15", "Sukkah 26a:12", "Tamid 28a:9", "Sanhedrin 93b:10", "Kiddushin 49b:10"], "language_reference": " <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_יָשֵׁן I.1\" data-ref=\"Jastrow, יָשֵׁן I 1\"><a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_יָשֵׁן I.1\" data-ref=\"Jastrow, יָשֵׁן I 1\">יָשֵׁן</a>)</a>", "content": {"senses": [{"definition": "<i>sleep</i>. <a class=\"refLink\" href=\"/Berakhot.3b.21\" data-ref=\"Berakhot 3b:21\">Ber. 3ᵇ</a> <span dir=\"rtl\">מעולם לא עבר … בש׳</span> midnight never found me asleep. <a class=\"refLink\" href=\"/Berakhot.62b.1\" data-ref=\"Berakhot 62b:1\">Ib. 62ᵇ</a> <span dir=\"rtl\">ש׳ בעמוד וכ׳</span> sleep at morning dawn (v. <a class=\"refLink\" href=\"/Jastrow,_*שֵׁינָא I.1\" data-ref=\"Jastrow, *שֵׁינָא I 1\"><span dir=\"rtl\">שֵׁינָא</span> I</a>). <a class=\"refLink\" href=\"/Megillah.15b.20\" data-ref=\"Megillah 15b:20\">Meg. 15ᵇ</a> <span dir=\"rtl\">שְׁנַת וכ׳</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נָדַד.1\" data-ref=\"Jastrow, נָדַד 1\">נָדַד</a>. <a class=\"refLink\" href=\"/Sukkah.26a.15\" data-ref=\"Sukkah 26a:15\">Succ. 26ᵃ</a> <span dir=\"rtl\">שֵׁינַת</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עַרְאַי.1\" data-ref=\"Jastrow, עַרְאַי 1\">עַרְאַי</a>. <a class=\"refLink\" href=\"/Sukkah.26a.12\" data-ref=\"Sukkah 26a:12\">Ib.</a> <span dir=\"rtl\">במוסר שֵׁינָתוֹ וכ׳</span> when he gives his sleep in charge of others (gives orders to wake him up). <a class=\"refLink\" href=\"/Mishnah_Yoma.1.4\" data-ref=\"Mishnah Yoma 1:4\">Yoma I, 4</a> <span dir=\"rtl\">המאכל מביא את הש׳</span> eating causes sleepiness. <a class=\"refLink\" href=\"/Tamid.28a.9\" data-ref=\"Tamid 28a:9\">Tam. 28ᵃ</a> <span dir=\"rtl\">אונס ש׳</span> being overcome by sleep. <a class=\"refLink\" href=\"/Sanhedrin.93b.10\" data-ref=\"Sanhedrin 93b:10\">Snh. 93ᵇ</a> <span dir=\"rtl\">שהיו אונסין … ומן הש׳</span> they forced themselves not to laugh, talk, or fall asleep. <a class=\"refLink\" href=\"/Kiddushin.49b.10\" data-ref=\"Kiddushin 49b:10\">Kidd. 49ᵇ</a> <span dir=\"rtl\">עשרה ש׳ וכ׳</span> ten measures of sleep have come down to the world, nine of which the slaves have taken &c.; a. fr."}], "morphology": "f."}, "plural_form": [], "alt_headwords": ["שֵׁנָה"], "quotes": [], "prev_hw": "שִׁינְדְּפִין", "next_hw": "שִׁינּוּי", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "שֵׁינָה", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>עי' <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_שֵׁנָה_I.1\" data-ref=\"Ben Yehuda Dictionary, שֵׁנָה I 1\">א. שֵׁנָה</a><sup class=\"footnote-marker\">2</sup><i class=\"footnote\">[עי' הערה בערך <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_ש.1\" data-ref=\"Ben Yehuda Dictionary, ש 1\">שׁ</a> ג.]</i>.</p>"]}, "rid": "BY-20103", "prev_hw": "שִׁין II", "next_hw": "שִׁיפָה I", "page_num": 7068, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]