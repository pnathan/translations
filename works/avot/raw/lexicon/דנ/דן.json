ph. <span dir=\"rtl\">דִּינָה מִתְעֲבֵד מִנֵּהּ</span> <a data-ref=\"Ezra 7:26\" href=\"/Ezra.7.26\">Ezr 7:26</a> <em>judgment be executed upon him;</em> <span dir=\"rtl\">דִּינָא</span> = <em>judges, court</em> <a data-ref=\"Daniel 7:10\" href=\"/Daniel.7.10\">Dn 7:10</a>, <a data-ref=\"Daniel 7:26\" href=\"/Daniel.7.26\">26</a> + perhaps v <a data-ref=\"Daniel 7:22\" href=\"/Daniel.7.22\">22</a> (reading <span dir=\"rtl\">וְד׳ יְהִב [יְתִב וְשָׁלְטָנָא]</span>, Ew Bev Kmp Dr); MT however = <em>judgment was given in favour of</em> (v. Dr)."}]}, "rid": "BDBA0206", "strong_numbers": ["1777", "1778", "1779", "1780"], "next_hw": "דַּיָּן", "prev_hw": "דִּין", "all_cited": true, "quotes": [], "GK": ["1878", "1906", "1907"], "TWOT": ["2674", "426", "426a"], "parent_lexicon_details": {"name": "BDB Aramaic Dictionary", "language": "ara.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB Aramaic", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}]