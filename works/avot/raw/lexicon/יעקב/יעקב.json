[{"headword": "יַעֲקֹב", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-pr-m", "senses": [{"definition": "Jacob = \"heel holder\" or \"supplanter\""}, {"definition": "son of Isaac,  grandson of Abraham,  and father of the 12 patriarchs of the tribes of Israel"}]}, "strong_number": "3290", "transliteration": "Yaʻăqôb", "pronunciation": "yah-ak-obe'", "language_code": "x-pn", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "יַעֲקֹב", "parent_lexicon": "Jastrow Dictionary", "rid": "J00496", "refs": ["Jastrow, טָפֵל 1", "Berakhot 13a:1", "Bereishit Rabbah 1:15", "Pesachim 84a:14", "Sanhedrin 63b:2", "Chullin 45b:10", "Chullin 45b:11", "Horayot 13b:14", "Yevamot 96b:17", "Pesikta Rabbati 22:1", "Avodah Zarah 17a", "Jerusalem Talmud Pesachim 10:1:3", "Jerusalem Talmud Bikkurim 3:3:18", "Jerusalem Talmud Berakhot 2:1:16", "Jerusalem Talmud Shekalim 2:5:4", "Jerusalem Talmud Moed Katan 3:7:18", "Jerusalem Talmud Berakhot 2:3:6"], "content": {"senses": [{"definition": " (b. h.) pr. n. m. <i>Jacob</i>, "}, {"definition": " J. the patriarch. <a class=\"refLink\" href=\"/Berakhot.13a.1\" data-ref=\"Berakhot 13a:1\">Ber. 13ᵃ</a> <span dir=\"rtl\">לא שיעקר י׳ וכ׳</span> not that the name Jacob should be entirely abandoned, but &c., v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_טָפֵל.1\" data-ref=\"Jastrow, טָפֵל 1\">טָפֵל</a>. <a class=\"refLink\" href=\"/Bereishit_Rabbah.1.15\" data-ref=\"Bereishit Rabbah 1:15\">Gen. R. s. 1</a>; a. v. fr.—2) R. J., name of a Tannai (or of several Tannaim, v. Fr. Darkhe Mish. p. 202). <a class=\"refLink\" href=\"/Pirkei_Avot.4.16\" data-ref=\"Pirkei Avot 4:16\">Ab. IV, 16</a>. <a class=\"refLink\" href=\"/Pesachim.84a.14\" data-ref=\"Pesachim 84a:14\">Pes. 84ᵃ</a>; <a class=\"refLink\" href=\"/Sanhedrin.63b.2\" data-ref=\"Sanhedrin 63b:2\">Snh. 63ᵇ</a>, a. e., v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_שֵׁם.1\" data-ref=\"Jastrow, שֵׁם 1\">שֵׁם</a>. <a class=\"refLink\" href=\"/Chullin.45b.11\" data-ref=\"Chullin 45b:11\">Ḥull. 45ᵇ</a>.—<a class=\"refLink\" href=\"/Horayot.13b.14\" data-ref=\"Horayot 13b:14\">Hor. 13ᵇ</a> <span dir=\"rtl\">ר׳ י׳ בן קרשי</span>; <a class=\"refLink\" href=\"Jerusalem_Talmud_Pesachim.10.1.3\" data-ref=\"Jerusalem Talmud Pesachim 10:1:3\">Y. Pes. X, beg. 37ᵇ</a> <span dir=\"rtl\">ר׳ י׳ בן קורשיי</span>.—3) R. J., name of many Amoraim, esp. a) R. J. of K’far Nibburaya. <a class=\"refLink\" href=\"Jerusalem_Talmud_Bikkurim.3.3.18\" data-ref=\"Jerusalem Talmud Bikkurim 3:3:18\">Y. Bicc. III, 65ᵈ</a> top, a. fr., v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נִבּוּרַיָּא.1\" data-ref=\"Jastrow, נִבּוּרַיָּא 1\">נִבּוּרַיָּא</a>.—b) R. J. b. Idi. <a class=\"refLink\" href=\"Jerusalem_Talmud_Berakhot.2.1.16\" data-ref=\"Jerusalem Talmud Berakhot 2:1:16\">Y. Ber. II, 4ᵇ</a>; <a class=\"refLink\" href=\"Jerusalem_Talmud_Shekalim.2.5.4\" data-ref=\"Jerusalem Talmud Shekalim 2:5:4\">Y. Shek. II, 47ᵃ</a> top; <a class=\"refLink\" href=\"Jerusalem_Talmud_Moed_Katan.3.7.18\" data-ref=\"Jerusalem Talmud Moed Katan 3:7:18\">Y. M. Kat. III, 83ᶜ</a> bot.; Midr. Sam. ch. XIX; <a class=\"refLink\" href=\"/Yevamot.96b.17\" data-ref=\"Yevamot 96b:17\">Yeb. 96ᵇ</a>; a. fr.—V. Fr. M’bo p. 104ᵃ, sq.—4) J. the bathing master (?). <a class=\"refLink\" href=\"Jerusalem_Talmud_Berakhot.2.3.6\" data-ref=\"Jerusalem Talmud Berakhot 2:3:6\">Y. Ber. II, 4ᶜ</a> top <span dir=\"rtl\">עד י׳ תרמוסרא היה לובשן</span> until he came to the station of J. &c. he kept the T’fillin on; <a class=\"refLink\" href=\"/Pesikta_Rabbati.22.1\" data-ref=\"Pesikta Rabbati 22:1\">Pesik. R. s. 22</a> <span dir=\"rtl\">עד יעקר תורמוסא</span>.—5) J. of K’far Sikhnaya, a disciple of Jesus of Nazareth. <a class=\"refLink\" href=\"/Avodah_Zarah.17a\" data-ref=\"Avodah Zarah 17a\">Ab. Zar. 17ᵃ</a>; a. e.; v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_סִכְנַיָּא.1\" data-ref=\"Jastrow, סִכְנַיָּא 1\">סִכְנַיָּא</a>.", "number": "1)"}]}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "*יְעַק", "next_hw": "יַעַר", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "יַעֲקֹב", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "v. sub <a data-ref=\"BDB, עקב\" href=\"/BDB,_עקב\", dir=\"rtl\">עקב</a>."}]}, "rid": "BDB04069", "strong_numbers": ["3290", "3291"], "next_hw": "יַעֲקָן", "prev_hw": "מועֵצָה", "alt_headwords": [{"word": "יַעֲקֹ֫בָה"}], "quotes": [], "GK": ["3620", "3621"], "TWOT": ["1676f"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "יַעֲקֹב", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>—  שֵׁם פרטי, יַעֲקֹב בן יצחק. —  ובקבלה °כנוי קבלי להחצי התחתון מהגוף ממתנים ולמטה:  וגם הוא (השם יעקב) מרמז על ז\"א ממראה מתניו ולמטה נקרא <strong>יעקב</strong> וממראה מתניו ולמעלה נקרא ישראל <span class=\"by-source\">עמה\"מ, רישא דז\"א מא</span>.</p>"]}, "rid": "BY-07888", "prev_hw": "יָעַץ II", "next_hw": "יער I", "page_num": 2091, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]