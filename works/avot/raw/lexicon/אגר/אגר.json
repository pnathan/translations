[{"headword": "אֲגַר I", "parent_lexicon": "Jastrow Dictionary", "rid": "A00336", "language_code": " ch. ", "refs": ["Jastrow, אָגַר I 1", "Jastrow, אָגַר I 1"], "language_reference": "<a class=\"refLink\" href=\"/Jastrow,_אָגַר I.1\" data-ref=\"Jastrow, אָגַר I 1\">same</a>", "content": {"senses": [{"definition": "; <i>Pa</i>. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אִגָר.1\" data-ref=\"Jastrow, אִגָר 1\">אַגַּר</a> <i>to heap up</i>. <a class=\"refLink\" href=\"/Targum_Jonathan_on_Deuteronomy.1.16\" data-ref=\"Targum Jonathan on Deuteronomy 1:16\">Targ. Y. Deut. I, 16</a> <span dir=\"rtl\">דמְאַגַּר וכ׳</span> (ed. Vien. <span dir=\"rtl\">מֶאֱגַר</span>—) who heaps up litigations, v. <a class=\"refLink\" href=\"/Jastrow,_אָגַר I.1\" data-ref=\"Jastrow, אָגַר I 1\">foreg.</a> [<a class=\"refLink\" href=\"/Aramaic_Targum_to_Psalms.104.7\" data-ref=\"Aramaic Targum to Psalms 104:7\">Targ. Ps. CIV, 7</a> למיגר Ms., v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נְגַד.1\" data-ref=\"Jastrow, נְגַד 1\">נְגַד</a>.]"}]}, "quotes": [], "prev_hw": "אָגַר I", "next_hw": "אָגַר II", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אֲגַר II", "parent_lexicon": "Jastrow Dictionary", "rid": "A00338", "refs": ["Jastrow, אָגַר II 1", "Kohelet Rabbah 4:6", "Vayikra Rabbah 3:1", "Gittin 73a:16", "Sanhedrin 73a", "Bava Metzia 79a:5", "Jastrow, אָגַר II 1", "Targum Jonathan on Deuteronomy 23:4", "Bava Metzia 77a", "Eruvin 63b:11", "Yoma 20b:6", "Jerusalem Talmud Taanit 1:4:6"], "content": {"senses": [{"definition": " (<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אָגַר I.1\" data-ref=\"Jastrow, אָגַר I 1\">אָגַר</a>) (√<span dir=\"rtl\">אג</span>, akin to <span dir=\"rtl\">חכר</span>; v. <a class=\"refLink\" href=\"/Jastrow,_אָגַר II.1\" data-ref=\"Jastrow, אָגַר II 1\">foreg.</a>) prop. <i>to tie</i>, whence <i>to hire, employ, rent</i>. <a class=\"refLink\" href=\"/Onkelos_Genesis.30.16\" data-ref=\"Onkelos Genesis 30:16\">Targ. Gen. XXX, 16</a>; a. fr.—<a class=\"refLink\" href=\"/Kohelet_Rabbah.4.6\" data-ref=\"Kohelet Rabbah 4:6\">Koh. R. to IV, 6</a>; <a class=\"refLink\" href=\"/Vayikra_Rabbah.3.1\" data-ref=\"Vayikra Rabbah 3:1\">Lev. R. s. 3</a> beg. (prov.) <span dir=\"rtl\">גינא וכ׳ דא׳</span> he who rents one garden will eat birds; him who rents gardens, the birds will eat. <a class=\"refLink\" href=\"/Gittin.73a.16\" data-ref=\"Gittin 73a:16\">Git. 73ᵃ</a> <span dir=\"rtl\">אגור מלחי</span> they hired boatsmen. <a class=\"refLink\" href=\"/Sanhedrin.73a\" data-ref=\"Sanhedrin 73a\">Snh. 73ᵃ</a> <span dir=\"rtl\">מֵיגַר אֲגִירֵי</span> to hire help. <a class=\"refLink\" href=\"Jerusalem_Talmud_Taanit.1.4.6\" data-ref=\"Jerusalem Talmud Taanit 1:4:6\">Y. Taan. I, 64ᵇ</a> bot. <span dir=\"rtl\">מיגר זנייתא</span> hiring prostitutes. <a class=\"refLink\" href=\"/Bava_Metzia.79a.5\" data-ref=\"Bava Metzia 79a:5\">B. Mets. 79ᵃ</a>; a. fr."}, {"grammar": {"binyan_form": ["אוֹגַר"], "verbal_stem": "Af."}, "senses": [{"definition": " <a class=\"refLink\" href=\"/Jastrow,_אָגַר II.1\" data-ref=\"Jastrow, אָגַר II 1\">same</a>. <a class=\"refLink\" href=\"/Targum_Jonathan_on_Deuteronomy.23.5\" data-ref=\"Targum Jonathan on Deuteronomy 23:5\">Targ. Y. Deut. XXIII, 5</a> (<a class=\"refLink\" href=\"/Targum_Jonathan_on_Deuteronomy.23.4\" data-ref=\"Targum Jonathan on Deuteronomy 23:4\">4</a>).—<a class=\"refLink\" href=\"/Bava_Metzia.77a\" data-ref=\"Bava Metzia 77a\">B. Mets. 77ᵃ</a> (interch. with Pe.) <span dir=\"rtl\">(<span dir=\"rtl\">אגירי</span>) <span dir=\"rtl\">אוגיר אגורי</span></span> engages laborers.", "number": "1)"}, {"definition": "<i>to rent out, lease</i>. <a class=\"refLink\" href=\"/Eruvin.63b.11\" data-ref=\"Eruvin 63b:11\">Erub. 63ᵇ</a> <span dir=\"rtl\">אוֹגַר לן רשותך</span> lease to us thy property. Y. Dem. VI, 25ᵇ top. Y. Taan. I, 64ᵇ bot. <span dir=\"rtl\">אוגרית חמרי</span> I hired my ass out.", "number": "—2)"}]}, {"grammar": {"binyan_form": ["אִיתַּגַּר", ""], "verbal_stem": "Ithpa."}}, {"grammar": {"binyan_form": ["אִתְּגַר"], "verbal_stem": "Ithpe."}, "senses": [{"definition": " (contr. of <span dir=\"rtl\">איתאגר</span>) <i>to be hired, to work as a laborer</i>. <a class=\"refLink\" href=\"/Onkelos_Deuteronomy.23.25\" data-ref=\"Onkelos Deuteronomy 23:25\">Targ. O. Deut. XXIII, 25</a>; a. e.—<a class=\"refLink\" href=\"/Yoma.20b.6\" data-ref=\"Yoma 20b:6\">Yoma 20ᵇ</a> (prov.) <span dir=\"rtl\">אי תגרת וכ׳</span> (combine into one w.) when thou hast hired thyself out to one, comb his wool (shrink from no labor)."}]}]}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "אָגַר II", "next_hw": "אֲגַר III", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אֲגַר III", "parent_lexicon": "Jastrow Dictionary", "rid": "A00339", "refs": ["Jastrow, אֲגַר II 1", "Bava Metzia 63b:10", "Bava Metzia 68b:15", "Bava Metzia 69b:12", "Berakhot 6b:11", "Jerusalem Talmud Moed Katan 2:3:2", "Jerusalem Talmud Bava Metzia 2:5:3"], "content": {"senses": [{"definition": " (<a class=\"refLink\" href=\"/Jastrow,_אֲגַר II.1\" data-ref=\"Jastrow, אֲגַר II 1\">foreg.</a>) <i>rent, wages; reward, profit</i>. <a class=\"refLink\" href=\"/Onkelos_Genesis.15.1\" data-ref=\"Onkelos Genesis 15:1\">Targ. Gen. XV, 1</a>; a. fr.—<a class=\"refLink\" href=\"/Bava_Metzia.63b.10\" data-ref=\"Bava Metzia 63b:10\">B. Mets. 63ᵇ</a> <span dir=\"rtl\">א׳ נטר ליה</span> compensation for waiting (giving time for delivery), i.e. advancing the money to the seller. <a class=\"refLink\" href=\"/Bava_Metzia.68b.15\" data-ref=\"Bava Metzia 68b:15\">Ib. 68ᵇ</a> <span dir=\"rtl\">פלגא בא׳ כ׳</span> half profit or loss. <a class=\"refLink\" href=\"/Bava_Metzia.69b.12\" data-ref=\"Bava Metzia 69b:12\">Ib. 69ᵇ</a> <span dir=\"rtl\">א׳ ופגרא</span> payment for carrying freight, and indemnity to the boatsmen in case of wreck. <a class=\"refLink\" href=\"Jerusalem_Talmud_Moed_Katan.2.3.2\" data-ref=\"Jerusalem Talmud Moed Katan 2:3:2\">Y. M. Kat. II, 81ᵇ</a> top <span dir=\"rtl\">א׳ וקרנא</span> profit and principal (cost-price).—<a class=\"refLink\" href=\"Jerusalem_Talmud_Bava_Metzia.2.5.3\" data-ref=\"Jerusalem Talmud Bava Metzia 2:5:3\">Y. B. Mets. II, 8ᶜ</a> top <span dir=\"rtl\">מא׳ כל הדין עלמא</span> than all profit this world can offer.—2) <i>that which deserves reward, meritorious deed.</i> <a class=\"refLink\" href=\"/Berakhot.6b.11\" data-ref=\"Berakhot 6b:11\">Ber. 6ᵇ</a> <span dir=\"rtl\">א׳ דפירקא ריהטא</span> the merit in attending a lecture lies in running [to it] (anxiety to hear it). [<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אֲגַר I.1\" data-ref=\"Jastrow, אֲגַר I 1\">אֲגַר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אֲגַר III.1\" data-ref=\"Jastrow, אֲגַר III 1\">אַגְרָא</a> <i>staff, pole</i>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אֵגֶד.1\" data-ref=\"Jastrow, אֵגֶד 1\">אגד</a>.]"}], "morphology": "m."}, "plural_form": [], "alt_headwords": ["אַגְרָא I"], "quotes": [], "prev_hw": "אֲגַר II", "next_hw": "אִגָר", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}]