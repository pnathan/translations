[{"headword": "בַּת", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-f", "senses": [{"definition": "n f"}, {"definition": "daughter", "senses": [{"definition": "daughter,  girl,  adopted daughter,  daughter-in-law,  sister, granddaughters,  female child,  cousin", "senses": [{"definition": "as polite address"}]}]}, {"definition": "n pr f", "senses": [{"definition": "as designation of women of a particular place"}]}, {"definition": "young women,  women", "senses": [{"definition": "as personification"}, {"definition": "daughter-villages"}, {"definition": "description of character"}]}]}, "strong_number": "1323", "transliteration": "bath", "pronunciation": "bath", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "בַּת", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-m", "senses": [{"definition": "bath,  a unit of liquid measure,  equal to dry measure ephah (about 9 imperial gallons or 40 litres,  rabbinical writings give sizes of one-half this amount)"}]}, "strong_number": "1324", "transliteration": "bath", "pronunciation": "bath", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "בַּת", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-m", "senses": [{"definition": "bath,  a unit of liquid measure,  about 40 litres,  equal to dry measure ephah"}, {"definition": "(TWOT) a liquid measure,  about 22 litres"}]}, "strong_number": "1325", "transliteration": "bath", "pronunciation": "bath", "language_code": "arc", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "צִיּוֹן", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-pr-loc", "senses": [{"definition": "Zion = \"parched place\""}, {"definition": "another name for Jerusalem especially in the prophetic books"}]}, "strong_number": "6726", "transliteration": "Tsîyôwn", "pronunciation": "tsee-yone'", "language_code": "x-pn", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "צִיּוֹן", "parent_lexicon": "Jastrow Dictionary", "rid": "R00324", "refs": ["Midrash Tehillim 48:2", "Midrash Tehillim 87:3"], "content": {"senses": [{"definition": " (b. h.) pr. n. <i>Mount Zion, Zion</i> (= Jerusalem). <a class=\"refLink\" href=\"/Midrash_Tehillim.48.2\" data-ref=\"Midrash Tehillim 48:2\">Midr. Till. to Ps. XLVIII</a> <span dir=\"rtl\">אבל בצ׳ אינו כן</span> but this is not the case with the city of Zion. <a class=\"refLink\" href=\"/Midrash_Tehillim.87.3\" data-ref=\"Midrash Tehillim 87:3\">Midr. Till. to Ps. LXXXVII</a> צ׳ שהוא פלטין שלי Zion which is my (the Lord’s) palace; a. fr."}]}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "צִיוְחָא", "next_hw": "צִיּוּן", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "צִיּוֹן", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"definition": "Zion."}]}, "rid": "R00298", "refs": ["Klein Dictionary, צוה 1", "Klein Dictionary, צִיּוּן 1", "Klein Dictionary, צין 1", "Klein Dictionary, צִיּוֹן 1", "Klein Dictionary, צִיּוֹן 1", "Klein Dictionary, צִיָּה 1", "Klein Dictionary, צִיּוֹן 1", "Klein Dictionary, צוה 1", "Klein Dictionary, צִיּוּן 1", "Klein Dictionary, צין 1", "Klein Dictionary, צִיּוֹן 1", "Klein Dictionary, צִיּוֹן 1", "Klein Dictionary, צִיָּה 1", "Klein Dictionary, צִיּוֹן 1", "Klein Dictionary, צִיּוֹנוּת 1", "Klein Dictionary, צִיּוֹנִי 1", "Klein Dictionary, צִיּוֹנוּת 1", "Klein Dictionary, צִיּוֹנִי 1"], "derivatives": "Derivatives: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_צִיּוֹנוּת.1\" data-ref=\"Klein Dictionary, צִיּוֹנוּת 1\">צִיּוֹנוּת</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_צִיּוֹנִי.1\" data-ref=\"Klein Dictionary, צִיּוֹנִי 1\">צִיּוֹנִי</a>.", "prev_hw": "צָיוֹן", "next_hw": "צִיּוּן", "notes": "[Of uncertain etymology. Some scholars derive it from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_צוה.1\" data-ref=\"Klein Dictionary, צוה 1\">צוה</a> in the sense ‘to erect’ (cp. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_צִיּוּן.1\" data-ref=\"Klein Dictionary, צִיּוּן 1\">צִיּוּן</a>). Others connect it with base <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_צין.1\" data-ref=\"Klein Dictionary, צין 1\">צין</a>, appearing in Arab. <i>ṣāna</i> (= he protected), so that <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_צִיּוֹן.1\" data-ref=\"Klein Dictionary, צִיּוֹן 1\">צִיּוֹן</a> would lit. mean ‘fortress, citadel’. Scholars, with reference to Syr. <span dir=\"rtl\">צֶהְיוּן</span> (= Heb. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_צִיּוֹן.1\" data-ref=\"Klein Dictionary, צִיּוֹן 1\">צִיּוֹן</a>), derive these words from base <span dir=\"rtl\">צהה</span> or <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_צִיָּה.1\" data-ref=\"Klein Dictionary, צִיָּה 1\">ציה</a>; according to them the orig. meaning of <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_צִיּוֹן.1\" data-ref=\"Klein Dictionary, צִיּוֹן 1\">צִיוֹן</a> would be ‘bare hill’. Other scholars regard Syr. <span dir=\"rtl\">צֶהְיוּן</span> as the older form.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "בַּת", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.f.</strong> daughter <strong>(</strong>= <span dir=\"rtl\">בַּנְתְּ</span> from <span dir=\"rtl\">בן</span>; Ph. <span dir=\"rtl\">בת</span>, MI <span dir=\"rtl\">בנת</span> pl. <em>maidens</em>, Assyrian <em>bintu</em> Winckler<sup>Sargon, Gloss.</sup>, Arabic <span dir=\"rtl\">بِنْتٌ</span> Sab. <span dir=\"rtl\">בת</span>, <span dir=\"rtl\">בנת</span> DHM<sup>ZMG 1883, 391</sup> CIS<sup>iv. 1, No. 6. 21</sup>; Aramaic <span dir=\"rtl\">ܒܰܪܬ</span> <strong>)</strong>—<span dir=\"rtl\">ב׳</span> abs. <a data-ref=\"Exodus 1:16\" href=\"/Exodus.1.16\">Ex 1:16</a> +; cstr. <a data-ref=\"Genesis 11:29\" href=\"/Genesis.11.29\">Gn 11:29</a> +; sf. <span dir=\"rtl\">בִּתִּי</span> <a data-ref=\"Deuteronomy 22:16\" href=\"/Deuteronomy.22.16\">Dt 22:16</a> +; <span dir=\"rtl\">בִּתְּךָ</span> <a data-ref=\"Genesis 29:18\" href=\"/Genesis.29.18\">Gn 29:18</a> +; <span dir=\"rtl\">בִּתֵּנוּ</span> <a data-ref=\"Genesis 34:17\" href=\"/Genesis.34.17\">Gn 34:17</a> etc.; pl. <span dir=\"rtl\">בָּנוֹת</span> <a data-ref=\"Genesis 5:4\" href=\"/Genesis.5.4\">Gn 5:4</a> +; cstr. <span dir=\"rtl\">בְּנוֹת</span> <a data-ref=\"Genesis 6:2\" href=\"/Genesis.6.2\">Gn 6:2</a> +; sf. <span dir=\"rtl\">בְּנֹתַי</span> <a data-ref=\"Genesis 31:26\" href=\"/Genesis.31.26\">Gn 31:26</a> +; <span dir=\"rtl\">בְּנוֹתֶיךָ</span> <a data-ref=\"Genesis 19:12\" href=\"/Genesis.19.12\">Gn 19:12</a> +; <span dir=\"rtl\">בְּנֹתָם</span> <a data-ref=\"Genesis 34:21\" href=\"/Genesis.34.21\">Gn 34:21</a>; <span dir=\"rtl\">בְּנוֹתֵיהֶם</span> <a data-ref=\"Deuteronomy 12:31\" href=\"/Deuteronomy.12.31\">Dt 12:31</a> +, etc.;—"}, {"senses": [{"definition": "<em>daughter</em>, female child, born of a woman <a data-ref=\"Genesis 30:21\" href=\"/Genesis.30.21\">Gn 30:21</a>; <a data-ref=\"Genesis 34:1\" href=\"/Genesis.34.1\">34:1</a> <a data-ref=\"Exodus 1:16\" href=\"/Exodus.1.16\">Ex 1:16</a>, <a data-ref=\"Exodus 1:22\" href=\"/Exodus.1.22\">22</a>; <a data-ref=\"Exodus 21:4\" href=\"/Exodus.21.4\">21:4</a> <a data-ref=\"Leviticus 12:6\" href=\"/Leviticus.12.6\">Lv 12:6</a> <a data-ref=\"Hosea 1:6\" href=\"/Hosea.1.6\">Ho 1:6</a> cf. <a data-ref=\"Genesis 20:12\" href=\"/Genesis.20.12\">Gn 20:12</a> <a data-ref=\"Leviticus 18:9\" href=\"/Leviticus.18.9\">Lv 18:9</a> <a data-ref=\"Deuteronomy 27:22\" href=\"/Deuteronomy.27.22\">Dt 27:22</a> +; begotten by a man <a data-ref=\"Genesis 5:4\" href=\"/Genesis.5.4\">Gn 5:4</a>, <a data-ref=\"Genesis 5:7\" href=\"/Genesis.5.7\">7</a>, <a data-ref=\"Genesis 5:10\" href=\"/Genesis.5.10\">10</a>; <a data-ref=\"Genesis 11:11\" href=\"/Genesis.11.11\">11:11</a>, <a data-ref=\"Genesis 11:13\" href=\"/Genesis.11.13\">13</a>, <a data-ref=\"Genesis 11:15\" href=\"/Genesis.11.15\">15</a> cf. <a data-ref=\"Genesis 11:29\" href=\"/Genesis.11.29\">Gn 11:29</a>; <a data-ref=\"Genesis 19:8\" href=\"/Genesis.19.8\">19:8</a>; <a data-ref=\"Genesis 20:12\" href=\"/Genesis.20.12\">20:12</a>; <a data-ref=\"Genesis 28:2\" href=\"/Genesis.28.2\">28:2</a> <a data-ref=\"Leviticus 19:9\" href=\"/Leviticus.19.9\">Lv 19:9</a> <a data-ref=\"Deuteronomy 27:22\" href=\"/Deuteronomy.27.22\">Dt 27:22</a> +; often ‖ <span dir=\"rtl\">בֵּן</span> <em>son</em> <a data-ref=\"Genesis 5:4\" href=\"/Genesis.5.4\">Gn 5:4</a>, <a data-ref=\"Genesis 5:7\" href=\"/Genesis.5.7\">7</a> + (v. <a data-ref=\"BDB, בֵּן²\" href=\"/BDB,_בֵּן²\", dir=\"rtl\">בֵּן</a>); cf. in allegory of Jehoash <a data-ref=\"II Kings 14:9\" href=\"/II_Kings.14.9\">2 K 14:9</a> = <a data-ref=\"II Chronicles 25:18\" href=\"/II_Chronicles.25.18\">2 Ch 25:18</a>; note especially <span dir=\"rtl\">בְּנוֹת הָאָדָם</span> i.e. human women <a data-ref=\"Genesis 6:2\" href=\"/Genesis.6.2\">Gn 6:2</a>, <a data-ref=\"Genesis 6:4\" href=\"/Genesis.6.4\">4</a>; <span dir=\"rtl\">בִּתְּךָ הַקְּטַנָּה</span> <em>thy younger daughter</em> <a data-ref=\"Genesis 29:18\" href=\"/Genesis.29.18\">Gn 29:18</a> (cf. <span dir=\"rtl\">הַצְּעִירָה</span> v <a data-ref=\"Genesis 29:26\" href=\"/Genesis.29.26\">26</a> opp. <span dir=\"rtl\">הַבְּכִירָה</span>); <span dir=\"rtl\">בִּתִּי הַגְּדוֹלָה</span> <em>my eldest daughter</em> <a data-ref=\"I Samuel 18:17\" href=\"/I_Samuel.18.17\">1 S 18:17</a>; <span dir=\"rtl\">בַּת־(הַ)מֶּלֶךְ</span> = <em>princess</em> <a data-ref=\"II Chronicles 22:11\" href=\"/II_Chronicles.22.11\">2 Ch 22:11</a> <a data-ref=\"II Kings 9:34\" href=\"/II_Kings.9.34\">2 K 9:34</a> <a data-ref=\"Daniel 11:6\" href=\"/Daniel.11.6\">Dn 11:6</a> cf. <a data-ref=\"II Samuel 13:18\" href=\"/II_Samuel.13.18\">2 S 13:18</a> <a data-ref=\"Jeremiah 41:10\" href=\"/Jeremiah.41.10\">Je 41:10</a>; <a data-ref=\"Jeremiah 43:6\" href=\"/Jeremiah.43.6\">43:6</a> <a data-ref=\"Psalms 45:10\" href=\"/Psalms.45.10\">ψ 45:10</a>; cf. as term of praise <span dir=\"rtl\">בַּת־נָדִיב</span> <a data-ref=\"Song of Songs 7:2\" href=\"/Song_of_Songs.7.2\">Ct 7:2</a>; in partic."}, {"senses": [{"definition": "girl called <span dir=\"rtl\">בִּתֵּנוּ</span> by father and brothers <a data-ref=\"Genesis 34:17\" href=\"/Genesis.34.17\">Gn 34:17</a> cf. <span dir=\"rtl\">בִּתְּכֶם</span> v <a data-ref=\"Genesis 34:8\" href=\"/Genesis.34.8\">8</a>."}], "all_cited": true, "num": "a."}, {"senses": [{"definition": "of adopted daughter <a data-ref=\"Esther 2:7\" href=\"/Esther.2.7\">Est 2:7</a>, <a data-ref=\"Esther 2:15\" href=\"/Esther.2.15\">15</a>."}], "all_cited": true, "num": "b."}, {"senses": [{"definition": "used in speaking to daughter-in-law <a data-ref=\"Ruth 1:11\" href=\"/Ruth.1.11\">Ru 1:11</a>, <a data-ref=\"Ruth 1:12\" href=\"/Ruth.1.12\">12</a>, <a data-ref=\"Ruth 1:13\" href=\"/Ruth.1.13\">13</a>; <a data-ref=\"Ruth 2:2\" href=\"/Ruth.2.2\">2:2</a>, <a data-ref=\"Ruth 2:8\" href=\"/Ruth.2.8\">8</a>, <a data-ref=\"Ruth 2:22\" href=\"/Ruth.2.22\">22</a>; <a data-ref=\"Ruth 3:1\" href=\"/Ruth.3.1\">3:1</a>, <a data-ref=\"Ruth 3:16\" href=\"/Ruth.3.16\">16</a>, <a data-ref=\"Ruth 3:18\" href=\"/Ruth.3.18\">18</a>."}], "all_cited": true, "num": "c."}, {"senses": [{"definition": "<span dir=\"rtl\">בַּת־אָבִיו</span> = <em>sister</em> <a data-ref=\"Ezekiel 22:11\" href=\"/Ezekiel.22.11\">Ez 22:11</a> (appos. <span dir=\"rtl\">אחותו</span>); also <em>half-sister</em> <a data-ref=\"Genesis 20:12\" href=\"/Genesis.20.12\">Gn 20:12</a> <span dir=\"rtl\">בַּת־אָבִי אַךְ לֹא בַת־אִמִּי</span>, cf. <a data-ref=\"Leviticus 18:9\" href=\"/Leviticus.18.9\">Lv 18:9</a> & v <a data-ref=\"Leviticus 18:11\" href=\"/Leviticus.18.11\">11</a> <span dir=\"rtl\">בַּת־אֵשֶׁת אָבִיךָ</span>, <a data-ref=\"Leviticus 20:17\" href=\"/Leviticus.20