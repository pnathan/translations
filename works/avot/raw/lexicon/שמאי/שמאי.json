[{"headword": "שַׁמַּאי", "parent_lexicon": "Jastrow Dictionary", "rid": "U01410", "refs": ["Bava Batra 133b:13", "Mishnah Eduyot 1:4", "Mishnah Eduyot 1:7", "Jerusalem Talmud Nedarim 5:6:4", "Jerusalem Talmud Shabbat 3:2:2"], "content": {"senses": [{"definition": "<i>Shammai</i> (abbrev. of <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_שְׁמַעְיָא.1\" data-ref=\"Jastrow, שְׁמַעְיָא 1\">שמעיה</a>), "}, {"definition": " (<span dir=\"rtl\">הזקן</span>) <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_ש׳.1\" data-ref=\"Jastrow, ש׳ 1\">ש׳</a> Sh., the colleague of Hillel in the Sanhedrin under king Herod. <a class=\"refLink\" href=\"/Mishnah_Chagigah.2.2\" data-ref=\"Mishnah Chagigah 2:2\">Ḥag. II, 2</a>. <a class=\"refLink\" href=\"/Bava_Batra.133b.13\" data-ref=\"Bava Batra 133b:13\">B. Bath. 133ᵇ</a>; <a class=\"refLink\" href=\"Jerusalem_Talmud_Nedarim.5.6.4\" data-ref=\"Jerusalem Talmud Nedarim 5:6:4\">Y. Ned. V, end, 39ᵇ</a>. <a class=\"refLink\" href=\"/Mishnah_Sukkah.2.8\" data-ref=\"Mishnah Sukkah 2:8\">Succ. II, 8</a>, a. e. <span dir=\"rtl\">ש׳ הזקן</span>. <a class=\"refLink\" href=\"/Mishnah_Eduyot.1.1\" data-ref=\"Mishnah Eduyot 1:1\">Eduy. I, 1</a> sq. (differences between Sh. and Hillel). <a class=\"refLink\" href=\"/Mishnah_Eduyot.1.4\" data-ref=\"Mishnah Eduyot 1:4\">Ib. 4</a>; a. v. fr.—<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_שְׁאָן.1\" data-ref=\"Jastrow, שְׁאָן 1\">בֵּית שַׁ׳</a> (abbrev. <span dir=\"rtl\">ב\"ש</span>) the school of Sh., the disciples of Sh. <a class=\"refLink\" href=\"/Mishnah_Eduyot.1.7\" data-ref=\"Mishnah Eduyot 1:7\">Ib. 7</a>. <a class=\"refLink\" href=\"/Mishnah_Beitzah.1.1\" data-ref=\"Mishnah Beitzah 1:1\">Bets. I, 1</a>; a. v. fr.", "number": "1)"}, {"definition": " name of an Amora. <a class=\"refLink\" href=\"Jerusalem_Talmud_Shabbat.3.2.2\" data-ref=\"Jerusalem Talmud Shabbat 3:2:2\">Y. Sabb. III, 5ᵈ</a> bot.; a. fr. V. Fr. M’bo, p. 124ᵇ", "number": "—2)"}], "morphology": "pr. n. m."}, "plural_form": [], "alt_headwords": ["שַׁמַּי", "שַׁמַּיי"], "quotes": [], "prev_hw": "שֶׁמָּא", "next_hw": "שִׁמָּאָה", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "שַׁמַּאי", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "assessor, valuer, estimator."}]}, "rid": "U01220", "language_code": "MH", "refs": ["Klein Dictionary, שׁום 1", "Klein Dictionary, פָּעַל 1", "Klein Dictionary, שׁום 1", "Klein Dictionary, פָּעַל 1", "Klein Dictionary, שַׁמָּאוּת 1", "Klein Dictionary, שַׁמָּאוּת 1"], "derivatives": "Derivative: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_שַׁמָּאוּת.1\" data-ref=\"Klein Dictionary, שַׁמָּאוּת 1\">שַׁמָּאוּת</a>.", "prev_hw": "שַׁמָּאוּת", "next_hw": "שְׂמֹאל", "notes": "[Nomen opificis formed from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_שׁום.1\" data-ref=\"Klein Dictionary, שׁום 1\">שׁום</a> (= to assess, value, estimate), according to the pattern <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_פָּעַל.1\" data-ref=\"Klein Dictionary, פָּעַל 1\">פַּעָל</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "שַׁמַּאי", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>°, ש\"ז, — שתפקידו לשום ולהעריך Schätzer, Taxator; estimateur; evaluator, appraisor: מי שיש בידו משכון וכו' יקח ג' <strong>שמאים</strong> וישומו המשכון כמה הוא שוה (<span class=\"by-source\">טוחו\"מ, מלוה ולוה עג</span>). אלו<strong> שמאי </strong>העיר שמעריכים המס של בני העיר לפי אומד דעתן <span class=\"by-source\">(לבוש חו\"מ, עדות לד יד)</span>. והחלוקת כבוד שנחלק להם, שיהיו להם שני <strong>שמאים</strong> עכשיו בתוך <strong>שמאי </strong>הארצות, באשר מנעו את עצמם מהכבוד ולא באו אינהו דאפסידו אנפשייהו ולעת עשיית הערכה החדשה בשבט הנ\"ל יהיה להם רק <strong>שמאי</strong> אחד <span class=\"by-source\">(פנקס ועד ארבע ארצות, היילפרין, 107)</span>.</p>"]}, "rid": "BY-20368", "prev_hw": "שַׁמָּאוּת", "next_hw": "שַׁמָּאִי", "page_num": 7221, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]