[{"headword": "קְטָלָא", "parent_lexicon": "Jastrow Dictionary", "rid": "S00775", "refs": ["Jastrow, קְטַל 1", "Onkelos Leviticus 20:11", "Sanhedrin 11a:3-8", "Sanhedrin 73b:9", "Sanhedrin 78b:4", "Sanhedrin 78b:5", "Sanhedrin 79b:4", "Sanhedrin 79b:5", "Ketubot 35a:5"], "content": {"senses": [{"definition": " (<a class=\"refLink\" href=\"/Jastrow,_קְטַל.1\" data-ref=\"Jastrow, קְטַל 1\">preced.</a>) <i>killing, death-penalty</i>. <a class=\"refLink\" href=\"/Onkelos_Leviticus.20.9\" data-ref=\"Onkelos Leviticus 20:9\">Targ. Lev. XX, 9</a>; <a class=\"refLink\" href=\"/Onkelos_Leviticus.20.11\" data-ref=\"Onkelos Leviticus 20:11\">11</a> (O. ed. Berl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_קִיטְנִית.1\" data-ref=\"Jastrow, קִיטְנִית 1\">קַטְּ׳</a>). <a class=\"refLink\" href=\"/Aramaic_Targum_to_Proverbs.24.11\" data-ref=\"Aramaic Targum to Proverbs 24:11\">Targ. Prov. XXIV, 11</a>; a. e.—<a class=\"refLink\" href=\"/Sanhedrin.11a.3-8\" data-ref=\"Sanhedrin 11a:3-8\">Snh. 11ᵃ</a> שמעון … לחרבא וחברוהי לק׳ Simon and Yishmael are destined to fall by the sword, and their colleagues to be executed. <a class=\"refLink\" href=\"/Pirkei_Avot.1.13\" data-ref=\"Pirkei Avot 1:13\">Ab. I, 13</a> <span dir=\"rtl\">ק׳ חייב</span> deserves death. <a class=\"refLink\" href=\"/Sanhedrin.73b.9\" data-ref=\"Sanhedrin 73b:9\">Snh. 73ᵇ</a> <span dir=\"rtl\">מסרה נפשה לק׳</span> she was prepared to die (resisting her assailant). <a class=\"refLink\" href=\"/Sanhedrin.78b.5\" data-ref=\"Sanhedrin 78b:5\">Ib. 78ᵇ</a> <span dir=\"rtl\">בר ק׳ הוא … קְטָלֵיה במאי</span> he was guilty of a capital crime, but Moses did not know in what manner he was to be executed. <a class=\"refLink\" href=\"/Sanhedrin.79b.5\" data-ref=\"Sanhedrin 79b:5\">Ib. 79ᵇ</a> <span dir=\"rtl\">אי בר ק׳ הוא וכ׳</span> if he is to be put to death &c. <a class=\"refLink\" href=\"/Ketubot.35a.5\" data-ref=\"Ketubot 35a:5\">Keth. 35ᵃ</a> <span dir=\"rtl\">האי בק׳ כתיב</span> this (<i>makkeh</i>, <a class=\"refLink\" href=\"/Leviticus.24.2\" data-ref=\"Leviticus 24:2\">Lev. XXIV, 2</a>"}], "morphology": "m."}, "plural_form": [], "alt_headwords": ["(קַטְּלָא)"], "quotes": [], "prev_hw": "קְטַל", "next_hw": "קַטְלָא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "קְטָלָא", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "killing."}]}, "rid": "S00603", "language_code": "PBH", "refs": ["Klein Dictionary, קטל 1", "Klein Dictionary, קטל 1", "Klein Dictionary, קטל 1", "Klein Dictionary, קטל 1", "Klein Dictionary, קטל 1", "Klein Dictionary, קטל 1"], "prev_hw": "קֶֽטֶל", "next_hw": "קְטָלָב", "notes": "[From Aram. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_קטל.1\" data-ref=\"Klein Dictionary, קטל 1\">קְטַל</a> (= he killed). See <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_קטל.1\" data-ref=\"Klein Dictionary, קטל 1\">קטל</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}]