 data-ref=\"Genesis 36:22\" href=\"/Genesis.36.22\">Gn 36:22</a> = <a data-ref=\"I Chronicles 1:39\" href=\"/I_Chronicles.1.39\">1 Ch 1:39</a>; 𝔊 Χορρ(ε)ι."}], "num": "a."}, {"senses": [{"definition": "<span dir=\"rtl\">חוֹרי</span> a Simeonite <a data-ref=\"Numbers 13:5\" href=\"/Numbers.13.5\">Nu 13:5</a>, but 𝔊 Σουρ(ε)ι, 𝔊L Σουδρι.—i. <span dir=\"rtl\">חֹרִי</span> v. sub <a ,=\"\" data-ref=\"BDB, חוּר\" dir=\"rtl\" href=\"/BDB,_חוּר\">i. חור</a>."}], "num": "b."}], "num": "3."}]}, "rid": "BDB03522", "strong_numbers": ["2751", "2752", "2753"], "next_hw": "חרשׂ", "prev_hw": "חֻר", "all_cited": true, "ordinal": "II.", "alt_headwords": [{"word": "חוֹרִי"}], "quotes": [], "GK": ["3035", "3036", "3037"], "TWOT": ["630c", "740"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}]