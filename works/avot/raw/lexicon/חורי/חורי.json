almud Sukkah 5:1:3\">Y. Succ. V, beg. 55ᵃ</a> <span dir=\"rtl\">בשובתא ח׳</span> the next Sabbath; a. e."}], "morphology": "m."}, "plural_form": ["חוֹרְיֵי"], "alt_headwords": [], "quotes": [], "prev_hw": "חוֹרֵי", "next_hw": "חוֹרִי II", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "חוֹרִי II", "parent_lexicon": "Jastrow Dictionary", "rid": "H00469", "refs": ["Jastrow, חֲרָרָה 1"], "content": {"senses": [{"definition": " (b. h.) <i>cakes</i>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חֲרָרָה.1\" data-ref=\"Jastrow, חֲרָרָה 1\">חֲרָרָה</a>."}], "morphology": "f."}, "quotes": [], "prev_hw": "חוֹרִי I", "next_hw": "חוּרְלָא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "חֹרִי", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.</strong>[<strong>m.</strong>] <strong>white</strong> bread or cake <span dir=\"rtl\">שְׁלֹשָׁה סַלֵּי חֹרִי</span> <a data-ref=\"Genesis 40:16\" href=\"/Genesis.40.16\">Gn 40:16</a> <em>three baskets of white bread</em>.—ii. <span dir=\"rtl\">חֹרִי</span> v. iii. <a data-ref=\"BDB, חרר²\" href=\"/BDB,_חרר²\", dir=\"rtl\">חרר</a>."}]}, "rid": "BDB02938", "strong_numbers": ["2751", "2752", "2753"], "next_hw": "חוּר²", "prev_hw": "חוֹרָ֑י", "all_cited": true, "ordinal": "I.", "quotes": [], "GK": ["3035", "3036", "3037"], "TWOT": ["630c", "740"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_languag