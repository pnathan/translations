nses": [{"definition": "v. sub <a data-ref=\"BDB, אַי\" href=\"/BDB,_אַי\", dir=\"rtl\">אַי</a> (p. 32)."}]}, "rid": "BDB00421", "strong_numbers": ["349", "349", "349"], "next_hw": "אַיִל", "prev_hw": "אִיִּים", "alt_headwords": [{"word": "אֵיכָה"}, {"word": "אֵיכָכָה"}], "quotes": [], "GK": ["375", "377", "379"], "TWOT": ["75", "75", "75c", "75", "75e"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "אֵיכָה", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p><sup class=\"footnote-marker\">2</sup><i class=\"footnote\">מרכב מן אי ומן כה.</i>, —  א) מלת שאלה באיזה אופן, כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_אֵיךְ.1\" data-ref=\"Ben Yehuda Dictionary, אֵיךְ 1\">אֵיךְ</a>, wie; comment; how: אֵיכָה אשא לבדי טרחכם ומשאכם וריבכם  <span class=\"by-source\">דבר'  א  יב</span>.  כי תאמר בלבבך רבים הגוים האלה ממני אֵיכָה אוכל להורישם  <span class=\"by-source\">שם  ז  יז</span>.  ויאמרו בני ישראל (לבני בנימין) דברו אֵיכָה נהיתה הרעה הזאת (של הפלגש בגבעה) <span class=\"by-source\">שופט'  כ  ג</span>.  ולתמה, ולהשתוממות: אֵיכָה היתה לזונה קריה נאמנה  <span class=\"by-source\">ישעי'  א  כא</span>.  נדו לו (למואב) כל סביביו וכל ידעי שמו אמרו אֵיכָה נשבר מטה עז מקל תפארה  <span class=\"by-source\">ירמ'  מח  יז</span>.  אֵיכָה ישבה בדד העיר  <span class=\"by-source\">איכה  א  א</span>.  – ב) כמו אֵי, אַיַה, הגידה לי שאהבה נפשי אֵיכָה תרעה אֵיכָה תרביץ בצהרים שלמה אהיה כעטיה על עדרי חבריך  <span class=\"by-source\">שה\"ש  א  ז</span>.  – ג) °בחשבון, בשברים, המספר התחתון שהוא מורה לכמה חלקי'  נחלק הדבר: ולהיות שמנין הנאחז באחדות הוא מוליד הציור בלב מגודל השבר לכן יקרא ציון ההוא <strong>איכה</strong> <span class=\"by-source\">כליל החשבון ג</span>.  המספר התחתון מורה על מנין כל החלקים שנתחלק בו האחד השלם ונקרא בשם <strong>איכה</strong> <span class=\"by-source\">יסודי חכמ'  השעור  ח\"ס  חשבון הכללי ג</span>.</p>"]}, "rid": "BY-00584", "prev_hw": "אֻיַּךְ", "next_hw": "אֵיכֹה", "page_num": 178, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]