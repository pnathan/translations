[{"headword": "בָּקַשׁ", "parent_lexicon": "Jastrow Dictionary", "rid": "B01148", "language_code": "(b. h.;", "refs": ["Kiddushin 65a:14", "Berakhot 12b:14", "Bereishit Rabbah 84:6", "Bava Batra 91b:3", "Taanit 29a:14", "Bava Metzia 86a"], "language_reference": " √<span dir=\"rtl\">בק</span>", "content": {"senses": [{"definition": " , v. <span dir=\"rtl\">בקא</span>; corresp. to ch. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_בעי.1\" data-ref=\"Jastrow, בעי 1\">בעי</a>); <i>Pi.</i> <span dir=\"rtl\">בִּיקֵּשׁ</span>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_בָּקַשׁ.1\" data-ref=\"Jastrow, בָּקַשׁ 1\">בִּקֵּשׁ</a> <i>to seek, desire, beg, ask</i>. <a class=\"refLink\" href=\"/Kiddushin.65a.14\" data-ref=\"Kiddushin 65a:14\">Kidd. 65ᵃ</a> <span dir=\"rtl\">מְבַקְּשִׁין וכ׳</span> the court begs him to give her a letter of divorce, opp. to <span dir=\"rtl\">כופין</span>. <a class=\"refLink\" href=\"/Berakhot.12b.14\" data-ref=\"Berakhot 12b:14\">Ber. 12ᵇ</a> <span dir=\"rtl\">בִּקְּשׁוּ לקבוע וכ׳</span> they (the Rabbis) intended to insert the chapter about Balak &c. <a class=\"refLink\" href=\"/Bereishit_Rabbah.84.6\" data-ref=\"Bereishit Rabbah 84:6\">Gen. R. s. 84</a> <span dir=\"rtl\">ב׳ לישב וכ׳</span> he intended to live in peace; a. fr.—ב׳ רחמים <i>to pray</i> (for mercy), v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_בעי.1\" data-ref=\"Jastrow, בעי 1\">בעי</a>. Ber. l. c. <a class=\"refLink\" href=\"/Bava_Batra.91b.3\" data-ref=\"Bava Batra 91b:3\">B. Bath. 91ᵇ</a>; a. fr."}, {"grammar": {"binyan_form": ["הִתְבַּקֵּשׁ", ""], "verbal_stem": "Hithpa."}, "senses": [{"definition": ", <i>Nithpa</i>. <span dir=\"rtl\">נִתְבַּקֵּשׁ</span> <i>to be sought, to be hunted for</i> (by detectives); <i>to be summoned</i>. <a class=\"refLink\" href=\"/Taanit.29a.14\" data-ref=\"Taanit 29a:14\">Taan. 29ᵃ</a> (a disguised warning given to R. Gamliel) <span dir=\"rtl\">בעל החוטם מִתְבַּקֵּשׁ</span> the well-known man is wanted; v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חוֹטָם.1\" data-ref=\"Jastrow, חוֹטָם 1\">חוֹטֶם</a>. <a class=\"refLink\" href=\"/Bava_Metzia.86a\" data-ref=\"Bava Metzia 86a\">B. Mets. 86ᵃ</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_יְשִׁיבָה.1\" data-ref=\"Jastrow, יְשִׁיבָה 1\">יְשִׁיבָה</a>."}]}]}, "plural_form": [], "alt_headwords": [], "quotes": [[null, "בָּקַשׁ רחמים", null]], "prev_hw": "בַּקְרַת", "next_hw": "בַּקָּשָׁה", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}]