[{"headword": "עֶרְיָה", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-f", "senses": [{"definition": "nudity,  nakedness"}]}, "strong_number": "6181", "transliteration": "ʻeryâh", "pronunciation": "er-yaw'", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "עֶרְיָה", "parent_lexicon": "Jastrow Dictionary", "rid": "P01351", "language_code": "(b. h.;", "refs": ["Jastrow, עֶרְוָה 1"], "content": {"senses": [{"definition": " v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עֶרְוָה.1\" data-ref=\"Jastrow, עֶרְוָה 1\">עֶרְוָה</a>) <i>genitals</i>. <a class=\"refLink\" href=\"/Mishnah_Bekhorot.6.5\" data-ref=\"Mishnah Bekhorot 6:5\">Bekh. VI, 5</a> <span dir=\"rtl\">ע׳ של נקבה</span> the genitals of a female animal.—Pl. <span dir=\"rtl\">עֲרָיוֹת</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עֶרְוָה.1\" data-ref=\"Jastrow, עֶרְוָה 1\">עֶרְוָה</a>."}], "morphology": "f."}, "plural_form": ["עֲרָיוֹת", ""], "quotes": [], "prev_hw": "עריבתא", "next_hw": "עַרַיי", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "עֶרְיָה", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"definition": "nakedness.", "number": "1"}, {"definition": "shame.", "number": "2"}]}, "rid": "P01084", "refs": ["Klein Dictionary, ערה ᴵ 1", "Klein Dictionary, ◌ָה ᴵ 1", "Klein Dictionary, ערה ᴵ 1", "Klein Dictionary, ◌ָה ᴵ 1"], "prev_hw": "עֲרִיגָה", "next_hw": "עֲרִיָּה", "notes": "[cp. Aram. <span dir=\"rtl\">עִירִיתָא</span>, <span dir=\"rtl\">עָרְיְתָא</span>, Syr. <span dir=\"rtl\">עַרְיַת</span> (= naked), Arab. ‘ <i>urya</i><i></i>, Akka. <i>ūru</i> (= nakedness). From <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_ערה ᴵ.1\" data-ref=\"Klein Dictionary, ערה ᴵ 1\">ערה ᴵ</a>. for the ending see first suff. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_◌ָה ᴵ.1\" data-ref=\"Klein Dictionary, ◌ָה ᴵ 1\">◌ָה</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "עֶרְיָה", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.f. nakedness</strong>;—always abs. <span dir=\"rtl\">ע׳</span>;—<span dir=\"rtl\">ע׳־בֹּשֶׁת</span> <a data-ref=\"Micah 1:11\" href=\"/Micah.1.11\">Mi 1:11</a> (in) <em>nakedness</em>, (in) <em>shame</em> (fig. of town Shaphir); of Jerus. <span dir=\"rtl\">עֵרֹם וְע׳</span> <a data-ref=\"Ezekiel 16:7\" href=\"/Ezekiel.16.7\">Ez 16:7</a> + 3 times (v. <a data-ref=\"BDB, עֵירֹם\" href=\"/BDB,_עֵירֹם\", dir=\"rtl\">עֵירֹם</a> sub <a data-ref=\"BDB, עוּר²\" href=\"/BDB,_עוּר²\", dir=\"rtl\">II. עור</a>); of bow <a data-ref=\"Habakkuk 3:9\" href=\"/Habakkuk.3.9\">Hb 3:9</a> (v. <a data-ref=\"BDB, עוּר²\" href=\"/BDB,_עוּר²\", dir=\"rtl\">II. עור</a>)."}]}, "rid": "BDB07629", "strong_numbers": [], "next_hw": "מַעֲרֶה", "prev_hw": "עֶרְוָה", "all_cited": true, "occurrences": "6", "quotes": [], "GK": [], "TWOT": [], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "עֶרְיָה", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>ש\"נ, — א) מעמד אדם עָרֹם, Blösse;nudité; nakedness: ותבאי בעדי עדיים שדיים נכנו ושערך צמח ואת ערם ועֶרְיָה ואעבר עליך ואראך והנה עתך עת דדים (<span class=\"by-source\">יחזק' יו ז-ח</span>). לא זכרתי את ימי נעוריך בהיותך עירם וְעֶרְיָה מתבוססת בדמיך היית (<span class=\"by-source\">שם כב</span>).והפשיטו אותך בגדיך ולקחו כלי תפארתך והניחוך עירם וְעֶרְיָה (<span class=\"by-source\">שם לט</span>). — ואמר המקונן: פצו מעשה <strong>עריה</strong> לנדיה פרשה ציון בידיה (<span class=\"by-source\">ר\"א הקליר, שבת סורו מני, קינ'</span>). — ואמר המשורר: וגפן וכו' אשר נותרה ימי חרף וזרע מפרי <strong>עריה </strong>התמאס ויינה טוב ורב לשתות ולרויה (<span class=\"by-source\">ר\"ש הנגיד, הבמות פליליה</span>). או בת שבע מעל הגג אראנה רוחצת <strong>עריה</strong> לא אתחיל על חשק תמר לא אחשוב רע על אוריה (<span class=\"by-source\">עמנו', מחבר' ד</span>).— ב) כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_עֶרְוָה.1\" data-ref=\"Ben Yehuda Dictionary, עֶרְוָה 1\">עֶרְוָה</a><sup class=\"footnote-marker\">1</sup><i class=\"footnote\">[עי' גם  <span class=\"by-source\">ביכלר, ספ' היובל לר\"י לוי</span>.]</i>, במשמ' אבר המין: נפגם הזובן או <strong>עריה </strong>של נקבה במוקדשים נפגם הזנב מן העצם אבל לא מן הפרק (<span class=\"by-source\">בכור' ו ה</span>). — ומ\"ר עֲרָיוֹת, עי' <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_עֶרְוָה.1\" data-ref=\"Ben Yehuda Dictionary, עֶרְוָה 1\">עֶרְוָה</a>. — ובמשמ' זנות: ולא נפקד ממנו איש <strong>לערייה</strong> ולחטא (<span class=\"by-source\">מד\"ר שה\"ש, כמגדל דוד</span>).— ואמר הפיטן: למו השיבה נות יפיפיה לי איך תיסרוני ברמיה לערל וטמא תשגילוני <strong>עריה </strong>(<span class=\"by-source\">ר' יוסף בר שלמה, אודך כי אנפת, יוצ' שבת א חנוכ'</span>).</p>"]}, "rid": "BY-15044", "prev_hw": "עֲרִיגָה", "next_hw": "עֲרָיָה", "page_num": 4721, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]