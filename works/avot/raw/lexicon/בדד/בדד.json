[{"headword": "בָּדַד", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "v", "senses": [{"definition": "to withdraw,  be separate,  be isolated", "senses": [{"definition": " an army straggler (part.)", "senses": [{"definition": "of Ephraim (metaph.)"}], "grammar": {"verbal_stem": "Qal"}}]}, {"definition": "(TWOT) alone"}]}, "strong_number": "909", "transliteration": "bâdad", "pronunciation": "baw-dad'", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "בָּדָד", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-m", "senses": [{"definition": "n m"}, {"definition": "isolation,  withdrawal,  separation", "senses": [{"definition": "an isolated city"}]}, {"definition": "adv"}, {"definition": "alone", "senses": [{"definition": "security (fig.)"}]}]}, "strong_number": "910", "transliteration": "bâdâd", "pronunciation": "baw-dawd'", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "בָּדָד", "parent_lexicon": "Jastrow Dictionary", "rid": "B00108", "language_code": "(b. h.;", "refs": ["Jastrow, בָּדַד 1", "Sanhedrin 104a:12"], "content": {"senses": [{"definition": " <a class=\"refLink\" href=\"/Jastrow,_בָּדַד.1\" data-ref=\"Jastrow, בָּדַד 1\">preced.</a>) <i>loneliness</i>, (adv.) <i>in a lonely state, in exile</i>. <a class=\"refLink\" href=\"/Sanhedrin.104a.12\" data-ref=\"Sanhedrin 104a:12\">Snh. 104ᵃ</a> <span dir=\"rtl\">יהיה ב׳ מושבם</span> the exile shall be their dwelling. <a class=\"refLink\" href=\"/Eichah_Rabbah.1.1\" data-ref=\"Eichah Rabbah 1:1\">Lam. R. to I, 1</a> <span dir=\"rtl\">בגדי ב׳</span> garments (outfit) of exile, v. preced.—Pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_*בְּדָדִין.1\" data-ref=\"Jastrow, *בְּדָדִין 1\">בְּדָדִים</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_*בְּדָדִין.1\" data-ref=\"Jastrow, *בְּדָדִין 1\">בְּדָדִין</a>. Ib. <span dir=\"rtl\">בגדי ב׳</span> (plur. abstr. as <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חַיִּים.1\" data-ref=\"Jastrow, חַיִּים 1\">חיים</a> &c.)."}], "morphology": "m."}, "plural_form": ["בְּדָדִים", "בְּדָדִין"], "alt_headwords": [], "quotes": [], "prev_hw": "בָּדַד", "next_hw": "בַּדָּד", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "בָּדָד", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "adv.", "senses": [{"definition": "alone."}]}, "rid": "B00072", "refs": ["Klein Dictionary, לְבָדָד 1", "Klein Dictionary, בדד 1", "Klein Dictionary, לְבָדָד 1", "Klein Dictionary, בדד 1", "Klein Dictionary, לְבָדָד 1", "Klein Dictionary, לְבָדָד 1"], "prev_hw": "בדד", "next_hw": "בַּדָּד", "notes": "[Derived from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_בדד.1\" data-ref=\"Klein Dictionary, בדד 1\">בדד</a>. See <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_לְבָדָד.1\" data-ref=\"Klein Dictionary, לְבָדָד 1\">לְבָדָד</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "בָּדַד", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>vb. be separate, isolated (</strong>Arabic <span dir=\"rtl\">بَدَّ</span> <em>cause to withdraw;</em> ii. <em>separate, disunite</em>, <a data-ref=\"Genesis 11:8\" href=\"/Genesis.11.8\">Gn 11:8</a> Saad.; iv. <em>divide into parts;</em> x. <em>go alone, act independently</em><strong>)</strong>, only Pt. <span dir=\"rtl\">בּוֹדֵד</span> <a data-ref=\"Isaiah 14:31\" href=\"/Isaiah.14.31\">Is 14:31</a> (of straggler in army), <a data-ref=\"Hosea 8:9\" href=\"/Hosea.8.9\">Ho 8:9</a> <span dir=\"rtl\">פֶּרֶא בוֹדֵד לוֹ</span> a wild-ass (sim. of Ephr.) <em>going alone</em> for itself (i.e. wilfully: v. sub <a data-ref=\"BDB, לְ\" href=\"/BDB,_לְ\", dir=\"rtl\">לְ</a>), <a data-ref=\"Psalms 102:8\" href=\"/Psalms.102.8\">ψ 102:8</a> (of bird sitting solitarily)."}]}, "rid": "BDB01026", "strong_numbers": ["909"], "next_hw": "בַּד³", "prev_hw": "בָּדָא", "all_cited": true, "ordinal": "I.", "brackets": "first_word", "root": true, "quotes": [], "GK": ["969"], "TWOT": ["201"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "בָּדָד", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.</strong>[<strong>m.</strong>] <strong>isolation, separation</strong>: <a data-ref=\"Isaiah 27:10\" href=\"/Isaiah.27.10\">Is 27:10</a> <span dir=\"rtl\">עִיר בְּצוּרָה בָּדָד</span> the fenced city is <em>isolation</em>, i.e. is solitary (subst. for adj.: Dr<sup>§ 189.2</sup>); more usually as adv. accus., to signify <em>alone</em>, <a data-ref=\"Deuteronomy 32:12\" href=\"/Deuteronomy.32.12\">Dt 32:12</a>; especially with vbs. of dwelling, <a data-ref=\"Leviticus 13:46\" href=\"/Leviticus.13.46\">Lv 13:46</a> <span dir=\"rtl\">בָּדָד יֵשֵׁב</span> he shall dwell <em>alone</em> (lit. <em>in isolation</em>), <a data-ref=\"Jeremiah 15:17\" href=\"/Jeremiah.15.17\">Je 15:17</a> <a data-ref=\"Lamentations 1:1\" href=\"/Lamentations.1.1\">La 1:1</a>; <a data-ref=\"Lamentations 3:28\" href=\"/Lamentations.3.28\">3:28</a>: fig. of freedom from attack, security <a data-ref=\"Deuteronomy 33:28\" href=\"/Deuteronomy.33.28\">Dt 33:28</a> (of Isr.), <a data-ref=\"Jeremiah 49:31\" href=\"/Jeremiah.49.31\">Je 49:31</a> (Kedar); so <span dir=\"rtl\">לְבָדָד</span> <a data-ref=\"Numbers 23:9\" href=\"/Numbers.23.9\">Nu 23:9</a> (Isr.) <a data-ref=\"Micah 7:14\" href=\"/Micah.7.14\">Mi 7:14</a> <a data-ref=\"Psalms 4:9\" href=\"/Psalms.4.9\">ψ 4:9</a> for thou <span dir=\"rtl\">לְבָדָד לָבֶטַח תּוֹשִׁיבֵנִי</span> makest me dwell <em>solitarily</em>, in safety (v. <a data-ref=\"Deuteronomy 33:28\" href=\"/Deuteronomy.33.28\">Dt 33:28</a>)."}]}, "rid": "BDB01028", "strong_numbers": ["910"], "next_hw": "בדד", "prev_hw": "בַּד³", "all_cited": true, "quotes": [], "GK": ["970"], "TWOT": ["201b"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "בָּדָד", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>תה\"פ, – א) נבדל ונפרד מזולתו, יחיד, einsam, isoliert; isolé; alone: בָּדָד ישב מחוץ למחנה (<span class=\"by-source\">ויקר' יג מו</span>). ישב בָּדָד וידם (<span class=\"by-source\">איכה ג כח</span>). גוי שליו יושב לבטח לא דלתים ולא בריח לו בָּדָד ישכנו (<span class=\"by-source\">ירמ' מט לא</span>). וישכן ישראל בטח בָּדָד (<span class=\"by-source\">דבר' לג כח</span>). – ובמשמעת לבדו: ה' בָּדָד  ינחנו ואין עמו אל נכר (<span class=\"by-source\">דבר' לב יב</span>).  – ועם ל: לְבָדָד: הן עם לְבָדָד ישכן (<span class=\"by-source\">במד' כג ט</span>), בטח, או לבדו. אתה ה' לְבָדָד לבטח תושיבני (<span class=\"by-source\">תהל' ד ט</span>), כמו לבטח. רעה עמך בשבטך צאן נחלתך שכני לְבָדָד (<span class=\"by-source\">מיכה ז יד</span>). – ולעיר וכיוצא בזה: איכה ישבה בָדָד העיר (<span class=\"by-source\">איכה א א</span>), עזובה, שוממה. כי עיר בצורה בָּדָד נוה משלח  ונעזב כמדבר (<span class=\"by-source\">ישעי' כז י</span>).</p>"]}, "rid": "BY-01478", "prev_hw": "בדד I", "next_hw": "בָּדַד", "page_num": 461, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]