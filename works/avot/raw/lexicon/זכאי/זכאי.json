[{"headword": "זַכַּאי I", "parent_lexicon": "Jastrow Dictionary", "rid": "G00440", "refs": ["Shabbat 32a:5", "Taanit 29a:11", "Sanhedrin 11a:7", "Sotah 48b:8", "Jastrow, זָכָה 1", "Sotah 48b:8", "Sanhedrin 45a:5"], "content": {"senses": [{"definition": " (<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_זָכָה.1\" data-ref=\"Jastrow, זָכָה 1\">זָכָה</a>) "}, {"definition": "<i>clear, guiltless, righteous; deserving, worthy</i> (corresp. to b. h. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_צַדִּיק.1\" data-ref=\"Jastrow, צַדִּיק 1\">צַדִּיק</a>), opp. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_חַיָּיב.1\" data-ref=\"Jastrow, חַיָּיב 1\">חַיָּיב</a>. <a class=\"refLink\" href=\"/Shabbat.32a.5\" data-ref=\"Shabbat 32a:5\">Sabb. 32ᵃ</a>, a. e. <span dir=\"rtl\">מגלגלין זכות ע\"י ז׳</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_גִּלְגֵּל.1\" data-ref=\"Jastrow, גִּלְגֵּל 1\">גִּלְגֵּל</a>.—<span dir=\"rtl\">יום ז׳</span> a lucky day, anniversary of joyous events. <a class=\"refLink\" href=\"/Taanit.29a.11\" data-ref=\"Taanit 29a:11\">Taan. 29ᵃ</a>; a. e.—<a class=\"refLink\" href=\"/Sanhedrin.11a.7\" data-ref=\"Sanhedrin 11a:7\">Snh. 11ᵃ</a> <span dir=\"rtl\">אין דורו ז׳ לכך</span> his generation is not deserving it (<a class=\"refLink\" href=\"/Sotah.48b.8\" data-ref=\"Sotah 48b:8\">Sot. 48ᵇ</a> <span dir=\"rtl\">זכאין</span>, pl.); a. fr.", "number": "1)"}, {"definition": "<i>acquitted, not guilty</i>. <a class=\"refLink\" href=\"/Mishnah_Sanhedrin.3.6\" data-ref=\"Mishnah Sanhedrin 3:6\">Snh. III, 6</a> <span dir=\"rtl\">שנים אומרים ז׳</span> if two vote, ‘Not guilty’; a. fr.", "number": "—2)"}, {"definition": "<i>entitled to possession</i> or <i>disposal, having authority, a right</i> &c.; v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_זָכָה.1\" data-ref=\"Jastrow, זָכָה 1\">זָכָה</a>.—<a class=\"refLink\" href=\"/Mishnah_Ketubot.4.4\" data-ref=\"Mishnah Ketubot 4:4\">Keth. IV, 4</a> <span dir=\"rtl\">האב ז׳ בבתו וכ׳</span> the father has authority over his (minor) daughter to give her away in marriage by receiving a consideration &c.; <span dir=\"rtl\">וז׳ במציאתה וכ׳</span> and has the right of possession of what she finds … and of interference with her vows; a. fr.—Pl. <span dir=\"rtl\">זַכָּאִין</span>. <a class=\"refLink\" href=\"/Pirkei_Avot.1.8\" data-ref=\"Pirkei Avot 1:8\">Ab. I, 8</a> <span dir=\"rtl\">כז׳</span> as if both (claimant and defendant) had been right. <a class=\"refLink\" href=\"/Sotah.48b.8\" data-ref=\"Sotah 48b:8\">Sot. 48ᵇ</a>, v. supra; a. fr.—Fem. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_זַכָּאָה.1\" data-ref=\"Jastrow, זַכָּאָה 1\">זַכָּאָה</a>. <a class=\"refLink\" href=\"/Sanhedrin.45a.5\" data-ref=\"Sanhedrin 45a:5\">Snh. 45ᵃ</a> <span dir=\"rtl\">שמא תצא … ז׳</span> she may be acquitted in court.", "number": "—3)"}], "morphology": "m."}, "plural_form": ["זַכָּאִין"], "alt_headwords": [], "quotes": [], "prev_hw": "זַכָּאוּתָא", "next_hw": "זַכַּאי", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "זַכַּאי", "parent_lexicon": "Jastrow Dictionary", "rid": "G00441", "language_code": " ch. ", "refs": ["Jastrow, זַכַּאי I 1"], "language_reference": "<a class=\"refLink\" href=\"/Jastrow,_זַכַּאי I.1\" data-ref=\"Jastrow, זַכַּאי I 1\">same</a>", "content": {"senses": [{"definition": ", <i>righteous, innocent</i>. <a class=\"refLink\" href=\"/Onkelos_Genesis.6.9\" data-ref=\"Onkelos Genesis 6:9\">Targ. Gen. VI, 9</a>; a. e.—Pl. <span dir=\"rtl\">זַכָּאִין</span>. <a class=\"refLink\" href=\"/Targum_Jonathan_on_Jeremiah.19.4\" data-ref=\"Targum Jonathan on Jeremiah 19:4\">Targ. Jer. XIX, 4</a>; a. e.—V. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_זַכַּי.1\" data-ref=\"Jastrow, זַכַּי 1\">זַכַּי</a>."}]}, "plural_form": ["זַכָּאִין"], "quotes": [], "prev_hw": "זַכַּאי I", "next_hw": "זַכַּאי II", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "זַכַּאי II", "parent_lexicon": "Jastrow Dictionary", "rid": "G00442", "language_code": "(b. h. ", "refs": ["Jastrow, זְכֵי 1", "Sanhedrin 41b:1", "Chullin 52a:7", "Chullin 52a:11", "Sanhedrin 62a:5", "Sanhedrin 62a:7", "Jerusalem Talmud Shabbat 7:2:8", "Jerusalem Talmud Yevamot 8:3:5", "Jerusalem Talmud Ketubot 4:6:3", "Jerusalem Talmud Yevamot 7:5:5", "Jerusalem Talmud Megillah 4:5:3"], "language_reference": "<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_זְכֵי.1\" data-ref=\"Jastrow, זְכֵי 1\"><a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_זְכֵי.1\" data-ref=\"Jastrow, זְכֵי 1\">זַכָּי</a>)</a>", "content": {"senses": [{"definition": "<i>Zakkai</i>, "}, {"definition": " father of R. Johanan. <a class=\"refLink\" href=\"/Sanhedrin.41b.1\" data-ref=\"Sanhedrin 41b:1\">Snh. 41ᵇ</a> <span dir=\"rtl\">כי הוה למד בן ז׳ וכ׳</span> when he was a student, they called him Ben Z. when he was a student, they called him Ben Z. &c. <a class=\"refLink\" href=\"/Pirkei_Avot.2.8\" data-ref=\"Pirkei Avot 2:8\">Ab. II, 8</a>; a. fr.", "number": "1)"}, {"definition": " (<span dir=\"rtl\">בר</span>) <span dir=\"rtl\">בן ז׳</span> <i>Ben</i> (<i>Bar</i>) <i>Z</i>. <a class=\"refLink\" href=\"/Chullin.52a.11\" data-ref=\"Chullin 52a:11\">Ḥull. 52ᵃ</a>", "number": "—2)"}, {"definition": "<i>R. Z.</i>, also <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_זַכַּיי.1\" data-ref=\"Jastrow, זַכַּיי 1\">זַכַּיי</a> name of several Amoraim. <a class=\"refLink\" href=\"Jerusalem_Talmud_Shabbat.7.2.8\" data-ref=\"Jerusalem Talmud Shabbat 7: