[{"headword": "מִדְבָּר", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-m", "senses": [{"definition": "wilderness", "senses": [{"definition": "pasture"}, {"definition": "uninhabited land, wilderness"}, {"definition": "large tracts of wilderness (around cities)"}, {"definition": "wilderness (fig.)"}]}, {"definition": "mouth", "senses": [{"definition": "mouth (as organ of speech)"}]}]}, "strong_number": "4057", "transliteration": "midbâr", "pronunciation": "mid-bawr'", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "בְּמִדְבַּר", "parent_lexicon": "Jastrow Dictionary", "rid": "B00924", "refs": ["Bereishit Rabbah 3:5", "Bereishit Rabbah 3:9"], "content": {"senses": [{"definition": "<i>the fourth book of Moses</i> (<i>Numeri</i>). <a class=\"refLink\" href=\"/Bereishit_Rabbah.3.9\" data-ref=\"Bereishit Rabbah 3:9\">Gen. R. s. 3</a>; a. e.—<span dir=\"rtl\">ב׳ רבה</span> the fourth book of Midrash Rabbah (Num. R.)."}], "morphology": "m."}, "plural_form": [], "alt_headwords": ["סֵפֶר ב׳"], "quotes": [], "prev_hw": "במגנימין", "next_hw": "בָּמָה", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מְדַבֵּר", "parent_lexicon": "Jastrow Dictionary", "rid": "M00240", "refs": ["Berakhot 63b:6", "Tosefta Bekhorot 4:11", "Kiddushin 25a"], "content": {"senses": [{"definition": " (<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דָּבַר.1\" data-ref=\"Jastrow, דָּבַר 1\">דָּבַר</a>) "}, {"definition": "<i>speaker</i>.—Pl. <span dir=\"rtl\">מְדַבְּרִים</span>. <a class=\"refLink\" href=\"/Berakhot.63b.6\" data-ref=\"Berakhot 63b:6\">Ber. 63ᵇ</a>, a. e. <span dir=\"rtl\">ראש המ׳ וכ׳</span> the first among the speakers on all occasions (attribute of R. Judah).–", "number": "1)"}, {"definition": "<i>the anterior part of the tongue</i>. <a class=\"refLink\" href=\"/Mishnah_Bekhorot.6.8\" data-ref=\"Mishnah Bekhorot 6:8\">Bekh. VI, 8</a>; <a class=\"refLink\" href=\"/Tosefta_Bekhorot.4.11\" data-ref=\"Tosefta Bekhorot 4:11\">Tosef. ib. IV, 11</a>; <a class=\"refLink\" href=\"/Kiddushin.25a\" data-ref=\"Kiddushin 25a\">Kidd. 25ᵃ</a>", "number": "2)"}], "morphology": "m."}, "plural_form": ["מְדַבְּרִים"], "alt_headwords": [], "quotes": [], "prev_hw": "מַדְבַּק", "next_hw": "מִדְבָּר", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מִדְבָּר", "parent_lexicon": "Jastrow Dictionary", "rid": "M00241", "language_code": "(b. h.;", "refs": ["Jastrow, דְּבַר 1", "Bereishit Rabbah 31", "Shir HaShirim Rabbah 4:4:8", "Shir HaShirim Rabbah 3", "Bava Batra 73b:11", "Tosefta Makkot 3", "Tosefta Makkot 2:2", "Makkot 9b:16", "Menachot 87a", "Sotah 34b", "Berakhot 54b:12"], "content": {"senses": [{"definition": " v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דְּבַר.1\" data-ref=\"Jastrow, דְּבַר 1\">דְּבַר</a>) <i>pasture-ground, desert</i>. <a class=\"refLink\" href=\"/Bereishit_Rabbah.31\" data-ref=\"Bereishit Rabbah 31\">Gen. R. s. 31</a>, end. <a class=\"refLink\" href=\"/Shir_HaShirim_Rabbah.4.4.8\" data-ref=\"Shir HaShirim Rabbah 4:4:8\">Cant. R. to IV, 4</a> (play on <span dir=\"rtl\">מדברך</span> <a class=\"refLink\" href=\"/Shir_HaShirim_Rabbah.3\" data-ref=\"Shir HaShirim Rabbah 3\">ib. 3</a>) <span dir=\"rtl\">אע\"פ שהוא מ׳וכ׳</span> although the Temple is a desert, you are bound to observe the sacredness of its precincts now that it is ruined &c.; a. fr.—<span dir=\"rtl\">מֵתֵי מ׳</span> the generation that died in the wilderness. <a class=\"refLink\" href=\"/Bava_Batra.73b.11\" data-ref=\"Bava Batra 73b:11\">B. Bath. 73ᵇ</a> bot.; a. fr.—<a class=\"refLink\" href=\"/Tosefta_Makkot.3\" data-ref=\"Tosefta Makkot 3\">Tosef. Macc. III</a> (<a class=\"refLink\" href=\"/Tosefta_Makkot.2.2\" data-ref=\"Tosefta Makkot 2:2\">II), 2</a>; <a class=\"refLink\" href=\"/Makkot.9b.16\" data-ref=\"Makkot 9b:16\">Macc. 9ᵇ</a>; Y. ib. II, 31ᵈ top <span dir=\"rtl\">בצר במ׳</span> (b. h.) <i>Bezer in the Wilderness</i>, on the eastern side of the Jordan.—<a class=\"refLink\" href=\"/Tosefta_Menahot.9.13\" data-ref=\"Tosefta Menahot 9:13\">Tosef. Men. IX, 13</a> <span dir=\"rtl\">כבשים ממ׳</span>, read: <span dir=\"rtl\">ממִדְבַּר חברון</span> from the pasture-ground of Hebron; v. <a class=\"refLink\" href=\"/Menachot.87a\" data-ref=\"Menachot 87a\">Men. 87ᵃ</a>; <a class=\"refLink\" href=\"/Sotah.34b\" data-ref=\"Sotah 34b\">Sot. 34ᵇ</a>.—Pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_מִדַּבְּרוֹת.1\" data-ref=\"Jastrow, מִדַּבְּרוֹת 1\">מִדְבָּרוֹת</a>. <a class=\"refLink\" href=\"/Mishnah_Berakhot.9.2\" data-ref=\"Mishnah Berakhot 9:2\">Ber. IX, 2</a>. <a class=\"refLink\" href=\"/Berakhot.54b.12\" data-ref=\"Berakhot 54b:12\">Ib. 54ᵇ</a> <span dir=\"rtl\">הולכי מ׳</span> those travelling in the deserts; a. e."}], "morphology": "m."}, "plural_form": ["מִדְבָּרוֹת"], "alt_headwords": [], "quotes": [], "prev_hw": "מְדַבֵּר", "next_hw": "מַדְבְּרָא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מִדְבָּר ᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"plural_form": "(pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מִדְבָּרִי.1\" data-ref=\"Klein Dictionary, מִדְבָּרִי 1\">מִדְבָּרִים</a>, also <span dir=\"rtl\">מִדְבָּרוֹת</span> and <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מִדְבָּרִיּוּת.1\" data-ref=\"Klein Dictionary, מִדְבָּרִיּוּת 1\">מִדְבָּרִיּוֹת</a>)", "definition": "wilderness, desert."}]}, "rid": "M00558", "refs": ["Klein Dictionary, מִדְבָּרִי 1", "Klein Dictionary, מִדְבָּרִיּוּת 1", "Klein Dictionary, מִדְבָּרִי 1", "Klein Dictionary, מִדְבָּרִיּוּת 1", "Klein Dictionary, מִ◌ 1", "Klein Dictionary, דבר ᴵᴵ 1", "Klein Dictionary, מִדְבָּר ᴵ 1", "Klein Dictionary, דבר ᴵᴵ 1", "Klein Dictionary, מִקְרָא 1", "Klein Dictionary, מִקְרָא 1", "Klein Dictionary, קרא ᴵ 1", "Klein Dictionary, דבר ᴵ 1", "Klein Dictionary, מִגְרָשׁ 1", "Klein Dictionary, גרשׁ 1", "Klein Dictionary, מִ◌ 1", "Klein Dictionary, דבר ᴵᴵ 1", "Klein Dictionary, מִדְבָּר ᴵ 1", "Klein Dictionary, דבר ᴵᴵ 1", "Klein Dictionary, מִקְרָא 1", "Klein Dictionary, מִקְרָא 1", "Klein Dictionary, קרא ᴵ 1", "Klein Dictionary, דבר ᴵ 1", "Klein Dictionary, מִגְרָשׁ 1", "Klein Dictionary, גרשׁ 1", "Klein Dictionary, מִדְבָּרִי 1", "Klein Dictionary, מִדְבָּרִי 1"], "derivatives": "Derivative: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מִדְבָּרִי.1\" data-ref=\"Klein Dictionary, מִדְבָּרִי 1\">מִדְבָּרִי</a>.", "prev_hw": "מַדְבֵּקָה", "next_hw": "מִדְבָּר ᴵᴵ", "notes": "[Formed with local pref. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מִ◌.1\" data-ref=\"Klein Dictionary, מִ◌ 1\">מִ◌</a> from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דבר ᴵᴵ.1\" data-ref=\"Klein Dictionary, דבר ᴵᴵ 1\">דבר ᴵᴵ</a> and orig. meaning ‘pasturage’, lit.: ‘the place whither cattle are driven’. cp. Aram. <span dir=\"rtl\">מִדְבְּרָא</span>, <span dir=\"rtl\">מַדְבְּרָא</span>, Ugar. <i>mdbr</i> (= wilderness, desert). According to my opinion the noun <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מִדְבָּר ᴵ.1\" data-ref=\"Klein Dictionary, מִדְבָּר ᴵ 1\">מִדְבָּר</a> was orig. an infinitive meaning ‘to drive’ (cattle), derived from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דבר ᴵᴵ.1\" data-ref=\"Klein Dictionary, דבר ᴵᴵ 1\">דבר ᴵᴵ</a> (= to drive). cp. the infinitive <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מִקְרָא.1\" data-ref=\"Klein Dictionary, מִקְרָא 1\">מִקְרָא</a> in the phrase <span dir=\"rtl\">וְהָיוּ לְךָ לְמִקְרָא</span> (<a class=\"refLink\" href=\"/Numbers.10.2\" data-ref=\"Numbers 10:2\">Num. 10:2</a>), where <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מִקְרָא.1\" data-ref=\"Klein Dictionary, מִקְרָא 1\">מִקְרָא</a> is obviously the inf. of <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_קרא ᴵ.1\" data-ref=\"Klein Dictionary, קרא ᴵ 1\">קרא</a> (= to call), which later became a noun meaning ‘convocation’. For sense development cp. the related Aram. <span dir=\"rtl\">דַּבְרָא</span> (= field), from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דבר ᴵ.1\" data-ref=\"Klein Dictionary, דבר ᴵ 1\">דְּבַר</a> (= to lead). cp. also (= <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מִגְרָשׁ.1\" data-ref=\"Klein Dictionary, מִגְרָשׁ 1\">מִגְרָשׁ</a> common land, orig. ‘pasture’, and properly ‘land whither cattle are driven’), from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_גרשׁ.1\" data-ref=\"Klein Dictionary, גרשׁ 1\">גרשׁ</a>, ‘to drive out’.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מִדְבָּר ᴵᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "speech, talk (a hapax legomenon in the Bible, occurring <a class=\"refLink\" href=\"/Song_of_Songs.4.3\" data-ref=\"Song of Songs 4:3\">Cant. 4:3</a> in the form <span dir=\"rtl\">מִדְבָּרֵךָ</span>, ‘your speech’)."}]}, "rid": "M00559", "refs": ["Klein Dictionary, דבר ᴵ 1", "Klein Dictionary, מִי ᴵᴵ 1", "Klein Dictionary, דבר ᴵ 1", "Klein Dictionary, מִי ᴵᴵ 1"], "prev_hw": "מִדְבָּר ᴵ", "next_hw": "מַדְבֵּר", "notes": "[Formed from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דבר ᴵ.1\" data-ref=\"Klein Dictionary, דבר ᴵ 1\">דבר ᴵ</a> (= to speak), with pref. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מִי ᴵᴵ.1\" data-ref=\"Klein Dictionary, מִי ᴵᴵ 1\">מִ◌ ᴵᴵ</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מַדְבֵּר", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "suppressor."}]}, "rid": "M00560", "language_code": "NH", "refs": ["Klein Dictionary, דבר ᴵᴵ 1", "Klein Dictionary, מַ◌ 1", "Klein Dictionary, דבר ᴵᴵ 1", "Klein Dictionary, מַ◌ 1"], "prev_hw": "מִדְבָּר ᴵᴵ", "next_hw": "מְדַבֵּר", "notes": "[Formed from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דבר ᴵᴵ.1\" data-ref=\"Klein Dictionary, דבר ᴵᴵ 1\">דבר ᴵᴵ</a> (= to drive), with pref. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מַ◌.1\" data-ref=\"Klein Dictionary, מַ◌ 1\">מַ◌</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מְדַבֵּר", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "speaker.", "number": "1", "language_code": "NH"}, {"definition": "man (in contradistinction to animals).", "number": "2", "language_code": "MH"}, {"definition": "first person (grammar).", "number": "3", "language_code": "MH"}]}, "rid": "M00561", "refs": ["Klein Dictionary, דבר ᴵ 1", "Klein Dictionary, דבר ᴵ 1", "Klein Dictionary, דבר ᴵ 1", "Klein Dictionary, דבר ᴵ 1"], "prev_hw": "מַדְבֵּר", "next_hw": "מְדֻבָּר", "notes": "[Subst. use of <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דבר ᴵ.1\" data-ref=\"Klein Dictionary, דבר ᴵ 1\">דִבֵּר</a> (= he spoke), Pi. of <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דבר ᴵ.1\" data-ref=\"Klein Dictionary, דבר ᴵ 1\">דבר ᴵ</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מְדֻבָּר", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "adj.", "senses": [{"definition": "spoken of, said."}]}, "rid": "M00562", "language_code": "NH", "refs": ["Klein Dictionary, דבר ᴵ 1", "Klein Dictionary, דבר ᴵ 1", "Klein Dictionary, דבר ᴵ 1", "Klein Dictionary, דבר ᴵ 1"], "prev_hw": "מְדַבֵּר", "next_hw": "מִדְבָּרִי", "notes": "[Part. of <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דבר ᴵ.1\" data-ref=\"Klein Dictionary, דבר ᴵ 1\">דֻּבַּר</a> (= was spoken), Pu. of <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דבר ᴵ.1\" data-ref=\"Klein Dictionary, דבר ᴵ 1\">דבר ᴵ</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מִדְבָּר", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.m.</strong> mouth, as organ of speech,—<span dir=\"rtl\">מִדְבָּרֵךְ נָאוֶה</span> <em>thy mouth is lovely</em> <a data-ref=\"Song of Songs 4:3\" href=\"/Song_of_Songs.4.3\">Ct 4:3</a> ‖<span dir=\"rtl\">שִׂפְתוֹתַיִךְ</span>, 𝔊 λαλιά, Jer <em>eloquium</em>."}]}, "rid": "BDB02027", "strong_numbers": ["4057"], "next_hw": "מִדְבָּר²", "prev_hw": "דִּבְרִי", "all_cited": true, "ordinal": "I.", "brackets": "first_word", "quotes": [], "GK": ["4497", "4498"], "TWOT": ["399k", "399l"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מִדְבָּר²", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.m. wilderness</strong>—<a data-ref=\"Deuteronomy 32:10\" href=\"/Deuteronomy.32.10\">Dt 32:10</a> +; c. ה loc. <span dir=\"rtl\">מִדְבָּ֫רָה</span> <a data-ref=\"Joshua 18:12\" href=\"/Joshua.18.12\">Jos 18:12</a> + 15 times; cstr. <a data-ref=\"Exodus 15:22\" href=\"/Exodus.15.22\">Ex 15:22</a> +; <span dir=\"rtl\">מִדְבַּ֫רָה</span> <a data-ref=\"I Kings 19:15\" href=\"/I_Kings.19.15\">1 K 19:15</a>; sf. <span dir=\"rtl\">מִדְבָּרָהּ</span> <a data-ref=\"Isaiah 51:3\" href=\"/Isaiah.51.3\">Is 51:3</a>;—"}, {"senses": [{"definition": "tracts of land, used for the pasturage of flocks and herds, <span dir=\"rtl\">דָּֽשְׁאוּ נְאוֹת מִדְבָּר</span> <em>the pastures of the wilderness put forth green grass</em> <a data-ref=\"Joel 2:22\" href=\"/Joel.2.22\">Jo 2:22</a>; <span dir=\"rtl\">יִרְעֲפוּ נ׳ מ׳</span> <em>the pastures of the wilderness drop</em> (fertility) <a data-ref=\"Psalms 65:13\" href=\"/Psalms.65.13\">ψ 65:13</a>; <span dir=\"rtl\">יָֽבְשׁוּ נ׳ מ׳</span> <em>are dried up</em> <a data-ref=\"Jeremiah 23:10\" href=\"/Jeremiah.23.10\">Je 23:10</a>, cf. <a data-ref=\"Jeremiah 9:9\" href=\"/Jeremiah.9.9\">Je 9:9</a> <a data-ref=\"Joel 1:19\" href=\"/Joel.1.19\">Jo 1:19</a>, <a data-ref=\"Joel 1:20\" href=\"/Joel.1.20\">20</a>."}], "num": "1."}, {"senses": [{"definition": "<em>uninhabited land</em>, <span dir=\"rtl\">מִדְבָּר לֹא־אָדָם בּוֹ</span> <em>wilderness in which is no man</em> <a data-ref=\"Job 38:26\" href=\"/Job.38.26\">Jb 38:26</a>; the abode of pelicans <a data-ref=\"Psalms 102:7\" href=\"/Psalms.102.7\">ψ 102:7</a>; wild asses <a data-ref=\"Job 24:5\" href=\"/Job.24.5\">Jb 24:5</a> <a data-ref=\"Jeremiah 2:24\" href=\"/Jeremiah.2.24\">Je 2:24</a>; jackals <a data-ref=\"Malachi 1:3\" href=\"/Malachi.1.3\">Mal 1:3</a>; ostriches <a data-ref=\"Lamentations 4:3\" href=\"/Lamentations.4.3\">Lam 4:3</a>; <span dir=\"rtl\">מִי־יִתְּנֵנִי בַמִּדְבָּר מְלוֹן אֹרְחִים וְאֶֽעֶזְבָה אֶת־עַמִּי</span> <em>O that I had in the wilderness a lodging place of wayfarers, that I might leave my people</em> <a data-ref=\"Jeremiah 9:1\" href=\"/Jeremiah.9.1\">Je 9:1</a>; <span dir=\"rtl\">טוֹב שֶׁבֶת בְּאֶרֶץ מִדְבָּר</span> <em>better to dwell in a desert land</em>, than with a contentious woman <a data-ref=\"Proverbs 21:19\" href=\"/Proverbs.21.19\">Pr 21:19</a>; <span dir=\"rtl\">בְּאֶרֶץ מִדְבָּר וּבְתֹהוּ יְלֵל יְשִׁמֹן</span> <em>in a desert land, and in a waste howling wilderness</em> <a data-ref=\"Deuteronomy 32:10\" href=\"/Deuteronomy.32.10\">Dt 32:10</a>."}], "num": "2."}, {"senses": [{"definition": "<em>large tracts</em> of such land bearing various names, in certain districts of which there might be towns and cities: <span dir=\"rtl\">יִשְׂאוּ מִדְבָּר וְעָרָיו חֲצֵרִים תֵּשֵׁב קֵדָר</span> <em>let the wilderness and its cities lift up</em> (their voice), <em>the villages that Kedar doth inhabit</em> <a data-ref=\"Isaiah 42:11\" href=\"/Isaiah.42.11\">Is 42:11</a>. There were six cities in the wilderness of Judah <a data-ref=\"Joshua 15:61\" href=\"/Joshua.15.61\">Jos 15:61</a>, <a data-ref=\"Joshua 15:62\" href=\"/Joshua.15.62\">62</a>; <span dir=\"rtl\">הַמִּדְבָּר</span> usually = wilderness of the wanderings <a data-ref=\"Genesis 14:6\" href=\"/Genesis.14.6\">Gn 14:6</a> <a data-ref=\"Numbers 14:16\" href=\"/Numbers.14.16\">Nu 14:16</a>, <a data-ref=\"Numbers 14:29\" href=\"/Numbers.14.29\">29</a>, <a data-ref=\"Numbers 14:32\" href=\"/Numbers.14.32\">32</a>, <a data-ref=\"Numbers 14:33\" href=\"/Numbers.14.33\">33</a><sup>(×2)</sup> +, or the great Arabian desert <a data-ref=\"Judges 11:22\" href=\"/Judges.11.22\">Ju 11:22</a> +; but may also refer to any other <a data-ref=\"Song of Songs 3:6\" href=\"/Song_of_Songs.3.6\">Ct 3:6</a>; <a data-ref=\"Song of Songs 8:5\" href=\"/Song_of_Songs.8.5\">8:5</a>. Special tracts—(a) of the wilderness of the wanderings were <span dir=\"rtl\">מ׳ שׁוּר</span> <a data-ref=\"Exodus 15:22\" href=\"/Exodus.15.22\">Ex 15:22</a>, <span dir=\"rtl\">סין</span> <a data-ref=\"Exodus 16:1\" href=\"/Exodus.16.1\">Ex 16:1</a> +, <span dir=\"rtl\">סיני</span> <a data-ref=\"Exodus 19:1\" href=\"/Exodus.19.1\">Ex 19:1</a> +, <span dir=\"rtl\">פארן</span> <a data-ref=\"Numbers 13:26\" href=\"/Numbers.13.26\">Nu 13:26</a> +, <span dir=\"rtl\">צן</span> <a data-ref=\"Numbers 20:1\" href=\"/Numbers.20.1\">Nu 20:1</a> +, <span dir=\"rtl\">קדשׁ</span> <a data-ref=\"Psalms 29:8\" href=\"/Psalms.29.8\">ψ 29:8</a>, <span dir=\"rtl\">אתם</span> <a data-ref=\"Numbers 33:8\" href=\"/Numbers.33.8\">Nu 33:8</a>; (b) in W. Pal. <span dir=\"rtl\">מ׳ יהודה</span> <a data-ref=\"Judges 1:16\" href=\"/Judges.1.16\">Ju 1:16</a> <a data-ref=\"Psalms 63:1\" href=\"/Psalms.63.1\">ψ 63:1</a> cf. <a data-ref=\"Joshua 15:61\" href=\"/Joshua.15.61\">Jos 15:61</a>, <span dir=\"rtl\">מעוֹן</span> <a data-ref=\"I Samuel 23:24\" href=\"/I_Samuel.23.24\">1 S 23:24</a>, <a data-ref=\"I Samuel 23:25\" href=\"/I_Samuel.23.25\">25</a>, <span dir=\"rtl\">זיף</span> <a data-ref=\"I Samuel 23:15\" href=\"/I_Samuel.23.15\">1 S 23:15</a>; <a data-ref=\"I Samuel 26:2\" href=\"/I_Samuel.26.2\">26:2</a>, <span dir=\"rtl\">באר שׁבע</span> <a data-ref=\"Genesis 21:14\" href=\"/Genesis.21.14\">Gn 21:14</a>, <span dir=\"rtl\">עין גדי</span> <a data-ref=\"I Samuel 24:2\" href=\"/I_Samuel.24.2\">1 S 24:2</a>, <span dir=\"rtl\">תקוע</span> <a data-ref=\"II Chronicles 20:20\" href=\"/II_Chronicles.20.20\">2 Ch 20:20</a>, <span dir=\"rtl\">ירואל</span> <a data-ref=\"II Chronicles 20:16\" href=\"/II_Chronicles.20.16\">2 Ch 20:16</a>, <span dir=\"rtl\">גבעון</span> <a data-ref=\"II Samuel 2:24\" href=\"/II_Samuel.2.24\">2 S 2:24</a>; (c) in East. Palestine <span dir=\"rtl\">מואב</span> <a data-ref=\"Deuteronomy 2:8\" href=\"/Deuteronomy.2.8\">Dt 2:8</a>, <span dir=\"rtl\">אדום</span> <a data-ref=\"II Kings 3:8\" href=\"/II_Kings.3.8\">2 K 3:8</a>, <span dir=\"rtl\">קדמות</span> <a data-ref=\"Deuteronomy 2:26\" href=\"/Deuteronomy.2.26\">Dt 2:26</a>."}], "num": "3."}, {"senses": [{"definition": "fig. <span dir=\"rtl\">וְשַׂמְתִּיהָ כַמִּדְבָּר וְשַׁתִּהָ כְּאֶרֶץ צִיָּה</span> <em>and (lest I) make her as a wilderness and set her like a dry land</em> <a data-ref=\"Hosea 2:5\" href=\"/Hosea.2.5\">Ho 2:5</a>; <span dir=\"rtl\">הֲמִדְבָּר הָיִיתִי לְיִשְׂרָאֵל</span> <em>have I been a wilderness to Israel</em>? <a data-ref=\"Jeremiah 2:31\" href=\"/Jeremiah.2.31\">Je 2:31</a>."}], "num": "4."}]}, "rid": "BDB02028", "strong_numbers": ["4057"], "next_hw": "דבשׁ", "prev_hw": "מִדְבָּר", "ordinal": "II.", "occurrences": "270", "quotes": [], "GK": ["4497", "4498"], "TWOT": ["399k", "399l"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מִדְבָּר³", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "v. <a data-ref=\"BDB, דָּבָר\" href=\"/BDB,_דָּבָר\", dir=\"rtl\">דבר</a>."}]}, "rid": "BDB05085", "strong_numbers": ["4057"], "next_hw": "מָדַד", "prev_hw": "מַד", "ordinal": "I, II.", "quotes": [], "GK": ["4497", "4498"], "TWOT": ["399k", "399l"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}]