[{"headword": "רָמַם", "parent_lexicon": "Jastrow Dictionary", "rid": "T00826", "refs": ["Jastrow, רוּם 1"], "content": {"senses": [{"definition": ", <i>Pi.</i> <span dir=\"rtl\">רִימֵּם</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_רוּם.1\" data-ref=\"Jastrow, רוּם 1\">רוּם</a> h."}]}, "quotes": [], "prev_hw": "רמכוך", "next_hw": "רָמְמָא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "רָמַם I", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p><sup class=\"footnote-marker\">2</sup><i class=\"footnote\">[גם בערב' רַמַּ رم  במשמ' זו, וכן רִמַּה رمة, רקבון כמו רמה בעבר'.]</i>, פ\"י, יָרֻם, — רָקַב, שרץ תולעים, faulen; pourrir; to rot, decay: ויותרו אנשים ממנו עד בקר וַיָּרֻם<sup class=\"footnote-marker\">3</sup><i class=\"footnote\">[הטעם מלעיל.]</i> תולעים ויבאש (שמות יו כ). ואמר המשורר: אם היום ירום, מחר תולעים <strong>ירום</strong> (<span class=\"by-source\">רשב\"ג, כתר מלכות, יהיה רצון</span>). יזכר לו יום יחשך אורו גם תולעים גופו <strong>ירום</strong> (<span class=\"by-source\">רמב\"ע, הענק ח, ברודי, שעט</span>). בלוייו נקרעים <strong>וירום</strong> תולעים בשובו אל אדמה (<span class=\"by-source\">ראב\"ע, אשרי האיש, איגר 204</span>).</p>", "<p>— הָפע', *הוּרַם, — כמו קל, ואמר בן סירא: מה יגאה עפר ואפר אשר בחייו <strong>יורם</strong><sup class=\"footnote-marker\">4</sup><i class=\"footnote\">[ואולי צ\"ל <strong>ירום</strong>, קל.]</i> גויו (<span class=\"by-source\">ב\"ס, גני' י ט</span>).</p>", "<p>— הִפע', °הֵרֵם, הרים — שָׁרַץ רמה: אבל זה שהתליע בדרך נס יתכן <strong>שהרים</strong> תולעים תחלה וכו' כי אלו לא היה <strong>מרים</strong> תולעים עד אשר עלה באשו תחלה וכו' כעצים המתליעים והפירות <strong>המרימים</strong> תולעים באיביהן (<span class=\"by-source\">רמב\"ן, שמות טז כ</span>).</p>"]}, "rid": "BY-19005", "prev_hw": "רמם", "next_hw": "רָמַם II", "page_num": 6616, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}, {"headword": "רָמַם II", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>* <sup class=\"footnote-marker\">1</sup><i class=\"footnote\">[עי' בהערה הבאה.]</i>, קל לא נמצא.</p>", "<p>— פִע', *רִמֵּם, רימם<sup class=\"footnote-marker\">2</sup><i class=\"footnote\">[ואולי אין זה אלא שבוש במקום <strong>רומם</strong>, פוֹע'  מן <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_רוּם_I.1\" data-ref=\"Ben Yehuda Dictionary, רוּם I 1\">א. רום</a>, עי' שם.]</i>, — כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_רוֹמָם.1\" data-ref=\"Ben Yehuda Dictionary, רוֹמָם 1\">רוֹמם</a>: <strong>וריממן</strong> הקב\"ה על הכל שנא' ונתנך ה' אלהיך עליון (<span class=\"by-source\">מד\"ר שמות כה</span>).</p>"]}, "rid": "BY-19006", "prev_hw": "רָמַם I", "next_hw": "רמס I", "page_num": 6616, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]