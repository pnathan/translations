[{"headword": "גְּמִילוּת", "parent_lexicon": "Jastrow Dictionary", "rid": "C01029", "refs": ["Jastrow, גְּמִילָה 1", "Berakhot 5a", "Sotah 14a:6", "Devarim Rabbah 1"], "content": {"senses": [{"definition": " <span dir=\"rtl\">(גמל</span>), <span dir=\"rtl\">ג׳ חֲסָדִים</span> (also <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_גְּמִילָה.1\" data-ref=\"Jastrow, גְּמִילָה 1\">גְּמִילַת</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_גְּמִילָה.1\" data-ref=\"Jastrow, גְּמִילָה 1\">גְּמִילָה</a>) <i>deeds of love, charity</i> (abbr. <span dir=\"rtl\">ג\"ח</span>). <a class=\"refLink\" href=\"/Mishnah_Peah.1.1\" data-ref=\"Mishnah Peah 1:1\">Peah I, 1</a>. <a class=\"refLink\" href=\"/Berakhot.5a\" data-ref=\"Berakhot 5a\">Ber. 5ᵃ</a>. <a class=\"refLink\" href=\"/Sotah.14a.6\" data-ref=\"Sotah 14a:6\">Sot. 14ᵃ</a> the Torah <span dir=\"rtl\">תחילתה ג\"ח וכ׳</span> begins with charity (clothing the naked, <a class=\"refLink\" href=\"/Genesis.3.21\" data-ref=\"Genesis 3:21\">Gen. III, 21</a>) and ends with charity (burying the dead, <a class=\"refLink\" href=\"/Deuteronomy.34.6\" data-ref=\"Deuteronomy 34:6\">Deut. XXXIV, 6</a>); a. v. fr.—[<a class=\"refLink\" href=\"/Devarim_Rabbah.1\" data-ref=\"Devarim Rabbah 1\">Deut. R. s. 1</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_גְּמוּל.1\" data-ref=\"Jastrow, גְּמוּל 1\">גְּמוּל</a>.]"}], "morphology": "f."}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "גְּמִילָה", "next_hw": "גמיסיקין", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "גְּמִילוּת", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"definition": "used in the phrases <span dir=\"rtl\">גְּמִילוּת חֲסָדִים</span>, ‘benevolence, charity’; <span dir=\"rtl\">גְּמִילוּת חֶסֶד</span>, ‘loan (to the poor) without interest’."}]}, "rid": "C00723", "language_code": "PBH", "refs": ["Klein Dictionary, גמל ᴵᴵ 1", "Klein Dictionary, גמל ᴵ 1", "Klein Dictionary, גמל ᴵᴵ 1", "Klein Dictionary, ◌וּת 1", "Klein Dictionary, גמל ᴵ 1", "Klein Dictionary, גמל ᴵᴵ 1", "Klein Dictionary, גמל ᴵᴵ 1", "Klein Dictionary, ◌וּת 1"], "prev_hw": "גְּמִילָה ᴵᴵ", "next_hw": "גְּמִיעָה", "notes": "[Formed from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_גמל ᴵ.1\" data-ref=\"Klein Dictionary, גמל ᴵ 1\">גָּמַל</a>. See <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_גמל ᴵᴵ.1\" data-ref=\"Klein Dictionary, גמל ᴵᴵ 1\">גמל ᴵᴵ</a> and suff. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_◌וּת.1\" data-ref=\"Klein Dictionary, ◌וּת 1\">◌וּת</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "גְּמִילוּת", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>*, ש\"נ, — כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_גְּמִילָה.1\" data-ref=\"Ben Yehuda Dictionary, גְּמִילָה 1\">גְּמִילָה</a>, מעשה של גמילות חסד: אלו דברים שאין להם שיעור הפאה והבכורים והראיון <strong>וגמילות</strong><sup class=\"footnote-marker\">1</sup><i class=\"footnote\">הקרי הרגיל גמילוּת, אעפ\"י שאפשר שזה מ\"ר מן גמילה וצריך לקרוא גמילוֹת. אך מהמאמר: הדרך <strong>זו</strong> גמילות חסדים ולא אלו, נראה באמת כי הקריא האמתי הוא גמילוּת ולא גמילוֹת.</i> חסדים ותלמוד תורה (<span class=\"by-source\">פאה א א</span>).  ואין פוסקין הימנו (ממעשר עני) צדקה אבל משלחין הימנו דבר של <strong>גמילות</strong> חסדים (<span class=\"by-source\">תוספתא שם ד יו</span>).  צדקה <strong>וגמילות</strong> חסדים שקולין כנגד כל מצות שבתורה אלא שהצדקה בחיים <strong>גמילות </strong>חסדים בחיים ובמתים צדקה בעניים <strong>גמילות</strong> חסדים בעניים ובעשירים צדקה בממונו <strong>גמילות</strong> חסדים בגופו ובממונו (<span class=\"by-source\">שם יט</span>).  את הדרך זו <strong>גמילות</strong> חסדים ילכו זו ביקור חולים (<span class=\"by-source\">ב\"ק ק.</span>).  שנתגעשו ישראל לעשות <strong>גמילות</strong> חסד ליהושע (<span class=\"by-source\">מד\"ר רות, פתי' ב</span>), ר\"ל לעסוק בקבורתו כהגן.  אחד מהעמודים שעומדת עליהם הארץ ויושביה הוא <strong>גמילות</strong> חסדים עם כל אדם (<span class=\"by-source\">מנוה\"מ, ה א רכ</span>).</p>"]}, "rid": "BY-02853", "prev_hw": "גְּמִילָה", "next_hw": "גְּמִיעָה", "page_num": 799, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]