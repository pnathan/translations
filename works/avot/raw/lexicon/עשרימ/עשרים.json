[{"headword": "עֶשְׂרִים", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n", "senses": [{"definition": "twenty,  twentieth"}]}, "strong_number": "6242", "transliteration": "ʻesrîym", "pronunciation": "es-reem'", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "עֶשֶׂר", "parent_lexicon": "Jastrow Dictionary", "rid": "P01501", "refs": ["Shemot Rabbah 15:20", "Shemot Rabbah 15:21", "Shemot Rabbah 15:27", "Shemot Rabbah 15:20", "Shemot Rabbah 15:21", "Shemot Rabbah 15:27", "Bava Batra 107a:8"], "content": {"senses": [{"definition": " (b. h.) <i>ten.</i> <a class=\"refLink\" href=\"/Pirkei_Avot.5.1\" data-ref=\"Pirkei Avot 5:1\">Ab. V, 1</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_מַאֲמָר.1\" data-ref=\"Jastrow, מַאֲמָר 1\">מַאֲמָר</a>. <a class=\"refLink\" href=\"/Shemot_Rabbah.15.27\" data-ref=\"Shemot Rabbah 15:27\">Ex. R. s. 15</a>, a. fr. <span dir=\"rtl\">עשר מכות</span> (not <span dir=\"rtl\">עשרה</span>) the ten Egyptian plagues. <a class=\"refLink\" href=\"/Shemot_Rabbah.15.27\" data-ref=\"Shemot Rabbah 15:27\">Ib.</a> <span dir=\"rtl\">ע׳ אנשים</span> ten men; a. v. fr.—In compounds <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עֲשַׂר I.1\" data-ref=\"Jastrow, עֲשַׂר I 1\">עָשָׂר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עֲשָׂרָה.1\" data-ref=\"Jastrow, עֲשָׂרָה 1\">עֶשְׂרֵה</a>, as <span dir=\"rtl\">אַחַד ע׳</span> <i>eleven</i>, <span dir=\"rtl\">שְׁנֵים ע׳</span> <i>twelve</i> &c. <a class=\"refLink\" href=\"/Mishnah_Rosh_Hashanah.1.1\" data-ref=\"Mishnah Rosh Hashanah 1:1\">R. Hash. I, 1</a> <span dir=\"rtl\">בחמשה ע׳ בו</span> on the fifteenth day of it (the month of Shebat). <a class=\"refLink\" href=\"/Mishnah_Pesachim.1.1\" data-ref=\"Mishnah Pesachim 1:1\">Pes. I, 1</a> <span dir=\"rtl\">אור לארבעה ע׳</span>, v. <a class=\"refLink\" href=\"/Jastrow,_אוֹר II.1\" data-ref=\"Jastrow, אוֹר II 1\"><span dir=\"rtl\">אוֹר</span> II</a>; a. v. fr.—Pl. <span dir=\"rtl\">עֶשְׂרִים</span> <i>twenty</i>. <a class=\"refLink\" href=\"/Bava_Batra.107a.8\" data-ref=\"Bava Batra 107a:8\">B. Bath. 107ᵃ</a> <span dir=\"rtl\">ואחד אומר בע׳</span> and one of the experts says, it is worth twenty (Selaim). <a class=\"refLink\" href=\"/Pirkei_Avot.5.21\" data-ref=\"Pirkei Avot 5:21\">Ab. V, 21</a> <span dir=\"rtl\">בן ע׳ לרריף</span> at the age of twenty years it is time to hunt (for a living); a. v. fr."}], "morphology": "m."}, "plural_form": ["עֶשְׂרִים"], "alt_headwords": ["עֲשָׂרָה"], "quotes": [], "prev_hw": "עשֶׁר", "next_hw": "עֲשַׂר I", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "עֶשְׂרִים", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "adj.", "senses": [{"definition": "twenty."}]}, "rid": "P01240", "refs": ["Klein Dictionary, עשׂר ᴵ 1", "Klein Dictionary, עֶשְׂרִים 1", "Klein Dictionary, עשׂר ᴵ 1", "Klein Dictionary, עֶשְׂרִים 1", "Klein Dictionary, עֶשְׂרִימוֹן 1", "Klein Dictionary, עֶשְׂרִימוֹן 1"], "derivatives": "Derivative: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_עֶשְׂרִימוֹן.1\" data-ref=\"Klein Dictionary, עֶשְׂרִימוֹן 1\">עֶשְׂרִימוֹן</a>.", "prev_hw": "עֶשְׂרוֹנִי", "next_hw": "עֶשְׂרִימוֹן", "notes": "[Properly pl. of <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_עשׂר ᴵ.1\" data-ref=\"Klein Dictionary, עשׂר ᴵ 1\"