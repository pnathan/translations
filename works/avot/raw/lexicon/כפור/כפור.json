[{"headword": "כִּפּוּר", "parent_lexicon": "Jastrow Dictionary", "rid": "K00992", "language_code": "(b. h. ", "refs": ["Yoma 85b:2", "Mishnah Yoma 1:4", "Mishnah Yoma 8:9", "Sifrei Bamidbar 24:1"], "language_reference": "<span dir=\"rtl\">כִּפֻּרִים</span>; <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_כָּפַר.1\" data-ref=\"Jastrow, כָּפַר 1\">כָּפַר</a>)", "content": {"senses": [{"definition": "<i>redemption, atonement</i>; mostly pl. <span dir=\"rtl\">כִּפּוּרִים</span>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_כָּבֵד I.1\" data-ref=\"Jastrow, כָּבֵד I 1\">כִּי׳</a>. <a class=\"refLink\" href=\"/Mishnah_Meilah.2.1\" data-ref=\"Mishnah Meilah 2:1\">Meïl. II, 1</a> <span dir=\"rtl\">מחוסר כ׳</span> one wanting the ceremony of atonement for full restoration to cleanness; a. fr.—<span dir=\"rtl\">יוֹם כִּפּוּר</span>, mostly <span dir=\"rtl\">יום הַכִּפּוּרִים</span> (abbr. <span dir=\"rtl\">יוה\"כ</span>, <span dir=\"rtl\">יה\"כ</span>, <span dir=\"rtl\">י\"ה</span>) <i>Day of Atonement</i>, the tenth day of Tishri. <a class=\"refLink\" href=\"/Yoma.85b.2\" data-ref=\"Yoma 85b:2\">Yoma 85ᵇ</a> <span dir=\"rtl\">יום כפור</span> ed. (Ms. M. <span dir=\"rtl\">יום הכפורים</span>). Y. Shebu. I, 32ᵈ bot. <span dir=\"rtl\">י\"ה</span> a. <span dir=\"rtl\">יום הכפו׳</span>. <a class=\"refLink\" href=\"/Mishnah_Zevachim.5.1\" data-ref=\"Mishnah Zevachim 5:1\">Zeb. V, 1</a>. <a class=\"refLink\" href=\"/Mishnah_Yoma.1.1\" data-ref=\"Mishnah Yoma 1:1\">Yoma I, 1</a>. <a class=\"refLink\" href=\"/Mishnah_Yoma.1.4\" data-ref=\"Mishnah Yoma 1:4\">Ib. 4</a> <span dir=\"rtl\">ערב יוה\"כ</span> on the eve of the Day of Atonement (the ninth of Tishri). <a class=\"refLink\" href=\"/Mishnah_Yoma.8.9\" data-ref=\"Mishnah Yoma 8:9\">Ib. VIII, 9</a> <span dir=\"rtl\">אחטא … אין יה\"כ מכפר</span> if one says, I will sin, and repent, the Day of At. will bring him no atonement. Y. ib. VII, 45ᵇ bot., v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אֶפֶשׁ.1\" data-ref=\"Jastrow, אֶפֶשׁ 1\">אֶפֶשׁ</a>; a fr.—<a class=\"refLink\" href=\"/Sifrei_Bamidbar.24.1\" data-ref=\"Sifrei Bamidbar 24:1\">Sifré Num. 24</a> <span dir=\"rtl\">ומה כפורים וכ׳</span> (= <span dir=\"rtl\">יה\"כ</span>) the institution of the Day of Atonement being a strict one &c.—יה\"כ <i>Yom hak-Kippurim</i>, name of a treatise of the Tosefta, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_יוֹם ².1\" data-ref=\"Jastrow, יוֹם ² 1\">יוֹמָא</a>."}], "morphology": "m."}, "plural_form": ["כִּפּוּרִים", "כִּי׳"], "alt_headwords": ["כִּיפּ׳"], "quotes": [], "prev_hw": "כפוני", "next_hw": "כִּפּוּר ²", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "כִּפּוּר ²", "parent_lexicon": "Jastrow Dictionary", "rid": "K00993", "language_code": " ch. ", "refs": ["Jastrow, כִּפּוּר 1", "Jastrow, כִּפּוּר 1", "Yoma 20a", "Ketubot 67b:15"], "language_reference": "<a class=\"refLink\" href=\"/Jastrow,_כִּפּוּר.1\" data-ref=\"Jastrow, כִּפּוּר 1\">same</a>.", "content": {"senses": [{"definition": " <a class=\"refLink\" href=\"/Targum_Jonathan_on_Hosea.3.2\" data-ref=\"Targum Jonathan on Hosea 3:2\">Targ. Hos. III, 2</a>.—<a class=\"refLink\" href=\"/Targum_Jerusalem,_Leviticus.23.29\" data-ref=\"Targum Jerusalem, Leviticus 23:29\">Targ. Y. II, Lev. XXIII, 29</a> <span dir=\"rtl\">יום צום כִּפּוּרֵיה</span>.—Pl. <span dir=\"rtl\">כִּפּוּרַיָּא</span>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_כַּפּוֹרֵי.1\" data-ref=\"Jastrow, כַּפּוֹרֵי 1\">כִּפּוּרֵי</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_כָּבֵד I.1\" data-ref=\"Jastrow, כָּבֵד I 1\">כִּי׳</a>.—<a class=\"refLink\" href=\"/Onkelos_Exodus.29.36\" data-ref=\"Onkelos Exodus 29:36\">Targ. Ex. XXIX, 36</a>; a. fr.—<span dir=\"rtl\">יומא 