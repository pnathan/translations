[{"headword": "מִטְבָּחִים", "parent_lexicon": "Jastrow Dictionary", "rid": "M00964", "refs": [], "content": {"senses": [{"definition": " (<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_טָבַח.1\" data-ref=\"Jastrow, טָבַח 1\">טָבַח</a>) <i>slaughtering</i>; <span dir=\"rtl\">בית המ׳</span> <i>slaughtering place</i> (in the Temple). <a class=\"refLink\" href=\"/Mishnah_Middot.3.5\" data-ref=\"Mishnah Middot 3:5\">Midd. III, 5</a> (Mish. ed. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_מִטְבָּחִים.1\" data-ref=\"Jastrow, מִטְבָּחִים 1\">מִטְבָּחַיִים</a>). <a class=\"refLink\" href=\"/Pirkei_Avot.5.5\" data-ref=\"Pirkei Avot 5:5\">Ab. V, 5</a> (Strack a. other pointed ed. read <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_מִטְבָּחִים.1\" data-ref=\"Jastrow, מִטְבָּחִים 1\">מַטְבָּחַיִם</a>)."}], "morphology": "m. pl."}, "quotes": [], "prev_hw": "מַטְבָּחַיָּיא", "next_hw": "מַטְבֵּיעַ", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מִטְבָּחַֽיִם", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n. dual", "senses": [{"definition": "slaughtering-place (occurring only in the term <span dir=\"rtl\">בֵּית־מִטֽבָּחַיִם</span>, ‘slaughter-house’)."}]}, "rid": "M01572", "language_code": "PBH", "refs": ["Klein Dictionary, טבח 1", "Klein Dictionary, מִ◌ 1", "Klein Dictionary, טבח 1", "Klein Dictionary, מִ◌ 1"], "prev_hw": "מִטְבָּחוֹן", "next_hw": "מַטְבִּיל", "notes": "[Formed from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_טבח.1\" data-ref=\"Klein Dictionary, טבח 1\">טבח</a> (= to slaughter), with pref. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מִ◌.1\" data-ref=\"Klein Dictionary, מִ◌ 1\">מִ◌</a> and dual suff. <span dir=\"rtl\">◌ִיִם</span>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "מִטְבְּחַיִם", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>* <sup class=\"footnote-marker\">1</sup><i class=\"footnote\">גם בכנענ' מטבח: חדש ופעל אית <strong>המטבח</strong> <span class=\"by-source\">(כתבת <span dir=\"ltr\">CIS I, 175</span>)</span>.</i>, ש\"ז, — בצרוף עם השם בֵּית, בֵּית הַמִטְבָּחַיִם, ששם טֹבחים הבהמה, Schlachthaus; abattoir; slaughter-house: לא הפילה אשה מריח בשר הקדש וכו' ולא נראה זבוב בבית <strong>המטבחים</strong> (<span class=\"by-source\">אבות ה ה</span>). מי שזכה בתמיד מושכו והולך לבית <strong>המטבחים וכו' </strong>בית <strong>המטבחים</strong> היה לצפונו של מזבח <span class=\"by-source\">(תמיד ג ה)</span>. הכהנים והלויים והעניים המסייעים בבית הרועים ובבית הגרנות ובבית <strong>המטבחים</strong> אין נותנין להם תרומה ומעשר בשכרן <span class=\"by-source\">(בכור' כו:)</span>. בית <strong>המטבחים</strong> אין בו משום ריסוקי אברים <span class=\"by-source\">(ר' נחמן, חול' נא:)</span>. — ובסהמ\"א: הבהמה שמשליכין אותה בבית <strong>המטבחים</strong> לשוחטה <span class=\"by-source\">(ערוך, ערך טבח)</span>. הלך ראובן לבית <strong>המטבחים</strong> וקנה חתיכת ריאה אחת ומצא בה ג' סירכות <span class=\"by-source\">(פסקי ריקאנטי האחרונ' י)</span>.</p>"]}, "rid": "BY-10311", "prev_hw": "מַטְבֵּחַ", "next_hw": "מַטְבֵּעַ", "page_num": 2942, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]