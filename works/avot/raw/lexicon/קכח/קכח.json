[{"headword": "כָּח", "parent_lexicon": "Jastrow Dictionary", "rid": "K00449", "refs": ["Jastrow, כָּחַח 1"], "content": {"senses": [{"definition": ", v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_כָּחַח.1\" data-ref=\"Jastrow, כָּחַח 1\">כָּחַח</a>"}]}, "quotes": [], "prev_hw": "כְּזַר", "next_hw": "כֹּחַ", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "כֹּחַ", "parent_lexicon": "Jastrow Dictionary", "rid": "K00450", "language_code": "(b. h.;", "refs": ["Jastrow, יָכַח 1", "Horayot 9a:2", "Chagigah 12a", "Sanhedrin 96a:5", "Berakhot 63a:3-22", "Beitzah 2b:6", "Bava Kamma 18a:5", "Bava Kamma 19a:6", "Bava Kamma 19a:12", "Makkot 8a:3", "Avodah Zarah 60a:7", "Bava Kamma 10b:9", "Sanhedrin 77b:15", "Shevuot 48a:3", "Bava Metzia 105b", "Bereishit Rabbah 98:2", "Yevamot 34a:13"], "content": {"senses": [{"definition": " v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_יָכַח.1\" data-ref=\"Jastrow, יָכַח 1\">יָכַח</a>) <i>firmness, strength, power</i>. <a class=\"refLink\" href=\"/Horayot.9a.2\" data-ref=\"Horayot 9a:2\">Hor. 9ᵃ</a> <span dir=\"rtl\">בנוי בכ׳ וכ׳</span> in beauty, in physical strength, &c. <a class=\"refLink\" href=\"/Chagigah.12a\" data-ref=\"Chagigah 12a\">Ḥag. 12ᵃ</a>. <a class=\"refLink\" href=\"/Sanhedrin.96a.5\" data-ref=\"Sanhedrin 96a:5\">Snh. 96ᵃ</a> <span dir=\"rtl\">תשש כֹּחוֹ</span> his strength failed him. <a class=\"refLink\" href=\"/Berakhot.63a.3-22\" data-ref=\"Berakhot 63a:3-22\">Ber. 63ᵃ</a> <span dir=\"rtl\">כל … אין בו כח וכ׳</span> he who is careless about the study of the Law, will have no strength to endure on the day of trouble; a. v. fr.—<a class=\"refLink\" href=\"/Beitzah.2b.6\" data-ref=\"Beitzah 2b:6\">Bets. 2ᵇ</a>, a. fr. (mixed diction) <span dir=\"rtl\">להוריעך … כֹּחָן</span> to show the power of …, i.e. how far-reaching are the consequences of the opinion of … Ib., a. fr. <span dir=\"rtl\">כח דהיתרא עדיף</span> showing the power of the more lenient opinion is preferred (as an evidence of courage of conviction, while the more rigid opinion may be the outcome of doubt).—כח כֹּחוֹ <i>indirect action</i>, opp. <span dir=\"rtl\">כֹּחוֹ</span> direct action. <a class=\"refLink\" href=\"/Bava_Kamma.18a.5\" data-ref=\"Bava Kamma 18a:5\">B. Kam. 18ᵃ</a> שאני … בין נזק כחו לכח כחו S. distinguishes between direct and indirect injury. <a class=\"refLink\" href=\"/Bava_Kamma.19a.12\" data-ref=\"Bava Kamma 19a:12\">Ib. 19ᵃ</a>. <a class=\"refLink\" href=\"/Makkot.8a.3\" data-ref=\"Makkot 8a:3\">Macc. 8ᵃ</a>.—<a class=\"refLink\" href=\"/Avodah_Zarah.60a.7\" data-ref=\"Avodah Zarah 60a:7\">Ab. Zar. 60ᵃ</a> <span dir=\"rtl\">כ׳ כ׳</span> pressing wine by turning a wheel. <a class=\"refLink\" href=\"/Bava_Kamma.10b.9\" data-ref=\"Bava Kamma 10b:9\">B. Kam. 10ᵇ</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_לַאו.1\" data-ref=\"Jastrow, לַאו 1\">לַאו</a>.—<a class=\"refLink\" href=\"/Sanhedrin.77b.15\" data-ref=\"Sanhedrin 77b:15\">Snh. 77ᵇ</a> <span dir=\"rtl\">כ׳ ראשון</span> direct agency, <span dir=\"rtl\">כ׳ שני</span> indirect agency.—<a class=\"refLink\" href=\"/Shevuot.48a.3\" data-ref=\"Shevuot 48a:3\">Shebu. 48ᵃ</a>, a. fr. <span dir=\"rtl\">יפה כ׳</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_יָפֶה.1\" data-ref=\"Jastrow, יָפֶה 1\">יָפֶה</a>.—Ohol. XVIII, 6 <span dir=\"rtl\">שכֹּחָן יפה</span> who (which) can endure pressure without shaking, opp. <span dir=\"rtl\">כחן רע</span>; <a class=\"refLink\" href=\"/Mishnah_Zavim.3.1\" data-ref=\"Mishnah Zavim 3:1\">Zab. III, 1</a>; <a class=\"refLink\" href=\"/Bava_Metzia.105b\" data-ref=\"Bava Metzia 105b\">B. Mets. 105ᵇ</a>; a. e.—<a class=\"refLink\" href=\"/Bereishit_Rabbah.98.2\" data-ref=\"Bereishit Rabbah 98:2\">Gen. R. s. 98</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_לִיבְדְּקוֹס.1\" data-ref=\"Jastrow, לִיבְדְּקוֹס 1\">לִיבְדְּקוֹס</a>. Y. Pes. I, 27ᶜ bot. <span dir=\"rtl\">ל\"ת שבא מכח עשה</span> a prohibition derived from a positive law, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_לַאו.1\" data-ref=\"Jastrow, לַאו 1\">לַאו</a>; a. fr.—Trnsf. <i>coition</i>. <a class=\"refLink\" href=\"/Yevamot.34a.13\" data-ref=\"Yevamot 34a:13\">Yeb. 34ᵃ</a>"}], "morphology": "m."}, "plural_form": [], "alt_headwords": ["כּוֹחַ"], "quotes": [], "prev_hw": "כָּח", "next_hw": "כֹּחַ ²", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "כֹּחַ ²", "parent_lexicon": "Jastrow Dictionary", "rid": "K00451", "language_code": " ch. ", "refs": ["Jastrow, כֹּחַ 1", "Beitzah 2b:6"], "content": {"senses": [{}, {"definition": " <a class=\"refLink\" href=\"/Jastrow,_כֹּחַ.1\" data-ref=\"Jastrow, כֹּחַ 1\">same</a>. <a class=\"refLink\" href=\"/Aramaic_Targum_to_Lamentations.1.6\" data-ref=\"Aramaic Targum to Lamentations 1:6\">Targ. Lam. I, 6</a>.—<a class=\"refLink\" href=\"/Beitzah.2b.6\" data-ref=\"Beitzah 2b:6\">Bets. 2ᵇ</a>, a. fr. (mostly in Hebrew form), v. supra.", "number": "1)"}, {"definition": " name of a <i>lizzard</i>. <a class=\"refLink\" href=\"/Onkelos_Leviticus.11.30\" data-ref=\"Onkelos Leviticus 11:30\">Targ. Lev. XI, 30</a> (h. text <span dir=\"rtl\">כח</span>).", "number": "—2)"}, {"definition": " <span dir=\"rtl\">בַּר כּוֹחָא</span> pr. n. m. <i>Bar-Koḥa</i>. Y. Sabb. XIV, 14ᵈ bot.", "number": "—3)"}]}, "plural_form": [], "alt_headwords": ["כֹּחָא", "כּוֹ׳"], "quotes": [], "prev_hw": "כֹּחַ", "next_hw": "כָּחַד", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "כֹּֽחַ ᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"plural_form": "(pl. <span dir=\"rtl\">כֹּחוֹת</span>)", "definition": "strength, power, force, vigor."}]}, "rid": "K00278", "refs": ["Klein Dictionary, כוח 1", "Klein Dictionary, כוח 1", "Klein Dictionary, כֹּחִי 1", "Klein Dictionary, כֹּחָנִי 1", "Klein Dictionary, כֹּחִי 1", "Klein Dictionary, כֹּחָנִי 1"], "derivatives": "Derivatives: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_כֹּחִי.1\" data-ref=\"Klein Dictionary, כֹּחִי 1\">כֹּחִי</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_כֹּחָנִי.1\" data-ref=\"Klein Dictionary, כֹּחָנִי 1\">כֹּחָנִו</a>.", "prev_hw": "כזר", "next_hw": "כֹּֽחַ ᴵᴵ", "notes": "[Prob. from base <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_כוח.1\" data-ref=\"Klein Dictionary, כוח 1\">כוח</a>. cp. Aram. <span dir=\"rtl\">כּוֹחָא</span> (= strength, power). cp. also Arab. <i>kaḥa</i> (= he defeated), <i>wakaha</i> (= he battered down).]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "כֹּֽחַ ᴵᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"plural_form": "(pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_כֹּחִי.1\" data-ref=\"Klein Dictionary, כֹּחִי 1\">כֹּחִים</a>)", "definition": "a kind of a lizard (a hapax legomenon in the Bible, occurring <a class=\"refLink\" href=\"/Leviticus.11.30\" data-ref=\"Leviticus 11:30\">Lev. 11:30</a>)."}]}, "rid": "K00279", "refs": ["Klein Dictionary, כֹּחִי 1", "Klein Dictionary, כֹּחִי 1"], "prev_hw": "כֹּֽחַ ᴵ", "next_hw": "כחד", "notes": "[Of unknown origin.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "כיח", "parent_lexicon": "Klein Dictionary", "content": {"senses": [{"definition": "to cough up phlegm, expectorate."}, {"senses": [{"definition": "he coughed up phlegm, expectorated."}], "grammar": {"morphology": "intr. v.", "binyan_form": ["כָּח"], "verbal_stem": "— Qal", "language_code": "PBH"}}]}, "rid": "K00342", "refs": ["Klein Dictionary, כחה 1", "Klein Dictionary, כחח 1", "Klein Dictionary, כחה 1", "Klein Dictionary, כחח 1", "Klein Dictionary, כִּֽיחַ 1", "Klein Dictionary, כִּיחָה 1", "Klein Dictionary, כַּיְחָן 1", "Klein Dictionary, כִּֽיחַ 1", "Klein Dictionary, כִּיחָה 1", "Klein Dictionary, כַּיְחָן 1"], "derivatives": "Derivatives: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_כִּֽיחַ.1\" data-ref=\"Klein Dictionary, כִּֽיחַ 1\">כִּיחַ</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_כִּיחָה.1\" data-ref=\"Klein Dictionary, כִּיחָה 1\">כִּיחָה</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_כַּיְחָן.1\" data-ref=\"Klein Dictionary, כַּיְחָן 1\">כַּיְחָן</a>.", "prev_hw": "כִּיּוּת", "next_hw": "כִּֽיחַ", "notes": "[Of imitative origin. cp. the bases <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_כחה.1\" data-ref=\"Klein Dictionary, כחה 1\">כחה</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_כחח.1\" data-ref=\"Klein Dictionary, כחח 1\">כחח</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_