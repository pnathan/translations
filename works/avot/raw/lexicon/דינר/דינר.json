[{"headword": "דִּינָר", "parent_lexicon": "Jastrow Dictionary", "rid": "D00649", "refs": ["Bava Metzia 44b:10", "Bava Metzia 44b:11", "Bava Metzia 44b:12", "Bava Batra 166a:2", "Bava Batra 166a:3", "Jerusalem Talmud Kiddushin 1:1:21", "Jerusalem Talmud Berakhot 9:2:18"], "content": {"senses": [{"definition": " (denarius) <i>denar</i> (silver denar = <sup>1</sup>/<sub>24</sub> of a gold denar, v. Zuckerm. Talm. Münz. p. 19 sq.; Sm. Ant. s. v. Denarius). <a class=\"refLink\" href=\"Jerusalem_Talmud_Kiddushin.1.1.21\" data-ref=\"Jerusalem Talmud Kiddushin 1:1:21\">Y. Kidd. I, 58ᵈ</a> top; cmp. <a class=\"refLink\" href=\"/Bava_Metzia.44b.12\" data-ref=\"Bava Metzia 44b:12\">B. Mets. 44ᵇ</a>; a. fr.—Pl. <span dir=\"rtl\">דִּינְרִין</span>, constr. <span dir=\"rtl\">דִּינְרֵי</span>. <a class=\"refLink\" href=\"Jerusalem_Talmud_Berakhot.9.2.18\" data-ref=\"Jerusalem Talmud Berakhot 9:2:18\">Y. Ber. IX, 13ᵈ</a> bot.; a. fr.—V. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_גּוּרְדיָנוֹן.1\" data-ref=\"Jastrow, גּוּרְדיָנוֹן 1\">גֹּורְדִּינוֹן</a> a. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אִיסָר.1\" data-ref=\"Jastrow, אִיסָר 1\">אִיסָר</a>.—<a class=\"refLink\" href=\"/Bava_Batra.166a.3\" data-ref=\"Bava Batra 166a:3\">B. Bath. 166ᵃ</a> <span dir=\"rtl\">דִּינְרֵי</span> (sub. <span dir=\"rtl\">זהב</span>) <i>gold denars</i>, <span dir=\"rtl\">דינרין</span> <i>silver denars</i>"}], "morphology": "m."}, "plural_form": ["דִּינְרִין", ""], "alt_headwords": [], "quotes": [], "prev_hw": "דינקאי", "next_hw": "דִּינָר ²", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "דִּינָר ²", "parent_lexicon": "Jastrow Dictionary", "rid": "D00650", "refs": ["Jastrow, דִּינָר 1", "Avodah Zarah 52b:12", "Avodah Zarah 6b:6", "Bava Batra 166a:2", "Bava Batra 166a:3", "Jerusalem Talmud Kiddushin 2:4:5"], "content": {"senses": [{"definition": ", ch. <a class=\"refLink\" href=\"/Jastrow,_דִּינָר.1\" data-ref=\"Jastrow, דִּינָר 1\">same</a>. <a class=\"refLink\" href=\"/Targum_Jonathan_on_Exodus.30.13\" data-ref=\"Targum Jonathan on Exodus 30:13\">Targ. Y. Ex. XXX, 13</a>.—Y. Keth. VII, 31ᵈ top; <a class=\"refLink\" href=\"Jerusalem_Talmud_Kiddushin.2.4.5\" data-ref=\"Jerusalem Talmud Kiddushin 2:4:5\">Y. Kidd. II, 62ᵈ</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_גּוּרְדיָנוֹן.1\" data-ref=\"Jastrow, גּוּרְדיָנוֹן 1\">גֹּורְדִּינוֹן</a>. <a class=\"refLink\" href=\"/Avodah_Zarah.52b.12\" data-ref=\"Avodah Zarah 52b:12\">Ab. Zar. 52ᵇ</a> ד׳ טריינא והדריינא שיפא Ms. (ed. <span dir=\"rtl\">הדר׳ טוריי׳</span>) a Trojanic, Hadrianic denar which is rubbed off (i.e. Jewish coins restamped by Trojanus &c.). <a class=\"refLink\" href=\"/Avodah_Zarah.6b.6\" data-ref=\"Avodah Zarah 6b:6\">Ib. 6ᵇ</a> <span dir=\"rtl\">ד׳ קיסראנא</span> (some ed. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_קִיסְרְנָאָה.1\" data-ref=\"Jastrow, קִיסְרְנָאָה 1\">קיסרנאה</a>, Rashi <span dir=\"rtl\">קס׳</span>) a Cæsarean denar (Ms. M. <span dir=\"rtl\">ד׳ דקיסר</span> a denar coined in commemoration of coronation; cmp., however, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דִּיסְקוֹס I.1\" data-ref=\"Jastrow, דִּיסְקוֹס I 1\">דִּיסְקוֹס</a>); a. fr.—Pl. <span dir=\"rtl\">דִּינְרִין</span>, <span dir=\"rtl\">דִּינְרֵי</span>. <a class=\"refLink\" href=\"/Bava_Batra.166a.3\" data-ref=\"Bava Batra 166a:3\">B. Bath. 166ᵃ</a>; a. fr."}]}, "plural_form": ["דִּינְרִין", "דִּינְרֵי"], "alt_headwords": ["דִּינָרָא", "דִּינְרָא"], "quotes": [], "prev_hw": "דִּינָר", "next_hw": "דַּיְסָא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "דִּינָר", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "denarius."}]}, "rid": "D00439", "language_code": "PBH", "refs": ["Klein Dictionary, דֶּקָדָה 1", "Klein Dictionary, דֶּקָן 1", "Klein Dictionary, דֶּצֶמְבֶּר 1", "Klein Dictionary, דֶּקָגְרַם 1", "Klein Dictionary, דֶּקָלִיטֶר 1", "Klein Dictionary, דֶּקָמֶטֶר 1", "Klein Dictionary, דֶּצִיגְרַם 1", "Klein Dictionary, דֶּצִילִיטֶר 1", "Klein Dictionary, דֶּצִימֶטֶר 1", "Klein Dictionary, דֶּקָדָה 1", "Klein Dictionary, דֶּקָן 1", "Klein Dictionary, דֶּצֶמְבֶּר 1", "Klein Dictionary, דֶּקָגְרַם 1", "Klein Dictionary, דֶּקָלִיטֶר 1", "Klein Dictionary, דֶּקָמֶטֶר 1", "Klein Dictionary, דֶּצִיגְרַם 1", "Klein Dictionary, דֶּצִילִיטֶר 1", "Klein Dictionary, דֶּצִימֶטֶר 1"], "prev_hw": "דַּיְּנָן", "next_hw": "דַּֽיִס", "notes": "[L. <i>dēnārius</i>, short for <i>dēnārius nummus</i> (= the coin containing ten), from <i>dēnārius</i> (= containing ten), and <i>nummus</i> (= coin). <i>Dēnārius</i> derives from <i>dēnī</i> (= ten each), which stands for * <i>dec-noi</i>, from <i>decem</i> (= ten). The <i>denarius</i> was so called because it originally contained ten asses. L. <i>decem</i> derives from IE base * <i>géƙm</i>–, * <i>deƙmt(i)</i> (= ten). cp. ‘ten’ in my CEDEL. cp. also <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דֶּקָדָה.1\" data-ref=\"Klein Dictionary, דֶּקָדָה 1\">דֶּקָדָה</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דֶּקָן.1\" data-ref=\"Klein Dictionary, דֶּקָן 1\">דֶּקָן</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דֶּצֶמְבֶּר.1\" data-ref=\"Klein Dictionary, דֶּצֶמְבֶּר 1\">דֶּצֶמְבֶּר</a> and the first element in <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דֶּקָגְרַם.1\" data-ref=\"Klein Dictionary, דֶּקָגְרַם 1\">דֶּקָגְרַם</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דֶּקָלִיטֶר.1\" data-ref=\"Klein Dictionary, דֶּקָלִיטֶר 1\">דֶּקָלִיטֶר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דֶּקָמֶטֶר.1\" data-ref=\"Klein Dictionary, דֶּקָמֶטֶר 1\">דֶּקָמֶטֶר</a> and in <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דֶּצִיגְרַם.1\" data-ref=\"Klein Dictionary, דֶּצִיגְרַם 1\">דֶּצִיגְרַם</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דֶּצִילִיטֶר.1\" data-ref=\"Klein Dictionary, דֶּצִילִיטֶר 1\">דֶּצִילִיטֶר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דֶּצִימֶטֶר.1\" data-ref=\"Klein Dictionary, דֶּצִימֶטֶר 1\">דֶּצִימֶטֶר</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "דִּינָר", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>* <sup class=\"footnote-marker\">1</sup><i class=\"footnote\">במשנ' מנק' כ\"י פרמה:  דֵינָר.</i>, ש\"ז, מ\"ר דִּינָרִים, —  שם מטבע יונית ורומית של כסף ושל זהב, denarius, נזכר הרבה פעמים במשנה וגמרה (<span class=\"by-source\">כתוב' ה ז</span>), <span class=\"by-source\">כלים יב ט</span>, ועוד.  — ואמר המליץ:  <strong>דינר</strong> קוצר, <strong>דינר</strong> בוצר, <strong>דינר</strong> מתיר, <strong>דינר</strong> אוסר, <strong>דינר</strong> מעמיד פרנס בוּר, על הצבור  (<span class=\"by-source\">משה חגיז, לקט הקמח</span>).</p>"]}, "rid": "BY-03494", "prev_hw": "דִּינִי", "next_hw": "דַּיִס", "page_num": 930, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]