[{"headword": "סְדוֹם", "parent_lexicon": "Jastrow Dictionary", "rid": "O00179", "refs": ["Sanhedrin 108a:1", "Bava Batra 12b:13", "Bava Batra 12b:14", "Bava Batra 114b", "Shabbat 108b:9"], "content": {"senses": [{"definition": " (b. h.) pr. n. pl. <i>Sodom</i>, one of the cities in the plain of Jordan destroyed for their wickedness. <a class=\"refLink\" href=\"/Mishnah_Sanhedrin.10.3\" data-ref=\"Mishnah Sanhedrin 10:3\">Snh. X, 3</a> (<a class=\"refLink\" href=\"/Sanhedrin.108a.1\" data-ref=\"Sanhedrin 108a:1\">108ᵃ</a>) (ref. to <a class=\"refLink\" href=\"/Psalms.1.5\" data-ref=\"Psalms 1:5\">Ps. I, 5</a>) <span dir=\"rtl\">אלו אנשי ס׳</span> this alludes to the men of S. Ib. 109ᵇ <span dir=\"rtl\">ארבעה … בס׳ וכ׳</span> four judges lived in S. &c., v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_זְיָיפִי.1\" data-ref=\"Jastrow, זְיָיפִי 1\">זְיָיפִי</a>; a. fr.—מִדַּת ס׳ <i>Sodomitic rule, unfairness, selfishness.</i> <a class=\"refLink\" href=\"/Pirkei_Avot.5.10\" data-ref=\"Pirkei Avot 5:10\">Ab. V, 10</a> ‘mine is mine, and thine is thine’, <span dir=\"rtl\">זו היא מ׳ ס׳</span> that is a Sodomitic principle (justice without charity). <a class=\"refLink\" href=\"/Bava_Batra.12b.14\" data-ref=\"Bava Batra 12b:14\">B. Bath. 12ᵇ</a> <span dir=\"rtl\">כופין על מ׳ ס׳</span> the law may use force against unfairness (where one claims a privilege which causes the neighbor no loss); a. fr.—<a class=\"refLink\" href=\"/Bava_Batra.114b\" data-ref=\"Bava Batra 114b\">Ib. 114ᵇ</a> הלכתא … יוסף בס׳ Ar. (ed. <span dir=\"rtl\">בשדה</span>) the law follows R. Joseph’s opinion as to using force against unfairness.—ימא דס׳ <i>the Lake of Sodom</i> (usu. <span dir=\"rtl\">ימא דמילחא</span>). <a class=\"refLink\" href=\"/Shabbat.108b.9\" data-ref=\"Shabbat 108b:9\">Sabb. 108ᵇ</a>, v. <a class=\"refLink\" href=\"/Jastrow,_טָבַע I.1\" data-ref=\"Jastrow, טָבַע I 1\"><span dir=\"rtl\">טְבַע</span> I</a>; a. e."}]}, "plural_form": [], "alt_headwords": [], "quotes": [[null, "מִדַּת סְדוֹם", null]], "prev_hw": "סַדָּה", "next_hw": "סְדוֹמִי", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "סְדוֹם", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "Sodom — name of a city whose inhabitants were ‘wicked and sinners’ (<a class=\"refLink\" href=\"/Genesis.13.13\" data-ref=\"Genesis 13:13\">Gen. 13:13</a>)."}]}, "rid": "O00155", "refs": ["Klein Dictionary, סְדוֹמִי 1", "Klein Dictionary, סְדוֹמִי 1"], "derivatives": "Derivative: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_סְדוֹמִי.1\" data-ref=\"Klein Dictionary, סְדוֹמִי 1\">סְדוֹמִי</a>.", "prev_hw": "סַד", "next_hw": "סְדוֹמִי", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "סְדוֹם", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>— שם עיר בככר הירדן שאנשיה היו רעים וחטאים <span class=\"by-source\">(בראש' יג יג)</span>. — *מִדַת סְדוֹם, מנהג אנשי סדום: ויש אומרים זו מדת <strong>סדום</strong> (האומר שלי שלי ושלך שלך) <span class=\"by-source\">(אבו' ה י)</span>. כגון זה כופין על מדת <strong>סדום</strong> <span class=\"by-source\">(רבה ור' יוסף, ב\"ב יב:)</span>. — ובסהמ\"א: שכל מי שעינו צרה בהנאת אורחים מדת <strong>סדום</strong> בו ופסקו הדין ואמרו כגון זה כופים אותו על מדת <strong>סדום</strong> <span class=\"by-source\">(ר\"י בר' אנטולי, מלמד התלמידים, וירא יח:)</span>.</p>"]}, "rid": "BY-13077", "prev_hw": "סְדָא", "next_hw": "סְדוֹמִי", "page_num": 3963, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]