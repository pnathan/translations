[{"headword": "יַבְנֶה", "parent_lexicon": "Jastrow Dictionary", "rid": "J00065", "refs": ["Rosh Hashanah 31a", "Gittin 56b:5", "Avot D'Rabbi Natan 4:5", "Tosefta Demai 1:14", "Jerusalem Talmud Sotah 7:5:5", "Jerusalem Talmud Demai 3:4:7"], "content": {"senses": [{"definition": " (b. h.) pr. n. pl. <i>Jabneh, Jamnia</i>, north of west of Jerusalem, seat of the Sanhedrin after the destruction of Jerusalem. <a class=\"refLink\" href=\"/Rosh_Hashanah.31a\" data-ref=\"Rosh Hashanah 31a\">R. Hash. 31ᵃ</a>, sq. <a class=\"refLink\" href=\"/Gittin.56b.5\" data-ref=\"Gittin 56b:5\">Gitt. 56ᵇ</a> <span dir=\"rtl\">תן לי י׳ וכ׳</span> give me (promise to spare) J. and her scholars; <a class=\"refLink\" href=\"/Avot_D'Rabbi_Natan.4.5\" data-ref=\"Avot D'Rabbi Natan 4:5\">Ab. d’R. N. ch. IV</a>.—<a class=\"refLink\" href=\"/Mishnah_Ketubot.4.6\" data-ref=\"Mishnah Ketubot 4:6\">Keth. IV, 6</a>, a. fr. <span dir=\"rtl\">בכרם בי׳</span> in the college of R. Johanan b. Zackai in J., v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_כֶּרֶם.1\" data-ref=\"Jastrow, כֶּרֶם 1\">כֶּרֶם</a>. <a class=\"refLink\" href=\"Jerusalem_Talmud_Sotah.7.5.5\" data-ref=\"Jerusalem Talmud Sotah 7:5:5\">Y. Sot. VII, end, 22ᵃ</a>.—<a class=\"refLink\" href=\"/Tosefta_Demai.1.13\" data-ref=\"Tosefta Demai 1:13\">Tosef. Dem. I, 13</a> <span dir=\"rtl\">אוצר י׳ וכ׳</span> the store of provision in J., inside of the fortification. <a class=\"refLink\" href=\"/Tosefta_Demai.1.14\" data-ref=\"Tosefta Demai 1:14\">Ib. 14</a>; <a class=\"refLink\" href=\"/Tosefta_Makhshirin.3.15\" data-ref=\"Tosefta Makhshirin 3:15\">Tosef. Makhsh. III, 15</a>; <a class=\"refLink\" href=\"Jerusalem_Talmud_Demai.3.4.7\" data-ref=\"Jerusalem Talmud Demai 3:4:7\">Y. Dem. III, 23ᶜ</a> bot.; v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נָזָה.1\" data-ref=\"Jastrow, נָזָה 1\">נָזָה</a>."}]}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "יְבַמְתָּא", "next_hw": "יַבְּקָא", "parent_lexicon_details": {"n