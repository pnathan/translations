[{"headword": "דָּר", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-m", "senses": [{"definition": "generation"}]}, "strong_number": "1859", "transliteration": "dâr", "pronunciation": "dawr", "language_code": "arc", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "דָּר", "parent_lexicon": "Jastrow Dictionary", "rid": "D01024", "refs": [], "content": {"senses": [{"definition": " part. of <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דּוּר.1\" data-ref=\"Jastrow, דּוּר 1\">דּוּר</a>."}]}, "quotes": [], "prev_hw": "דֹּר", "next_hw": "דָּר ²", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "דָּר ²", "parent_lexicon": "Jastrow Dictionary", "rid": "D01025", "refs": ["Bereishit Rabbah 20:10"], "content": {"senses": [{"definition": " (<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דּוּר.1\" data-ref=\"Jastrow, דּוּר 1\">דּוּר</a>) <i>row</i>.—Pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דָּמִין.1\" data-ref=\"Jastrow, דָּמִין 1\">דָּרִין</a>. <a class=\"refLink\" href=\"/Bereishit_Rabbah.20.10\" data-ref=\"Bereishit Rabbah 20:10\">Gen. R. s. 20</a> (explain. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דַּרְדֵּר.1\" data-ref=\"Jastrow, דַּרְדֵּר 1\">דַּרְדַּר</a>) <span dir=\"rtl\">שהיא עשוייה ד׳ ד׳</span> because it consists of rows above rows (of the imbricated form of the artichoke)."}], "morphology": "m."}, "plural_form": ["דָּרִין"], "alt_headwords": [], "quotes": [], "prev_hw": "דָּר", "next_hw": "דָּר ³", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "דָּר ³", "parent_lexicon": "Jastrow Dictionary", "rid": "D01026", "language_code": " ch. ", "refs": ["Jastrow, דָּר ² 1", "Ketubot 60a:3", "Bava Kamma 117a:13", "Chullin 11a:1", "Chullin 47a:4", "Chullin 53a:14", "Sanhedrin 97b:11", "Sukkah 45b:5", "Kiddushin 36b", "Megillah 12a:15", "Niddah 20a:77", "Berakhot 28a:1", "Berakhot 62b", "Avodah Zarah 28a:8", "Yoma 84a:7", "Yoma 84a:6", "Taanit 3b:8", "Bava Metzia 73a:10", "Bava Kamma 113b:17", "Shir HaShirim Rabbah 3:4:2", "Jastrow, דּוֹר 1", "Chagigah 5a:3", "Sanhedrin 97b:11", "Chullin 93b:16", "Chullin 93b:18", "Yevamot 39b:15"], "content": {"senses": [{"definition": " <a class=\"refLink\" href=\"/Jastrow,_דָּר ².1\" data-ref=\"Jastrow, דָּר ² 1\">same</a>, <i>row, range, order</i>. <a class=\"refLink\" href=\"/Ketubot.60a.3\" data-ref=\"Ketubot 60a:3\">Keth. 60ᵃ</a> <span dir=\"rtl\">בד׳ דנשי</span> in a row of women. <a class=\"refLink\" href=\"/Bava_Kamma.117a.13\" data-ref=\"Bava Kamma 117a:13\">B. Kam. 117ᵃ</a> <span dir=\"rtl\">בד׳ קמא</span> in the first row of scholars. <a class=\"refLink\" href=\"/Chullin.11a.1\" data-ref=\"Chullin 11a:1\">Ḥull. 11ᵃ</a> top <span dir=\"rtl\">ד׳ דגברי</span> a row of men. <a class=\"refLink\" href=\"/Chullin.47a.4\" data-ref=\"Chullin 47a:4\">Ib. 47ᵃ</a> <span dir=\"rtl\">בד׳ דאוני</span> within the ranges of the lobes of the lungs. <a class=\"refLink\" href=\"/Chullin.53a.14\" data-ref=\"Chullin 53a:14\">Ib. 53ᵃ</a> <span dir=\"rtl\">בד׳ דסיחופיה</span> in the order in which the claws of the lion’s paw appear when he assaults an animal. <a class=\"refLink\" href=\"/Sanhedrin.97b.11\" data-ref=\"Sanhedrin 97b:11\">Snh. 97ᵇ</a> ד׳ קמא דקמי וכ׳ Ms. M. (ed. <span dir=\"rtl\">ד׳ דקמי</span>; Ms. K. a. Ar. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דָּרֵי.1\" data-ref=\"Jastrow, דָּרֵי 1\">דָּרֵי</a>, pl.) the first row (of righteous men) before the Lord; <a class=\"refLink\" href=\"/Sukkah.45b.5\" data-ref=\"Sukkah 45b:5\">Succ. 45ᵇ</a> (v. Rabb. D. S. a. l. note 9).—<a class=\"refLink\" href=\"/Kiddushin.36b\" data-ref=\"Kiddushin 36b\">Kidd. 36ᵇ</a> ר\"י דדריה R. J. his class-mate; a. fr.—Pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דָּמִין.1\" data-ref=\"Jastrow, דָּמִין 1\">דָּרִין</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דָּרֵי.1\" data-ref=\"Jastrow, דָּרֵי 1\">דָּרֵי</a>. <a class=\"refLink\" href=\"/Megillah.12a.15\" data-ref=\"Megillah 12a:15\">Meg. 12ᵃ</a> (expl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דָּר.1\" data-ref=\"Jastrow, דָּר 1\">דַּר</a>, <a class=\"refLink\" href=\"/Esther.1.6\" data-ref=\"Esther 1:6\">Esth. I, 6</a>) <span dir=\"rtl\">ד׳ ד׳</span> ranges of mosaics. <a class=\"refLink\" href=\"/Niddah.20a.77\" data-ref=\"Niddah 20a:77\">Nidd. 20ᵃ</a> <span dir=\"rtl\">תלתא ד׳ וכ׳</span> there are three ranges of leaves, and three leaves in each. <a class=\"refLink\" href=\"/Berakhot.28a.1\" data-ref=\"Berakhot 28a:1\">Ber. 28ᵃ</a> <span dir=\"rtl\">ד׳ חיוורתא</span> rows of white hair. <a class=\"refLink\" href=\"/Berakhot.62b\" data-ref=\"Berakhot 62b\">Ib. 62ᵇ</a> (phonetic etymol. of <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_קָפַּנְדַּרְיָא.1\" data-ref=\"Jastrow, קָפַּנְדַּרְיָא 1\">קפנדריא</a>) <span dir=\"rtl\">אַדָּ׳ וכ׳ אדמקיפנא</span> in place of going around the rows of houses &c. <a class=\"refLink\" href=\"/Avodah_Zarah.28a.8\" data-ref=\"Avodah Zarah 28a:8\">Ab. Zar. 28ᵃ</a> <span dir=\"rtl\">ומייתי דמא מבי דרי</span> ed. (Ms. M. <span dir=\"rtl\">מבי ככי</span>); <a class=\"refLink\" href=\"/Yoma.84a.7\" data-ref=\"Yoma 84a:7\">Yoma 84ᵃ</a> <span dir=\"rtl\">ואתי דמא מבי ד׳</span> (Ms. M. <span dir=\"rtl\">ומייתי ליה דמא מבי ככי ושיני</span>) and he makes blood come (and blood will come) out from between the rows of teeth. [<a class=\"refLink\" href=\"/Yoma.84a.6\" data-ref=\"Yoma 84a:6\">Ib.</a> <span dir=\"rtl\">בככי דריה</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דְּרָרָא I.1\" data-ref=\"Jastrow, דְּרָרָא I 1\">דְּרָרָא</a>.] [<a class=\"refLink\" href=\"/Taanit.3b.8\" data-ref=\"Taanit 3b:8\">Taan. 3ᵇ</a>; <a class=\"refLink\" href=\"/Bava_Metzia.73a.10\" data-ref=\"Bava Metzia 73a:10\">B. Mets. 73ᵃ</a>; <a class=\"refLink\" href=\"/Bava_Kamma.113b.17\" data-ref=\"Bava Kamma 113b:17\">B. Kam. 113ᵇ</a> <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דָּרֵי.1\" data-ref=\"Jastrow, דָּרֵי 1\">בי ד׳</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דָּרֵי.1\" data-ref=\"Jastrow, דָּרֵי 1\">דָּרֵי</a>.]", "number": "1)"}, {"definition": "<i>a range of wood, pyre</i>. <a class=\"refLink\" href=\"/Shir_HaShirim_Rabbah.3.4.2\" data-ref=\"Shir HaShirim Rabbah 3:4:2\">Cant. R. to III, 4</a> <span dir=\"rtl\">ד׳ יקידא יקדת</span> a burning pyre hast thou set on fire, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_יְקַד.1\" data-ref=\"Jastrow, יְקַד 1\">יְקַד</a>.—Pl. as above. <a class=\"refLink\" href=\"/Aramaic_Targum_to_Psalms.82.15\" data-ref=\"Aramaic Targum to Psalms 82:15\">Targ. Ps. LXXXII, 15</a> Ms. (ed. <span dir=\"rtl\">זרזי</span>).", "number": "—2)"}, {"definition": " (v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דּוֹר.1\" data-ref=\"Jastrow, דּוֹר 1\">דּוֹר</a>) <i>period, generation</i>. <a class=\"refLink\" href=\"/Onkelos_Deuteronomy.33.7\" data-ref=\"Onkelos Deuteronomy 33:7\">Targ. Deut. XXXIII, 7</a>. <a class=\"refLink\" href=\"/Aramaic_Targum_to_Job.6.17\" data-ref=\"Aramaic Targum to Job 6:17\">Targ. Job. VI, 17</a>; a. fr.—<a class=\"refLink\" href=\"/Chagigah.5a.3\" data-ref=\"Chagigah 5a:3\">Ḥag. 5ᵃ</a> <span dir=\"rtl\">עד דמלי להו לד׳</span> until they have completed the period (lived the years allotted to them). <a class=\"refLink\" href=\"/Sanhedrin.97b.11\" data-ref=\"Sanhedrin 97b:11\">Snh. 97ᵇ</a> <span dir=\"rtl\">בכל ד׳ וד׳</span> (Ms. M.) in each generation; a. fr.—Pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דָּמִין.1\" data-ref=\"Jastrow, דָּמִין 1\">דָּרִין</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דריא.1\" data-ref=\"Jastrow, דריא 1\">דָּרַיָּא</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דָּרֵי.1\" data-ref=\"Jastrow, דָּרֵי 1\">דָּרֵי</a>. <a class=\"refLink\" href=\"/Targum_Jonathan_on_Isaiah.51.8\" data-ref=\"Targum Jonathan on Isaiah 51:8\">Targ. Is. LI, 8</a> sq.—<a class=\"refLink\" href=\"/Aramaic_Targum_to_Psalms.49.12\" data-ref=\"Aramaic Targum to Psalms 49:12\">Targ. Ps. XLIX, 12</a> (Ms. <span dir=\"rtl\">דָּרָתָא</span>); a. fr.—<a class=\"refLink\" href=\"/Chullin.93b.18\" data-ref=\"Chullin 93b:18\">Ḥull. 93ᵇ</a>; <a class=\"refLink\" href=\"/Yevamot.39b.15\" data-ref=\"Yevamot 39b:15\">Yeb. 39ᵇ</a> <span dir=\"rtl\">אכשור ד׳</span> have the generations (the present) grown better?", "number": "—3)"}]}, "plural_form": ["דָּרִין", "דָּרֵי", "II", "זרזי", "דָּרִין", "דָּרַיָּא", "דָּרֵי"], "alt_headwords": ["דָּרָא I"], "quotes": [], "prev_hw": "דָּר ²", "next_hw": "דָּרָא II", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "דור", "parent_lexicon": "Klein Dictionary", "content": {"senses": [{"definition": "to move in a circle, go round, whence ‘to dwell’."}, {"senses": [{"definition": "he dwelt (a hapax legomenon in the Bible, occurring <a class=\"refLink\" href=\"/Psalms.84.11\" data-ref=\"Psalms 84:11\">Ps. 84:11</a>)."}], "grammar": {"morphology": "intr. v.", "binyan_form": ["דָּר"], "verbal_stem": "— Qal"}}, {"senses": [{"definition": "he introduced;", "number": "1", "language_code": "PBH"}, {"definition": "he caused to dwell, housed, accommodated.", "number": "2", "language_code": "NH"}], "grammar": {"binyan_form": ["דִּיֵּר"], "verbal_stem": "— Pi."}}]}, "rid": "D00292", "refs": ["Klein Dictionary, דּוּר ᴵ 1", "Klein Dictionary, מָדוֹר 1", "Klein Dictionary, דור 1", "Klein Dictionary, דרא 1", "Klein Dictionary, דּוּרָה 1", "Klein Dictionary, דּוּר ᴵ 1", "Klein Dictionary, מָדוֹר 1", "Klein Dictionary, דור 1", "Klein Dictionary, דרא 1", "Klein Dictionary, דּוּרָה 1", "Klein Dictionary, דּוּר ᴵ 1", "Klein Dictionary, דּוֹר 1", "Klein Dictionary, דָּיוֹר 1", "Klein Dictionary, דִּיּוּר 1", "Klein Dictionary, דִּיר 1", "Klein Dictionary, דַּיָּר 1", "Klein Dictionary, מָדוֹר 1", "Klein Dictionary, מְדוּרָה 1", "Klein Dictionary, דֹּֽאַר 1", "Klein Dictionary, דרדר 1", "Klein Dictionary, דַּרְדַּר 1", "Klein Dictionary, דְּרָרָא 1", "Klein Dictionary, תָּדִיר 1", "Klein Dictionary, דּוּר ᴵ 1", "Klein Dictionary, דּוֹר 1", "Klein Dictionary, דָּיוֹר 1", "Klein Dictionary, דִּיּוּר 1", "Klein Dictionary, דִּיר 1", "Klein Dictionary, דַּיָּר 1", "Klein Dictionary, מָדוֹר 1", "Klein Dictionary, מְדוּרָה 1", "Klein Dictionary, דֹּֽאַר 1", "Klein Dictionary, דרדר 1", "Klein Dictionary, דַּרְדַּר 1", "Klein Dictionary, דְּרָרָא 1", "Klein Dictionary, תָּדִיר 1"], "derivatives": "Derivatives: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דּוּר ᴵ.1\" data-ref=\"Klein Dictionary, דּוּר ᴵ 1\">דּוּר ᴵ</a> (n.), <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דּוֹר.1\" data-ref=\"Klein Dictionary, דּוֹר 1\">דּוֹר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דָּיוֹר.1\" data-ref=\"Klein Dictionary, דָּיוֹר 1\">דָּיוֹר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דִּיּוּר.1\" data-ref=\"Klein Dictionary, דִּיּוּר 1\">דִּיּוּר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דִּיר.1\" data-ref=\"Klein Dictionary, דִּיר 1\">דִּיר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דַּיָּר.1\" data-ref=\"Klein Dictionary, דַּיָּר 1\">דַּיָּר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מָדוֹר.1\" data-ref=\"Klein Dictionary, מָדוֹר 1\">מָדוֹר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מְדוּרָה.1\" data-ref=\"Klein Dictionary, מְדוּרָה 1\">מֽדוּרָה</a>. cp. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דֹּֽאַר.1\" data-ref=\"Klein Dictionary, דֹּֽאַר 1\">דֹּאַר</a>. cp. also <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דרדר.1\" data-ref=\"Klein Dictionary, דרדר 1\">דרדר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דַּרְדַּר.1\" data-ref=\"Klein Dictionary, דַּרְדַּר 1\">דַּרְדַּר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דְּרָרָא.1\" data-ref=\"Klein Dictionary, דְּרָרָא 1\">דְּרָרָא</a> and <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_תָּדִיר.1\" data-ref=\"Klein Dictionary, תָּדִיר 1\">תָּדִיר</a>.", "prev_hw": "דּוֹקְרָנִי", "next_hw": "דּוֹר", "notes": "[Arab. <i>dāra</i> (= he moved in a circle, went about), <i>dār</i> (= house; orig.: ‘buildings surrounding a court’), <i>daur</i> (= circumference), <i>dahr</i> (= long time, age), BAram. and JAram. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דּוּר ᴵ.1\" data-ref=\"Klein Dictionary, דּוּר ᴵ 1\">דּוּר</a> (= to dwell), <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מָדוֹר.1\" data-ref=\"Klein Dictionary, מָדוֹר 1\">מְדוֹר</a>, <span dir=\"rtl\">מְדָר</span> (= dwelling place), <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דור.1\" data-ref=\"Klein Dictionary, דור 1\">דָּר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דרא.1\" data-ref=\"Klein Dictionary, דרא 1\">דָּרָא</a> (= generation), JAram. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דּוּרָה.1\" data-ref=\"Klein Dictionary, דּוּרָה 1\">דּוּרָא</a>, Syr. <span dir=\"rtl\">דַּיְרָא</span> (= abode), Ugar. <i>dr</i> (= generation), Akka. <i>dūru</i> (= wall, fortress; also duration, eternity), <i>dārū</i> (= everlasting).]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "דָּר", "parent_lexicon": "BDB Aramaic Dictionary", "content": {"senses": [{"definition": "<strong>n.</strong>[<strong>m.</strong>] <strong>generation (</strong>BH <span dir=\"rtl\">דּוֹר</span><strong>)</strong>;—abs. in phr. <span dir=\"rtl\">עִם־דָּר וְדָר</span> <a data-ref=\"Daniel 3:33\" href=\"/Daniel.3.33\">Dn 3:33</a>; <a data-ref=\"Daniel 4:31\" href=\"/Daniel.4.31\">4:31</a> (is) <em>with generation and generation</em>, i.e. endures gen. after gen."}]}, "rid": "BDBA0196", "strong_numbers": ["1859"], "next_hw": "מְדוּר", "prev_hw": "דּוּר", "quotes": [], "GK": [], "TWOT": ["2669a"], "parent_lexicon_details": {"name": "BDB Aramaic Dictionary", "language": "ara.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB Aramaic", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "דָּר²", "parent_lexicon": "BDB Aramaic Dictionary", "content": {"senses": [{"definition": "v. <a data-ref=\"BDB Aramaic, דּוּר\" href=\"/BDB Aramaic,_דּוּר\", dir=\"rtl\">דוּר</a>."}]}, "rid": "BDBA0220", "strong_numbers": ["1859"], "next_hw": "דָּֽרְיָ֫וֶשׁ", "prev_hw": "דְּקַק", "quotes": [], "GK": [], "TWOT": ["2669a"], "parent_lexicon_details": {"name": "BDB Aramaic Dictionary", "language": "ara.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB Aramaic", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "דָּר", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>*, ש\"ז, מ\"ר דָּרִים, — בצמח, עלה דומה קצת לקשקשת הדג יושב זה ע\"ג זה: שהיא עשויה <strong>דרין דרין</strong> (<span class=\"by-source\">מד\"ר בראש' כ</span>).</p>"]}, "rid": "BY-03747", "prev_hw": "דַּר", "next_hw": "דרא", "page_num": 990, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]