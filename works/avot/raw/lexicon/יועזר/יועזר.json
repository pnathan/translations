[{"headword": "יוֹעֶזֶר", "parent_lexicon": "Jastrow Dictionary", "rid": "J00221", "refs": [], "content": {"senses": [{"definition": " (b. h.) "}, {"definition": " pr. n. m. <i>Joezer</i>. Orlah II, 12 a disciple of Shammai’s school.—<a class=\"refLink\" href=\"/Pirkei_Avot.1.4\" data-ref=\"Pirkei Avot 1:4\">Ab. I, 4</a>; a. fr., v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_יוֹסֵי.1\" data-ref=\"Jastrow, יוֹסֵי 1\">יוֹסֵי</a>", "number": "1)"}, {"definition": " name of <i>a plant</i>. <a class=\"refLink\" href=\"/Mishnah_Shabbat.14.3\" data-ref=\"Mishnah Shabbat 14:3\">Sabb. XIV, 3</a>, expl. Y. ib. 14ᶜ פוליטריכין <i>polytrichon, Maiden-hair</i>; Bab. ib. 109ᵇ <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_פּוּתְנַק.1\" data-ref=\"Jastrow, פּוּתְנַק 1\">פותנק</a>.", "number": "—2)"}]}, "quotes": [], "prev_hw": "יוסתיניא", "next_hw": "יוֹפִי", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "יוֹעֶזֶר", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>*, ש\"ז, —  שֵׁם צמח דומה קצת לשערות ארוכות, Frauenhaar; adiante; maidenhair:  אין אוכלין איזוב יון בשבת לפי שאינו מאכל בריאים אבל אוכל הוא את <strong>יועזר</strong> <sup class=\"footnote-marker\">1</sup><i class=\"footnote\">תרגמו בגמ' ירוש' בפוליטריכין, ובגמ' בבלי אמרו:  מאי יועזר פותנק.  ע\"כ.  ואעפ\"י שהרמב\"ם החליט כמו הבבלי כפי המקובל <strong>בהלכה </strong>כבבלי נגד הירוש', אבל בענין הלשון בדואי פרוש הירוש' מכריע.  ומקור השם הזה לא נתברר.</i> ושותה אבוב רועה (<span class=\"by-source\">שבת יד ג</span>).</p>"]}, "rid": "BY-07675", "prev_hw": "יוֹנֶקֶת", "next_hw": "יוֹעֵץ", "page_num": 2004, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]