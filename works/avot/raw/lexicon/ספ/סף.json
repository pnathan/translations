[{"headword": "סַף", "parent_lexicon": "Jastrow Dictionary", "rid": "O01308", "refs": [], "content": {"senses": [{"definition": " part. a. perf. of <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_סוּף.1\" data-ref=\"Jastrow, סוּף 1\">סוּף</a>."}]}, "alt_headwords": ["סָף"], "quotes": [], "prev_hw": "סְעַרְתָּא", "next_hw": "סַף ²", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "סוף", "parent_lexicon": "Klein Dictionary", "content": {"senses": [{"definition": "to come to an end, cease."}, {"senses": [{"definition": "came to an end, ceased."}], "grammar": {"morphology": "intr. v.", "binyan_form": ["סָף"], "verbal_stem": "— Qal"}}, {"senses": [{"definition": "he made an end of."}], "grammar": {"binyan_form": ["הֵסִיף"], "verbal_stem": "— Hiph."}}]}, "rid": "O00304", "refs": ["Klein Dictionary, סוּף 1", "Klein Dictionary, סוף 1", "Klein Dictionary, סוּף 1", "Klein Dictionary, סוף 1", "Klein Dictionary, סוֹף 1", "Klein Dictionary, סוּפָה 1", "Klein Dictionary, סוֹף 1", "Klein Dictionary, סוּפָה 1"], "derivatives": "Derivatives: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_סוֹף.1\" data-ref=\"Klein Dictionary, סוֹף 1\">סוֹף</a>, prob. also <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_סוּפָה.1\" data-ref=\"Klein Dictionary, סוּפָה 1\">סוּפָה</a>.", "prev_hw": "סוֹעֵר", "next_hw": "סוֹף", "notes": "[Aram. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_סוּף.1\" data-ref=\"Klein Dictionary, סוּף 1\">סוּף</a> (= to cease), Syr. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_סוף.1\" data-ref=\"Klein Dictionary, סוף 1\">סָף</a> (= came to an end, ceased, perished), Arab. <i>sāfa</i> (= he disappeared, perished).]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "סָף", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>°, ת\"ז, נק' סָפָה, מ\"ר סָפים, — מה שהוא סָף, עובר וכלה: כי הם יבטחו בכחם הכלה ובגבורתם <strong>הספה</strong> ואתם תבטחו בכח יי' אלהינו אשר לא יכלה ובעוז גבורתו אשר לא תסוף (<span class=\"by-source\">יוסיפון כ, דפו' פרנקפ'</span>). — ואמר המשורר: ואל תכאב לדבר <strong>סף</strong> ונודד ולא תדרך סלול יחיד ובדד (<span class=\"by-source\">רה\"ג, מוסר השכל, לקו\"ק 70</span>). הן כחשו וטיט רפשו הלא נפשו יודעת עת ביתו וחיתו כרוח <strong>סף </strong>ונוסעת (<span class=\"by-source\">רמב\"ע, מרי שגיון, הוצ' דוקס 66</span>). אלהים חי וגם קים עדי עד וכל חיים אשר יצר <strong>ספים</strong> (<span class=\"by-source\">ר\"מ דרעי, לקו\"ק נט</span>). עדי עש תהי <strong>ספה </strong>וחוג צדק ומאדים (<span class=\"by-source\">הוא, שם פב</span>). ולאל היא יקר תבל יהיה <strong>סף</strong> ובעדה כל יקר נוצר ונברא (<span class=\"by-source\">ר\"י חריזי, תחכמ' מב</span>). — ובכל המשמע' יחד: בכוס שהם יצק יין כעין הדם אשר <strong>בסף</strong><sup class=\"footnote-marker\">1</sup><i class=\"footnote\">[כלי]</i> אשר יחזיק לבב חלש ויבא בקרב עם <strong>סף</strong><sup class=\"footnote-marker\">2</sup><i class=\"footnote\">גבור (<span class=\"by-source\">ש\"ב כא יח</span>).</i> ואשתה עד מראשותי בלא בין יהיו <strong>בסף</strong><sup class=\"footnote-marker\">3</sup><i class=\"footnote\">[במפתן]</i> וכליל כל יגון לבי בעת הקיץ ורגלו <strong>סף</strong><sup class=\"footnote-marker\">4</sup><i class=\"footnote\">[מן סוף, סף וכלה.]</i> (<span class=\"by-source\">רמב\"ע, התרשיש ב פח</span>).</p>"]}, "rid": "BY-13554", "prev_hw": "סַף II", "next_hw": "ספא", "page_num": 4142, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]