[{"headword": "לְוִיָּה", "parent_lexicon": "Jastrow Dictionary", "rid": "L00255", "refs": ["Yoma 54b", "Jastrow, לְוָיָה 1", "Jerusalem Talmud Moed Katan 1:6:4"], "content": {"senses": [{"definition": " (<a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_לָוָה.1\" data-ref=\"Jastrow, לָוָה 1\">לָוָה</a>) "}, {"definition": "<i>consort, wife</i>. <a class=\"refLink\" href=\"/Yoma.54b\" data-ref=\"Yoma 54b\">Yoma 54ᵇ</a> top (ref. to <span dir=\"rtl\">וליות</span>, <a class=\"refLink\" href=\"/I_Kings.7.36\" data-ref=\"I Kings 7:36\">I Kings VII, 36</a>), v. <a class=\"refLink\" href=\"/Jastrow,_ערי ².1\" data-ref=\"Jastrow, ערי ² 1\"><span dir=\"rtl\">עָרָה</span> II</a>.", "number": "1)"}, {"definition": " (v. <a class=\"refLink\" href=\"/Jastrow,_לְוָיָה.1\" data-ref=\"Jastrow, לְוָיָה 1\">next w.</a>) <i>the wailing woman’s company</i>. <a class=\"refLink\" href=\"Jerusalem_Talmud_Moed_Katan.1.6.4\" data-ref=\"Jerusalem Talmud Moed Katan 1:6:4\">Y. M. Kat. I, 80ᵈ</a> top, [read:] <span dir=\"rtl\">לא תעורר אשה לְוִיָּיתָהּ … רבי נחמן … אמר לִיוְיָתָהּ</span> a woman must not stir up her company for wailing during the festive week; R. N. read <i>livyatha</i> (with ref. to <span dir=\"rtl\">עורר לויתן</span> <a class=\"refLink\" href=\"/Job.3.8\" data-ref=\"Job 3:8\">Job III, 8</a>; cmp. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אִילַּוָּיוּתָא.1\" data-ref=\"Jastrow, אִילַּוָּיוּתָא 1\">אִילַּוָּיוּתָא</a>).", "number": "—2)"}], "morphology": "f."}, "plural_form": [], "alt_headwords": ["לְיִיָּיה II", "לִוְיָה"], "quotes": [], "prev_hw": "לִוִיָּה", "next_hw": "לְוָיָה", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "לִוְיָה ᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"definition": "wreath, garland, chaplet."}]}, "rid": "L00229", "refs": ["Klein Dictionary, לוה ᴵᴵᴵ 1", "Klein Dictionary, ◌ָה ᴵ 1", "Klein Dictionary, לוה ᴵᴵᴵ 1", "Klein Dictionary, ◌ָה ᴵ 1", "Klein Dictionary, לִוְיָתָן 1", "Klein Dictionary, לִוְיָתָן 1"], "derivatives": "Derivative: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_לִוְיָתָן.1\" data-ref=\"Klein Dictionary, לִוְיָתָן 1\">לִוְיָתָן</a>.", "prev_hw": "לוֹיָאלִי", "next_hw": "לִוְיָה ᴵᴵ", "notes": "[Formed from <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_לוה ᴵᴵᴵ.1\" data-ref=\"Klein Dictionary, לוה ᴵᴵᴵ 1\">לוה ᴵᴵᴵ</a> with first suff. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_◌ָה ᴵ.1\" data-ref=\"Klein Dictionary, ◌ָה ᴵ 1\">◌ָה</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "לִוְיָה ᴵᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "f.n.", "senses": [{"definition": "cry of woe."}]}, "rid": "L00230", "language_code": "PBH", "refs": [], "prev_hw": "לִוְיָה ᴵ", "next_hw": "לְוָיָה", "notes": "[Of uncertain origin.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "לִוְיָה I", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p><sup class=\"footnote-marker\">1</sup><i class=\"footnote\">משרש <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_לֹה.1\" data-ref=\"Ben Yehuda Dictionary, לֹה 1\">לוה</a>, עי\"ש.</i>, ש\"נ, סמי' לִוְיַת, — אֶגד של בגד וכדומ' סביב להראש, Stirnband; bandeau; wreath, ובמליצה: שמע בני מוסר אביך ואל תטש תורת אמך כי לִוְיַת חן הם לראשך וענקים לגרגרתיך (<span class=\"by-source\">משלי א ח-ט</span>).  סלסלה (את החכמה) ותרוממך תכבדך כי תחבקנה תתן לראשך לִוְיַת חן עטרת תפארת תמגנך (<span class=\"by-source\">שם ד ח-ט</span>). — ואמר המשורר: <strong>לוית</strong> חן תסובבם אל מרחמם, וסוכה תהיה לצל יומם (<span class=\"by-source\">ר\"י הלוי, אראה היום</span>).  נשיא אל יאשיה, לראש היקר <strong>לויה</strong>, במחשכי שביה, שלחו צור אירה (<span class=\"by-source\">ר\"י חריזי, תחכמ' א</span>).  ללוי כל יקר נלוה ונקוה והוא <strong>לוית</strong> פאר על ראש משיחיו (<span class=\"by-source\">שם ג</span>).  לו חכמו לבשו שק כעדי וחבלים שמו <strong>לויתן</strong> (<span class=\"by-source\">הוא, הענק ג קמט</span>). — ומ\"ר: איה חלי חמדם ונזר נעמם איה רפידת תֹם אשר רפדו, אי שהרון החן אשר על <strong>לויותיהם</strong> ואי קשור יקר ענדו (<span class=\"by-source\">יעקב בן אלעזר, לא אתמהה</span>).</p>"]}, "rid": "BY-09262", "prev_hw": "לוֹיָה", "next_hw": "לִוְיָה II", "page_num": 2641, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}, {"headword": "לִוְיָה II", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>*, לִוְיָתָהּ,— עי' *<a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_לִוְיָתָה.1\" data-ref=\"Ben Yehuda Dictionary, לִוְיָתָה 1\">לִוְיָתָה</a>. ואמר הפיטן: וכי אין להוסיף מועד שבר ותבערה, ואין להקדים זולתי לאחרה, תחת כן היום <strong>לויתי</strong> אעוררה, ואספדה ואלילה ואבכה בנפש מרה (<span class=\"by-source\">קלוני' בר\"י, מי יתן ראשי מים</span>).</p>"]}, "rid": "BY-09263", "prev_hw": "לִוְיָה I", "next_hw": "לְוִיָּה", "page_num": 2641, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]