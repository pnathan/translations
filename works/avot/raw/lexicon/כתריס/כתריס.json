[{"headword": "תְּרֵיס", "parent_lexicon": "Jastrow Dictionary", "rid": "V00993", "refs": ["Jastrow, תְּרַס 1"], "content": {"senses": [{"definition": ", v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_תְּרַס.1\" data-ref=\"Jastrow, תְּרַס 1\">תְּרַס</a>"}]}, "quotes": [], "prev_hw": "תרינוס", "next_hw": "תָּרִיס", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "תָּרִיס", "parent_lexicon": "Jastrow Dictionary", "rid": "V00994", "refs": ["Jastrow, אָרַס 1", "Jastrow, *טַארְגָא 1", "Midrash Tehillim 1:3", "Yalkut Shimoni on Nach 833:1", "Berakhot 27b:16", "Bekhorot 36a:13", "Beitzah 11b:4", "Jerusalem Talmud Shabbat 12:1:6"], "content": {"senses": [{"definition": " (= <span dir=\"rtl\">תאריס</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_אָרַס.1\" data-ref=\"Jastrow, אָרַס 1\">אָרַס</a> a. denom.; cmp. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_תָּגָא.1\" data-ref=\"Jastrow, תָּגָא 1\">תָּגָא</a> a. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_תָּאגָא.1\" data-ref=\"Jastrow, תָּאגָא 1\">תָּאגָא</a>) "}, {"definition": "<i>shield</i> (of twisted osiers &c.). <a class=\"refLink\" href=\"/Mishnah_Shabbat.6.4\" data-ref=\"Mishnah Shabbat 6:4\">Sabb. VI, 4</a>. <a class=\"refLink\" href=\"/Mishnah_Kelim.24.1\" data-ref=\"Mishnah Kelim 24:1\">Kel. XXIV, 1</a> <span dir=\"rtl\">שלשה תריסין הן ת׳ כפוף וכ׳</span> there are three sorts of shields (with regard to levitical cleanness): the bent shield (which may be used as an improvised seat) is unclean as <i>midras</i> (v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_מִדְרָס.1\" data-ref=\"Jastrow, מִדְרָס 1\">מִדְרָס</a>), and that with which they play in the camp &c., v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דִּיצָה.1\" data-ref=\"Jastrow, דִּיצָה 1\">דִּיצָה</a>. <a class=\"refLink\" href=\"/Midrash_Tehillim.1.3\" data-ref=\"Midrash Tehillim 1:3\">Midr. Till. to Ps. I</a>; <a class=\"refLink\" href=\"/Yalkut_Shimoni_on_Nach.833.1\" data-ref=\"Yalkut Shimoni on Nach 833:1\">Yalk. ib. 833</a> (ref. to <span dir=\"rtl\">מגן</span>, <a class=\"refLink\" href=\"/Psalms.84.12\" data-ref=\"Psalms 84:12\">Ps. LXXXIV, 12</a>) [read:] <span dir=\"rtl\">הת׳ שמקיף וכ׳</span> (<span dir=\"rtl\">איסקוטא פרסאה</span>, <span dir=\"rtl\">איש׳</span>, being a gloss, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_*טַארְגָא.1\" data-ref=\"Jastrow, *טַארְגָא 1\">טַארְגָא</a>) that is the <i>taris</i>, which protects man on three sides, contrad. to <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_צִנָּה.1\" data-ref=\"Jastrow, צִנָּה 1\">צִנָּה</a>. <a class=\"refLink\" href=\"/Pirkei_Avot.4.11\" data-ref=\"Pirkei Avot 4:11\">Ab. IV, 11</a> <span dir=\"rtl\">תשובה … כת׳ בפני הפורענות</span> repentance and good deeds are as a shield against misfortune; [oth. opin: as a <i>shutter</i>, v. infra).—Pl. <span dir=\"rtl\">תָּרִיסִין</span>. Kel. l. c. <a class=\"refLink\" href=\"/Berakhot.27b.16\" data-ref=\"Berakhot 27b:16\">Ber. 27ᵇ</a>; <a class=\"refLink\" href=\"/Bekhorot.36a.13\" data-ref=\"Bekhorot 36a:13\">Bekh. 36ᵃ</a> <span dir=\"rtl\">בעלי ת׳</span> shield-bearers, i.e. great debaters.—2) (cmp. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_נַעַל.1\" data-ref=\"Jastrow, נַעַל 1\">נַעַל</a>) <i>shutter.—</i> Pl. as ab. <a class=\"refLink\" href=\"/Mishnah_Beitzah.1.5\" data-ref=\"Mishnah Beitzah 1:5\">Bets. I, 5</a> <span dir=\"rtl\">אין מסלקין את הת׳ וכ׳</span> you must not remove (take apart) shutters on the Holy Day; expl. <a class=\"refLink\" href=\"/Beitzah.11b.4\" data-ref=\"Beitzah 11b:4\">ib. 11ᵇ</a> <span dir=\"rtl\">תְּרֵיסֵי חנויות</span> shutters of shops. Y. ib. I, 60ᶜ, v. <a class=\"refLink\" href=\"/Jastrow,_לָחַם I.1\" data-ref=\"Jastrow, לָחַם I 1\"><span dir=\"rtl\">לָחַם</span> I</a>; <a class=\"refLink\" href=\"Jerusalem_Talmud_Shabbat.12.1.6\" data-ref=\"Jerusalem Talmud Shabbat 12:1:6\">Y. Sabb. XII, 13ᶜ</a> <span dir=\"rtl\">התירצין</span> (read: <span dir=\"rtl\">התְּרִיצִין</span>).", "number": "1)"}], "morphology": "m."}, "plural_form": ["I", "אין מסלקין את הת׳ וכ׳"], "alt_headwords": [], "quotes": [], "prev_hw": "תְּרֵיס", "next_hw": "תָּרִיס ²", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "תָּרִיס ²", "parent_lexicon": "Jastrow Dictionary", "rid": "V00995", "language_code": " ch. ", "refs": ["Jastrow, תָּרִיס 1", "Aramaic Targum to Psalms 5:13"], "language_reference": "<a class=\"refLink\" href=\"/Jastrow,_תָּרִיס.1\" data-ref=\"Jastrow, תָּרִיס 1\">same</a>", "content": {"senses": [{"definition": ", <i>shield</i>. <a class=\"refLink\" href=\"/Aramaic_Targum_to_Psalms.3.4\" data-ref=\"Aramaic Targum to Psalms 3:4\">Targ. Ps. III, 4</a> (h. text <span dir=\"rtl\">מגן</span>). <a class=\"refLink\" href=\"/Aramaic_Targum_to_Psalms.5.13\" data-ref=\"Aramaic Targum to Psalms 5:13\">Ib. V, 13</a> (h. text <span dir=\"rtl\">צנח</span>). <a class=\"refLink\" href=\"/Targum_Jonathan_on_Deuteronomy.33.29\" data-ref=\"Targum Jonathan on Deuteronomy 33:29\">Targ. Y. Deut. XXXIII, 29</a>; a. fr.—Pl. <span dir=\"rtl\">תְּרֵיסַיָּא</span>, <span dir=\"rtl\">תְּרֵיסִין</span>, <span dir=\"rtl\">תְּרִי׳</span>. <a class=\"refLink\" href=\"/Targum_Jonathan_on_Ezekiel.39.9\" data-ref=\"Targum Jonathan on Ezekiel 39:9\">Targ. Ez. XXXIX, 9</a> (ed. Lag. <span dir=\"rtl\">תרסין</span>). <a class=\"refLink\" href=\"/Aramaic_Targum_to_Job.15.26\" data-ref=\"Aramaic Targum to Job 15:26\">Targ. Job XV, 26</a> (ed. Wil. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_תְּרֵיסִיּוֹת.1\" data-ref=\"Jastrow, תְּרֵיסִיּוֹת 1\">תְּרֵס׳</a>); a. fr."}]}, "plural_form": ["תְּרֵיסַיָּא", "תְּרֵיסִין", "תְּרִי׳"], "alt_headwords": ["תְּרִיס", "תְּרֵיסָא"], "quotes": [], "prev_hw": "תָּרִיס", "next_hw": "תְּרֵיסִיּוֹת", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "תְּרִיס ᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "shutter, blind."}]}, "rid": "V01246", "language_code": "PBH", "refs": ["Klein Dictionary, תְּרִיס ᴵᴵ 1", "Klein Dictionary, תְּרִיס ᴵᴵ 1"], "prev_hw": "תַּרְיַ״ג", "next_hw": "תְּרִיס ᴵᴵ", "notes": "[From Gk. <i>thyris</i> (= window), which is related to <i>thyra</i> (= door), and cogn. with Old I. <i>dvā́raḥ</i>, <i>duráḥ, dúraḥ</i> (= door), <i>duróṇa</i>– (= dwelling, home), Avestic <i>dvar</i><i></i><i>m</i> (= gate, court), etc. cp. ‘door’ in my CEDEL. cp. also <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_תְּרִיס ᴵᴵ.1\" data-ref=\"Klein Dictionary, תְּרִיס ᴵᴵ 1\">תּֽרִיס ᴵᴵ</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "תְּרִיס ᴵᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "shield."}]}, "rid": "V01247", "language_code": "PBH", "refs": ["Klein Dictionary, תְּרִיס ᴵ 1", "Klein Dictionary, תְּרִיס ᴵ 1", "Klein Dictionary, תְּרִיס ᴵ 1", "Klein Dictionary, תְּרִיס ᴵ 1", "Klein Dictionary, תרס ᴵ