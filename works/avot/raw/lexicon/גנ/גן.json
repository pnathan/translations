[{"headword": "גַּן", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n", "senses": [{"definition": "n m/f"}, {"definition": "garden,  enclosure", "senses": [{"definition": "enclosed garden", "senses": [{"definition": "(fig. of a bride)"}]}, {"definition": "garden (of plants)"}]}, {"definition": "n pr loc", "senses": [{"definition": "Garden of Eden"}]}]}, "strong_number": "1588", "transliteration": "gan", "pronunciation": "gan", "language_code": "heb", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "גַּן", "parent_lexicon": "Jastrow Dictionary", "rid": "C01072", "language_code": "(b. h.;", "refs": ["Pesachim 54a:10", "Nedarim 39b:4", "Nedarim 39b:7", "Bereishit Rabbah 15:1", "Taanit 10a:9", "Shemot Rabbah 31:5", "Pirkei DeRabbi Eliezer 21:1", "Shir HaShirim Rabbah 4:12:1", "Vayikra Rabbah 3:1", "Bereishit Rabbah 85:4"], "language_reference": " <span dir=\"rtl\">גנן</span>)", "content": {"senses": [{"definition": "<i>a fenced-in place, garden</i>.—גַּן עֵדֶן <i>paradise, place of future reward</i>, opp. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_גֵּיהִינָּם.1\" data-ref=\"Jastrow, גֵּיהִינָּם 1\">גֵּיהִינָּם</a>. <a class=\"refLink\" href=\"/Pesachim.54a.10\" data-ref=\"Pesachim 54a:10\">Pes. 54ᵃ</a>; <a class=\"refLink\" href=\"/Nedarim.39b.7\" data-ref=\"Nedarim 39b:7\">Ned. 39ᵇ</a>; a. fr.—<a class=\"refLink\" href=\"/Bereishit_Rabbah.15.1\" data-ref=\"Bereishit Rabbah 15:1\">Gen. R. s. 15</a> beg. <span dir=\"rtl\">גן גדול מעדן</span> the garden was larger than Eden (Eden was a portion of the garden, ref. to <a class=\"refLink\" href=\"/Ezekiel.31.9\" data-ref=\"Ezekiel 31:9\">Ez. XXXI, 9</a>). <a class=\"refLink\" href=\"/Taanit.10a.9\" data-ref=\"Taanit 10a:9\">Taan. 10ᵃ</a> <span dir=\"rtl\">וגן אחד וכ׳</span> and the garden was one sixtieth portion of Eden.—Gen. R. l. c. <span dir=\"rtl\">כפיגי שהיא נתונה בגי׳</span> like a spring in a garden. <a class=\"refLink\" href=\"/Mishnah_Kilayim.2.2\" data-ref=\"Mishnah Kilayim 2:2\">Kil. II, 2</a> <span dir=\"rtl\">זרעוני גנה</span> garden plants. <a class=\"refLink\" href=\"/Shemot_Rabbah.31.5\" data-ref=\"Shemot Rabbah 31:5\">Ex. R. s. 31</a> <span dir=\"rtl\">גלגל שבגי׳</span> the wheel works of the well in the garden; a. fr.—Trnsf. (cmp. hortulus a. κῆπος) <i>woman</i>. <a class=\"refLink\" href=\"/Pirkei_DeRabbi_Eliezer.21.1\" data-ref=\"Pirkei DeRabbi Eliezer 21:1\">Pirké d’R. El. ch. XXI</a> אין גן אלא האשה וכ׳ <i>gan</i> (<a class=\"refLink\" href=\"/Genesis.3.3\" data-ref=\"Genesis 3:3\">Gen. III, 3</a>) means woman who is compared to a garden (ref. to <a class=\"refLink\" href=\"/Song_of_Songs.4.12\" data-ref=\"Song of Songs 4:12\">Cant. IV, 12</a>), <span dir=\"rtl\">מה הגנה זו וכ׳</span> as a garden &c. <a class=\"refLink\" href=\"/Shir_HaShirim_Rabbah.4.12.1\" data-ref=\"Shir HaShirim Rabbah 4:12:1\">Cant. R. to IV, 12</a> <span dir=\"rtl\">גַּנָּתִי נעולה והיא מתגניא</span> my consort (Israel) is closed (chaste), and yet defamed.—Pl. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_גְּנוּת.1\" data-ref=\"Jastrow, גְּנוּת 1\">גַּנּוֹת</a>. <a class=\"refLink\" href=\"/Vayikra_Rabbah.3.1\" data-ref=\"Vayikra Rabbah 3:1\">Lev. R. s. 3</a>, beg. better off is he who owns <span dir=\"rtl\">גינה</span> one garden and &c. <span dir=\"rtl\">ממי שנוטל ג׳ של וכ׳</span> than he who takes other people’s gardens on half-shares; a. fr.—<a class=\"refLink\" href=\"/Bereishit_Rabbah.85.4\" data-ref=\"Bereishit Rabbah 85:4\">Gen. R. s. 85</a> <span dir=\"rtl\">חורש בגנות</span> (euphem. for sexual intercourse)."}], "morphology": "f."}, "plural_form": ["גַּנּוֹת"], "alt_headwords": ["גַּנָּה", "גִּינָּה"], "quotes": [], "prev_hw": "גְּמַשׁ", "next_hw": "גַּנָּא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "גַּן", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "garden.", "number": "1"}, {"definition": "(short for <span dir=\"rtl\">גַּן־יֽלָדִים</span>) kindergarten.", "number": "2", "language_code": "NH"}]}, "rid": "C00759", "refs": ["Klein Dictionary, גִּנָּה 1", "Klein Dictionary, גִּנָּה 1", "Klein Dictionary, גַּנִּי 1", "Klein Dictionary, גַּנָּן 1", "Klein Dictionary, גַּנּוֹן 1", "Klein Dictionary, גנן ᴵ 1", "Klein Dictionary, גַּנִּי 1", "Klein Dictionary, גַּנָּן 1", "Klein Dictionary, גַּנּוֹן 1", "Klein Dictionary, גנן ᴵ 1"], "derivatives": "Derivatives: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_גַּנִּי.1\" data-ref=\"Klein Dictionary, גַּנִּי 1\">גַּנִּי</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_גַּנָּן.1\" data-ref=\"Klein Dictionary, גַּנָּן 1\">גַּנָּן</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_גַּנּוֹן.1\" data-ref=\"Klein Dictionary, גַּנּוֹן 1\">גַּנּוֹן</a>. cp. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_גנן ᴵ.1\" data-ref=\"Klein Dictionary, גנן ᴵ 1\">גנן</a>.", "prev_hw": "גְּמָשָׁה", "next_hw": "גֶּן", "notes": "[Aram. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_גִּנָּה.1\" data-ref=\"Klein Dictionary, גִּנָּה 1\">גִּנָּא</a>, <span dir=\"rtl\">גִּנְּתָא</span>, Ugar. <i>gn</i>, Arab. <i>janna</i><i></i>, Akka. <i>ganna</i> (= garden).]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "בֵּית הַגָּן", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.pr.loc.</strong>? 𝔊 Βαιθαν (Βαιατγαν), 𝔊L Βαιθωρων, <a data-ref=\"II Kings 9:27\" href=\"/II_Kings.9.27\">2 K 9:27</a>; mod. <em>Jenîn</em>? v. <a data-ref=\"BDB, גַּן²\" href=\"/BDB,_גַּן²\", dir=\"rtl\">גַּן</a>, sub <a data-ref=\"BDB, גָּנַן\" href=\"/BDB,_גָּנַן\", dir=\"rtl\">גנן</a>, and <a data-ref=\"BDB, עֵין גַּנִּים\" href=\"/BDB,_עֵין גַּנִּים\", dir=\"rtl\">עֵין גַּנִּים</a>; cf. Sta<sup>Gesch. i. 542</sup>."}]}, "rid": "BDB01178", "strong_numbers": ["1004", "1588"], "next_hw": "בֵּית דִּבְלָתָ֑יִם", "prev_hw": "בֵּית גָּמוּל", "all_cited": true, "quotes": [], "GK": ["1091"], "TWOT": [], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "גַּן", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "v. sub <a data-ref=\"BDB, גָּנַן\" href=\"/BDB,_גָּנַן\", dir=\"rtl\">גנן</a>."}]}, "rid": "BDB01879", "strong_numbers": ["1588", "1593", "1594"], "next_hw": "גָּנַב", "prev_hw": "גְּמַרְיָ֫הוּ", "alt_headwords": [{"word": "גַּנָּה"}], "quotes": [], "GK": ["1703", "1708"], "TWOT": ["367a", "367b"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "גַּן²", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>n.m.</strong> <sup><a data-ref=\"Song of Songs 4:12\" href=\"/Song_of_Songs.4.12\">Ct 4:12</a></sup> & (<a data-ref=\"Genesis 2:15\" href=\"/Genesis.2.15\">Gn 2:15</a>) <strong>f. enclosure, garden (</strong>NH <em>id.</em>, <span dir=\"rtl\">גַּנָּה</span>, Arabic <span dir=\"rtl\">جَنَّةٌ</span>, Ethiopic ገnነት Assyrian <em>gannu</em> or <em>gannatu</em> word of unc. meaning; Aramaic <span dir=\"rtl\">גִּנָּא</span>, <span dir=\"rtl\">גִּנְתָּא</span>, <span dir=\"rtl\">ܓܰܢܬܳܐ</span>; Ph. <span dir=\"rtl\">פר אגנן אם צץ[צ]</span> CIS<sup>i, 165, 11 & p. 232 f.</sup> <em>birds of enclosure</em> (domestic fowls) <em>or of wing</em><strong>)</strong>—abs. <span dir=\"rtl\">גַּן</span> <a data-ref=\"Genesis 2:8\" href=\"/Genesis.2.8\">Gn 2:8</a> + 3 times; cstr. <em>id.</em> <a data-ref=\"Genesis 2:15\" href=\"/Genesis.2.15\">Gn 2:15</a> + 19 times; c. art. <span dir=\"rtl\">הַגָּן</span> <a data-ref=\"Genesis 2:9\" href=\"/Genesis.2.9\">Gn 2:9</a> + 9 times, but <span dir=\"rtl\">כַּגַּן</span> <a data-ref=\"Lamentations 2:6\" href=\"/Lamentations.2.6\">La 2:6</a>; sf. <span dir=\"rtl\">גַּנִּי</span> <a data-ref=\"Song of Songs 4:16\" href=\"/Song_of_Songs.4.16\">Ct 4:16</a>; <a data-ref=\"Song of Songs 5:1\" href=\"/Song_of_Songs.5.1\">5:1</a>, <span dir=\"rtl\">גַּנּוֹ</span> <a data-ref=\"Song of Songs 4:16\" href=\"/Song_of_Songs.4.16\">Ct 4:16</a>; <a data-ref=\"Song of Songs 6:2\" href=\"/Song_of_Songs.6.2\">6:2</a>; Pl. <span dir=\"rtl\">גַּנִּים</span> <a data-ref=\"Song of Songs 4:15\" href=\"/Song_of_Songs.4.15\">Ct 4:15</a> + 2 times—<em>garden</em> as enclosure <a data-ref=\"Lamentations 2:6\" href=\"/Lamentations.2.6\">La 2:6</a> (simile); <span dir=\"rtl\">הַיּוֹשֶׁבֶת בַּגַּנִּים</span> <a data-ref=\"Song of Songs 8:13\" href=\"/Song_of_Songs.8.13\">Ct 8:13</a>; cf. <a data-ref=\"Song of Songs 4:12\" href=\"/Song_of_Songs.4.12\">Ct 4:12</a> (fig. of bride <span dir=\"rtl\">גַּן נָעוּל</span>); <em>g. of herbs</em> <span dir=\"rtl\">(יָרָק)</span> <a data-ref=\"Deuteronomy 11:10\" href=\"/Deuteronomy.11.10\">Dt 11:10</a> <a data-ref=\"I Kings 21:2\" href=\"/I_Kings.21.2\">1 K 21:2</a>; fig. of bride, <em>g. of plants, fruits, and spices</em> <a data-ref=\"Song of Songs 4:16\" href=\"/Song_of_Songs.4.16\">Ct 4:16</a><sup>(×2)</sup>; <a data-ref=\"Song of Songs 5:1\" href=\"/Song_of_Songs.5.1\">5:1</a>; <a data-ref=\"Song of Songs 6:2\" href=\"/Song_of_Songs.6.2\">6:2</a><sup>(×2)</sup> cf. <span dir=\"rtl\">מַעְיַן גנים</span> <a data-ref=\"Song of Songs 4:15\" href=\"/Song_of_Songs.4.15\">Ct 4:15</a>; <em>g. of</em> (<em>king’s</em>) <em>house</em> <a data-ref=\"II Kings 21:18\" href=\"/II_Kings.21.18\">2 K 21:18</a> = <span dir=\"rtl\">גַּן־עֻזָּא</span> <a data-ref=\"II Kings 21:18\" href=\"/II_Kings.21.18\">2 K 21:18</a>, <a data-ref=\"II Kings 21:26\" href=\"/II_Kings.21.26\">26</a>; <span dir=\"rtl\">גַּן הַמֶּלֶךְ</span> <a data-ref=\"II Kings 25:4\" href=\"/II_Kings.25.4\">2 K 25:4</a> <a data-ref=\"Jeremiah 39:4\" href=\"/Jeremiah.39.4\">Je 39:4</a>; <a data-ref=\"Jeremiah 52:7\" href=\"/Jeremiah.52.7\">52:7</a> <a data-ref=\"Nehemiah 3:15\" href=\"/Nehemiah.3.15\">Ne 3:15</a>, cf. <a data-ref=\"BDB, בֵּית הַגָּן\" href=\"/BDB,_בֵּית הַגָּן\", dir=\"rtl\">בֵּית הַגָּן</a> <a data-ref=\"II Kings 9:27\" href=\"/II_Kings.9.27\">2 K 9:27</a> (at Jezreel? but this perhaps <strong>n.pr.loc.</strong> v. sub <a data-ref=\"BDB, בַּ֫יִת\" href=\"/BDB,_בַּ֫יִת\", dir=\"rtl\">בית</a> p. 111); most often of garden (orchard?) in Eden (Hex only Gn & only J) <a data-ref=\"Genesis 2:8\" href=\"/Genesis.2.8\">Gn 2:8</a>, <a data-ref=\"Genesis 2:9\" href=\"/Genesis.2.9\">9</a>, <a data-ref=\"Genesis 2:10\" href=\"/Genesis.2.10\">10</a>, <a data-ref=\"Genesis 2:16\" href=\"/Genesis.2.16\">16</a>; <a data-ref=\"Genesis 3:1\" href=\"/Genesis.3.1\">3:1</a>, <a data-ref=\"Genesis 3:2\" href=\"/Genesis.3.2\">2</a>, <a data-ref=\"Genesis 3:3\" href=\"/Genesis.3.3\">3</a>, <a data-ref=\"Genesis 3:8\" href=\"/Genesis.3.8\">8</a><sup>(×2)</sup>, <a data-ref=\"Genesis 3:10\" href=\"/Genesis.3.10\">10</a>, called <span dir=\"rtl\">גַּן־עֵדֶן</span> <a data-ref=\"Genesis 2:15\" href=\"/Genesis.2.15\">Gn 2:15</a>; <a data-ref=\"Genesis 3:23\" href=\"/Genesis.3.23\">3:23</a>, <a data-ref=\"Genesis 3:24\" href=\"/Genesis.3.24\">24</a> <a data-ref=\"Ezekiel 36:35\" href=\"/Ezekiel.36.35\">Ez 36:35</a> <a data-ref=\"Joel 2:3\" href=\"/Joel.2.3\">Jo 2:3</a>, cf. <span dir=\"rtl\">גן־י׳</span> <a data-ref=\"Genesis 13:10\" href=\"/Genesis.13.10\">Gn 13:10</a> <a data-ref=\"Isaiah 51:3\" href=\"/Isaiah.51.3\">Is 51:3</a> (both in simile); <span dir=\"rtl\">גן־אלהים</span> <a data-ref=\"Ezekiel 28:13\" href=\"/Ezekiel.28.13\">Ez 28:13</a> <span dir=\"rtl\">(עֵדֶן גן־אל׳)</span>, <a data-ref=\"Ezekiel 31:8\" href=\"/Ezekiel.31.8\">31:8</a><sup>(×2)</sup>, <a data-ref=\"Ezekiel 31:9\" href=\"/Ezekiel.31.9\">9</a> (‖ <span dir=\"rtl\">עֵדֶן</span>); in last three the trees of the garden are comp. with Assyrian under fig. of cedar of Lebanon."}]}, "rid": "BDB01888", "strong_numbers": ["1588"], "next_hw": "גַּנָּה", "prev_hw": "גָּנַן", "all_cited": true, "quotes": [], "GK": ["1703"], "TWOT": ["367a"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "גַּן", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p><sup class=\"footnote-marker\">1</sup><i class=\"footnote\">מן שרש <a class=\"refLink\" data-ref=\"Ben Yehuda Dictionary, גנן 1\" href=\"/Ben_Yehuda_Dictionary,_גנן.1\">גנן</a>, באשור' גַנַּתַ, בארמ' גינתא, בערב' גִ'נַּה جِنَّة, וחושב פ'רנקל (<span class=\"by-source\">Frä<span dir=\"ltr\">nkel, Aram. Frw. 148</span></span>), כי זו מלה שאולה מארמ', כי אין לה גזרה נכונה מהשרש גנן בערבית.</i>, ש\"ז, בהפס' גָּן, כנ' גַּנִּי, מ\"ר גַּנִּים, — מקום עפי\"ר מוקף גדר ונטוע אילנות או ירקות או פרחים, למאכל או לתענוג, Garten; jardin; garden: ויטע יי' אלהים גַּן בעדן מקדם וכו' ויצמח יי' אלהים מן האדמה כל עץ נחמד למראה וטוב למאכל וכו' ונהר יצא מעדן להשקות את הַגָּן (<span class=\"by-source\">בראש' ב ח-י</span>).  מפרי עץ הַגָּן נאכל (<span class=\"by-source\">בשם ג ב</span>).  ויברחו ויצאו לילה מן העיר דרך גַּן המלך (<span class=\"by-source\">ירמ' לט ד</span>).  אשר תזרע את זרעך והשקית ברגלך כְּגַן הירק (<span class=\"by-source\">דבר' יא י</span>).  תנה לי את כרמך ויהי לי לְגַן ירק כי הוא קרוב אצל ביתי (<span class=\"by-source\">מ\"א כא ב</span>).  והיית כְּגַן רוה וכמוצא מים אשר לא יכזבו מימיו (<span class=\"by-source\">ישע' נח יא</span>).  עורי צפון ובואי תימן הפיחי גַנִּי יזלו בשמיו יבא דודי לְגַנּוֹ ויאכל פרי מגדיו באתי לְגַנִּי אחתי כלה אריתי מורי עם בשמי (<span class=\"by-source\">שה\"ש ד יו-ה יא</span>). דודי ירד לְגַנּוֹ לערוגת הבשם לרעות בַּגַּנִּים וללקט שושנים (<span class=\"by-source\">שם ו ב</span>).  —  גַּן עֵדֶן, הגן אשר בעדן, ששם היה אדם הראשון וחוה, ובתוך האילנות היו עץ החיים ועץ הדעת טוב ורע, וכאשר אכלו מפרי עץ הדעת נגרשו ממנו.  ומזה השם *גַּן עֵדֶן, מקום התענוג להצדיקים אחרי המות, עי' <a class=\"refLink\" data-ref=\"Ben Yehuda Dictionary, עֵדֶן I 1\" href=\"/Ben_Yehuda_Dictionary,_עֵדֶן_I.1\">עֵדֶן</a>.</p>"]}, "rid": "BY-02899", "prev_hw": "גָּמַשׁ", "next_hw": "גְּנַאי", "page_num": 806, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]