[{"headword": "עַרְעָר", "parent_lexicon": "Jastrow Dictionary", "rid": "P01423", "language_code": "(b. h.;", "refs": ["Jastrow, עִרְעֵר II 1", "Vayikra Rabbah 30:3", "Yalkut Shimoni on Nach 855:11"], "language_reference": " <a class=\"refLink\" href=\"/Jastrow,_עִרְעֵר II.1\" data-ref=\"Jastrow, עִרְעֵר II 1\"><span dir=\"rtl\">עִרְעֵר</span> II)</a>", "content": {"senses": [{"definition": "<i>stripped, lonely</i>. <a class=\"refLink\" href=\"/Vayikra_Rabbah.30.3\" data-ref=\"Vayikra Rabbah 30:3\">Lev. R. s. 30</a>; <a class=\"refLink\" href=\"/Yalkut_Shimoni_on_Nach.855.11\" data-ref=\"Yalkut Shimoni on Nach 855:11\">Yalk. Ps. 855</a> <span dir=\"rtl\">שהיה ע׳ ממעשים וכ׳</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_עִרְעֵר.1\" data-ref=\"Jastrow, עִרְעֵר 1\">עִרְעֵר</a>.—Pl. <span dir=\"rtl\">עַרְעָרִים</span>. Ib.; <a class=\"refLink\" href=\"/Midrash_Tehillim.102.4\" data-ref=\"Midrash Tehillim 102:4\">Midr. Till. to Ps. CII, 18</a>."}], "morphology": "m."}, "plural_form": ["עַרְעָרִים"], "alt_headwords": [], "quotes": [], "prev_hw": "עַרְעֵר III", "next_hw": "עַרְעַר", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "עַרְעָר ᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n. & adj.", "senses": [{"definition": "name of a tree, prob. the juniper.", "number": "1"}, {"definition": "stripped, destitute, lonely.", "number": "2"}]}, "rid": "P01150", "refs": ["Klein Dictionary, עַרְעָרוּת 1", "Klein Dictionary, עַרְעָרוּת 1"], "derivatives": "Derivative: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_עַרְעָרוּת.1\" data-ref=\"Klein Dictionary, עַרְעָרוּת 1\">עַרְעָרוּת</a>.", "prev_hw": "ערער ᴵᴵᴵ", "next_hw": "עַרְעָר ᴵᴵ", "notes": "[Related to Arab. <i>‘ar‘ar</i> (= juniper). cp. Syr. <span dir=\"rtl\">עַרַא</span> (= tamarisk).]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "עַרְעָר ᴵᴵ", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "m.n.", "senses": [{"definition": "appeal."}]}, "rid": "P01151", "language_code": "PBH", "refs": ["Klein Dictionary, ערער ᴵ 1", "Klein Dictionary, ערער ᴵ 1"], "prev_hw": "עַרְעָר ᴵ", "next_hw": "עַרְעָרוּת", "notes": "[From <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_ערער ᴵ.1\" data-ref=\"Klein Dictionary, ערער ᴵ 1\">ערער ᴵ</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "עַרְעָר I", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p><sup class=\"footnote-marker\">1</sup><i class=\"footnote\">בער': עַרְעַר عرعر, וגם עִ'רְעִ'ר غرغر, מין אילן.</i>, ש\"ז, —  שם שיח גדל במדבר Wachholder;  genièvre;  juniper(?):   והיה כְּעַרְעָר בערבה ולא יראה כי יבוא טוב (<span class=\"by-source\">ירמ' יז ו</span>). – ובהשאלה, עני, מסכן, שפל: פנה אל תפלת הָעַרְעָר ולא בזה את תפלתם (<span class=\"by-source\">תהל' קב יח</span>) – ובמדר': אלא פנה אל תפלת  <strong>הערער  </strong>זה תפלתו של מנשה מלך יהודה שהיה  <strong>ערער</strong> ממעשים טובים (<span class=\"by-source\">מד\"ר ויק' ל</span>). – ובסהמ\"א: שת לבו ורעיוניו לחילה פסגו ארמונותיה ויקם עמודיה ואדניה איך פנה טפל\"ת <strong>הערער </strong>עשר גליות גלה (<span class=\"by-source\">ר' יוחנן טרוייש, מנח' קנא' לר\"י מפיסא, 4</span>). – ואמר הפיטן: חסדו לי צח ומגיה תארי זרחה כלבוש אדום ישאג כארי והודיה אפציח בת אדום <strong>בערערי </strong>(<span class=\"by-source\">גנזי שכטר ג, דודסון 70</span>).</p>"]}, "rid": "BY-15118", "prev_hw": "עִרְעֵר II", "next_hw": "עַרְעָר II", "page_num": 4741, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}, {"headword": "עַרְעָר II", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>*, ש\"ז, כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_עִרְעוּר_I.1\" data-ref=\"Ben Yehuda Dictionary, עִרְעוּר I 1\">א. עִרְעוּר</a>, — טענה לפסול דבר או פלוני: איזה הוא <strong>ערער </strong>אמרו האיך קפץ פלוני לכהונה שלא נטל חלקו מימיו ושלא נשא כפיו מימיו אין זה <strong>ערער </strong>שהוא בן גרושה או בן חלוצה נתין ממזר הרי זה <strong>ערער </strong>וכו' כל מי שיש לו <strong>ערער </strong>יבוא ויאמר (<span class=\"by-source\">תוספת' כתוב' ב ג</span>). נאמנת חיה לומר זה יצא ראשונה אימתי בזמן שאין שם <strong>ערער </strong>אבל אם יש שם <strong>ערער </strong>אינה נאמנת (<span class=\"by-source\">שם ב\"ב ז ב</span>). —  קרא עַרְעָר: מעשה במשפח' בדרום שהיו קורין עליה <strong>ערער </strong>ושלח ר' את רומינוס לבדקן ומצא שנתגיירה זקנתה פחותה מבת ג' שנים ויום אחד והכשירה לכהונה (<span class=\"by-source\">ר' יעקב בר אידי, ירוש' ביכור' א ה</span>). אילו שטר שהוא מחותם בארבע עדי' יקרא עליו <strong>ערער</strong> זה מעיד על שנים וזה מעיד על שנים (<span class=\"by-source\">ר' חגיי, שם סוט' א א</span>). הרי שהיה אוכל שדה ובא בחזקת שהיא שלו וקרא עליו אחד <strong>ערער</strong> לומר שלי היא (<span class=\"by-source\">בר קפרא, ב\"ב קנד:</span>). כגון שקרא עליו <strong>ערער ערער</strong> דמאי אילימא <strong>ערער </strong>דגזלנותא כל כמיניה נוגע בעדות הוא אלא <strong>ערער </strong>דפגם משפחה (<span class=\"by-source\">ר' אחא בריה דרב איקא, סנה' כג:</span>). — ובסהמ\"א: משפחה שקרא עליה <strong>ערער</strong> והוא שיעידו שנים שנתערב בהן ממזר (<span class=\"by-source\">רמב\"ם, אסורי ביאה יט יח</span>). וכן מקיימים השטר משטר שקרא עליו <strong>ערער </strong>והוחזק בבי\"ד וכו' (<span class=\"by-source\">שו\"ע חו\"מ מו ז</span>). ואם יש עדים וכו' יוצא ממקום אחר משטר שקרא עליו <strong>ערער </strong>וכו' ויש מי שאומר שאין צריך שקרא עליו <strong>ערער </strong>דבהוחזק בבית דין סגי אפילו לא קרא <strong>ערער </strong>וכו' (<span class=\"by-source\">שם לז</span>).  אפילו אם פוסלו ככלל המשפח' כגון שקראו <strong>ערער </strong>(<span class=\"by-source\">לבוש חו\"מ, דיינים יג ה</span>).</p>"]}, "rid": "BY-15119", "prev_hw": "עַרְעָר I", "next_hw": "עַרְעָר III", "page_num": 4741, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}, {"headword": "עַרְעָר III", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>*,<strong> </strong>ש\"ז, מ\"ר עַרְעָרִים, <strong> — </strong>כלי של הסתת: כל כלי הסתת טמאין  <strong>והערערין</strong><sup class=\"footnote-marker\">1</sup><i class=\"footnote\">[כך הגרסה בפרוש רה\"ג ובר\"ש ל<span class=\"by-source\">כלים כא ב</span>.  ובדפו' ובצוק\"מ:  <strong>והערעין</strong>, ועי' <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_עִרְיָן.1\" data-ref=\"Ben Yehuda Dictionary, עִרְיָן 1\">עִרְיָן</a>.]</i> עמהן (<span class=\"by-source\">תוספת' כלים ב\"מ ד ו</span>).</p>"]}, "rid": "BY-15120", "prev_hw": "עַרְעָר II", "next_hw": "עַרְעָר IV", "page_num": 4741, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}, {"headword": "עַרְעָר IV", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>°, ש\"ז, — כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_עִרְעוּר_II.1\" data-ref=\"Ben Yehuda Dictionary, עִרְעוּר II 1\">ב. עִרְעוּר</a>, עשה עַרְעָר: מערערין אותה חוזרין לה לתוך גרונה כאדם הנחנק ע\"י משקה נראה כעושה <strong>ערער </strong>(<span class=\"by-source\">רש\"י, סוט' יח:</span>).</p>"]}, "rid": "BY-15121", "prev_hw": "עַרְעָר III", "next_hw": "עַרְעָר V", "page_num": 4741, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}, {"headword": "עַרְעָר V", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p><strong>°</strong><strong>, </strong>ש\"ז —  פגישה ומקרה: מקרה ושנוי אין בך נמצא ולא זמן  <strong>וערער </strong>ולא כל שמצה (<span class=\"by-source\">שיר היחוד, יום ג</span>).  לא משיגים לו איך וכמה לא מוצאים לו דבר דומה מקרה  <strong>וערער </strong>ושנוי וטפל וחבר ומסמך אור וגם אופל (<span class=\"by-source\">שם יום ה</span>).</p>"]}, "rid": "BY-15122", "prev_hw": "עַרְעָר IV", "next_hw": "עִרְעֲרוֹן", "page_num": 4741, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]