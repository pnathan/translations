[{"headword": "יְהוֹשׁוּעַ", "parent_lexicon": "BDB Augmented Strong", "content": {"morphology": "n-pr-m", "senses": [{"definition": "Joshua or Jehoshua = \"Jehovah is salvation\""}, {"definition": "n pr m"}, {"definition": "son of Nun of the tribe of Ephraim and successor to Moses as the leader of the children of Israel; led the conquest of Canaan"}, {"definition": "a resident of Beth-shemesh on whose land the Ark of the Covenant came to a stop after the Philistines returned it"}, {"definition": "son of Jehozadak and high priest after the restoration"}, {"definition": "governor of Jerusalem under king Josiah who gave his name to a gate of the city of Jerusalem"}]}, "strong_number": "3091", "transliteration": "Yᵉhôwshûwaʻ", "pronunciation": "yeh-ho-shoo'-ah", "language_code": "x-pn", "parent_lexicon_details": {"name": "BDB Augmented Strong", "language": "heb.biblical", "to_language": "eng", "text_categories": ["Tanakh, Torah", "Tanakh, Prophets", "Tanakh, Writings"], "source": "Open Scriptures on GitHub", "source_url": "https://github.com/openscriptures/strongs", "attribution": "Based on the work of Larry Pierce at the Online Bible", "attribution_url": "http://www.blueletterbible.org/contact/contact_gen.cfm"}}, {"headword": "יְהוֹשׁוּעַ", "parent_lexicon": "Jastrow Dictionary", "rid": "J00135", "refs": ["Berakhot 4a:10", "Berakhot 4a:18", "Bava Kamma 80b:12", "Eruvin 17a:17", "Sanhedrin 93a:7", "Sanhedrin 93a:15", "Sanhedrin 93a:16", "Sanhedrin 93a:18", "Mishnah Eruvin 4:2", "Chagigah 5b:3", "Chagigah 5b:5", "Berakhot 3b:14", "Berakhot 3b:15", "Berakhot 3b:17", "Bava Batra 14b:8", "Bava Batra 14b:12"], "content": {"senses": [{"definition": " (b. h.) pr. n. m. <i>Joshua</i>, "}, {"definition": "<i>J.</i> <i> bin Nun</i>, the successor of Moses. <a class=\"refLink\" href=\"/Pirkei_Avot.1.1\" data-ref=\"Pirkei Avot 1:1\">Ab. I, 1</a>. <a class=\"refLink\" href=\"/Berakhot.4a.18\" data-ref=\"Berakhot 4a:18\">Ber. 4ᵃ</a> bot. <a class=\"refLink\" href=\"/Bava_Kamma.80b.12\" data-ref=\"Bava Kamma 80b:12\">B. Kam. 80ᵇ</a>, sq. <span dir=\"rtl\">עשרה … התנה י׳ וכ׳</span> J., on conquering the promised land, laid down ten conditions (regulations) &c.; <a class=\"refLink\" href=\"/Eruvin.17a.17\" data-ref=\"Eruvin 17a:17\">Erub. 17ᵃ</a>; a. v. fr.—<a class=\"refLink\" href=\"/Mishnah_Megillah.1.1\" data-ref=\"Mishnah Megillah 1:1\">Meg. I, 1</a>, a. fr. <span dir=\"rtl\">מומות י׳ בן נון</span> <i>dating from the days of the conquest or before</i>", "number": "1)"}, {"definition": " the high-priest of the returning Babylonian exiles. <a class=\"refLink\" href=\"/Sanhedrin.93a.18\" data-ref=\"Sanhedrin 93a:18\">Snh. 93ᵃ</a>; a. e.—3) name of several Tannaim; a) J.; a. e.", "number": "—2)"}, {"definition": " name of several Tannaim; a) J. b. Praḥya. <a class=\"refLink\" href=\"/Pirkei_Avot.1.6\" data-ref=\"Pirkei Avot 1:6\">Ab. I, 6</a>; a. fr.—b) R. J. b. Ḥǎnania, mostly quoted as R. J. only. <a class=\"refLink\" href=\"/Mishnah_Maaser_Sheni.5.9\" data-ref=\"Mishnah Maaser Sheni 5:9\">Maas. Sh. V, 9</a>. <a class=\"refLink\" href=\"/Mishnah_Eruvin.4.1\" data-ref=\"Mishnah Eruvin 4:1\">Erub. IV, 1</a>; <a class=\"refLink\" href=\"/Mishnah_Eruvin.4.2\" data-ref=\"Mishnah Eruvin 4:2\">2</a>. <a class=\"refLink\" href=\"/Chagigah.5b.5\" data-ref=\"Chagigah 5b:5\">Ḥag. 5ᵇ</a>; a. v. fr.; and others (v. Fr. Darkhé pp. 97; 134; 178; 189).", "number": "—3)"}, {"definition": " name of several Amoraim, esp. R. J. b. Levi. <a class=\"refLink\" href=\"/Berakhot.3b.17\" data-ref=\"Berakhot 3b:17\">Ber. 3ᵇ</a>; a. v. fr.—R. J. of Sikhnin. Y. ib. IV, 7ᵇ bot.; a. fr.; and others (v. Fr. M’bo p. 91ᵃ, sq.).—(<span dir=\"rtl\">ספר</span>) <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_י׳.1\" data-ref=\"Jastrow, י׳ 1\">י׳</a> <i>the Book of Joshua</i>. <a class=\"refLink\" href=\"/Bava_Batra.14b.12\" data-ref=\"Bava Batra 14b:12\">B. Bath. 14ᵇ</a>; a. e.", "number": "—4)"}]}, "plural_form": [], "alt_headwords": ["יְהוֹשֻׁעַ"], "quotes": [], "prev_hw": "יְהוֹרָם", "next_hw": "יְהוֹשַׁעְיָא", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "יְהוֹשׁוּעַ", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "and (later <span dir=\"rtl\">יֵשׁוּעַ</span>, <strong>n.pr.m.</strong> (& <strong>loc.</strong>, v. <strong>9</strong> infr.) <strong>(</strong><span dir=\"rtl\">י׳</span> <em>is salvation</em>, or <span dir=\"rtl\">י׳</span> <em>is opulence</em>, cf. <a data-ref=\"BDB, אֱלִישָׁע\" href=\"/BDB,_אֱלִישָׁע\", dir=\"rtl\">אֱלִישָׁע</a>, <a data-ref=\"BDB, אֱלִישׁוּעַ\" href=\"/BDB,_אֱלִישׁוּעַ\", dir=\"rtl\">אֱלִישׁוּעַ</a>, <a data-ref=\"BDB, אֲבִישׁוּעַ\" href=\"/BDB,_אֲבִישׁוּעַ\", dir=\"rtl\">אֲבִישׁוּעַ</a>, & Nes<sup>SK 1892, 573 f.</sup>; in any case it came to be associated with <span dir=\"rtl\">ישׁע</span>, cf. Mat 1:21; on <span dir=\"rtl\">יֵשׁוּעַ</span> v. especially Frä<sup>VOJ iv, 1890, 332 f.</sup> Müll<sup>SK 1892, 177 f.</sup> who cite analog. for change of <span dir=\"rtl\">וֹ</span> to later—ֵ, & Nes<sup>l.c.</sup><strong>)</strong>—"}, {"senses": [{"definition": "Moses’ successor, son of Nun, (𝔊 Ἰησοῦς) <span dir=\"rtl\">יְהוֹשׁוּעַ</span> <a data-ref=\"Deuteronomy 3:21\" href=\"/Deuteronomy.3.21\">Dt 3:21</a> <a data-ref=\"Judges 2:7\" href=\"/Judges.2.7\">Ju 2:7</a>; = <span dir=\"rtl\">יְהוֹשֻׁעַ</span> <a data-ref=\"Exodus 17:9\" href=\"/Exodus.17.9\">Ex 17:9</a>, <a data-ref=\"Exodus 17:10\" href=\"/Exodus.17.10\">10</a>, <a data-ref=\"Exodus 17:13\" href=\"/Exodus.17.13\">13</a>, <a data-ref=\"Exodus 17:14\" href=\"/Exodus.17.14\">14</a>; <a data-ref=\"Exodus 24:13\" href=\"/Exodus.24.13\">24:13</a>; <a data-ref=\"Exodus 32:17\" href=\"/Exodus.32.17\">32:17</a>; <a data-ref=\"Exodus 33:11\"