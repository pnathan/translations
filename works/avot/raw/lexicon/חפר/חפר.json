ֶּרֶת</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מַחְפֵּר.1\" data-ref=\"Klein Dictionary, מַחְפֵּר 1\">מַחְפָּר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מַחְפֵּר.1\" data-ref=\"Klein Dictionary, מַחְפֵּר 1\">מַחְפֵּר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מְחֻפָּר.1\" data-ref=\"Klein Dictionary, מְחֻפָּר 1\">מְחֻפָּר</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מַחְפֹּֽרֶת.1\" data-ref=\"Klein Dictionary, מַחְפֹּֽרֶת 1\">מַחְפֹּרֶת</a>. cp. second element in <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_דַּחְפּוֹר.1\" data-ref=\"Klein Dictionary, דַּחְפּוֹר 1\">דַּחֽפּוֹר</a>.", "prev_hw": "חֶפְצִית", "next_hw": "חפר ᴵᴵ", "notes": "[Aram.-Syr. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_חַפָּר.1\" data-ref=\"Klein Dictionary, חַפָּר 1\">חֲפַר</a>, Arab. <i>ḥafara</i> (= he dug), Akka. <i>ḫapāru</i>(= to dig).]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "חפר ᴵᴵ", "parent_lexicon": "Klein Dictionary", "content": {"senses": [{"definition": "to be ashamed, be abashed."}, {"senses": [{"definition": "was ashamed, was abashed."}], "grammar": {"morphology": "intr. v.", "binyan_form": ["חָפַר"], "verbal_stem": "— Qal"}}, {"senses": [{"definition": "was put to shame."}], "grammar": {"binyan_form": ["נֶחְפַּר"], "verbal_stem": "— Niph.", "language_code": "MH"}}, {"senses": [{"morphology": "intr. v.", "definition": "was ashamed;", "number": "1"}, {"morphology": "tr. v.", "definition": "was put to shame.", "number": "2"}], "grammar": {"binyan_form": ["הֶחֽפִּיר"], "verbal_stem": "— Hiph."}}]}, "rid": "H01124", "refs": ["Klein Dictionary, חפר ᴵ 1", "Klein Dictionary, חפר ᴵ 1", "Klein Dictionary, חָפוּר ᴵᴵ 1", "Klein Dictionary, חֵֽפֶר ᴵᴵ 1", "Klein Dictionary, מַחְפִּיר 1", "Klein Dictionary, חָפוּר ᴵᴵ 1", "Klein Dictionary, חֵֽפֶר ᴵᴵ 1", "Klein Dictionary, מַחְפִּיר 1"], "derivatives": "Derivatives: <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_חָפוּר ᴵᴵ.1\" data-ref=\"Klein Dictionary, חָפוּר ᴵᴵ 1\">חָפוּר ᴵᴵ</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_חֵֽפֶר ᴵᴵ.1\" data-ref=\"Klein Dictionary, חֵֽפֶר ᴵᴵ 1\">חֵפֶר ᴵᴵ</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_מַחְפִּיר.1\" data-ref=\"Klein Dictionary, מַחְפִּיר 1\">מַחֽפִּיר</a>.", "prev_hw": "חפר ᴵ", "next_hw": "חַפָּר", "notes": "[Aram.-Syr. <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_חפר ᴵ.1\" data-ref=\"Klein Dictionary, חפר ᴵ 1\">חפר</a> (= to be ashamed), Arab. <i>ḥafira</i> (= was bashful, was shy), Ethiop. <i>ḥafara</i> (= was ashamed, blushed).]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "חָפַר", "parent_lexicon": "BDB Dictionary", "content": {"senses": [{"definition": "<strong>vb. dig, search for (</strong>Arabic <span dir=\"rtl\">حَفَرَ</span> <em>id.;</em> Aramaic <span dir=\"rtl\">חֲפַר</span>, <span dir=\"rtl\">ܚܦܰܪ</span>, <em>id.;</em> NH <span dir=\"rtl\">חֵפֶר</span> <em>act of digging</em><strong>)</strong>—"}, {"senses": [{"definition": "Pf. <span dir=\"rtl\">ח׳</span> <a data-ref=\"Job 39:29\" href=\"/Job.39.29\">Jb 39:29</a>; <span dir=\"rtl\">וְחָפַרְתָּ֫</span> <a data-ref=\"Job 11:18\" href=\"/Job.11.18\">Jb 11:18</a>; <span dir=\"rtl\">וְחָפַרְתָּ֫ה</span> <a data-ref=\"Deuteronomy 23:14\" href=\"/Deuteronomy.23.14\">Dt 23:14</a>; <span dir=\"rtl\">חָפַרְתִּי</span> <a data-ref=\"Genesis 21:30\" href=\"/Genesis.21.30\">Gn 21:30</a>; <span dir=\"rtl\">חָֽפְרוּ</span> <a data-ref=\"Genesis 26:18\" href=\"/Genesis.26.18\">Gn 26:18</a> + 2 times; <span dir=\"rtl\">חָפָ֑רוּ</span> <a data-ref=\"Genesis 26:32\" href=\"/Genesis.26.32\">Gn 26:32</a>; <span dir=\"rtl\">חֲפָרוּהָ</span> <a data-ref=\"Numbers 21:18\" href=\"/Numbers.21.18\">Nu 21:18</a>; Impf. <span dir=\"rtl\">וַיַּחְפֹּר</span> <a data-ref=\"Genesis 26:18\" href=\"/Genesis.26.18\">Gn 26:18</a>, <a data-ref=\"Genesis 26:22\" href=\"/Genesis.26.22\">22</a>; <span dir=\"rtl\">וַיַּחְפִּרֵהוּ</span> <a data-ref=\"Psalms 7:16\" href=\"/Psalms.7.16\">ψ 7:16</a>; <span dir=\"rtl\">וָאֶחְפֹּר</span> <a data-ref=\"Jeremiah 13:7\" href=\"/Jeremiah.13.7\">Je 13:7</a>; <span dir=\"rtl\">יַחְפְּדוּ</span> <a data-ref=\"Job 39:21\" href=\"/Job.39.21\">Jb 39:21</a> (but read <span dir=\"rtl\">יַחְפֹּר</span> so 𝔊 𝔙 𝔖 Di) <a data-ref=\"Deuteronomy 1:22\" href=\"/Deuteronomy.1.22\">Dt 1:22</a>; <span dir=\"rtl\">וַיַּחְפְּרוּ</span> <a data-ref=\"Genesis 26:19\" href=\"/Genesis.26.19\">Gn 26:19</a> + 2 times; <span dir=\"rtl\">וַיַּחְפְּרֻהוּ</span> <a data-ref=\"Job 3:21\" href=\"/Job.3.21\">Jb 3:21</a>; Inf. cstr. <span dir=\"rtl\">לַחְפֹּר</span> <a data-ref=\"Joshua 2:2\" href=\"/Joshua.2.2\">Jos 2:2</a>, <a data-ref=\"Joshua 2:3\" href=\"/Joshua.2.3\">3</a> + <a data-ref=\"Isaiah 2:20\" href=\"/Isaiah.2.20\">Is 2:20</a> (cf. infr.); Pt. <span dir=\"rtl\">חֹפֵר</span> <a data-ref=\"Ecclesiastes 10:8\" href=\"/Ecclesiastes.10.8\">Ec 10:8</a>;—"}, {"senses": [{"definition": "<em>dig:</em>"}, {"senses": [{"definition": "a well, c. acc. <span dir=\"rtl\">בְּאֵר</span> <a data-ref=\"Genesis 21:30\" href=\"/Genesis.21.30\">Gn 21:30</a> (E), <a data-ref=\"Genesis 26:15\" href=\"/Genesis.26.15\">26:15</a>, <a data-ref=\"Genesis 26:18\" href=\"/Genesis.26.18\">18</a><sup>(×2)</sup>, <a data-ref=\"Genesis 26:19\" href=\"/Genesis.26.19\">19</a>, <a data-ref=\"Genesis 26:21\" href=\"/Genesis.26.21\">21</a>, <a data-ref=\"Genesis 26:22\" href=\"/Genesis.26.22\">22</a>, <a data-ref=\"Genesis 26:32\" href=\"/Genesis.26.32\">32</a> (J), <a data-ref=\"Numbers 21:18\" href=\"/Numbers.21.18\">Nu 21:18</a> (E); cf. <a data-ref=\"Exodus 7:24\" href=\"/Exodus.7.24\">Ex 7:24</a> (E); <em>dig</em> (a hole, implied as obj.) <a data-ref=\"Deuteronomy 23:14\" href=\"/Deuteronomy.23.14\">Dt 23:14</a>; a pit, with hostile purpose, as snare or trap, fig. of malicious plan, c. acc. <span dir=\"rtl\">בּוֹר</span> <a data-ref=\"Psalms 7:16\" href=\"/Psalms.7.16\">ψ 7:16</a> (‖ <span dir=\"rtl\">כָּרָה</span>); so c. acc. <span dir=\"rtl\">גומץ</span> <a data-ref=\"Ecclesiastes 10:8\" href=\"/Ecclesiastes.10.8\">Ec 10:8</a>, cf. <span dir=\"rtl\">ח׳ לְנַפְשִׁי [שַׁחַת]</span> <a data-ref=\"Psalms 35:7\" href=\"/Psalms.35.7\">ψ 35:7</a>; of horse, <em>dig</em>, i.e. <em>paw</em> the ground, <span dir=\"rtl\">יַחְפֹּר בָּעֵמֶק</span> <a data-ref=\"Job 39:21\" href=\"/Job.39.21\">Jb 39:21</a> (so read, v. supr.) <em>he paweth in the valley</em> (cf. Arabic <span dir=\"rtl\">حَافِرٌ</span> <em>hoof</em>)."}], "num": "a."}, {"senses": [{"definition": "<em>dig</em> for something hidden, c. acc. <a data-ref=\"Job 3:21\" href=\"/Job.3.21\">Jb 3:21</a> (fig. of longing for death), <a data-ref=\"Jeremiah 13:7\" href=\"/Jeremiah.13.7\">Je 13:7</a> (no obj. expr.)"}], "num": "b."}], "num": "1."}, {"senses": [{"definition": "<em>search, search out, explore</em>, c. acc. <span dir=\"rtl\">הָאָרֶץ</span> <a data-ref=\"Joshua 2:2\" href=\"/Joshua.2.2\">Jos 2:2</a>, <a data-ref=\"Joshua 2:3\" href=\"/Joshua.2.3\">3</a> (JE), <a data-ref=\"Deuteronomy 1:22\" href=\"/Deuteronomy.1.22\">Dt 1:22</a>; of eagle, <em>search for</em> food, c. acc. <span dir=\"rtl\">ח׳ אֹכֶל</span> <a data-ref=\"Job 39:29\" href=\"/Job.39.29\">Jb 39:29</a>, with especially reference to keen vision (‖ <span dir=\"rtl\">מֵרָחוֹק עֵינָיו יַבִּיטוּ</span>); so = <em>search</em> or <em>look carefully about</em> before going to rest <a data-ref=\"Job 11:18\" href=\"/Job.11.18\">Jb 11:18</a> (no obj.).—<span dir=\"rtl\">לַחְפֹּר</span> <a data-ref=\"Isaiah 2:20\" href=\"/Isaiah.2.20\">Is 2:20</a> v. <a ,=\"\" data-ref=\"BDB, חֲפַרְפָּרָה\" dir=\"rtl\" href=\"/BDB,_חֲפַרְפָּרָה\">חֲפַרְפָּרָה</a> infr."}], "num": "2."}], "form": "Qal"}]}, "rid": "BDB03345", "strong_numbers": ["2658", "2659"], "next_hw": "חֵ֫פֶר", "prev_hw": "חָפַץ", "all_cited": true, "ordinal": "I.", "root": true, "quotes": [], "GK": ["2916", "2917"], "TWOT": ["714", "715"], "parent_lexicon_details": {"name": "BDB Dictionary", "language": "heb.biblical", "to_language": "eng", "text_categories": [], "source": "BDB Dictionary", "attribution": "F. Brown, S. Driver & C. Briggs", "index_title": "BDB", "version_title": "A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906", "version_lang": "en", "should_autocomplete": true}}, {"headword": "חָפַר I", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>פ\"י, עת' אֶחְפֹּר, יַחְפֹּר, יַחְפְּרוּ, לַחְפֹּר, — חָפַר בְּאֵר וכדומה, עשה באדמה מקום עמֹק ע\"י כלי חד, במעדור, במרה, וכדומה, graben; creuser; to dig:  בעבור תהיה לי לעדה כי חָפַרְתִּי את הבאר הזאת (<span class=\"by-source\">בראש' כא ל</span>).  וכל הבארֹת אשר חָפְרוּ עבדי אביו בימי אברהם אביו סתמום פלשתים וימלאום עפר (<span class=\"by-source\">שם כו יה</span>).  ויגידו לו על אדות הבאר אשר חָפָרוּ ויאמרו לו מצאנו מים (<span class=\"by-source\">שם לב</span>).  וישב יצחק וַיַחְפֹּר את בארת המים (<span class=\"by-source\">שם יח</span>).  וַיַּחְפְּרוּ עבדי יצחק בנחל וימצאו שם באר מים חיים (<span class=\"by-source\">שם יט</span>).  והיה בשבתך חוץ וְחָפַרְתָּה בה (<span class=\"by-source\">דבר' כג יד</span>).  באר חֲפָרוּהָ שרים כרוה נדיבי העם (<span class=\"by-source\">במד' כא יח</span>).  ואלך פרתה וָאֶחְפֹּר ואקח את האזור (<span class=\"by-source\">ירמ' יג ז</span>).  בור כרה וַיַּחְפְּרֵהוּ ויפל בשחת יפעל (<span class=\"by-source\">תהל' ז יו</span>).  וַיַּחְפְּרֻהוּ ממטמונים (<span class=\"by-source\">איוב ג כא</span>).  לחְפֹּר<sup class=\"footnote-marker\">1</sup><i class=\"footnote\">כך לפי הכתיב.</i> פרות ולעטלפים (<span class=\"by-source\">ישע' ב כ</span>).  חֹפֵר גומץ בו יפול (<span class=\"by-source\">קהל' י ח</span>). — ובספרות המאֹחרת:  <strong>החופר</strong> בור ברשות היחיד ופתחו לרשות הרבים (<span class=\"by-source\">ב\"ק ה ה</span>).  אין <strong>חופרין</strong> כוכין וקברות במועד (<span class=\"by-source\">מו\"ק א ו</span>).  אל תעשם (דברי תורה) עטרה להתגדל בהם ולא קרדום <strong>לחפור</strong> בהם (<span class=\"by-source\">אבות ד ה</span>).  אף הוא <strong>חופר</strong> בדקר ומכסה (<span class=\"by-source\">ירוש' ביצ' א ס:</span>).  מעשה בחסיד אחד שהיה <strong>חופר</strong> בורות שחין ומערות לעוברים ולשבים (<span class=\"by-source\">שם שקל' ה מח ד</span>).  לא <strong>יחפור</strong> אדם בור סמוך לבורו של חבירו (<span class=\"by-source\">ב\"ב יז:</span>).  כל ערב תשעה באב היה משה מוציא כרוז בכל המחנה ואומר צאו <strong>לחפור</strong> והיו יוצאין <strong>וחופרין</strong> קברות וישנין בהן (<span class=\"by-source\">מד\"ר איכ', פתיח'</span>).  לאחד שהיה לו שדה בית כור והלך ומכרה בדבר קל והלך הלוקח <strong>וחפר</strong> בה מעיינות ועשה בה גנות ופרדסין התחיל המוכר רואה ונחנק (<span class=\"by-source\">שם שה\"ש, גן נעול</span>).</p>", "<p>— נִפע', °נֶחְפַּר, — שחפרוהו:  אחד החופר בור או <strong>שנחפר</strong> מאליו או שחפרתו בהמה או חיה (<span class=\"by-source\">רמב\"ם, נזקי ממון יב ג</span>).</p>"]}, "rid": "BY-06600", "prev_hw": "חפר I", "next_hw": "חפר II", "page_num": 1694, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}, {"headword": "חָפַר II", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>, פ\"י, עת' יַחְפֹּר, יַחְפְּרוּ, לַחְפֹּר, — חָפַר את הארץ, רִגֵּל אותה, ראה והתבונן לעניניה איך ללכדה, auskundschaften; espionner; to explore:  ותקרבון אלי כלכם ותאמרו נשלחה אנשים לפנינו וְיַחְפְּרוּ לנו את הארץ וישבו אתנו דבר את הדרך אשר נעלה בה ואת הערים אשר נבא אליהן (<span class=\"by-source\">דבר' א כב</span>).  הנה אנשים באו הנה הלילה מבני ישראל לַחְפֹּר את הארץ (<span class=\"by-source\">יהוש' ב ב</span>).  הוציאי האנשים הבאים אליך אשר באו לביתך כי לַחְפֹּר את כל הארץ באו (<span class=\"by-source\">שם ג</span>). — ובמשמ' מחפש בעיניו, erspähen; épier; to espy:  סלע ישכן (הנשר) ויתלנן על שן סלע ומצודה משם חָפַר אכל למרחוק עיניו יביטו (<span class=\"by-source\">איוב לט כח-כט</span>).  ובטחת כי יש תקוה וְחָפַרְתָּ לבטח תשכב (<span class=\"by-source\">שם יא יח</span>).</p>"]}, "rid": "BY-06604", "prev_hw": "חפר III", "next_hw": "חֲפֹר", "page_num": 1695, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]