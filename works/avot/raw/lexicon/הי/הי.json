[{"headword": "הֵי I", "parent_lexicon": "Jastrow Dictionary", "rid": "E00327", "refs": ["Jastrow, הֵא II 1"], "content": {"senses": [{"definition": " pr. n. m., v. <a class=\"refLink\" href=\"/Jastrow,_הֵא II.1\" data-ref=\"Jastrow, הֵא II 1\"><span dir=\"rtl\">הֵא</span> II</a>"}]}, "quotes": [], "prev_hw": "ה\"י", "next_hw": "הֵי II", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "הֵי II", "parent_lexicon": "Jastrow Dictionary", "rid": "E00328", "refs": ["Bava Metzia 4a", "Bava Metzia 4a", "Chullin 14a:3", "Shabbat 9b:2", "Chullin 49b:14", "Berakhot 31a:3", "Jerusalem Talmud Sukkah 5:1:4"], "content": {"senses": [{"definition": " interj. (b. h.  interj. (b. h. <span dir=\"rtl\">הִא</span>) <i>behold, here is</i>. <a class=\"refLink\" href=\"Jerusalem_Talmud_Sukkah.5.1.4\" data-ref=\"Jerusalem Talmud Sukkah 5:1:4\">Y. Succ. V, beg. 55ᵃ</a> <span dir=\"rtl\">הי לך מצה</span> here is unleavened bread for thee. Combined <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_הֵילָךְ.1\" data-ref=\"Jastrow, הֵילָךְ 1\">הֵילָךְ</a>. Ib.—<a class=\"refLink\" href=\"/Bava_Metzia.4a\" data-ref=\"Bava Metzia 4a\">B. Mets. 4ᵃ I</a> owe thee only fifty Zuz, <span dir=\"rtl\">וה׳</span> and here they are.—Hence (law) <i>helakh, the instantaneous delivery of the amount confessed</i>, while the creditor claims a larger amount. <a class=\"refLink\" href=\"/Bava_Metzia.4a\" data-ref=\"Bava Metzia 4a\">Ib.</a> <span dir=\"rtl\">ה׳ פטור וכ׳</span> if one delivers one portion of the claim (says, ‘here it is’), he is exempt from taking an oath (as one who confesses a part of a claimed debt otherwise must do); a. fr.", "number": "1)"}, {"definition": " (interrog.) <i>which?</i> <a class=\"refLink\" href=\"/Chullin.14a.3\" data-ref=\"Chullin 14a:3\">Ḥull. 14ᵃ</a> <span dir=\"rtl\">הי ר׳ יהודה</span> which R. Judah, i.e. to which opinion of R. J. do you allude? <a class=\"refLink\" href=\"/Shabbat.9b.2\" data-ref=\"Shabbat 9b:2\">Sabb. 9ᵇ</a> <span dir=\"rtl\">הי סמוך וכ׳</span> which ‘near Minḥah’ is meant in the Mishnah?—<a class=\"refLink\" href=\"/Chullin.49b.14\" data-ref=\"Chullin 49b:14\">Ḥull. 49ᵇ</a> <span dir=\"rtl\">הי מינייהו</span> which of them (eventually closes up a hole in the entrails); a. fr.", "number": "—2)"}, {"definition": "<i>where?</i> <a class=\"refLink\" href=\"/Berakhot.31a.3\" data-ref=\"Berakhot 31a:3\">Ber. 31ᵃ</a> <span dir=\"rtl\">הי תורה וכ׳</span> where is the law, and where the good deeds to protect us?—<a class=\"refLink\" href=\"/Targum_Jonathan_on_Deuteronomy.5.23\" data-ref=\"Targum Jonathan on Deuteronomy 5:23\">Targ. Y. Deut. V, 23</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_דֵּן.1\" data-ref=\"Jastrow, דֵּן 1\">דֵּן</a>.—<span dir=\"rtl\">הי דינו</span>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_הַיְידְּנוּ.1\" data-ref=\"Jastrow, הַיְידְּנוּ 1\">הַיְידְּנוּ</a>.", "number": "—3)"}, {"definition": "<i>as, like</i>. <a class=\"refLink\" href=\"/Targum_Jonathan_on_Deuteronomy.32.41\" data-ref=\"Targum Jonathan on Deuteronomy 32:41\">Targ. Y. I Deut. XXXII, 41</a> <span dir=\"rtl\">הֵיא ברק</span> (not <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_הִיא.1\" data-ref=\"Jastrow, הִיא 1\">הִיא</a>) as lightning. Mostly <span dir=\"rtl\">הי כ־</span>; comb. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_הֵיכ־.1\" data-ref=\"Jastrow, הֵיכ־ 1\">היכ־</a>. <a class=\"refLink\" href=\"/Targum_Jonathan_on_Leviticus.25.40\" data-ref=\"Targum Jonathan on Leviticus 25:40\">Targ. Y. Lev. XXV, 40</a>, v. <a dir=\"rtl\" class=\"refLink\" href=\"/Jastrow,_הֵיךְ.1\" data-ref=\"Jastrow, הֵיךְ 1\">הֵיךְ</a>.", "number": "—4)"}]}, "plural_form": [], "alt_headwords": [], "quotes": [], "prev_hw": "הֵי I", "next_hw": "הִי I", "parent_lexicon_details": {"name": "Jastrow Dictionary", "language": "heb.talmudic", "to_language": "eng", "text_categories": [], "source": "Jastrow Dictionary", "attribution": "Rabbi Marcus Jastrow", "index_title": "Jastrow", "version_title": "London, Luzac, 1903", "version_lang": "en", "should_autocomplete": true}}, {"headword": "הֵי", "parent_lexicon": "Klein Dictionary", "content": {"morphology": "interj.", "senses": [{"definition": "here is."}]}, "rid": "E00629", "language_code": "PBH", "refs": ["Klein Dictionary, הַאי 1", "Klein Dictionary, הֵא ᴵ 1", "Klein Dictionary, הֵיכָא 1", "Klein Dictionary, הֵיכָן 1", "Klein Dictionary, הֵילָךְ ᴵ 1", "Klein Dictionary, הֵימֶנּוּ 1", "Klein Dictionary, הִלְכָּךְ 1", "Klein Dictionary, הַיְנוּ 1", "Klein Dictionary, הַאי 1", "Klein Dictionary, הֵא ᴵ 1", "Klein Dictionary, הֵיכָא 1", "Klein Dictionary, הֵיכָן 1", "Klein Dictionary, הֵילָךְ ᴵ 1", "Klein Dictionary, הֵימֶנּוּ 1", "Klein Dictionary, הִלְכָּךְ 1", "Klein Dictionary, הַיְנוּ 1"], "prev_hw": "הִטָּרְפוּת", "next_hw": "הִיא", "notes": "[From demonstrative <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_הַאי.1\" data-ref=\"Klein Dictionary, הַאי 1\">הַאי</a>, whence prob. also <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_הֵא ᴵ.1\" data-ref=\"Klein Dictionary, הֵא ᴵ 1\">הֵא</a> (= lo, behold). cp. the first element in <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_הֵיכָא.1\" data-ref=\"Klein Dictionary, הֵיכָא 1\">הֵיכָא</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_הֵיכָן.1\" data-ref=\"Klein Dictionary, הֵיכָן 1\">הֵיכָן</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_הֵילָךְ ᴵ.1\" data-ref=\"Klein Dictionary, הֵילָךְ ᴵ 1\">הֵילָךְ ᴵ</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_הֵימֶנּוּ.1\" data-ref=\"Klein Dictionary, הֵימֶנּוּ 1\">הֵימֶנּוּ</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_הִלְכָּךְ.1\" data-ref=\"Klein Dictionary, הִלְכָּךְ 1\">הִלְכָּךְ</a>, <a dir=\"rtl\" class=\"refLink\" href=\"/Klein Dictionary,_הַיְנוּ.1\" data-ref=\"Klein Dictionary, הַיְנוּ 1\">הַיְנוּ</a>.]", "parent_lexicon_details": {"name": "Klein Dictionary", "language": "heb.modern", "to_language": "eng", "text_categories": [], "source": "Klein Dictionary", "attribution": "Ezra Klein", "index_title": "Klein Dictionary", "version_title": "Carta Jerusalem; 1st edition, 1987", "version_lang": "en", "should_autocomplete": true}}, {"headword": "הֵי I", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>*, — כמו *<a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_הֵא_I.1\" data-ref=\"Ben Yehuda Dictionary, הֵא I 1\">א. הֵא</a> מלת הרמז: ובעצרת אומר לו <strong>הי</strong> לך מצה <strong>הי</strong> לך חמץ (<span class=\"by-source\">ירוש' סוכ' ה נה.</span>).  — ועי' <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_הֵילָךְ_I.1\" data-ref=\"Ben Yehuda Dictionary, הֵילָךְ I 1\">הילך</a>.</p>"]}, "rid": "BY-04098", "prev_hw": "הַטְרָפָה", "next_hw": "הֵי II", "page_num": 1070, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}, {"headword": "הֵי II", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>— כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_אֵי_I.1\" data-ref=\"Ben Yehuda Dictionary, אֵי I 1\">אֵי</a>, עי' *<a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_הֵיאַךְ.1\" data-ref=\"Ben Yehuda Dictionary, הֵיאַךְ 1\">הֵיאַך</a>.</p>"]}, "rid": "BY-04099", "prev_hw": "הֵי I", "next_hw": "הֵי III", "page_num": 1070, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}, {"headword": "הֵי III", "parent_lexicon": "Ben Yehuda Dictionary", "content": {"definition": ["<p>* —  כמו <a class=\"refLink\" href=\"/Ben_Yehuda_Dictionary,_הֵא_I.1\" data-ref=\"Ben Yehuda Dictionary, הֵא I 1\">הֵא</a>, שם האות החמשית:  הפותח ביוד <strong>הי</strong> וחותם ביוד <strong>הי</strong> הרי זה חכם (<span class=\"by-source\">תוספתא ברכ' ז כ</span>).  העולם הזה נכתב ביוד <strong>הי</strong> ונקרא באלף דלת אבל לעוה\"ב כולו אחד נקרא ביוד <strong>הי</strong> ונכתב ביוד <strong>הי </strong>(<span class=\"by-source\">פסח' נ.</span>). ידכה <strong>בהי</strong> זו שמאל (<span class=\"by-source\">מנח' לז.</span>). אלף למד חול יוד <strong>הי</strong> קדש (<span class=\"by-source\">שבוע' לה:</span>). הכותב אלף למד מארבע אותיות יוד <strong>הי</strong> מארבע אותיות אינן נמחקין (<span class=\"by-source\">מס' סופר' ד ב</span>).</p>"]}, "rid": "BY-04100", "prev_hw": "הֵי II", "next_hw": "הִי", "page_num": 1070, "parent_lexicon_details": {"name": "Ben Yehuda Dictionary", "language": "heb", "to_language": "heb", "text_categories": [], "index_title": "Ben Yehuda Dictionary", "version_title": "Ben Yehuda Dictionary", "version_lang": "he", "should_autocomplete": true}}]