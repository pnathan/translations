, "textDepth": 3, "sectionNames": ["Chapter", "Verse", "Comment"], "addressTypes": ["Perek", "Pasuk", "Integer"], "titleVariants": [], "heTitleVariants": [], "index_offsets_by_depth": {}, "warnings": []}