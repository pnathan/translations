ah Publications, 2009", "actualLanguage": "en", "languageFamilyName": "english", "isSource": false, "isPrimary": false, "direction": "ltr"}, {"status": "locked", "priority": 1.0, "license": "Public Domain", "versionNotes": "", "formatAsPoetry": "", "digitizedBySefaria": "", "method": "", "heversionSource": "", "versionUrl": "", "versionTitleInHebrew": "ובלכתך בדרך", "versionNotesInHebrew": "", "shortVersionTitle": "", "shortVersionTitleInHebrew": "", "extendedNotes": "", "extendedNotesHebrew": "", "purchaseInformationImage": "", "purchaseInformationURL": "", "hasManuallyWrappedRefs": "", "language": "he", "title": "Ibn Ezra on Genesis", "versionSource": "http://mobile.tora.ws/", "versionTitle": "On Your Way", "actualLanguage": "he", "languageFamilyName": "hebrew", "isSource": true, "isPrimary": true, "direction": "rtl"}], "ref": "Ibn Ezra on Genesis 41", "heRef": "אבן עזרא על בראשית מ״א", "sections": ["41"], "toSections": ["41"], "sectionRef": "Ibn Ezra on Genesis 41", "heSectionRef": "אבן עזרא על בראשית מ״א", "firstAvailableSectionRef": "Ibn Ezra on Genesis 41:1", "isSpanning": false, "next": "Ibn Ezra on Genesis 42:1", "prev": "Ibn Ezra on Genesis 40:23", "title": "Ibn Ezra on Genesis 41", "book": "Ibn Ezra on Genesis", "heTitle": "אבן עזרא על בראשית", "primary_category": "Commentary", "type": "Commentary", "indexTitle": "Ibn Ezra on Genesis", "categories": ["Tanakh", "Rishonim on Tanakh", "Ibn Ezra", "Torah"], "heIndexTitle": "אבן עזרא על בראשית", "isComplex": true, "isDependant": true, "order": [5], "collectiveTitle": "Ibn Ezra", "heCollectiveTitle": "אבן עזרא", "alts": [[{"en": ["Miketz"], "he": ["מקץ"], "whole": true}]], "lengths": [50, 802, 1255], "length": 50, "textDepth": 3, "sectionNames": ["Chapter", "Verse", "Comment"], "addressTypes": ["Perek", "Pasuk", "Integer"], "titleVariants": [], "heTitleVariants": [], "index_offsets_by_depth": {}, "warnings": []}