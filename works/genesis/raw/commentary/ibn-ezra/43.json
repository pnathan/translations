{"versions": [{"status": "locked", "priority": 6.0, "license": "Public Domain", "versionNotes": "", "formatAsPoetry": "", "digitizedBySefaria": true, "method": "", "heversionSource": "", "versionUrl": "", "versionTitleInHebrew": "", "versionNotesInHebrew": "", "shortVersionTitle": "", "shortVersionTitleInHebrew": "", "extendedNotes": "", "extendedNotesHebrew": "", "purchaseInformationImage": "", "purchaseInformationURL": "", "hasManuallyWrappedRefs": "", "language": "he", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH990020973480205171/NLI", "versionTitle": "Piotrkow, 1907-1911", "actualLanguage": "he", "languageFamilyName": "hebrew", "isSource": true, "isPrimary": true, "direction": "rtl", "text": [[], [], [], [], [], [], [], ["<b>גם אנחנו.</b> דרך לשון הקדש להוסיף גם ראשון<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"1\"></i> כמו משל בנו גם אתה (שופ' ה כב)<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"2\"></i>:"], [], [], ["<b>זאת עשו.</b> זאת העצה<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"3\"></i>:", "<b>מזמרת הארץ.</b> כל דבר משובח מגזרת \"זמירות\" (ישעי' כד טז)<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"4\"></i>:", "<b>צרי ונכאת.</b> כבר פירשתים<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"5\"></i>:", "<b>בטנים.</b> אין אלו ריע במקרא, וי\"א אגוזים<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"6\"></i><i data-commentator=\"Mechokekei Yehudah; Karnei Ohr\" data-order=\"1\"></i>:"], ["<b>משנה.</b> שני<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"7\"></i><i data-commentator=\"Mechokekei Yehudah; Karnei Ohr\" data-order=\"2\"></i>:", "<b>משגה.</b> משמות בעלי הה\"א<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"8\"></i>"], [], ["וטעם ואל שדי שיש לו כח לעשות כאלה<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"9\"></i>:", "<b>כאשר שכלת.</b> במות יוסף, אחשב כי שכלתי מהכל<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"10\"></i>:"], [], [], [], ["<b>להתגולל.</b> מגזרת בגלל הדבר (דבר' טו י)<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"11\"></i><i data-commentator=\"Mechokekei Yehudah; Karnei Ohr\" data-order=\"3\"></i>:", "<b>ולהתנפל</b> כאדם שיתנפל מעצמו על אחד, ויאמר לו אתה הפלתני<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"12\"></i><i data-commentator=\"Mechokekei Yehudah; Karnei Ohr\" data-order=\"4\"></i>:"], [], ["<b>בי.</b> לשון בקשה<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"13\"></i>, ולפי דעתי שהוא דרך קצרה, כמו בי אני אדני העון (ש\"א כה כד)<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"14\"></i>, וטעם עון במקום הזה, כטעם \"גדול עוני מנשוא\" (בראשית ד יג) והטעם עשה בי מה שתרצה ותשמעני<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"15\"></i>:"], [], [], ["<b>נתן לכם מטמון.</b> יתכן שהיה לאדם מטמון בביתו ושכחו כאשר שמו באוצר, ויצא בגורלכם<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"16\"></i><i data-commentator=\"Mechokekei Yehudah; Karnei Ohr\" data-order=\"5\"></i> כי כספיכם בא אלי<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"17\"></i><i data-commentator=\"Mechokekei Yehudah; Karnei Ohr\" data-order=\"6\"></i>:"], ["<b>ביתה יוסף.</b> כמשפט הלשון אל בית יוסף<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"18\"></i>:"], [], [], ["<b>השלום אביכם הזקן.</b> שם תחת שם התואר<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"19\"></i> והיא דרך קצרה, כאלו אמר השלום לאביכם, וכן \"ואתה שלום\" (ש\"א כה ו)<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"20\"></i><i data-commentator=\"Mechokekei Yehudah; Karnei Ohr\" data-order=\"7\"></i>:"], ["<b>ויקדו.</b> שמו הקדקד בארץ וכבר השתחוו<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"21\"></i><i data-commentator=\"Mechokekei Yehudah; Karnei Ohr\" data-order=\"8\"></i>:"], ["<b>אלהים יָחְנְך.</b> אין לו משקל<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"22\"></i> אולי השתנה כן בעבור אות הגרון<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"23\"></i>:"], ["<b>כי נכמרו.</b> בערו ויקדו<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"24\"></i>, וכן \"עורנו כתנור נכמרו\" (איכה ה, י)<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"25\"></i><i data-commentator=\"Mechokekei Yehudah; Karnei Ohr\" data-order=\"9\"></i>:"], [], [], [], ["<b>וישא משאות.</b> דורון<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"26\"></i><i data-commentator=\"Mechokekei Yehudah; Karnei Ohr\" data-order=\"10\"></i>:", "<b>ידות.</b> חלקים<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"27\"></i>:", "<b>ממשאות כלם.</b> מדורון כל אחד מהם<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"28\"></i> כי רחוק<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"29\"></i> לתת לו חמש ידות על כל חלק וחלק<i data-commentator=\"Mechokekei Yehudah; Yahel Ohr\" data-order=\"30\"></i><i data-commentator=\"Mechokekei Yehudah; Karnei Ohr\" data-order=\"11\"></i>:"]]}], "available_versions": [{"status": "locked", "priority": 6.0, "license": "Public Domain", "versionNotes": "", "formatAsPoetry": "", "digitizedBySefaria": true, "method": "", "heversionSource": "", "versionUrl": "", "versionTitleInHebrew": "", "versionNotesInHebrew": "", "shortVersionTitle": "", "shortVersionTitleInHebrew": "", "extendedNotes": "", "extendedNotesHebrew": "", "purchaseInformationImage": "", "purchaseInformationURL": "", "hasManuallyWrappedRefs": "", "language": "he", "title": "Ibn Ezra on Genesis", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH990020973480205171/NLI", "versionTitle": "Piotrkow, 1907-1911", "actualLanguage": "he", "languageFamilyName": "hebrew", "isSource": true, "isPrimary": true, "direction": "rtl"}, {"status": "locked", "prior