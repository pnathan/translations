": "", "method": "", "heversionSource": "", "versionUrl": "", "versionTitleInHebrew": "ובלכתך בדרך", "versionNotesInHebrew": "", "shortVersionTitle": "", "shortVersionTitleInHebrew": "", "extendedNotes": "", "extendedNotesHebrew": "", "purchaseInformationImage": "", "purchaseInformationURL": "", "hasManuallyWrappedRefs": "", "language": "he", "title": "Ibn Ezra on Genesis", "versionSource": "http://mobile.tora.ws/", "versionTitle": "On Your Way", "actualLanguage": "he", "languageFamilyName": "hebrew", "isSource": true, "isPrimary": true, "direction": "rtl"}, {"status": "", "priority": "", "license": "CC0", "versionNotes": "", "formatAsPoetry": "", "digitizedBySefaria": "", "method": "", "heversionSource": "", "versionUrl": "", "versionTitleInHebrew": "תרגום קהילת ספריא", "versionNotesInHebrew": "", "shortVersionTitle": "", "shortVersionTitleInHebrew": "", "extendedNotes": "", "extendedNotesHebrew": "", "purchaseInformationImage": "", "purchaseInformationURL": "", "hasManuallyWrappedRefs": "", "language": "en", "title": "Ibn Ezra on Genesis", "versionSource": "https://www.sefaria.org", "versionTitle": "Sefaria Community Translation", "actualLanguage": "en", "languageFamilyName": "english", "isSource": false, "isPrimary": false, "direction": "ltr"}], "ref": "Ibn Ezra on Genesis 38", "heRef": "אבן עזרא על בראשית ל״ח", "sections": ["38"], "toSections": ["38"], "sectionRef": "Ibn Ezra on Genesis 38", "heSectionRef": "אבן עזרא על בראשית ל״ח", "firstAvailableSectionRef": "Ibn Ezra on Genesis 38:1", "isSpanning": false, "next": "Ibn Ezra on Genesis 39:6", "prev": "Ibn Ezra on Genesis 37:36", "title": "Ibn Ezra on Genesis 38", "book": "Ibn Ezra on Genesis", "heTitle": "אבן עזרא על בראשית", "primary_category": "Commentary", "type": "Commentary", "indexTitle": "Ibn Ezra on Genesis", "categories": ["Tanakh", "Rishonim on Tanakh", "Ibn Ezra", "Torah"], "heIndexTitle": "אבן עזרא על בראשית", "isComplex": true, "isDependant": true, "order": [5], "collectiveTitle": "Ibn Ezra", "heCo